{
  "$schema": "vscode://schemas/color-theme",
  "name": "Hoox Signal",
  "type": "dark",
  "colors": {
    "editor.background": "#030303",
    "editor.foreground": "#EEEEEE",
    "editorCursor.foreground": "#FE6A00",
    "editor.selectionBackground": "#301602",
    "editor.lineHighlightBackground": "#100803",
    "editorLineNumber.foreground": "#747170",
    "editorLineNumber.activeForeground": "#868686",
    "editorIndentGuide.background1": "#161616",
    "editorIndentGuide.activeBackground1": "#2E2E2E",
    "editorBracketMatch.background": "#301602",
    "editorBracketMatch.border": "#C76D2D",
    "editorWhitespace.foreground": "#161616",
    "editorGutter.background": "#030303",
    "editorWidget.background": "#0B0B0B",
    "editorWidget.border": "#161616",
    "editorWidget.foreground": "#EEEEEE",
    "editorHoverWidget.background": "#0B0B0B",
    "editorHoverWidget.border": "#161616",
    "editorHoverWidget.foreground": "#EEEEEE",
    "editorHoverWidget.statusBarBackground": "#0B0B0B",
    "editorSuggestWidget.background": "#0B0B0B",
    "editorSuggestWidget.border": "#161616",
    "editorSuggestWidget.foreground": "#EEEEEE",
    "editorSuggestWidget.selectedBackground": "#301602",
    "editorSuggestWidget.highlightForeground": "#FE6A00",
    "editorError.foreground": "#E2726B",
    "editorWarning.foreground": "#EEEEEE",
    "editorInfo.foreground": "#868686",
    "editorHint.foreground": "#868686",
    "editorOverviewRuler.border": "#161616",
    "focusBorder": "#C76D2D",
    "foreground": "#EEEEEE",
    "descriptionForeground": "#868686",
    "errorForeground": "#E2726B",
    "sideBar.background": "#030303",
    "sideBar.foreground": "#868686",
    "sideBar.border": "#161616",
    "activityBar.background": "#030303",
    "activityBar.foreground": "#EEEEEE",
    "activityBar.border": "#161616",
    "statusBar.background": "#0B0B0B",
    "statusBar.foreground": "#868686",
    "statusBar.border": "#161616",
    "statusBar.noFolderBackground": "#0B0B0B",
    "statusBar.debuggingBackground": "#FE6A00",
    "titleBar.activeBackground": "#030303",
    "titleBar.activeForeground": "#EEEEEE",
    "titleBar.border": "#161616",
    "panel.background": "#030303",
    "panel.border": "#161616",
    "panelTitle.activeForeground": "#EEEEEE",
    "terminal.background": "#030303",
    "terminal.foreground": "#EEEEEE",
    "terminal.ansiBlack": "#0B0B0B",
    "terminal.ansiRed": "#E2726B",
    "terminal.ansiGreen": "#F7A56B",
    "terminal.ansiYellow": "#EEEEEE",
    "terminal.ansiBlue": "#FE6A00",
    "terminal.ansiMagenta": "#F4B98F",
    "terminal.ansiCyan": "#868686",
    "terminal.ansiWhite": "#EEEEEE",
    "button.background": "#FE6A00",
    "button.foreground": "#030303",
    "button.hoverBackground": "#C76D2D",
    "textLink.foreground": "#FE6A00",
    "textLink.activeForeground": "#F4B98F",
    "textPreformat.foreground": "#FE6A00",
    "textBlockQuote.background": "#0B0B0B",
    "textBlockQuote.border": "#2E2E2E",
    "textCodeBlock.background": "#030303",
    "badge.background": "#FE6A00",
    "badge.foreground": "#030303",
    "progressBar.background": "#FE6A00",
    "input.background": "#0B0B0B",
    "input.border": "#101010",
    "input.foreground": "#EEEEEE",
    "dropdown.background": "#0B0B0B",
    "dropdown.border": "#101010",
    "list.hoverBackground": "#0B0B0B",
    "list.activeSelectionBackground": "#301602",
    "list.activeSelectionForeground": "#EEEEEE",
    "list.inactiveSelectionBackground": "#0B0B0B",
    "list.highlightForeground": "#FE6A00",
    "scrollbarSlider.background": "#2E2E2E80",
    "scrollbarSlider.hoverBackground": "#2E2E2EB0",
    "scrollbarSlider.activeBackground": "#FE6A0080",
    "gitDecoration.addedResourceForeground": "#F7A56B",
    "gitDecoration.modifiedResourceForeground": "#EEEEEE",
    "gitDecoration.deletedResourceForeground": "#E2726B",
    "gitDecoration.untrackedResourceForeground": "#868686",
    "notifications.background": "#0B0B0B",
    "notifications.border": "#161616",
    "quickInput.background": "#0B0B0B",
    "quickInput.foreground": "#EEEEEE"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#747170",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#FE6A00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B26E3E"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.type.pinescript",
        "storage.type.qualifier",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#F4B98F"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F7A56B"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.na",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant.color",
        "support.constant.strategy"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.series",
        "variable.language.barstate"
      ],
      "settings": {
        "foreground": "#868686"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FE6A00"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#C8773C"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "keyword.other.annotation",
        "string.unquoted.annotation",
        "meta.function.declaration",
        "meta.type.declaration",
        "meta.enum.declaration",
        "meta.import",
        "meta.namespace.member",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#747170",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "entity.name.tag.directive"
      ],
      "settings": {
        "foreground": "#747170"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#837F7E"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E2726B"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C8773C",
    "type": "#F4B98F",
    "class": "#F4B98F",
    "function": "#FE6A00",
    "method": "#FE6A00",
    "variable": "#EEEEEE",
    "parameter": "#EEEEEE",
    "property": "#A47F64",
    "keyword": "#FE6A00",
    "string": "#F7A56B",
    "number": "#EEEEEE",
    "operator": "#B26E3E",
    "comment": {
      "foreground": "#747170",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "*.readonly": {
      "foreground": "#868686"
    },
    "*.defaultLibrary": {
      "foreground": "#868686"
    }
  }
}
