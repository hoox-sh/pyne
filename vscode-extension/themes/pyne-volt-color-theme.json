  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#71726F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#B7EF09",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#90AA41"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.type.pinescript",
        "storage.type.qualifier",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#D8EE92"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D0EF70"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.na",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant.color",
        "support.constant.strategy"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.series",
        "variable.language.barstate"
      ],
      "settings": {
        "foreground": "#9E9F98"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#B7EF09"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ACCB49"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "keyword.other.annotation",
        "string.unquoted.annotation",
        "meta.function.declaration",
        "meta.type.declaration",
        "meta.enum.declaration",
        "meta.import",
        "meta.namespace.member",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#71726F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "entity.name.tag.directive"
      ],
      "settings": {
        "foreground": "#71726F"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#7F817D"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E2726B"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ACCB49",
    "type": "#D8EE92",
    "class": "#D8EE92",
    "function": "#B7EF09",
    "method": "#B7EF09",
    "variable": "#EEEEEE",
    "parameter": "#EEEEEE",
    "property": "#A4B374",
    "keyword": "#B7EF09",
    "string": "#D0EF70",
    "number": "#EEEEEE",
    "operator": "#90AA41",
    "comment": {
      "foreground": "#71726F",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "*.readonly": {
      "foreground": "#9E9F98"
    },
    "*.defaultLibrary": {
      "foreground": "#9E9F98"
    }
  }
}
