{
  "$schema": "vscode://schemas/color-theme",
  "name": "PYNE Volt",
  "type": "dark",
  "colors": {
    "editor.background": "#030302",
    "editor.foreground": "#EEEEEE",
    "editorCursor.foreground": "#B7EF09",
    "editor.selectionBackground": "#2B3704",
    "editor.lineHighlightBackground": "#0E1102",
    "editorLineNumber.foreground": "#70706B",
    "editorLineNumber.activeForeground": "#9E9F98",
    "editorIndentGuide.background1": "#23231F",
    "editorIndentGuide.activeBackground1": "#3D3E37",
    "editorBracketMatch.background": "#2B3704",
    "editorBracketMatch.border": "#B7EF09",
    "editorWhitespace.foreground": "#23231F",
    "editorGutter.background": "#030302",
    "editorWidget.background": "#0B0B09",
    "editorWidget.border": "#23231F",
    "editorWidget.foreground": "#EEEEEE",
    "editorHoverWidget.background": "#0B0B09",
    "editorHoverWidget.border": "#23231F",
    "editorHoverWidget.foreground": "#EEEEEE",
    "editorHoverWidget.statusBarBackground": "#0C0C0A",
    "editorSuggestWidget.background": "#0B0B09",
    "editorSuggestWidget.border": "#23231F",
    "editorSuggestWidget.foreground": "#EEEEEE",
    "editorSuggestWidget.selectedBackground": "#2B3704",
    "editorSuggestWidget.highlightForeground": "#B7EF09",
    "editorError.foreground": "#F07178",
    "editorWarning.foreground": "#DCC63A",
    "editorInfo.foreground": "#60E4DB",
    "editorHint.foreground": "#9E9F98",
    "editorOverviewRuler.border": "#23231F",
    "focusBorder": "#B7EF09",
    "foreground": "#EEEEEE",
    "descriptionForeground": "#9E9F98",
    "errorForeground": "#F07178",
    "sideBar.background": "#030302",
    "sideBar.foreground": "#9E9F98",
    "sideBar.border": "#23231F",
    "activityBar.background": "#030302",
    "activityBar.foreground": "#EEEEEE",
    "activityBar.border": "#23231F",
    "statusBar.background": "#0C0C0A",
    "statusBar.foreground": "#9E9F98",
    "statusBar.border": "#23231F",
    "statusBar.noFolderBackground": "#0C0C0A",
    "statusBar.debuggingBackground": "#B7EF09",
    "titleBar.activeBackground": "#030302",
    "titleBar.activeForeground": "#EEEEEE",
    "titleBar.border": "#23231F",
    "panel.background": "#030302",
    "panel.border": "#23231F",
    "panelTitle.activeForeground": "#EEEEEE",
    "terminal.background": "#030302",
    "terminal.foreground": "#EEEEEE",
    "terminal.ansiBlack": "#0C0C0A",
    "terminal.ansiRed": "#F07178",
    "terminal.ansiGreen": "#3DDC97",
    "terminal.ansiYellow": "#DCC63A",
    "terminal.ansiBlue": "#B7EF09",
    "terminal.ansiMagenta": "#DE91C9",
    "terminal.ansiCyan": "#60E4DB",
    "terminal.ansiWhite": "#EEEEEE",
    "button.background": "#B7EF09",
    "button.foreground": "#030302",
    "button.hoverBackground": "#D7CB33",
    "textLink.foreground": "#B7EF09",
    "textLink.activeForeground": "#CBCAA1",
    "textPreformat.foreground": "#B7EF09",
    "textBlockQuote.background": "#0C0C0A",
    "textBlockQuote.border": "#B7EF09",
    "textCodeBlock.background": "#030302",
    "badge.background": "#B7EF09",
    "badge.foreground": "#030302",
    "progressBar.background": "#B7EF09",
    "input.background": "#0C0C0A",
    "input.border": "#23231F",
    "input.foreground": "#EEEEEE",
    "dropdown.background": "#0C0C0A",
    "dropdown.border": "#23231F",
    "list.hoverBackground": "#0C0C0A",
    "list.activeSelectionBackground": "#2B3704",
    "list.activeSelectionForeground": "#EEEEEE",
    "list.inactiveSelectionBackground": "#0C0C0A",
    "list.highlightForeground": "#B7EF09",
    "scrollbarSlider.background": "#3D3E3780",
    "scrollbarSlider.hoverBackground": "#3D3E37B0",
    "scrollbarSlider.activeBackground": "#B7EF0980",
    "gitDecoration.addedResourceForeground": "#3DDC97",
    "gitDecoration.modifiedResourceForeground": "#DCC63A",
    "gitDecoration.deletedResourceForeground": "#F07178",
    "gitDecoration.untrackedResourceForeground": "#60E4DB",
    "notifications.background": "#0C0C0A",
    "notifications.border": "#23231F",
    "quickInput.background": "#0C0C0A",
    "quickInput.foreground": "#EEEEEE"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#70706B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#B7EF09",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B0D931"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.type.pinescript",
        "storage.type.qualifier",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#DDC43C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#3DDC97"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.na",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#DCC63A"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant.color",
        "support.constant.strategy"
      ],
      "settings": {
        "foreground": "#DCC63A"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.series",
        "variable.language.barstate"
      ],
      "settings": {
        "foreground": "#60E4DB"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#B7EF09"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ACCD45"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "meta.function.declaration",
        "meta.type.declaration",
        "meta.enum.declaration",
        "meta.import",
        "meta.namespace.member",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9E9F98",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "entity.name.tag.directive"
      ],
      "settings": {
        "foreground": "#B7EF09"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#9E9F98"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F07178"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ACCD45",
    "type": "#DDC43C",
    "class": "#DDC43C",
    "function": "#B7EF09",
    "method": "#B7EF09",
    "variable": "#EEEEEE",
    "parameter": "#EEEEEE",
    "property": "#6FE1AF",
    "keyword": "#B7EF09",
    "string": "#3DDC97",
    "number": "#DCC63A",
    "operator": "#B0D931",
    "comment": {
      "foreground": "#70706B",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "*.readonly": {
      "foreground": "#60E4DB"
    },
    "*.defaultLibrary": {
      "foreground": "#60E4DB"
    }
  }
}
