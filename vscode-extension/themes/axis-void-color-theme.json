  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#717174",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#939FFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8086B3"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.type.pinescript",
        "storage.type.qualifier",
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#CACEF5"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#BCC3F7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.na",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "support.constant.color",
        "support.constant.strategy"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.series",
        "variable.language.barstate"
      ],
      "settings": {
        "foreground": "#9D9EA3"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#939FFF"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#989FD6"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable"
      ],
      "settings": {
        "foreground": "#EEEEEE"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "keyword.other.annotation",
        "string.unquoted.annotation",
        "meta.function.declaration",
        "meta.type.declaration",
        "meta.enum.declaration",
        "meta.import",
        "meta.namespace.member",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#717174",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "entity.name.tag.directive"
      ],
      "settings": {
        "foreground": "#717174"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#7F8083"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E2726B"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#989FD6",
    "type": "#CACEF5",
    "class": "#CACEF5",
    "function": "#939FFF",
    "method": "#939FFF",
    "variable": "#EEEEEE",
    "parameter": "#EEEEEE",
    "property": "#9A9EBA",
    "keyword": "#939FFF",
    "string": "#BCC3F7",
    "number": "#EEEEEE",
    "operator": "#8086B3",
    "comment": {
      "foreground": "#717174",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "*.readonly": {
      "foreground": "#9D9EA3"
    },
    "*.defaultLibrary": {
      "foreground": "#9D9EA3"
    }
  }
}
