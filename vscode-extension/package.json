{
  "name": "pyne-pinescript",
  "displayName": "PYNE — Pine Script",
  "description": "Pine Script™ language support for VS Code: LSP diagnostics, autocomplete, hover, formatting. Part of HOOX / PYNE (pynescript).",
  "version": "0.2.0",
  "publisher": "jango-blockchained",
  "license": "AGPL-3.0-or-later",
  "author": "jango_blockchained",
  "homepage": "https://hoox.sh/pyne",
  "repository": {
    "type": "git",
    "url": "https://github.com/jango-blockchained/pyne.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/jango-blockchained/pyne/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "pinescript",
    "pine script",
    "tradingview",
    "pyne",
    "pynescript",
    "hoox",
    "lsp",
    "trading"
  ],
  "activationEvents": [
    "onLanguage:pinescript",
    "workspaceContains:**/*.pine",
    "workspaceContains:**/*.pinev5",
    "workspaceContains:**/*.pinev6"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pinescript",
        "aliases": [
          "Pine Script",
          "pinescript",
          "Pine"
        ],
        "extensions": [
          ".pine",
          ".pinev5",
          ".pinev6"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinescript",
        "scopeName": "source.pinescript",
        "path": "./syntaxes/pinescript.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PYNE Pine Script",
      "properties": {
        "pynescript.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the PYNE / pynescript language server (completion, hover, diagnostics)."
        },
        "pynescript.lsp.command": {
          "type": "string",
          "default": "auto",
          "description": "LSP launch command. Use \"auto\" to try pynescript-lsp on PATH, then python -m pynescript.langserver. Or set an absolute path to the binary."
        },
        "pynescript.lsp.python": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used when lsp.command is auto and pynescript-lsp is not on PATH (must have: pip install pynescript[lsp])."
        },
        "pynescript.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the language server process."
        },
        "pynescript.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable formatting support (when the server supports it)."
        },
        "pynescript.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostic squiggles from the language server."
        },
        "pynescript.completion.snippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable snippet completions for builtin functions."
        }
      }
    },
    "commands": [
      {
        "command": "pynescript.restartServer",
        "title": "Restart Language Server",
        "category": "PYNE"
      },
      {
        "command": "pynescript.formatDocument",
        "title": "Format Document",
        "category": "PYNE"
      },
      {
        "command": "pynescript.showLspOutput",
        "title": "Show Language Server Output",
        "category": "PYNE"
      },
      {
        "command": "pynescript.showLspCommand",
        "title": "Show Resolved LSP Launch Command",
        "category": "PYNE"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pynescript.restartServer"
        },
        {
          "command": "pynescript.formatDocument",
          "when": "editorLangId == pinescript"
        },
        {
          "command": "pynescript.showLspOutput"
        },
        {
          "command": "pynescript.showLspCommand"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
