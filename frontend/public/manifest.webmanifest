{
    "name": "AXIS — open charting PWA",
    "short_name": "AXIS",
    "description": "AXIS: open charting PWA for Pine Script™. Runs locally, on Cloudflare, or fully offline. (Formerly SuperChart.)",
    "start_url": "./",
    "scope": "./",
    "id": "/pynescript-axis",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#0a0b10",
    "theme_color": "#0a0b10",
    "categories": ["finance", "productivity", "developer"],
    "icons": [
        { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        {
            "name": "New Run",
            "short_name": "Run",
            "url": "./?action=run",
            "description": "Run the current Pine Script"
        }
    ],
    "prefer_related_applications": false
}
