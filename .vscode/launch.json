{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PYNE: Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/examples/rsi_strategy.pine"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "pyne-vscode: compile"
    },
    {
      "name": "PYNE: Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "--extensionTestsPath=${workspaceFolder}/vscode-extension/out/test/index.js",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/out/test/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "pyne-vscode: compile-tests"
    }
  ]
}
