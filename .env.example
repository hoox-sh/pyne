#
# Copy to `.env` for local compose overrides:
#   cp .env.example .env

# Host port published for the Pro API (container always listens on 8080)
API_PORT=5002
# Datafeed and MCP bind 127.0.0.1 (nginx is the public path on hosted installs)
DATAFEED_PORT=5004
MCP_PORT=5003

# Flask / app
FLASK_DEBUG=1
# Required for POST /auth/create_key (X-Admin-Token). Empty = minting disabled (403).
# Production compose (make docker-prod) refuses to start if this is empty.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Development-only debug logging (leave OFF in production)
# ---------------------------------------------------------------------------
# PYNE_DEBUG=1 turns on detailed logging for the execution engine and datafeed:
#   - interpreter bar loop (start/end, bars + ms + bars/ms, aborts, timeouts)
#   - compile pipeline (eligibility, cache HIT/MISS, transpile, JIT warm, object mode)
#   - prewarm (builtins warm, per-script results, total ms)
#   - delta calculation (append_bars delta size + start index, forming-bar ticks)
#   - datafeed (CCXT Pro connect/subscribe/updates/reconnects, REST fetches)
#   - every HTTP request (method, path, status, ms)
# It also sets `pynescript`/`backend` loggers to DEBUG. Verbose by design.
# Runtime counters regardless of this flag are on GET /stats.
# PYNE_DEBUG=0

# Optional allowlist of logger prefixes (only used while PYNE_DEBUG=1).
# Empty = every logger. Useful to cut noise, e.g. only the engine:
# PYNE_DEBUG_SCOPE=pynescript.runtime,pynescript.compiler,pynescript.util

# Optional default HTTPS destination for alert()/alertcondition() webhooks (L2).
# Per-request webhook_url on POST /run overrides this.
# ALERT_WEBHOOK_URL=https://hooks.example.com/pine
# ALERT_WEBHOOK_TIMEOUT=10
ALLOWED_ORIGINS=https://hoox.sh,https://hoox.sh/axis,http://localhost:8081,http://127.0.0.1:8081
API_KEY_STORE=/data/api_keys.json
# json (default, single-process) | sqlite (multi-worker volume) | redis (multi-replica)
STORE_BACKEND=redis
API_KEY_STORE_SQLITE=/data/api_keys.db

# Engine-owned OHLCV series store (SQLite). Must live on the persistent
# volume in Docker — the default relative data/ is wiped on every restart.
PYNE_DATA_DIR=/data/series

# Live-session journal (SQLite event log; restart recovery). Explicit path wins;
# otherwise /data/sessions.db when /data exists, memory-only when it does not.
PYNE_SESSION_DB=/data/sessions.db
# Idle TTL and capacity for live sessions (defaults 900s / 64).
SESSION_TTL_SECONDS=900
SESSION_MAX_SESSIONS=64

# Redis is a default compose daemon. Required when STORE_BACKEND=redis.
# The redis service publishes NO ports (internal network only — never expose
# it; scanners wipe open instances within hours). For auth, set a password
# here AND point REDIS_URL at it (hex avoids shell-quoting issues):
#   openssl rand -hex 32
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@redis:6379/0
REDIS_PORT=6379

# Gunicorn (production overlay / target api)
# WORKERS must stay 1: live-session state is per-process, so a second worker
# 404s on ~half of the follow-up /session calls.
GUNICORN_WORKERS=1
# Worker class must be one flask-sock can hijack. gthread exposes
# `gunicorn.socket`, which is what flask-sock upgrades on, and every live WS
# connection holds one thread — hence the generous default.
# Do NOT use geventwebsocket.gunicorn.workers.GeventWebSocketWorker: its
# handler upgrades the socket itself and flask-sock then re-frames it, so
# clients get an HTTP error body where a WS frame belongs after a successful
# 101 (Chromium: "Invalid frame header"). `sync` cannot upgrade at all.
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=100
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=5000
GUNICORN_MAX_REQUESTS_JITTER=200

# Free-tier /run guards (bar/script caps, IP rate, concurrency, chart/mock data).
# Off by default. Set 1 to enable; then tune FREE_MAX_* / FREE_RATE_*.
# FREE_TIER_LIMITS=0
# FREE_MAX_BARS=5000
# FREE_MAX_SCRIPT_CHARS=262144
# FREE_MAX_CONCURRENT=4
# FREE_RATE_LIMIT=60
# FREE_RATE_WINDOW_SEC=60

# Optional hosted runner (script registry + bar-close). Off by default.
PYNE_RUNNER=1
PYNE_RUNNER_SCHEDULER=1
PYNE_RUNNER_POLL_SECONDS=60
# Job threads per tick (slow-script isolation). Floor 1, cap 16.
PYNE_RUNNER_WORKERS=2
PYNE_RUNNER_DB=/data/runner.db
# Runner store: sqlite (single host) or redis (multi-replica; needs REDIS_URL).
# PYNE_RUNNER_STORE_BACKEND=redis

# Warm compile (H2) — defaults favor production throughput
# Disk IR/module cache (default on). Set 0 to disable on tiny/ephemeral FS.
PYNE_COMPILE_DISK_CACHE=1
# Persistent volume path so IR + Numba .nbc survive restarts (Docker: /data/…).
PYNE_COMPILE_CACHE_DIR=/data/compile-cache
# Once-per-worker builtin prewarm on first /run (default on). Soft-fail without numba.
PYNE_COMPILE_PREWARM=1

# Image tags / bake
TAG=latest
PYNESCRIPT_VERSION=0.2.0
GIT_SHA=dev

# Prod resource caps (docker-compose.prod.yml)
API_MEM_LIMIT=1g
API_CPUS=1.0
DATAFEED_MEM_LIMIT=512m
DATAFEED_CPUS=0.5
MCP_MEM_LIMIT=256m
MCP_CPUS=0.25
