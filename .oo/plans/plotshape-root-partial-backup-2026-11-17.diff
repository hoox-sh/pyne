+        # Interpret reads only the ``size=`` kwarg (positional text_size is
+        # ignored) and exports both size and text_size wire keys.
+        ok, size = self._plotshape_size_value(kwargs.get("size"))
+        if not ok:
+            return None
+        if size is not None:
