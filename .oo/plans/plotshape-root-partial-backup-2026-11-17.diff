+    @staticmethod
+    def _plotshape_arg(
+        name: str,
+        index: int | None,
+        args: list[str],
+        kwargs: dict[str, str],
+    ) -> str | None:
+        """Kwarg-first plotshape arg resolution (``None`` when omitted)."""
+        if name in kwargs:
+            return kwargs[name]
+        if index is not None and len(args) > index:
+            return args[index]
+        return None
+
+    def _plotshape_const_str(self, expr: str | None) -> tuple[bool, str | None]:
+        """Resolve one constant string plotshape attr to ``(supported, value)``.
+
+        ``na`` is supported as an omitted attr; a dynamic expression returns
+        ``(False, None)`` so the call falls through to object mode instead of
+        emitting metadata that disagrees with interpret.
+        """
+        if expr is None:
+            return True, None
+        s = expr.strip()
+        if s in ("None", "np.nan"):
+            return True, None
+        val = self._fold_const(s)
+        if isinstance(val, str) and val.strip():
+            return True, val.strip()
+        return False, None
+
+    def _plotshape_size_value(self, expr: str | None) -> tuple[bool, int | str | None]:
+        """Resolve ``size=`` to the integer wire value interpret exports."""
+        if expr is None:
+            return True, None
+        s = expr.strip()
+        if s in ("None", "np.nan"):
+            return True, None
+        val = self._fold_const(s)
+        if isinstance(val, bool):
+            return False, None
+        if isinstance(val, (int, float)):
+            return True, int(val)
+        if isinstance(val, str) and val in _PLOTSHAPE_SIZE_VALUES:
+            return True, _PLOTSHAPE_SIZE_VALUES[val]
+        return False, None
+
+    def _emit_numeric_plotshape(self, args: list[str], kwargs: dict[str, str], arg_nodes: list) -> str | None:
+        """Synthesize statement-form plotshape as a 1/0 numeric marker series.
+
+        Supported: a proven-numeric condition (including ternary numeric
+        expressions and series bools) and constant visual metadata — literal
+        title, constant style/location/color/text/size/display, and the
+        foldable offset/editable/show_last wire attrs. Dynamic visual metadata
+        falls through to object mode; the drawing event is still queued so a
+        mixed script that later flips object mode keeps the series key.
+        """
+        if self.object_mode or self.in_function or not getattr(self, "_stmt_expr", False):
+            return None
+        cond_expr = self._plotshape_arg("series", 0, args, kwargs)
+        if cond_expr is None:
+            return None
+        cond_expr = cond_expr.strip()
+        if cond_expr in ("None", "np.nan"):
+            cond_expr = "False"
+        if not (self._is_safe_numeric_expr(cond_expr) or self._is_numeric_or_bool_literal(cond_expr)):
+            return None
+
+        title_expr = self._plotshape_arg("title", 1, args, kwargs)
+        title = "shape"
+        if title_expr is not None:
+            if not self._is_quoted_string_expr(title_expr):
+                return None
+            title = self._literal_str(title_expr, default="shape") or "shape"
+        title = self._unique_plot_title(title)
+
+        attrs = self._collect_plot_attrs("plotshape", args, kwargs)
+        # _collect_plot_attrs silently skips dynamic expressions; the slice
+        # must fail closed when a wire attr is present but not constant.
+        for name in ("offset", "editable", "show_last"):
+            raw = self._plotshape_arg(name, param_index("plotshape", name), args, kwargs)
+            if raw is not None and self._fold_const(raw) is None:
+                return None
+
+        ok, style = self._plotshape_const_str(self._plotshape_arg("style", 2, args, kwargs))
+        if not ok:
+            return None
+        attrs["style"] = style if style is not None else "shape"
+
+        ok, location = self._plotshape_const_str(self._plotshape_arg("location", 3, args, kwargs))
+        if not ok:
+            return None
+        if location is not None:
+            attrs["location"] = location
+
+        ok, color = self._plotshape_const_str(self._plotshape_arg("color", 4, args, kwargs))
+        if not ok:
