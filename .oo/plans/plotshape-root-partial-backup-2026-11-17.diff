+        display_expr = kwargs.get("display")
+        if display_expr is not None and display_expr.strip() not in ("None", "np.nan"):
+            display_val = self._fold_const(display_expr)
+            display = self._coerce_folded_attr("display", display_val) if display_val is not None else None
+            if display is None:
+                return None
+            attrs["display"] = display
+
+        entry: dict[str, Any] = {
