    "Ask first before messaging people outside my team."
  ],
  "board": {
    "file": "board.md",
    "statuses": ["Todo", "Working", "Blocked", "Ready for Review", "Done"],
    "fields": [
      "task",
      "owner",
      "status",
      "priority",
      "proof",
      "blockedReason",
      "source"
    ]
  },
  "routines": {
    "enabled": true,
    "items": [
      {
        "id": "nightly-audit",
        "name": "Nightly audit",
        "owner": "oo-spec-2",
        "schedule": "daily at 03:00",
        "job": "Audit the codebase: dead code, load time, bundle size, failing checks. Open small PRs with proof. Never merge.",
        "file": "routines/nightly-audit.md",
        "enabled": true,
        "silentOnNoChange": true
      }
    ]
  },
  "memory": {
    "playbook": "playbook.md",
    "store": "sqlite",
    "path": ".oo/state.db",
    "defaultTtlDays": 90,
    "requireSourceForFacts": true
  },
  "runtime": {
    "scheduler": "manual",
    "timezone": "UTC",
    "statePath": ".oo/state.db",
    "minIntervalMinutes": 5,
    "maxRunsPerHour": 300,
    "maxRunsPerRoutinePerHour": 200,
    "runHistoryLimit": 20
  },
  "approvals": {
    "backgroundExpiryMinutes": 30,
    "maxAllowRules": 20,
    "maxAskRules": 20,
    "rules": [
      {
        "action": "send",
        "resource": "external/*",
        "effect": "ask"
      },
      {
        "action": "push",
        "resource": "push/*",
        "effect": "ask"
      },
      {
        "action": "deploy",
        "resource": "production/*",
        "effect": "ask"
      },
      {
        "action": "deploy",
        "resource": "deploy/*",
        "effect": "ask"
      },
      {
        "action": "delete",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "release",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "release/*",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "tag",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "tag/*",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "package-install",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "package-install/*",
        "resource": "*",
        "effect": "ask"
      },
      {
        "action": "state.migrate",
        "resource": "state.db",
        "effect": "ask"
      }
    ]
  },
  "cost": {
    "budgetUsdPerWeek": 25,
    "warnAtPercent": 80,
    "denyAtPercent": 100,
    "ledgerPath": ".oo/state.db"
  },
  "projects": {
