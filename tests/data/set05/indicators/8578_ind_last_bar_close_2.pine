study("Last Bar Close 2", overlay=true)

var label l = na
label.delete(l)
c = close >= open ? color.lime : color.red
l := label.new(bar_index, na,
    text=tostring(close), color=c,
    style=label.style_label_down, yloc=yloc.abovebar)
