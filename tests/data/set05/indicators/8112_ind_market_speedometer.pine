//@version=5
// set05 corpus entry
// source_repo: Rfjr77-PineScripts
// source_path: Rfjr77-PineScripts/VolatilitySpeedometer
// content_hash: 4dbe3ce113e873b0
// collected: 2026-07-27
indicator("Market Speedometer", overlay=true)

// ============================================================
// 1. USER SETTINGS: DATA SOURCES
// ============================================================
grpD        = "Data Sources"
tickSym     = input.symbol("USI:TICK.US", "TICK Symbol",  group=grpD, tooltip="Change to TICK.CA, TICK.EU, etc. if needed.")
vixSym      = input.symbol("TVC:VIX",     "VIX Symbol",   group=grpD)
usoSym      = input.symbol("USO",         "USO Symbol",   group=grpD, tooltip="Can swap for UCO, CL1!, etc.")
spySym      = input.symbol("SPY",         "SPY Symbol",   group=grpD, tooltip="Can swap for QQQ, ES1!, etc.")

// ============================================================
// 2. USER SETTINGS: TICK
// ============================================================
grpTick     = "TICK Settings"
tickFastLen = input.int(5,    "TICK Fast EMA Length", minval=1,   group=grpTick)
tickSlowLen = input.int(20,   "TICK Slow EMA Length", minval=1,   group=grpTick)
tickRange   = input.int(1200, "TICK Range (±)",       minval=100, step=100, group=grpTick, tooltip="Values beyond ±this peg the gauge.")

// ============================================================
// 3. USER SETTINGS: VIX
// ============================================================
grpVix      = "VIX Settings"
vixFastLen  = input.int(5,  "VIX Fast EMA Length", minval=1,  group=grpVix)
vixSlowLen  = input.int(20, "VIX Slow EMA Length", minval=1,  group=grpVix)
vixMin      = input.int(10, "VIX Min (peg)",       minval=1,  step=1, group=grpVix, tooltip="VIX at or below this pegs the bar at minimum.")
vixMax      = input.int(40, "VIX Max (peg)",       minval=10, step=5, group=grpVix, tooltip="VIX at or above this pegs the bar at maximum.")

// ============================================================
// 4. USER SETTINGS: USO
// ============================================================
grpUso      = "USO Settings"
usoFastLen  = input.int(5,     "USO Fast EMA Length",          minval=1,    group=grpUso)
usoSlowLen  = input.int(20,    "USO Slow EMA Length",          minval=1,    group=grpUso)
usoSpotRng  = input.float(8.0, "USO SPOT Range (±%)",          minval=0.5,  step=0.5,  group=grpUso, tooltip="SPOT bar pegs at this % from PDC. Default ±8%.")
usoEmaBase  = input.float(0.05,"USO EMA Base Range (±% @ 1m)", minval=0.01, step=0.01, group=grpUso, tooltip="EMA bar range at 1m. Auto-scales for wider timeframes.")

// ============================================================
// 5. USER SETTINGS: SPY
// ============================================================
grpSpy      = "SPY Settings"
spyFastLen  = input.int(5,     "SPY Fast EMA Length",          minval=1,    group=grpSpy)
spySlowLen  = input.int(20,    "SPY Slow EMA Length",          minval=1,    group=grpSpy)
spySpotRng  = input.float(2.0, "SPY SPOT Range (±%)",          minval=0.1,  step=0.1,  group=grpSpy, tooltip="SPOT bar pegs at this % from PDC. Default ±2%.")
spyEmaBase  = input.float(0.02,"SPY EMA Base Range (±% @ 1m)", minval=0.01, step=0.01, group=grpSpy, tooltip="EMA bar range at 1m. Auto-scales for wider timeframes.")

// ============================================================
// 6. USER SETTINGS: CHART TICKER
// ============================================================
grpChart      = "Chart Ticker Settings"
chartFastLen  = input.int(5,     "Chart Fast EMA Length",          minval=1,    group=grpChart)
chartSlowLen  = input.int(20,    "Chart Slow EMA Length",          minval=1,    group=grpChart)
chartSpotRng  = input.float(2.0, "Chart SPOT Range (±%)",          minval=0.1,  step=0.1,  group=grpChart, tooltip="SPOT bar pegs at this % from PDC. Default ±2%.")
chartEmaBase  = input.float(0.02,"Chart EMA Base Range (±% @ 1m)", minval=0.01, step=0.01, group=grpChart, tooltip="EMA bar range at 1m. Auto-scales for wider timeframes.")

// ============================================================
// 7. USER SETTINGS: COLOR THEME
// ============================================================
grpC        = "Color Theme"
cBull       = input.color(#00ff44,                   "Bull Color",               group=grpC)
cBear       = input.color(#ff1100,                   "Bear Color",               group=grpC)
cTrack      = input.color(color.new(color.gray, 85), "Track Color (Unlit)",      group=grpC)
cHeader     = input.color(color.white,               "Header Text Color",        group=grpC)
cVixLow     = input.color(#00ff44,                   "VIX Low Color (<20)",      group=grpC)
cVixMid     = input.color(#ff9900,                   "VIX Mid Color (20-30)",    group=grpC)
cVixHigh    = input.color(#ff1100,                   "VIX High Color (>30)",     group=grpC)
cBgHeader   = input.color(#1a1a1a,                   "Header Background",        group=grpC)
cBgRow      = input.color(#262626,                   "Row Background",           group=grpC)
cBgNum      = input.color(#202020,                   "Number Column Background", group=grpC)
cFrame      = input.color(#555555,                   "Table Frame Color",        group=grpC)

// ============================================================
// 8. USER SETTINGS: TABLE POSITION
// ============================================================
grpT        = "Table Position"
tablePos    = input.string("Bottom Left", "Position", options=["Bottom Left", "Bottom Right", "Top Left", "Top Right"], group=grpT)

// ============================================================
// 9. TIMEFRAME-AWARE EMA SCALING
// ============================================================
tfMins      = timeframe.in_seconds() / 60.0
tfScale     = math.max(tfMins, 1.0)
usoEmaRng   = usoEmaBase   * tfScale
spyEmaRng   = spyEmaBase   * tfScale
chartEmaRng = chartEmaBase * tfScale

// ============================================================
// 10. FETCH DATA
// ============================================================
tickVal     = request.security(tickSym,        timeframe.period, close)
vixVal      = request.security(vixSym,         timeframe.period, close)
usoClose    = request.security(usoSym,         timeframe.period, close)
spyClose    = request.security(spySym,         timeframe.period, close)
chartClose  = request.security(syminfo.tickerid, timeframe.period, close)

// True PDC
usoPDC      = request.security(usoSym,          "D", close[1], lookahead=barmerge.lookahead_on)
spyPDC      = request.security(spySym,          "D", close[1], lookahead=barmerge.lookahead_on)
chartPDC    = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// ============================================================
// 11. CALCULATIONS: TICK
// ============================================================
tickFastEMA = ta.ema(tickVal, tickFastLen)
tickSlowEMA = ta.ema(tickVal, tickSlowLen)

f_tickNorm(val) =>
    math.max(math.min(val / tickRange, 1.0), -1.0)

tickSpotNorm = f_tickNorm(tickVal)
tickFastNorm = f_tickNorm(tickFastEMA)
tickSlowNorm = f_tickNorm(tickSlowEMA)

// ============================================================
// 12. CALCULATIONS: VIX
// ============================================================
vixFastEMA  = ta.ema(vixVal, vixFastLen)
vixSlowEMA  = ta.ema(vixVal, vixSlowLen)

f_vixNorm(val) =>
    math.max(math.min((val - vixMin) / (vixMax - vixMin), 1.0), 0.0)

vixSpotNorm = f_vixNorm(vixVal)
vixFastNorm = f_vixNorm(vixFastEMA)
vixSlowNorm = f_vixNorm(vixSlowEMA)

f_vixColor(val) =>
    val >= 30 ? cVixHigh : val >= 20 ? cVixMid : cVixLow

// ============================================================
// 13. CALCULATIONS: USO, SPY, CHART (shared pattern)
// ============================================================
f_pctFromPDC(c, pdc) =>
    pdc != 0 ? (c - pdc) / pdc * 100 : 0.0

f_btb(c) =>
    c[1] != 0 ? ta.change(c) / c[1] * 100 : 0.0

f_fixedNorm(val, rng) =>
    math.max(math.min(val / rng, 1.0), -1.0)

// USO
usoPctChg   = f_pctFromPDC(usoClose, usoPDC)
usoBtB      = f_btb(usoClose)
usoFastEMA  = ta.ema(usoBtB, usoFastLen)
usoSlowEMA  = ta.ema(usoBtB, usoSlowLen)
usoSpotNorm = f_fixedNorm(usoPctChg,  usoSpotRng)
usoFastNorm = f_fixedNorm(usoFastEMA, usoEmaRng)
usoSlowNorm = f_fixedNorm(usoSlowEMA, usoEmaRng)

// SPY
spyPctChg   = f_pctFromPDC(spyClose, spyPDC)
spyBtB      = f_btb(spyClose)
spyFastEMA  = ta.ema(spyBtB, spyFastLen)
spySlowEMA  = ta.ema(spyBtB, spySlowLen)
spySpotNorm = f_fixedNorm(spyPctChg,  spySpotRng)
spyFastNorm = f_fixedNorm(spyFastEMA, spyEmaRng)
spySlowNorm = f_fixedNorm(spySlowEMA, spyEmaRng)

// CHART
chartPctChg   = f_pctFromPDC(chartClose, chartPDC)
chartBtB      = f_btb(chartClose)
chartFastEMA  = ta.ema(chartBtB, chartFastLen)
chartSlowEMA  = ta.ema(chartBtB, chartSlowLen)
chartSpotNorm = f_fixedNorm(chartPctChg,  chartSpotRng)
chartFastNorm = f_fixedNorm(chartFastEMA, chartEmaRng)
chartSlowNorm = f_fixedNorm(chartSlowEMA, chartEmaRng)

// ============================================================
// 14. HELPER FUNCTIONS: BAR BUILDERS
// ============================================================
f_getBiBar(normVal, isBullSide) =>
    numBlocks = math.round(math.abs(normVal) * 9)
    res = ""
    for i = 1 to 9
        isActive = isBullSide ? (normVal > 0 and i <= numBlocks) : (normVal < 0 and (10 - i) <= numBlocks)
        res += isActive ? "█" : "░"
    res

f_getVixBarSeg(normVal, segStart) =>
    totalBlocks = math.round(normVal * 27)
    res = ""
    for i = 1 to 9
        globalPos = segStart + i - 1
        res += globalPos <= totalBlocks ? "█" : "░"
    res

// ============================================================
// 15. HELPER FUNCTIONS: ROW DRAWERS
// ============================================================

// Header — now size.small to match data rows
f_drawHeader(tbl, row, label) =>
    table.cell(tbl, 0, row, "", bgcolor=cBgHeader)
    table.cell(tbl, 1, row, "", bgcolor=cBgHeader)
    table.cell(tbl, 2, row, label,
         bgcolor=cBgHeader, text_color=cHeader, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, row, "", bgcolor=cBgHeader)

// TICK row
f_drawTickRow(tbl, row, label, normVal, rawVal) =>
    display = str.tostring(math.round(rawVal))
    numCol  = rawVal < 0 ? cBear : (rawVal > 0 ? cBull : color.gray)
    table.cell(tbl, 0, row, label,
         text_color=color.white, bgcolor=cBgRow, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 1, row, f_getBiBar(normVal, false),
         text_color=normVal < 0 ? cBear : cTrack, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_right, text_size=size.small)
    table.cell(tbl, 2, row, display,
         text_color=numCol, bgcolor=cBgNum, text_size=size.small)
    table.cell(tbl, 3, row, f_getBiBar(normVal, true),
         text_color=normVal > 0 ? cBull : cTrack, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_left, text_size=size.small)

// VIX row
f_drawVixRow(tbl, row, label, normVal, rawVal) =>
    display  = label + "  " + str.tostring(rawVal, "#.0")
    barColor = f_vixColor(rawVal)
    table.cell(tbl, 0, row, display,
         text_color=color.white, bgcolor=cBgRow, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 1, row, f_getVixBarSeg(normVal, 1),
         text_color=barColor, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 2, row, f_getVixBarSeg(normVal, 10),
         text_color=barColor, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 3, row, f_getVixBarSeg(normVal, 19),
         text_color=barColor, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_left, text_size=size.small)

// PCT row (USO / SPY / CHART)
f_drawPctRow(tbl, row, label, normVal, rawVal) =>
    display = str.tostring(rawVal, "#.00") + "%"
    numCol  = rawVal < 0 ? cBear : (rawVal > 0 ? cBull : color.gray)
    table.cell(tbl, 0, row, label,
         text_color=color.white, bgcolor=cBgRow, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 1, row, f_getBiBar(normVal, false),
         text_color=normVal < 0 ? cBear : cTrack, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_right, text_size=size.small)
    table.cell(tbl, 2, row, display,
         text_color=numCol, bgcolor=cBgNum, text_size=size.small)
    table.cell(tbl, 3, row, f_getBiBar(normVal, true),
         text_color=normVal > 0 ? cBull : cTrack, bgcolor=cBgRow,
         text_font_family=font.family_monospace, text_halign=text.align_left, text_size=size.small)

// ============================================================
// 16. RESOLVE TABLE POSITION
// ============================================================
f_pos(p) =>
    switch p
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        => position.bottom_left

// ============================================================
// 17. UI RENDERING
// 20 rows: 5 sections × (1 header + 3 metric rows)
// 0-3: TICK | 4-7: VIX | 8-11: USO | 12-15: SPY | 16-19: CHART
// ============================================================
var table dash = table.new(f_pos(tablePos), 4, 20,
     frame_width=1, frame_color=cFrame)

if barstate.islast
    tickFastLbl  = "EMA " + str.tostring(tickFastLen)
    tickSlowLbl  = "EMA " + str.tostring(tickSlowLen)
    vixFastLbl   = "EMA " + str.tostring(vixFastLen)
    vixSlowLbl   = "EMA " + str.tostring(vixSlowLen)
    usoFastLbl   = "EMA " + str.tostring(usoFastLen)
    usoSlowLbl   = "EMA " + str.tostring(usoSlowLen)
    spyFastLbl   = "EMA " + str.tostring(spyFastLen)
    spySlowLbl   = "EMA " + str.tostring(spySlowLen)
    chartFastLbl = "EMA " + str.tostring(chartFastLen)
    chartSlowLbl = "EMA " + str.tostring(chartSlowLen)
    chartLabel   = syminfo.ticker

    // --- TICK (rows 0-3) ---
    f_drawHeader(dash, 0, "TICK.US")
    f_drawTickRow(dash, 1, "SPOT",      tickSpotNorm, tickVal)
    f_drawTickRow(dash, 2, tickFastLbl, tickFastNorm, tickFastEMA)
    f_drawTickRow(dash, 3, tickSlowLbl, tickSlowNorm, tickSlowEMA)

    // --- VIX (rows 4-7) ---
    f_drawHeader(dash, 4, "VIX")
    f_drawVixRow(dash, 5, "SPOT",     vixSpotNorm, vixVal)
    f_drawVixRow(dash, 6, vixFastLbl, vixFastNorm, vixFastEMA)
    f_drawVixRow(dash, 7, vixSlowLbl, vixSlowNorm, vixSlowEMA)

    // --- USO (rows 8-11) ---
    f_drawHeader(dash, 8, "USO")
    f_drawPctRow(dash, 9,  "SPOT",     usoSpotNorm, usoPctChg)
    f_drawPctRow(dash, 10, usoFastLbl, usoFastNorm, usoFastEMA)
    f_drawPctRow(dash, 11, usoSlowLbl, usoSlowNorm, usoSlowEMA)

    // --- SPY (rows 12-15) ---
    f_drawHeader(dash, 12, "SPY")
    f_drawPctRow(dash, 13, "SPOT",     spySpotNorm, spyPctChg)
    f_drawPctRow(dash, 14, spyFastLbl, spyFastNorm, spyFastEMA)
    f_drawPctRow(dash, 15, spySlowLbl, spySlowNorm, spySlowEMA)

    // --- CHART TICKER (rows 16-19) ---
    f_drawHeader(dash, 16, chartLabel)
    f_drawPctRow(dash, 17, "SPOT",      chartSpotNorm, chartPctChg)
    f_drawPctRow(dash, 18, chartFastLbl, chartFastNorm, chartFastEMA)
    f_drawPctRow(dash, 19, chartSlowLbl, chartSlowNorm, chartSlowEMA)
