// content_hash: cb5fa3d1f5d6a96a
// collected: 2026-07-27
study(title = "Smoothed-Heiken-Ashi-MQ", shorttitle="HAMA-MQ", overlay=true)

//len=input(10)
//o=ema(open,len)
//c=ema(close,len)
//h=ema(high,len)
//l=ema(low,len)
o=open
c=close
h=high
l=low

haclose = (o+h+l+c)/4
haopen = na(haopen[1]) ? (o + c)/2 : (haopen[1] + haclose[1]) / 2
hahigh = max (h, max(haopen,haclose))
halow = min (l, min(haopen,haclose))

len2=input(10)
o2=ema(haopen, len2)
c2=ema(haclose, len2)
h2=ema(hahigh, len2)
l2=ema(halow, len2)

col=o2>c2 ? red : lime
plotcandle(o2, h2, l2, c2, title="heikin smoothed", color=col)

// boundaries
plot(series=l2, title="l2", color=red, linewidth=1,transp=0)
plot(series=h2, title="h2", color=blue, linewidth=1,transp=0)
