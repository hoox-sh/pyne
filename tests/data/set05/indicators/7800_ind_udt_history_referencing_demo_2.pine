//@type A custom type to hold bar's `label` settings based on bar's direction.
//Includes bar direction, label style and color, and "string" percentage difference between bar's `open` and `close`. 
type LblSettings
    bool isUp = false
    string lblStyle
    color lblColor
    string diff

