//@version=5
// set05 corpus entry
// source_repo: IFD_VSA_TV_Indicator
// source_path: IFD_VSA_TV_Indicator/InstitutionalFootprint_VSA.pine
// content_hash: b345b402e216e65d
// collected: 2026-07-27
// ══════════════════════════════════════════════════════════════════════════
//  INSTITUTIONAL FOOTPRINT + VSA DOMINANCE  [IFD-VSA]  v2
//  Pure price action IMPULSE fused with Volume Spread Analysis (VSA).
//
//  WHY TWO ENGINES
//  ---------------
//  ENGINE 1  Price-Impulse Dominance (from v1): convex velocity model. Rewards
//            sudden impulsive candles (institutional footprint) over slow grinds.
//  ENGINE 2  VSA Smart-Money Pressure: the classic Effort-vs-Result model.
//            Volume = EFFORT. Spread = RESULT. Close location (CLV) = WHO WON.
//            Volume-weighted close location reveals real accumulation/distribution.
//
//  THE EDGE = DIVERGENCE
//  ---------------------
//  When price is impulsing UP but VSA shows SELLING (effort without upward
//  result) => Hidden Distribution: big players unloading into retail buying.
//  This is the literal "slow drift up, then sudden drop" trap, caught early.
// ══════════════════════════════════════════════════════════════════════════
indicator("Institutional Footprint + VSA [IFD-VSA]", shorttitle="IFD-VSA", overlay=false, max_labels_count=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grpCore = "Core"
len       = input.int(20,  "Lookback (bars)",        minval=2, group=grpCore, tooltip="Window for accumulating bull/bear pressure and for volume/spread averages.")
atrLen    = input.int(14,  "ATR Normalisation",      minval=1, group=grpCore)
convexity = input.float(2.0,"Price Impulse Convexity",minval=1.0,maxval=3.0,step=0.1, group=grpCore, tooltip="Higher = sudden impulsive candles dominate over slow grinds (institutional footprint bias).")
smooth    = input.int(3,   "Smoothing",              minval=1, group=grpCore)

grpW = "Fusion Weights"
wPrice = input.float(0.5, "Price-Impulse Weight", minval=0, maxval=1, step=0.05, group=grpW)
wVSA   = input.float(0.5, "VSA Weight",           minval=0, maxval=1, step=0.05, group=grpW)

grpVSA = "VSA Classification"
ultraMult  = input.float(2.0, "Ultra-High Volume x avg", minval=1.2, step=0.1, group=grpVSA)
highMult   = input.float(1.4, "High Volume x avg",       minval=1.0, step=0.1, group=grpVSA)
lowMult    = input.float(0.7, "Low Volume x avg",        minval=0.1, maxval=1.0, step=0.05, group=grpVSA)
wideMult   = input.float(1.5, "Wide Spread x avg",       minval=1.0, step=0.1, group=grpVSA)
narrowMult = input.float(0.7, "Narrow Spread x avg",     minval=0.1, maxval=1.0, step=0.05, group=grpVSA)
clvEdge    = input.float(0.3, "Close-Location Edge",    minval=0.1, maxval=0.9, step=0.05, group=grpVSA, tooltip="How near an extreme the close must be to count as closing 'off the high/low'. CLV ranges -1 (at low) to +1 (at high).")

grpSig = "VSA Signal Labels"
showVSA = input.bool(true, "Show VSA Signal Labels", group=grpSig, tooltip="Named Wyckoff/VSA events plotted on the price chart.")

grpDiv = "Divergence"
showDiv   = input.bool(true, "Detect Hidden Accumulation/Distribution", group=grpDiv)
divThresh = input.float(30, "Divergence Threshold", minval=5, maxval=90, step=5, group=grpDiv, tooltip="Both engines must exceed this (in opposite directions) to flag hidden activity.")

grpVis = "Visuals"
colBull   = input.color(#26a69a, "Bull Color", group=grpVis)
colBear   = input.color(#ef5350, "Bear Color", group=grpVis)
colorBars = input.bool(true, "Color Bars by Composite Bias", group=grpVis)
showTable = input.bool(true, "Show Dashboard", group=grpVis)

// ─────────────────────────────────────────────
// PRIMITIVES
// ─────────────────────────────────────────────
atr       = ta.atr(atrLen)
spread    = math.max(high - low, syminfo.mintick)
bodyAbs   = math.abs(close - open)
conviction= bodyAbs / spread
speed     = bodyAbs / atr

avgVol    = ta.sma(volume, len)
avgSpread = ta.sma(spread, len)
hasVol    = not na(volume) and not na(avgVol) and avgVol > 0

relVol    = hasVol ? volume / avgVol : 1.0
relSpread = avgSpread > 0 ? spread / avgSpread : 1.0
clv       = (2 * close - high - low) / spread          // -1 (close at low) .. +1 (close at high)

isBull = close > open
isBear = close < open

// ─────────────────────────────────────────────
// ENGINE 1 — PRICE IMPULSE DOMINANCE (convex velocity, v1)
// ─────────────────────────────────────────────
impulse   = math.pow(speed, convexity) * conviction
bullImp   = math.sum(isBull ? impulse : 0.0, len)
bearImp   = math.sum(isBear ? impulse : 0.0, len)
totImp    = bullImp + bearImp
priceDom  = totImp > 0 ? 100.0 * (bullImp - bearImp) / totImp : 0.0
priceDom  := ta.ema(priceDom, smooth)

// ─────────────────────────────────────────────
// ENGINE 2 — VSA SMART-MONEY PRESSURE (Effort vs Result)
//   smartFlow = effort(relVol) × who-won(clv) × result(relSpread)
//   +ve = net buying pressure, -ve = net selling pressure
// ─────────────────────────────────────────────
smartFlow = relVol * clv * relSpread
buySmart  = math.sum(math.max(smartFlow, 0.0), len)
sellSmart = math.sum(math.max(-smartFlow, 0.0), len)
totSmart  = buySmart + sellSmart
vsaDom    = totSmart > 0 ? 100.0 * (buySmart - sellSmart) / totSmart : 0.0
vsaDom    := ta.ema(vsaDom, smooth)

// ─────────────────────────────────────────────
// FUSION — COMPOSITE BIAS
// ─────────────────────────────────────────────
wTot      = math.max(wPrice + wVSA, 0.0001)
composite = (wPrice * priceDom + wVSA * vsaDom) / wTot
strength  = math.abs(composite)

// ─────────────────────────────────────────────
// VSA EVENT CLASSIFICATION
// ─────────────────────────────────────────────
wide    = relSpread >= wideMult
narrow  = relSpread <= narrowMult
uHiVol  = relVol   >= ultraMult
hiVol   = relVol   >= highMult
loVol   = relVol   <= lowMult
cHigh   = clv >=  clvEdge
cLow    = clv <= -clvEdge

newHigh = high > high[1]
newLow  = low  < low[1]

// Priority-ordered so each bar carries at most one label (strongest first)
buyingClimax   = isBull and wide and uHiVol and cLow                       // distribution (bearish)
sellingClimax  = isBear and wide and uHiVol and cHigh                      // accumulation (bullish)
upthrust       = wide and hiVol and newHigh and cLow                       // trap (bearish)
spring         = newLow and cHigh and hiVol                               // shakeout (bullish)
noDemand       = isBull and narrow and loVol                              // weakness (bearish)
noSupply       = isBear and narrow and loVol                              // strength (bullish)
effortRise     = isBull and wide and hiVol and cHigh                      // genuine buying (bullish)
effortFall     = isBear and wide and hiVol and cLow                       // genuine selling (bearish)

// resolve to a single classification + polarity (+1 bull / -1 bear)
sigTxt = buyingClimax ? "BC" : sellingClimax ? "SC" : upthrust ? "UT" : spring ? "SPR" : noDemand ? "ND" : noSupply ? "NS" : effortRise ? "ER" : effortFall ? "EF" : na
sigBull = sellingClimax or spring or noSupply or effortRise
sigBear = buyingClimax  or upthrust or noDemand or effortFall
sigFire = not na(sigTxt)

// ─────────────────────────────────────────────
// DIVERGENCE — HIDDEN ACCUMULATION / DISTRIBUTION
// ─────────────────────────────────────────────
hidDist = showDiv and priceDom >  divThresh and vsaDom < -divThresh   // price up, smart money selling
hidAcc  = showDiv and priceDom < -divThresh and vsaDom >  divThresh   // price down, smart money buying

// ─────────────────────────────────────────────
// PLOTS — PANE
// ─────────────────────────────────────────────
oscTransp = int(78 - math.min(strength, 100.0) * 0.68)
compColor = color.new(composite >= 0 ? colBull : colBear, oscTransp)
plot(composite, "Composite Bias", color=compColor, style=plot.style_columns)
plot(priceDom,  "Price Impulse Dominance", color=color.new(color.orange, 10), linewidth=1)
plot(vsaDom,    "VSA Smart-Money Pressure", color=color.new(#42a5f5, 0), linewidth=2)

hline(0,   "Balance",     color=color.new(color.gray, 0),  linestyle=hline.style_solid)
hline(50,  "Strong Bull", color=color.new(colBull, 60),    linestyle=hline.style_dashed)
hline(-50, "Strong Bear", color=color.new(colBear, 60),    linestyle=hline.style_dashed)

bgcolor(hidDist ? color.new(colBear, 82) : hidAcc ? color.new(colBull, 82) : na, title="Divergence Zone")

// ─────────────────────────────────────────────
// PRICE-CHART LABELS (force_overlay) — VSA events + divergence
// ─────────────────────────────────────────────
f_lbl(_txt, _bull, _top) =>
    yloc = _top ? label.style_label_down : label.style_label_up
    yco  = _top ? high + atr * 0.4 : low - atr * 0.4
    label.new(bar_index, yco, _txt, style=yloc, color=_bull ? colBull : colBear, textcolor=color.white, size=size.small, force_overlay=true)

if showVSA and sigFire
    f_lbl(sigTxt, sigBull, sigBear)

if hidDist and not hidDist[1]
    label.new(bar_index, high + atr * 0.9, "HIDDEN DISTRIBUTION", style=label.style_label_down, color=color.new(colBear,0), textcolor=color.white, size=size.small, force_overlay=true)
if hidAcc and not hidAcc[1]
    label.new(bar_index, low - atr * 0.9, "HIDDEN ACCUMULATION", style=label.style_label_up, color=color.new(colBull,0), textcolor=color.white, size=size.small, force_overlay=true)

barcolor(colorBars ? (composite > 5 ? colBull : composite < -5 ? colBear : color.gray) : na, title="Composite Bar Color")

// ─────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────
sigName(t) => t == "BC" ? "Buying Climax (distrib.)" : t == "SC" ? "Selling Climax (accum.)" : t == "UT" ? "Upthrust (trap)" : t == "SPR" ? "Spring / Shakeout" : t == "ND" ? "No Demand" : t == "NS" ? "No Supply" : t == "ER" ? "Effort to Rise" : t == "EF" ? "Effort to Fall" : "-"

var table dash = table.new(position.top_right, 2, 8, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40))
if showTable and barstate.islast
    side  = composite > 5 ? "BULLS UP" : composite < -5 ? "BEARS DN" : "BALANCED"
    sCol  = composite > 5 ? colBull   : composite < -5 ? colBear   : color.gray
    grade = strength >= 70 ? "EXTREME" : strength >= 50 ? "STRONG" : strength >= 25 ? "MODERATE" : "WEAK"
    volTier = uHiVol ? "ULTRA-HIGH" : hiVol ? "HIGH" : loVol ? "LOW" : "AVERAGE"
    effRes  = (hiVol and narrow) ? "ABSORPTION" : (loVol and wide) ? "NO PARTICIPATION" : (hiVol and wide) ? "TRENDING" : "NEUTRAL"
    divTxt  = hidDist ? "HIDDEN DISTRIBUTION" : hidAcc ? "HIDDEN ACCUMULATION" : "aligned"
    divCol  = hidDist ? colBear : hidAcc ? colBull : color.new(color.gray, 30)

    table.cell(dash, 0, 0, "IFD-VSA CONTROL PANEL", text_color=color.white, bgcolor=color.new(color.black,0), text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=color.new(color.black,0))
    table.cell(dash, 0, 1, "Dominant Side", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, side, text_color=color.white, bgcolor=sCol, text_size=size.small)
    table.cell(dash, 0, 2, "Dominance", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(strength,"#.0") + "%  (" + grade + ")", text_color=color.white, bgcolor=sCol, text_size=size.small)
    table.cell(dash, 0, 3, "Price Impulse", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(priceDom,"#.0"), text_color=color.white, bgcolor=color.new(color.orange,40), text_size=size.small)
    table.cell(dash, 0, 4, "VSA Smart Money", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(vsaDom,"#.0"), text_color=color.white, bgcolor=color.new(#42a5f5,40), text_size=size.small)
    table.cell(dash, 0, 5, "Divergence", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, divTxt, text_color=color.white, bgcolor=divCol, text_size=size.small)
    table.cell(dash, 0, 6, "Effort vs Result", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, effRes, text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)
    table.cell(dash, 0, 7, hasVol ? ("Volume: " + volTier) : "Volume", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, hasVol ? sigName(sigTxt) : "NO DATA (price-only)", text_color=color.white, bgcolor=color.new(color.gray,30), text_size=size.small)

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(ta.crossover(composite, 0),  "Composite Bull Takeover", "IFD-VSA: composite bias flipped BULLISH")
alertcondition(ta.crossunder(composite, 0), "Composite Bear Takeover", "IFD-VSA: composite bias flipped BEARISH")
alertcondition(hidDist and not hidDist[1],  "Hidden Distribution", "IFD-VSA: price rising but smart money SELLING")
alertcondition(hidAcc  and not hidAcc[1],   "Hidden Accumulation", "IFD-VSA: price falling but smart money BUYING")
alertcondition(sellingClimax, "Selling Climax / Accumulation", "IFD-VSA: climactic volume, close off lows")
alertcondition(buyingClimax,  "Buying Climax / Distribution",  "IFD-VSA: climactic volume, close off highs")
alertcondition(spring,        "Spring / Shakeout", "IFD-VSA: shakeout below prior low, close near high")
alertcondition(upthrust,      "Upthrust", "IFD-VSA: upthrust above prior high, close near low")
