#!/bin/bash
# Pine Script validation hook - runs after Write/Edit operations
# Validates .pine files for common issues

# Read hook input from stdin
INPUT=$(cat)
FILE_PATH=$(echo "$INPUT" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/"file_path"[[:space:]]*:[[:space:]]*"//' | sed 's/"$//')

# Only validate .pine files
if [[ ! "$FILE_PATH" =~ \.pine$ ]]; then
    exit 0
fi

# Check if file exists
if [[ ! -f "$FILE_PATH" ]]; then
    exit 0
fi

ISSUES=""

# Check for version declaration
if ! grep -q "^//@version=" "$FILE_PATH"; then
    ISSUES="${ISSUES}\n- Missing //@version declaration"
fi

# Check for potential repainting issues
if grep -q "request\.security" "$FILE_PATH"; then
    if ! grep -q "lookahead=barmerge\.lookahead_off" "$FILE_PATH"; then
        ISSUES="${ISSUES}\n- Potential repainting: request.security() without lookahead_off"
    fi
fi

# Check for split ternary operators (common error)
if grep -E '^\s*\?' "$FILE_PATH" | grep -q .; then
    ISSUES="${ISSUES}\n- Possible line continuation error: ternary operator on new line"
fi

# Check for strategy missing alert annotation
if grep -q "^strategy(" "$FILE_PATH"; then
    if ! grep -q "@strategy_alert_message" "$FILE_PATH"; then
        ISSUES="${ISSUES}\n- Strategy missing @strategy_alert_message annotation"
    fi
fi

# Output issues as additional context
if [[ -n "$ISSUES" ]]; then
    echo "{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"Pine Script validation warnings:$ISSUES\"}}"
fi

exit 0
