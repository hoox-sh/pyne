//@version=6strategy(   "strategy.opentrades.capital_held example", overlay=false, margin_long=50, margin_short=50,   default_qty_type = strategy.percent_of_equity, default_qty_value = 100 )// Enter a short position on the first bar.if barstate.isfirst    strategy.entry("Short", strategy.short)// Plot the capital held by the short position.plot(strategy.opentrades.capital_held, "Capital held")// Highlight the chart background if the position is completely closed by margin calls.bgcolor(bar_index > 0 and strategy.opentrades.capital_held == 0 ? color.new(color.red, 60) : na)// set05 corpus entry
