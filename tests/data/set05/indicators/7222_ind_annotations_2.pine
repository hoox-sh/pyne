//@version=6indicator("Session highlight", overlay = true)//@enum       Contains fields with popular timezones as titles.//@field exch Has an empty string as the title to represent the chart timezone.enum tz    utc  = "UTC"    exch = ""    ny   = "America/New_York"    chi  = "America/Chicago"    lon  = "Europe/London"    tok  = "Asia/Tokyo"//@variable The session string.selectedSession = input.session("1200-1500", "Session")//@variable The selected timezone. The input's dropdown contains the fields in the `tz` enum.selectedTimezone = input.enum(tz.utc, "Session Timezone")//@variable Is `true` if the current bar's time is in the specified session.bool inSession = falseif not na(time("", selectedSession, str.tostring(selectedTimezone)))    inSession := true// Highlight the background when `inSession` is `true`.bgcolor(inSession ? color.new(color.green, 90) : na, title = "Active session highlight")// set05 corpus entry
