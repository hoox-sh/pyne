study("test-019-tuple_security")

f_()=>[open, high, low, close]

tf = input('M')

// dot after l was causing error
// no viable alternative at character ' '
[o, h, l, c]  = security(syminfo.tickerid, tf, f_(), barmerge.gaps_on, barmerge.lookahead_on)

plotcandle(o, h, l, c)
