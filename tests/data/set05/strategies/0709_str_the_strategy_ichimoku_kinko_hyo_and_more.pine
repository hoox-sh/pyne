                             entry_f_1 == 'MACD(fast) slope filter' ? macd_slope_up_f : 
                             entry_f_1 == 'MACD filter' ? macd_buy : 
                             entry_f_1 == 'RSI50 filter' ? rsi_f_buy_f : 
                             entry_f_1 == 'Fractals filter' ? fr_upx_f : 
