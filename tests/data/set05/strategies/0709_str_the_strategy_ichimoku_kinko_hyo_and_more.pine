exit_filter_sig_sell_2      = exit_f_2 == '---' ? false : 
                             exit_f_2 == 'TRIX slope exit' ? trix_slo_dn_x :
                             exit_f_2 == 'RSI Stochastic exit' ? kd_mom_dn_x : 
                             exit_f_2 == 'EMA1 x EMA2 exit' ? ema_1x2_sell_x : 
                             exit_f_2 == 'HMA slope exit' ? hma_dn_x : 
