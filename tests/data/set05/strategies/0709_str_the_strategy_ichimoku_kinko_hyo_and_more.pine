                             exit_f_2 == 'RSI50 exit' ? rsi_f_sell_x : 
                             exit_f_2 == 'Fractals exit' ? fr_dnx_x : 
                             exit_f_2 == 'SuperTrend exit' ? sup_sell_x : 
