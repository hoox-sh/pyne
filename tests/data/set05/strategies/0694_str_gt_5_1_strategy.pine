//======================fonksiyonlar===========//
satinalma() => 
    if year >= uyear and month >= umonth and dayofmonth >= uday
        strategy.close("shortexit",alert_message = sellexitalert)
        strategy.entry("long", strategy.long,alert_message = buyalert)
        strategy.exit("longtp", from_entry = "long", limit= (1+tpprice/100)*close, alert_message = buyexitalert)
     //   strategy.exit("longsl", from_entry = "long", stop = (1-slprice/100)*close, alert_message = buyexitalert)   
    
satma() =>
    if year >= uyear and month >= umonth and dayofmonth >= uday
        strategy.close("longexit", alert_message = buyexitalert)
        strategy.entry("short", strategy.short, alert_message = sellalert )
        strategy.exit("shorttp", from_entry = "short", limit= (1-tpprice/100)*close, alert_message = sellexitalert)   
