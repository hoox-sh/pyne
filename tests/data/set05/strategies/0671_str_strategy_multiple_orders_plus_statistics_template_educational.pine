// Colour code the candles
bclr = not clrBars ? na : strategy.position_size == 0 ? #dbd5d5 : 
 strategy.position_size > 0  ? color.lime :
 strategy.position_size < 0 ? color.red : color.gray
barcolor(bclr, title="Trade State Bar Colouring")
