// set05 corpus entry
// source_repo: hasnocool-tradingview-pine-scripts
// source_path: hasnocool-tradingview-pine-scripts/Rate Of Change Trend Strategy (ROC).pine
// content_hash: 66ab522d6551268d
// collected: 2026-07-27
strategy("ROC", overlay=true)
length = input(30)
longtrades = input.bool(true, "Long",   inline = "01")
shorttrades = input.bool(false, "Short",   inline = "01")
price = close
roc = ta.roc(price,length)
if (roc>0)
    if(longtrades)
        strategy.entry("ROCLong", strategy.long, comment="ROCLong")
    else
        strategy.close_all()
else
    if(shorttrades)
        strategy.entry("ROCShort", strategy.short, comment="ROCShort")
    else
        strategy.close_all()
