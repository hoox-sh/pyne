//@version=5
// set05 corpus entry
// source_repo: hasnocool-tradingview-pine-scripts
// source_path: hasnocool-tradingview-pine-scripts/robotrading ZeroCCI.pine
// content_hash: 7928777a670227fc
// collected: 2026-07-27
strategy(title="robotrading ZeroCCI", shorttitle="ZeroCCI", default_qty_type = strategy.percent_of_equity, default_qty_value = 100, pyramiding = 0, commission_value = 0.1)
length = input.int(20, minval=1)
src = input(hlc3, title="Source")
ma = ta.sma(src, length)
cci = (src - ma) / (0.015 * ta.dev(src, length))
plot(cci, "CCI", color=#2962FF)
band1 = hline(100, "Upper Band", color=#787B86, linestyle=hline.style_dashed)
band0 = hline(-100, "Lower Band", color=#787B86, linestyle=hline.style_dashed)
fill(band1, band0, color=color.rgb(33, 150, 243, 90), title="Background")
plot(0, color = color.black)
if cci > 0
    strategy.entry("Long", strategy.long)
if cci < 0
    strategy.entry("Short", strategy.short)
Expand (16 lines)
