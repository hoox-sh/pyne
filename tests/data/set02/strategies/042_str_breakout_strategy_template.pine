//@version=6
// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/templates/strategies/breakout.pine
// content_hash: 94eb2b8e93cf6111
// collected: 2026-07-27
strategy("Breakout Strategy Template", overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         commission_type=strategy.commission.percent,
         commission_value=0.1)
//@strategy_alert_message {{strategy.order.alert_message}}

// ============================================================================
// INPUTS
// ============================================================================
// Breakout Settings
lookbackPeriod = input.int(20, "Lookback Period", minval=5, maxval=100, group="Breakout", tooltip="Bars to look back for high/low")
breakoutBuffer = input.float(0.0, "Breakout Buffer (%)", minval=0, maxval=5, step=0.1, group="Breakout", tooltip="Additional buffer beyond high/low for confirmation")
confirmBars = input.int(1, "Confirmation Bars", minval=1, maxval=5, group="Breakout", tooltip="Bars price must stay beyond level")

// Filter Settings
useVolumeFilter = input.bool(true, "Volume Filter", group="Filters", tooltip="Require above average volume")
volumeMultiplier = input.float(1.5, "Volume Multiplier", minval=1.0, maxval=5.0, step=0.1, group="Filters")
useATRFilter = input.bool(true, "ATR Filter", group="Filters", tooltip="Require minimum ATR for volatility")
atrLength = input.int(14, "ATR Length", minval=1, group="Filters")
minATRMultiplier = input.float(0.5, "Min ATR Multiplier", minval=0.1, maxval=2.0, step=0.1, group="Filters")

// Risk Management
useStopLoss = input.bool(true, "Use Stop Loss", group="Risk Management")
stopLossType = input.string("ATR", "Stop Loss Type", options=["ATR", "Percent", "Swing"], group="Risk Management")
stopLossATR = input.float(2.0, "Stop Loss ATR Multiplier", minval=0.5, maxval=5.0, step=0.5, group="Risk Management")
stopLossPercent = input.float(2.0, "Stop Loss %", minval=0.5, maxval=10.0, step=0.5, group="Risk Management")

useTakeProfit = input.bool(true, "Use Take Profit", group="Risk Management")
takeProfitRR = input.float(2.0, "Take Profit R:R", minval=0.5, maxval=10.0, step=0.5, group="Risk Management", tooltip="Risk to reward ratio")

// Direction
longOnly = input.bool(false, "Long Only", group="Direction")
shortOnly = input.bool(false, "Short Only", group="Direction")

// ============================================================================
// CALCULATIONS
// ============================================================================
// Breakout levels
highestHigh = ta.highest(high, lookbackPeriod)
lowestLow = ta.lowest(low, lookbackPeriod)

// Add buffer
bufferAmount = breakoutBuffer / 100
resistanceLevel = highestHigh[1] * (1 + bufferAmount)
supportLevel = lowestLow[1] * (1 - bufferAmount)

// ATR for stops
atr = ta.atr(atrLength)

// Filters
avgVolume = ta.sma(volume, 20)
volumeOK = not useVolumeFilter or volume > avgVolume * volumeMultiplier
avgATR = ta.sma(atr, 20)
atrOK = not useATRFilter or atr > avgATR * minATRMultiplier

// Breakout detection
bullishBreakout = close > resistanceLevel and close[1] <= resistanceLevel
bearishBreakout = close < supportLevel and close[1] >= supportLevel

// Confirmation (price stays beyond level)
var int bullConfirmCount = 0
var int bearConfirmCount = 0

if close > resistanceLevel
    bullConfirmCount += 1
else
    bullConfirmCount := 0

if close < supportLevel
    bearConfirmCount += 1
else
    bearConfirmCount := 0

bullConfirmed = bullConfirmCount >= confirmBars
bearConfirmed = bearConfirmCount >= confirmBars

// ============================================================================
// STRATEGY CONDITIONS
// ============================================================================
longCondition = bullishBreakout and volumeOK and atrOK and not shortOnly
shortCondition = bearishBreakout and volumeOK and atrOK and not longOnly

// Calculate stop loss
calcStopLoss(isLong) =>
    switch stopLossType
        "ATR" => isLong ? close - atr * stopLossATR : close + atr * stopLossATR
        "Percent" => isLong ? close * (1 - stopLossPercent/100) : close * (1 + stopLossPercent/100)
        "Swing" => isLong ? lowestLow[1] : highestHigh[1]

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================
if longCondition
    stopPrice = calcStopLoss(true)
    riskAmount = close - stopPrice
    targetPrice = useTakeProfit ? close + riskAmount * takeProfitRR : na

    strategy.entry("Long", strategy.long, alert_message="Long breakout entry")

    if useStopLoss and useTakeProfit
        strategy.exit("Long Exit", "Long", stop=stopPrice, limit=targetPrice, alert_message="Long exit")
    else if useStopLoss
        strategy.exit("Long SL", "Long", stop=stopPrice, alert_message="Long stop loss")
    else if useTakeProfit
        strategy.exit("Long TP", "Long", limit=targetPrice, alert_message="Long take profit")

if shortCondition
    stopPrice = calcStopLoss(false)
    riskAmount = stopPrice - close
    targetPrice = useTakeProfit ? close - riskAmount * takeProfitRR : na

    strategy.entry("Short", strategy.short, alert_message="Short breakout entry")

    if useStopLoss and useTakeProfit
        strategy.exit("Short Exit", "Short", stop=stopPrice, limit=targetPrice, alert_message="Short exit")
    else if useStopLoss
        strategy.exit("Short SL", "Short", stop=stopPrice, alert_message="Short stop loss")
    else if useTakeProfit
        strategy.exit("Short TP", "Short", limit=targetPrice, alert_message="Short take profit")

// ============================================================================
// PLOTS
// ============================================================================
plot(resistanceLevel, "Resistance", color=color.red, linewidth=2, style=plot.style_stepline)
plot(supportLevel, "Support", color=color.green, linewidth=2, style=plot.style_stepline)

// Entry markers
plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Background for active filters
bgcolor(volumeOK and atrOK ? na : color.new(color.gray, 95), title="Filter Active")
