// =====================================================================================
// DEAD CAT BOUNCE — STRATEGY
// =====================================================================================
// Tracks a run of N consecutive bars that fail to make a new extreme, then mirrors it.
//
//   DOWN run — N bars in a row where each high <= the previous bar's high (no new highs).
//              When the run reaches N, draw a DASHED trend line from the run's anchor high
//              (the peak the run fell away from) to the most-recent (lowest) low, extending
//              it to each new low. The run ends the first time a bar's high exceeds the
//              previous bar's high (a higher high) — at that break the projection confirms:
//              a mirror of the trend line from the pivot low, up-and-right at the same angle
//              and length (a symmetric V / measured move), drawn as a SOLID ARROW to the target.
//
//   UP run   — the mirror: N bars where each low >= the previous bar's low (no new lows);
//              trend line from the anchor low to the most-recent (highest) high; the run
//              ends on the first lower low, and the projection drops from the pivot high.
//
//   FILTERS (optional) — require every run bar to close in its direction (bullish for up-runs,
//              bearish for down-runs); treat a doji as an invalidation; track runs by candle
//              bodies (open/close) instead of wicks (high/low); require the breakout candle to
//              be an engulfing candle; and/or require the breakout within X bars of the pivot.
//
//   STRATEGY — a bullish reversal (down_rev) goes LONG, a bearish reversal (up_rev) goes SHORT,
//              one position at a time (flat-only). EXITS, SESSIONS, BACKTEST RANGE and RISK /
//              PROFIT management are handled by the [TradersPost] Multi-VWAP framework ported in
//              below: stop loss, take profit, trailing stop, trailing take profit and breakeven,
//              each in Dollars / PnL / Percent / Ticks / Points / ATR units. The measured-move
//              projection, Fib grid and stats table remain for analysis (they no longer place the
//              exit orders).
// =====================================================================================

//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy("Dead Cat Bounce", overlay = true, pyramiding = 0, process_orders_on_close = true,
     initial_capital = 2000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2,
     margin_long = 0, margin_short = 0, use_bar_magnifier = true,
     max_lines_count = 500, max_labels_count = 500)

// =====================================================================================
// RISK / PROFIT / SESSION / BACKTEST FRAMEWORK
// Ported from [TradersPost] Multi-VWAP Crossover (contributors: sacredprofit, Mustang Trader).
// Reusable building blocks for exits and risk management: unit conversion, session filtering,
// backtest ranges, and the long/short exit handlers (SL, TP, trailing stop, trailing TP, BE).
// =====================================================================================

//@type Converts values between different unit systems (Dollars, PnL, Percent, Ticks, Points)
type UnitConverter
    string unit_type   // 'Dollars' | 'PnL' | 'Percent' | 'Ticks' | 'Points'
    float value

//@type Risk management settings: stop loss, trailing stop, breakeven
type RiskSettings
    // Stop Loss (unit applies to trailing stop and breakeven too)
    bool use_stop_loss = false
    string sl_unit = 'Dollars'
    float sl_value = 100.0

    // Trailing Stop (uses sl_unit)
    bool use_trailing_stop = false
    float trail_activation = 50.0    // Profit before trailing activates
    float trail_offset = 25.0        // Distance trailing stop follows price

    // Breakeven (uses sl_unit)
    bool use_breakeven = false
    float breakeven_activation = 100.0  // Profit before breakeven activates
    float breakeven_profit = 50.0       // Profit to lock in once activated

    // Trigger price type: 'Current' (high/low) or 'Close'
    string trigger_price = 'Current'

//@type Profit management settings: take profit, trailing take profit
type ProfitSettings
    // Take Profit (unit applies to trailing TP too)
    bool use_take_profit = false
    string tp_unit = 'Dollars'
    float tp_value = 200.0

    // Trailing Take Profit (uses tp_unit)
    bool use_trailing_tp = false
    float trail_tp_activation = 100.0  // Profit before TP starts trailing
    float trail_tp_offset = 50.0       // Distance trailing TP follows price

    // Trigger price type: 'Current' (high/low) or 'Close'
    string trigger_price = 'Current'

//@type Trading session configuration
type SessionSettings
    bool use = false
    string session = '0930-1600'
    string timezone = 'America/New_York'
    bool close_at_end = false

//@type Backtest date range configuration
type BacktestRange
    bool use = false
    int start_time = 0
    int end_time = 0

//@type Mutable strategy state - declared with 'var' and passed to the exit handlers
type StrategyState
    bool in_long = false
    bool in_short = false
    float entry_price = na
    float entry_atr = na                   // ATR locked at entry for consistent calculations
    float highest_since_entry = na
    float lowest_since_entry = na
    bool trail_stop_active = false
    bool trail_tp_active = false
    bool be_active = false                 // Breakeven has been triggered (stays true once triggered)
    float current_trail_stop = na
    float current_trail_tp = na
    float highest_since_trail_tp = na      // For trailing TP: tracks high since activation
    float lowest_since_trail_tp = na       // For trailing TP: tracks low since activation (shorts)

//@function Converts the unit value to a price distance
method toPrice(UnitConverter uc, float entry_price, float qty, float atr = na) =>
    float result = 0.0
    switch uc.unit_type
        'Dollars' =>
            result := uc.value
        'PnL' =>
            result := qty > 0 and syminfo.pointvalue > 0 ? uc.value / (qty * syminfo.pointvalue) : 0.0
        'Percent' =>
            result := entry_price * (uc.value / 100)
        'Ticks' =>
            result := uc.value * syminfo.mintick
        'Points' =>
            result := uc.value * syminfo.pointvalue
        'ATR' =>
            result := not na(atr) ? uc.value * atr : 0.0
    result

//@function Converts the unit value to ticks (for trail_offset parameter)
method toTicks(UnitConverter uc, float entry_price, float qty, float atr = na) =>
    float price_dist = uc.toPrice(entry_price, qty, atr)
    int ticks = math.round(price_dist / syminfo.mintick)
    ticks

//@function Checks if current bar is within the session window
method inSession(SessionSettings ss) =>
    ss.use and not na(time(timeframe.period, ss.session, ss.timezone))

//@function Checks if session just ended (for close_at_end logic)
method sessionEnded(SessionSettings ss) =>
    if ss.use and ss.close_at_end
        was_in = not na(time(timeframe.period, ss.session, ss.timezone)[1])
        now_out = na(time(timeframe.period, ss.session, ss.timezone))
        (was_in and now_out) or session.islastbar
    else
        false

//@function Checks if session just started (for event logging)
method sessionStarted(SessionSettings ss) =>
    if ss.use
        was_out = na(time(timeframe.period, ss.session, ss.timezone)[1])
        now_in = not na(time(timeframe.period, ss.session, ss.timezone))
        was_out and now_in
    else
        false

//@function Checks if session just ended (for event logging, ignores close_at_end)
method sessionEnd(SessionSettings ss) =>
    if ss.use
        was_in = not na(time(timeframe.period, ss.session, ss.timezone)[1])
        now_out = na(time(timeframe.period, ss.session, ss.timezone))
        was_in and now_out
    else
        false

//@function Checks if current bar is within the backtest date range
method inRange(BacktestRange br) =>
    if br.use
        (br.start_time == 0 or time >= br.start_time) and (br.end_time == 0 or time <= br.end_time)
    else
        true

//@function Updates strategy state based on current position and price action. Call at start of each bar.
updateState(StrategyState state, float atr = na) =>
    state.in_long := strategy.position_size > 0
    state.in_short := strategy.position_size < 0

    // Detect new position entry
    if strategy.position_size != 0 and strategy.position_size[1] == 0
        state.entry_price := strategy.position_avg_price
        state.entry_atr := atr  // Lock ATR at entry
        state.highest_since_entry := high
        state.lowest_since_entry := low
        state.trail_stop_active := false
        state.trail_tp_active := false
        state.be_active := false
        state.current_trail_stop := na
        state.current_trail_tp := na
        state.highest_since_trail_tp := na
        state.lowest_since_trail_tp := na

    // Update extremes while in position
    if state.in_long
        state.highest_since_entry := math.max(nz(state.highest_since_entry, high), high)
    if state.in_short
        state.lowest_since_entry := math.min(nz(state.lowest_since_entry, low), low)

    // Reset on position close
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        state.entry_price := na
        state.entry_atr := na
        state.highest_since_entry := na
        state.lowest_since_entry := na
        state.trail_stop_active := false
        state.trail_tp_active := false
        state.be_active := false
        state.current_trail_stop := na
        state.current_trail_tp := na
        state.highest_since_trail_tp := na
        state.lowest_since_trail_tp := na

    state

//@function Checks if any of the provided sessions are currently active
anySessionActive(SessionSettings session1, SessionSettings session2, SessionSettings session3) =>
    any_enabled = session1.use or session2.use or session3.use
    not any_enabled or session1.inSession() or session2.inSession() or session3.inSession()

//@function Checks if any session with close_at_end just ended
anySessionEnded(SessionSettings session1, SessionSettings session2, SessionSettings session3) =>
    session1.sessionEnded() or session2.sessionEnded() or session3.sessionEnded()

//@function Closes all positions if any session ended
closeOnSessionEnd(SessionSettings session1, SessionSettings session2, SessionSettings session3, string comment = 'Session End') =>
    if anySessionEnded(session1, session2, session3) and strategy.position_size != 0
        strategy.close_all(comment = comment)

//@function Closes all positions if outside backtest range
closeOutsideBacktestRange(BacktestRange br, string comment = 'Backtest End') =>
    if br.use and time > br.end_time and strategy.position_size != 0
        strategy.close_all(comment = comment)

//@function Manages all exit logic for long positions including SL, TP, trailing stop, trailing TP, breakeven
manageLongExits(StrategyState state, RiskSettings risk, ProfitSettings profit, string entry_id = 'Long', string exit_id = 'Long Exit', string sl_comment = 'SL', string tp_comment = 'TP', string trail_comment = 'Trail SL', string trail_tp_comment = 'Trail TP', string be_comment = 'BE', string alert_message = na, float atr = na) =>
    float pos_qty = math.abs(strategy.position_size)

    if state.in_long and pos_qty > 0
        float entry_price = strategy.position_avg_price
        // Use locked ATR from entry for consistent calculations throughout the trade
        float effective_atr = not na(state.entry_atr) ? state.entry_atr : atr

        // Calculate price distances
        float sl_distance = UnitConverter.new(risk.sl_unit, risk.sl_value).toPrice(entry_price, pos_qty, effective_atr)
        float tp_distance = UnitConverter.new(profit.tp_unit, profit.tp_value).toPrice(entry_price, pos_qty, effective_atr)
        float trail_activation_dist = UnitConverter.new(risk.sl_unit, risk.trail_activation).toPrice(entry_price, pos_qty, effective_atr)
        float trail_offset_dist = UnitConverter.new(risk.sl_unit, risk.trail_offset).toPrice(entry_price, pos_qty, effective_atr)

        float trail_tp_activation_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_activation).toPrice(entry_price, pos_qty, effective_atr)
        int trail_tp_offset_ticks = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toTicks(entry_price, pos_qty, effective_atr)
        float be_activation_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_activation).toPrice(entry_price, pos_qty, effective_atr)
        float be_profit_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_profit).toPrice(entry_price, pos_qty, effective_atr)

        float sl_price = entry_price - sl_distance
        float tp_price = entry_price + tp_distance
        float trail_tp_activation_price = entry_price + trail_tp_activation_dist

        // Calculate profit for trigger checks (Current uses high, Close uses close)
        float risk_trigger_profit = risk.trigger_price == 'Current' ? high - entry_price : close - entry_price
        float profit_trigger_profit = profit.trigger_price == 'Current' ? high - entry_price : close - entry_price

        // ===== TRAILING STOP: Manual calculation, pass to stop parameter =====
        if risk.use_trailing_stop and risk_trigger_profit >= trail_activation_dist
            state.trail_stop_active := true

        if state.trail_stop_active
            float new_trail = state.highest_since_entry - trail_offset_dist
            if na(state.current_trail_stop) or new_trail > state.current_trail_stop
                state.current_trail_stop := new_trail

        // ===== TRAILING TP: Track for visualization (native trail_* handles execution) =====
        if profit.use_trailing_tp and profit_trigger_profit >= trail_tp_activation_dist
            if not state.trail_tp_active
                state.highest_since_trail_tp := high
            state.trail_tp_active := true

        if state.trail_tp_active
            if high > state.highest_since_trail_tp
                state.highest_since_trail_tp := high
            float trail_tp_offset_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toPrice(entry_price, pos_qty, effective_atr)
            float new_trail_tp = state.highest_since_trail_tp - trail_tp_offset_dist
            if na(state.current_trail_tp) or new_trail_tp > state.current_trail_tp
                state.current_trail_tp := new_trail_tp

        // ===== DETERMINE EFFECTIVE STOP LOSS =====
        float effective_stop = na
        string stop_comment = na

        // Fixed stop loss (base)
        if risk.use_stop_loss
            effective_stop := sl_price
            stop_comment := sl_comment

        // Breakeven (overrides fixed SL if higher) - uses persistent flag so it stays active
        float be_stop = entry_price + be_profit_dist
        if risk.use_breakeven and risk_trigger_profit >= be_activation_dist
            state.be_active := true
        if state.be_active
            if na(effective_stop) or be_stop > effective_stop
                effective_stop := be_stop
                stop_comment := be_comment

        // Trailing stop (overrides if higher)
        if state.trail_stop_active and not na(state.current_trail_stop)
            if na(effective_stop) or state.current_trail_stop > effective_stop
                effective_stop := state.current_trail_stop
                stop_comment := trail_comment

        // ===== EXECUTE EXITS =====
        if profit.use_trailing_tp
            float effective_limit = profit.use_take_profit ? tp_price : na
            strategy.exit(exit_id, from_entry = '',
                 qty_percent = 100,
                 stop = effective_stop,
                 limit = effective_limit,
                 trail_price = trail_tp_activation_price,
                 trail_offset = trail_tp_offset_ticks,
                 comment_loss = stop_comment,
                 comment_profit = tp_comment,
                 comment_trailing = trail_tp_comment,
                 alert_message = alert_message)
        else
            float effective_limit = profit.use_take_profit ? tp_price : na
            if not na(effective_stop) or not na(effective_limit)
                strategy.exit(exit_id, from_entry = '',
                     qty_percent = 100,
                     stop = effective_stop,
                     limit = effective_limit,
                     comment_loss = stop_comment,
                     comment_profit = tp_comment,
                     alert_message = alert_message)

//@function Manages all exit logic for short positions including SL, TP, trailing stop, trailing TP, breakeven
manageShortExits(StrategyState state, RiskSettings risk, ProfitSettings profit, string entry_id = 'Short', string exit_id = 'Short Exit', string sl_comment = 'SL', string tp_comment = 'TP', string trail_comment = 'Trail SL', string trail_tp_comment = 'Trail TP', string be_comment = 'BE', string alert_message = na, float atr = na) =>
    float pos_qty = math.abs(strategy.position_size)

    if state.in_short and pos_qty > 0
        float entry_price = strategy.position_avg_price
        float effective_atr = not na(state.entry_atr) ? state.entry_atr : atr

        float sl_distance = UnitConverter.new(risk.sl_unit, risk.sl_value).toPrice(entry_price, pos_qty, effective_atr)
        float tp_distance = UnitConverter.new(profit.tp_unit, profit.tp_value).toPrice(entry_price, pos_qty, effective_atr)
        float trail_activation_dist = UnitConverter.new(risk.sl_unit, risk.trail_activation).toPrice(entry_price, pos_qty, effective_atr)
        float trail_offset_dist = UnitConverter.new(risk.sl_unit, risk.trail_offset).toPrice(entry_price, pos_qty, effective_atr)
        float trail_tp_activation_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_activation).toPrice(entry_price, pos_qty, effective_atr)
        int trail_tp_offset_ticks = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toTicks(entry_price, pos_qty, effective_atr)
        float be_activation_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_activation).toPrice(entry_price, pos_qty, effective_atr)
        float be_profit_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_profit).toPrice(entry_price, pos_qty, effective_atr)

        float sl_price = entry_price + sl_distance
        float tp_price = entry_price - tp_distance
        float trail_tp_activation_price = entry_price - trail_tp_activation_dist

        float risk_trigger_profit = risk.trigger_price == 'Current' ? entry_price - low : entry_price - close
        float profit_trigger_profit = profit.trigger_price == 'Current' ? entry_price - low : entry_price - close

        // ===== TRAILING STOP =====
        if risk.use_trailing_stop and risk_trigger_profit >= trail_activation_dist
            state.trail_stop_active := true

        if state.trail_stop_active
            float new_trail = state.lowest_since_entry + trail_offset_dist
            if na(state.current_trail_stop) or new_trail < state.current_trail_stop
                state.current_trail_stop := new_trail

        // ===== TRAILING TP =====
        if profit.use_trailing_tp and profit_trigger_profit >= trail_tp_activation_dist
            if not state.trail_tp_active
                state.lowest_since_trail_tp := low
            state.trail_tp_active := true

        if state.trail_tp_active
            if low < state.lowest_since_trail_tp
                state.lowest_since_trail_tp := low
            float trail_tp_offset_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toPrice(entry_price, pos_qty, effective_atr)
            float new_trail_tp = state.lowest_since_trail_tp + trail_tp_offset_dist
            if na(state.current_trail_tp) or new_trail_tp < state.current_trail_tp
                state.current_trail_tp := new_trail_tp

        // ===== DETERMINE EFFECTIVE STOP LOSS =====
        float effective_stop = na
        string stop_comment = na

        if risk.use_stop_loss
            effective_stop := sl_price
            stop_comment := sl_comment

        float be_stop = entry_price - be_profit_dist
        if risk.use_breakeven and risk_trigger_profit >= be_activation_dist
            state.be_active := true
        if state.be_active
            if na(effective_stop) or be_stop < effective_stop
                effective_stop := be_stop
                stop_comment := be_comment

        if state.trail_stop_active and not na(state.current_trail_stop)
            if na(effective_stop) or state.current_trail_stop < effective_stop
                effective_stop := state.current_trail_stop
                stop_comment := trail_comment

        // ===== EXECUTE EXITS =====
        if profit.use_trailing_tp
            float effective_limit = profit.use_take_profit ? tp_price : na
            strategy.exit(exit_id, from_entry = '',
                 qty_percent = 100,
                 stop = effective_stop,
                 limit = effective_limit,
                 trail_price = trail_tp_activation_price,
                 trail_offset = trail_tp_offset_ticks,
                 comment_loss = stop_comment,
                 comment_profit = tp_comment,
                 comment_trailing = trail_tp_comment,
                 alert_message = alert_message)
        else
            float effective_limit = profit.use_take_profit ? tp_price : na
            if not na(effective_stop) or not na(effective_limit)
                strategy.exit(exit_id, from_entry = '',
                     qty_percent = 100,
                     stop = effective_stop,
                     limit = effective_limit,
                     comment_loss = stop_comment,
                     comment_profit = tp_comment,
                     alert_message = alert_message)

// =====================================================================================
// DEAD CAT BOUNCE INPUTS (signal / drawing)
// =====================================================================================
length = input.int(5, 'Run length', minval = 1, group = 'Dead Cat Bounce', tooltip = "How many bars in a row must fail to extend a move before the strategy tracks it and mirrors it forward.\n\nLower = earlier, more frequent signals.\nHigher = only stronger, sustained moves.")

require_dir = input.bool(false, 'Directional candles only', group = 'Filters', tooltip = "Every bar in a run must close in the run's direction — bullish (close > open) on up-runs, bearish (close < open) on down-runs. A wrong-way candle invalidates the run.")
doji_breaks = input.bool(false, 'Doji invalidates run', group = 'Filters', tooltip = "A small-bodied candle (a doji) invalidates the current run.")
doji_max_body = input.float(5, '└ Max body %', inline = 'doji_body', minval = 0, maxval = 100, group = 'Filters', active = doji_breaks, tooltip = "A candle counts as a doji when its body is this percent of its high-low range, or smaller.")
use_body = input.bool(false, 'Use candle bodies', group = 'Filters', tooltip = "Track runs by body extremes (open/close) instead of wicks (high/low). The 'no new high / no new low' test and the drawn lines both use max/min(open, close).")
require_engulf = input.bool(false, 'Break candle must engulf', group = 'Filters', tooltip = "Only confirm the reversal when the breakout candle is an engulfing candle — bullish engulfing to confirm a down-run, bearish engulfing to confirm an up-run. Otherwise the run resets without firing.")
limit_break_dist = input.bool(false, 'Break near pivot', group = 'Filters', tooltip = "Only confirm the reversal when the breakout candle is within this many bars of the pivot extreme (the run's low for a down-run, its high for an up-run).")
break_max_bars = input.int(0, '└ Max bars', inline = 'bdist_max', minval = 0, group = 'Filters', active = limit_break_dist, tooltip = "Maximum number of bars between the pivot extreme and the breakout candle.")
atr_filter = input.bool(false, 'Big bar invalidates run', group = 'Filters', tooltip = "A run bar whose true range exceeds N × ATR invalidates the run — a volatility spike breaks it.")
atr_filter_len = input.int(14, '└ ATR', inline = 'atrf', minval = 1, group = 'Filters', active = atr_filter, tooltip = "ATR length.")
atr_filter_mult = input.float(2.0, '×', inline = 'atrf', minval = 0.1, step = 0.1, group = 'Filters', active = atr_filter, tooltip = "Max true range a run bar may have, as a multiple of ATR. A bar exceeding it invalidates the run.")
require_extend = input.bool(false, 'Sequential extremes', group = 'Filters', tooltip = "Each run bar must extend the move: a down-run bar must make a lower low than the previous bar, an up-run bar a higher high. A bar that fails to invalidates the run.")
break_clears_pivot = input.bool(true, 'Break clears pivot extreme', group = 'Filters', tooltip = "The breakout bar must strictly exceed the pivot candle's extreme — a down-run breaks only when price clears the HIGH of the run's low candle (an up-run, the LOW of its high candle) — instead of merely exceeding the previous bar. Weak ticks during consolidation no longer count as breakouts.")

show_trend = input.bool(true, 'Trend line', group = 'Display', tooltip = "Dashed line tracing the developing move from its origin to the running extreme.")
show_proj = input.bool(true, 'Projection', group = 'Display', tooltip = "The measured-move mirror of the move. Shown dotted as a live preview while unconfirmed; once the reversal confirms it stays dotted to the breakout candle and becomes a solid arrow to the target beyond it.")
show_rev = input.bool(true, 'Reversal marker', group = 'Display', tooltip = "Mark the candle that confirms the reversal — where the projection begins — with a 'DCB' tag.")
skip_realized = input.bool(true, 'Hide realized legs', group = 'Display', tooltip = "Hide a move that merely plays out the opposite move's projection (it would draw right on top of that projection). Keeps the chart uncluttered.")
show_hwm = input.bool(true, 'High-water mark', group = 'Display', tooltip = "A 1px dotted line marking the furthest price has progressed toward the active projection's target (its high-water mark).")

show_target = input.bool(true, 'Target label', group = 'Target', tooltip = "Label at the projection target showing the size of the projected move. Pick what it shows below.")
lbl_price = input.bool(true, 'Price', inline = 'lbl', group = 'Target', tooltip = "Target price.")
lbl_points = input.bool(true, 'Points', inline = 'lbl', group = 'Target', tooltip = "Size of the projected move (pivot → target), in points.")
lbl_pct = input.bool(true, '%', inline = 'lbl', group = 'Target', tooltip = "Size of the projected move as a % of price (same basis as the ruler tool).")
lbl_size = input.int(12, 'Text size', minval = 1, group = 'Target', tooltip = "Font size (in points) of the target label text.")

up_proj_col = input.color(#54a0ff, 'Bullish', inline = 'col', group = 'Colors', tooltip = "Color of an upward projection (and its trend line) — the mirror of a down-run / lower highs.")
down_proj_col = input.color(#B53471, 'Bearish', inline = 'col', group = 'Colors', tooltip = "Color of a downward projection (and its trend line) — the mirror of an up-run / higher lows.")
line_w = input.int(2, 'Line width', minval = 1, group = 'Colors')

show_fibs = input.bool(true, 'Fib level grid', group = 'Fib Levels', tooltip = "Draw horizontal Fibonacci levels of the latest reversal's measured move (pivot = 0.0, target = 1.0), extended to the right. They persist — always showing the most recent reversal's levels — and only redraw when a new reversal confirms, so they stay on the chart even after that reversal's projection drawing is gone.")
fib_show_ext = input.bool(false, 'Include extensions', group = 'Fib Levels', tooltip = "Also draw extension levels beyond the target: 1.272, 1.414, 1.618, 2.0, 2.618.")
fib_lbl = input.bool(true, 'Level labels', group = 'Fib Levels', tooltip = "Show each level's ratio and price. Labels ride the right edge so they stay visible.")
fib_style_sel = input.string('Dotted', 'Line style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Fib Levels')
fib_transp = input.int(55, 'Transparency', minval = 0, maxval = 100, group = 'Fib Levels', tooltip = "0 = solid, 100 = invisible. Levels use chart.fg_color.")

show_stats = input.bool(true, 'Stats table', group = 'Stats', tooltip = "Show a bottom-right table: how often price covers each Fibonacci level of the projected move (pivot→target = 1.0) by the predicted bar. Counts projections whose predicted bar has been reached; in-flight ones are excluded.")
stat1_sel = input.string('0.786', 'Reach levels (Fib)', options = ['0.236', '0.382', '0.5', '0.618', '0.786', '1.0', 'Custom'], inline = 'fib1', group = 'Stats', tooltip = "Three Fibonacci levels of the projected move to track, as a fraction of the pivot→target measured move (1.0 = the full target). Pick a standard level, or choose 'Custom' and type your own value in the box beside it.")
stat1_cust = input.float(0.786, '', inline = 'fib1', group = 'Stats', minval = 0, step = 0.001)
stat2_sel = input.string('0.618', '', options = ['0.236', '0.382', '0.5', '0.618', '0.786', '1.0', 'Custom'], inline = 'fib2', group = 'Stats')
stat2_cust = input.float(0.618, '', inline = 'fib2', group = 'Stats', minval = 0, step = 0.001)
stat3_sel = input.string('0.5', '', options = ['0.236', '0.382', '0.5', '0.618', '0.786', '1.0', 'Custom'], inline = 'fib3', group = 'Stats')
stat3_cust = input.float(0.5, '', inline = 'fib3', group = 'Stats', minval = 0, step = 0.001)

// Resolve a Fib dropdown: 'Custom' → the adjacent numeric box, otherwise the chosen preset.
fibLevel(string sel, float cust) => sel == 'Custom' ? cust : str.tonumber(sel)
float lvl1 = fibLevel(stat1_sel, stat1_cust)
float lvl2 = fibLevel(stat2_sel, stat2_cust)
float lvl3 = fibLevel(stat3_sel, stat3_cust)
string fib_style = fib_style_sel == 'Solid' ? line.style_solid : fib_style_sel == 'Dashed' ? line.style_dashed : line.style_dotted

// =====================================================================================
// FRAMEWORK INPUTS (Global / Backtest / Risk / Profit / Sessions / Design / Alerts)
// =====================================================================================
string g_backtest = 'Backtest Range'
string g_risk = 'Risk Settings'
string g_profit = 'Profit Settings'
string g_sessions = 'Sessions'
string g_design = 'Design'
string g_global = 'Global Settings'
string g_alerts = 'Alerts'

// Global Settings
i_global_unit = input.string('PnL', 'Default Unit', options = ['Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], group = g_global, tooltip = 'Default unit for Stop Loss and Take Profit.\n\nDollars — Price movement\nExample: 10 = asset moves $10\n\nPnL — Position profit/loss\nExample: 10 = position gains/loses $10\n\nPercent — % of entry price\n\nTicks — Minimum tick (syminfo.mintick)\n\nPoints — Price points (1.0 = 1 point)\n\nATR — Multiple of Average True Range\nExample: 1.5 = 1.5× ATR')
i_atr_period = input.int(14, 'ATR Period', minval = 1, step = 1, group = g_global, tooltip = 'Period for ATR calculations.\nUsed when ATR is selected as a unit type.', display = display.none)
i_global_tz = input.string('America/New_York', 'Timezone', options = ['America/New_York', 'America/Chicago', 'America/Los_Angeles', 'Europe/London', 'Europe/Berlin', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Singapore', 'Australia/Sydney', 'UTC'], group = g_global, tooltip = 'Timezone used for all trading sessions.\nAll session time windows are interpreted in this timezone.', display = display.none)
i_trigger_price = input.string('Current', 'Trigger Price', options = ['Current', 'Close'], group = g_global, tooltip = 'When trailing/breakeven triggers activate:\n\nCurrent — Triggers when high (longs) or low (shorts) reaches the level during a bar\n\nClose — Triggers only when the bar closes at or beyond the level', display = display.none)

// Global ATR calculation
global_atr = ta.atr(i_atr_period)

// Helper to resolve 'Global' to actual unit value
resolveUnit(string unit) =>
    unit == 'Global' ? i_global_unit : unit

// Backtest Inputs
i_use_backtest_range = input.bool(false, 'Use Date Range', inline = 'bt', group = g_backtest, tooltip = 'Restrict backtesting to a specific date range.\nTrades will only be taken within this period.', display = display.none)
i_backtest_preset = input.string('Custom', '', options = ['Last 7 Days', 'This Month', 'This Quarter', 'This Year', 'Custom'], inline = 'bt', group = g_backtest, active = i_use_backtest_range, tooltip = 'Quick date range presets:\n\nLast 7 Days — Rolling 7-day window\n\nThis Month — From 1st of current month\n\nThis Quarter — From start of current quarter\n(Jan 1, Apr 1, Jul 1, or Oct 1)\n\nThis Year — From Jan 1 of current year\n\nCustom — Use manual start/end dates below', display = display.none)
i_backtest_start = input.time(timestamp('01 Jan 2020 00:00 +0000'), 'Start Date', group = g_backtest, active = i_use_backtest_range and i_backtest_preset == 'Custom', display = display.none)
i_backtest_end = input.time(timestamp('31 Dec 2030 23:59 +0000'), 'End Date', group = g_backtest, active = i_use_backtest_range and i_backtest_preset == 'Custom', display = display.none)

// Calculate backtest start based on preset
getBacktestStart() =>
    int result = i_backtest_start
    if i_backtest_preset == 'Last 7 Days'
        result := timenow - 7 * 24 * 60 * 60 * 1000
    else if i_backtest_preset == 'This Month'
        result := timestamp(year(timenow), month(timenow), 1, 0, 0, 0)
    else if i_backtest_preset == 'This Quarter'
        int q_month = month(timenow) <= 3 ? 1 : month(timenow) <= 6 ? 4 : month(timenow) <= 9 ? 7 : 10
        result := timestamp(year(timenow), q_month, 1, 0, 0, 0)
    else if i_backtest_preset == 'This Year'
        result := timestamp(year(timenow), 1, 1, 0, 0, 0)
    result

backtest_start = getBacktestStart()
backtest_end = i_backtest_preset == 'Custom' ? i_backtest_end : timenow
backtest_range = BacktestRange.new(i_use_backtest_range, backtest_start, backtest_end)

// Risk Inputs (Stop Loss, Trailing Stop, Breakeven - all use the SL unit)
i_use_sl = input.bool(true, 'Use Stop Loss', inline = 'sl', group = g_risk, tooltip = 'Fixed stop loss at a set distance from entry.\nThe unit selected here also applies to Trailing Stop and Breakeven.', display = display.none)
i_sl_value = input.float(1000, '', minval = 0.01, step = 0.5, inline = 'sl', group = g_risk, active = i_use_sl, display = display.none)
i_sl_unit = input.string('Global', '', options = ['Global', 'Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], inline = 'sl', group = g_risk, active = i_use_sl, tooltip = 'Unit for Stop Loss, Trailing Stop, and Breakeven.\n\nGlobal — Uses Default Unit setting\n\nDollars — Price movement\n\nPnL — Position profit/loss\n\nATR — Multiple of ATR', display = display.none)
i_color_sl = input.color(color.red, '', inline = 'sl', group = g_risk, display = display.none)

i_use_trail = input.bool(false, '└ Trailing  ›', inline = 'trail', group = g_risk, tooltip = 'Stop loss that trails price after reaching the trigger profit.\nOnce activated, the stop moves up (longs) or down (shorts) as price moves favorably,\nbut never moves against you. Uses Stop Loss unit.', display = display.none)
i_trail_activation = input.float(500, 'Trigger', minval = 0, step = 0.5, inline = 'trail', group = g_risk, active = i_use_trail, display = display.none)
i_trail_offset = input.float(250, 'Offset', minval = 0.01, step = 0.5, inline = 'trail', group = g_risk, active = i_use_trail, display = display.none)

i_use_breakeven = input.bool(false, '└ BE  ›', inline = 'be', group = g_risk, tooltip = 'Moves stop to lock in profit after reaching the trigger.\nOnce activated, stop moves to entry price + Lock In amount.\nSet Lock In to 0 for true breakeven. Uses Stop Loss unit.', display = display.none)
i_breakeven_activation = input.float(1000, 'Trigger', minval = 0, step = 0.5, inline = 'be', group = g_risk, active = i_use_breakeven, display = display.none)
i_breakeven_profit = input.float(500, 'Lock In', minval = 0, step = 0.5, inline = 'be', group = g_risk, active = i_use_breakeven, display = display.none)
i_color_be_trig = input.color(#ff9900ba, '', inline = 'be', group = g_risk, display = display.none)

risk_settings = RiskSettings.new(
     i_use_sl, resolveUnit(i_sl_unit), i_sl_value,
     i_use_trail, i_trail_activation, i_trail_offset,
     i_use_breakeven, i_breakeven_activation, i_breakeven_profit,
     i_trigger_price)

// Profit Inputs (Take Profit, Trailing TP - all use the TP unit)
i_use_tp = input.bool(true, 'Use Take Profit', inline = 'tp', group = g_profit, tooltip = 'Fixed take profit at a set distance from entry.\nThe unit selected here also applies to Trailing TP.', display = display.none)
i_tp_value = input.float(2000, '', minval = 0.01, step = 0.5, inline = 'tp', group = g_profit, active = i_use_tp, display = display.none)
i_tp_unit = input.string('Global', '', options = ['Global', 'Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], inline = 'tp', group = g_profit, active = i_use_tp, tooltip = 'Unit for Take Profit and Trailing TP.\n\nGlobal — Uses Default Unit setting\n\nDollars — Price movement\n\nPnL — Position profit/loss\n\nATR — Multiple of ATR', display = display.none)
i_color_tp = input.color(color.green, '', inline = 'tp', group = g_profit, display = display.none)

i_use_trail_tp = input.bool(false, '└ Trailing  ›', inline = 'trail_tp', group = g_profit, tooltip = 'Take profit that trails price after reaching the trigger profit.\nOnce activated, the TP moves up (longs) or down (shorts) as price moves favorably,\nlocking in more profit. Uses Take Profit unit.', display = display.none)
i_trail_tp_activation = input.float(1000, 'Trigger', minval = 0, step = 0.5, inline = 'trail_tp', group = g_profit, active = i_use_trail_tp, display = display.none)
i_trail_tp_offset = input.float(500, 'Offset', minval = 0.01, step = 0.5, inline = 'trail_tp', group = g_profit, active = i_use_trail_tp, display = display.none)

profit_settings = ProfitSettings.new(
     i_use_tp, resolveUnit(i_tp_unit), i_tp_value,
     i_use_trail_tp, i_trail_tp_activation, i_trail_tp_offset,
     i_trigger_price)

// Session Inputs
i_use_session1 = input.bool(true, 'Session 1', inline = 's1', group = g_sessions, tooltip = 'Trading window for Session 1.\nTrades only taken when at least one enabled session is active.\nTimezone set in Global Settings.', display = display.none)
i_session1 = input.session('0930-1600', '', inline = 's1', group = g_sessions, active = i_use_session1, display = display.none)
i_session1_close = input.bool(false, 'Close', inline = 's1', group = g_sessions, active = i_use_session1, tooltip = 'Close all positions when Session 1 ends.', display = display.none)

i_use_session2 = input.bool(false, 'Session 2', inline = 's2', group = g_sessions, tooltip = 'Trading window for Session 2.\nTrades only taken when at least one enabled session is active.\nTimezone set in Global Settings.', display = display.none)
i_session2 = input.session('1900-0400', '', inline = 's2', group = g_sessions, active = i_use_session2, display = display.none)
i_session2_close = input.bool(false, 'Close', inline = 's2', group = g_sessions, active = i_use_session2, tooltip = 'Close all positions when Session 2 ends.', display = display.none)

i_use_session3 = input.bool(false, 'Session 3', inline = 's3', group = g_sessions, tooltip = 'Trading window for Session 3.\nTrades only taken when at least one enabled session is active.\nTimezone set in Global Settings.', display = display.none)
i_session3 = input.session('0300-1100', '', inline = 's3', group = g_sessions, active = i_use_session3, display = display.none)
i_session3_close = input.bool(false, 'Close', inline = 's3', group = g_sessions, active = i_use_session3, tooltip = 'Close all positions when Session 3 ends.', display = display.none)

// Session objects (use global timezone)
session1 = SessionSettings.new(i_use_session1, i_session1, i_global_tz, i_session1_close)
session2 = SessionSettings.new(i_use_session2, i_session2, i_global_tz, i_session2_close)
session3 = SessionSettings.new(i_use_session3, i_session3, i_global_tz, i_session3_close)

// Session event logs
if session1.sessionStarted()
    log.info('SESSION 1 START | {0}', i_session1)
if session1.sessionEnd()
    log.info('SESSION 1 END | {0}', i_session1)
if session2.sessionStarted()
    log.info('SESSION 2 START | {0}', i_session2)
if session2.sessionEnd()
    log.info('SESSION 2 END | {0}', i_session2)
if session3.sessionStarted()
    log.info('SESSION 3 START | {0}', i_session3)
if session3.sessionEnd()
    log.info('SESSION 3 END | {0}', i_session3)

// Design Inputs
i_show_levels = input.bool(true, 'Show Levels', group = g_design, tooltip = 'Entry, stop, and target lines while in position.\n\nExample:\n───────── SL\n───────── Entry\n───────── TP', display = display.none)
i_show_triggers = input.bool(true, 'Show Triggers', group = g_design, tooltip = 'Dotted lines where trailing/breakeven activate.\n\nExample:\n┈┈┈┈┈┈┈┈┈ BE▸\n┈┈┈┈┈┈┈┈┈ SL▸\n┈┈┈┈┈┈┈┈┈ TP▸', display = display.none)
i_show_labels = input.bool(true, 'Show Labels', group = g_design, tooltip = 'Text labels on price levels.\n\nExample:\nSL ─────────\nTP ─────────', display = display.none)
i_show_values = input.bool(false, 'Show Values', group = g_design, tooltip = 'Price/PnL values in labels.\n\nExample:\nSL $100 ─────────\nTP $200 ─────────', display = display.none)
i_color_entry = input.color(color.gray, 'Entry Line', group = g_design, display = display.none)
i_show_session_bg = input.bool(false, 'Session Shading', inline = 'session_bg', group = g_design, tooltip = 'Shade background during or outside trading sessions.', display = display.none)
i_session_bg_mode = input.string('In Session', '', options = ['In Session', 'Out of Session'], inline = 'session_bg', group = g_design, display = display.none)
i_session_bg_color = input.color(color.blue, '', inline = 'session_bg', group = g_design, display = display.none)

// Alert Messages
i_alert_long_raw = input.text_area('', 'Long Entry', group = g_alerts, tooltip = 'Alert message when opening a long position.\nSupports TradingView placeholders like {{ticker}}, {{close}}, etc.', display = display.none)
i_alert_short_raw = input.text_area('', 'Short Entry', group = g_alerts, tooltip = 'Alert message when opening a short position.\nSupports TradingView placeholders like {{ticker}}, {{close}}, etc.', display = display.none)
i_alert_exit_raw = input.text_area('', 'Exit', group = g_alerts, tooltip = 'Alert message when closing a position (SL, TP, trailing, or breakeven).\nSupports TradingView placeholders like {{ticker}}, {{close}}, etc.', display = display.none)

// Convert empty strings to na (TradingView ignores empty string alerts)
i_alert_long = i_alert_long_raw == '' ? na : i_alert_long_raw
i_alert_short = i_alert_short_raw == '' ? na : i_alert_short_raw
i_alert_exit = i_alert_exit_raw == '' ? na : i_alert_exit_raw

// Strategy state (declared with var)
var StrategyState state = StrategyState.new()

// === Down-run state (consecutive lower-or-equal highs) ===
var int   d_anchor_bar  = na   // bar of the peak the run is falling away from
var float d_anchor_high = na   // that peak's high
var int   d_count       = 0    // consecutive bars with high <= previous high
var float d_low         = na   // lowest low since the peak
var int   d_low_bar     = na
var line  d_line        = na   // active trend line (na once finalized)
var line  d_preview     = na   // dotted live projection preview (until the reversal confirms)
var bool  d_skip        = false // this down-run just realizes a shown up-projection → omit it
var float d_pivot_bh    = na   // bH of the pivot (low) candle — the breakout must clear this

// === Up-run state (consecutive higher-or-equal lows) ===
var int   u_anchor_bar = na    // bar of the trough the run is rising away from
var float u_anchor_low = na    // that trough's low
var int   u_count      = 0     // consecutive bars with low >= previous low
var float u_high       = na    // highest high since the trough
var int   u_high_bar   = na
var line  u_line       = na
var line  u_preview    = na   // dotted live projection preview (until the reversal confirms)
var bool  u_skip       = false // this up-run just realizes a shown down-projection → omit it
var float u_pivot_bl   = na   // bL of the pivot (high) candle — the breakout must clear this

// === Active projection target (for the live readout label) ===
var float at_target = na   // projection endpoint price
var float at_pivot  = na   // the run's pivot (move measured from here)
var int   at_bar    = na   // projection endpoint bar
var color at_col    = na
var label at_label  = na

// === Stats: progress + outcome tracking for confirmed projections ===
var array<int>   p_dir     = array.new_int()    // pending projections: +1 up / -1 down
var array<float> p_target  = array.new_float()  // full-move target price (100%)
var array<float> p_entry   = array.new_float()  // break-candle close (recorded for reference; reach is measured from the pivot)
var array<float> p_pivot   = array.new_float()  // run pivot price (retrace past this = fail)
var array<int>   p_eta     = array.new_int()    // projected ETA bar_index (the "on time" deadline)
var array<int>   p_start   = array.new_int()    // confirmation (break) bar_index
var array<int>   p_runlen  = array.new_int()    // run leg length, in bars
var array<float> p_maxprog = array.new_float()  // best fraction of the move reached by the ETA (on-time window)
var array<float> p_maxall  = array.new_float()  // best fraction reached over the whole life (up to resolution)
var int n_total  = 0                            // fully resolved projections (full target hit, or pivot retraced)
var int n_ontime = 0                            // covered the FULL move by the predicted bar
var int n_h1     = 0                            // covered level 1 by the predicted bar
var int n_h2     = 0                            // covered level 2 by the predicted bar
var int n_h3     = 0                            // covered level 3 by the predicted bar
var int n_late   = 0                            // covered the full move late (after the bar, before retrace)
var int n_lt1    = 0                            // covered level 1 late
var int n_lt2    = 0                            // covered level 2 late
var int n_lt3    = 0                            // covered level 3 late
var int n_fail   = 0                            // never covered the full move before retracing past the pivot
var array<float> b2t     = array.new_float()    // bars from confirmation to full-target hit
var array<float> rl_succ = array.new_float()    // run length on full-target hits
var array<float> rl_fail = array.new_float()    // run length on fails
var table stats_tbl = na

// === High-water-mark tracking (one persistent dotted line per projection) ===
var array<int>   hwm_dir   = array.new_int()    // +1 up-projection / -1 down-projection
var array<float> hwm_piv   = array.new_float()  // pivot price (break past this = stop tracking)
var array<float> hwm_tgt   = array.new_float()  // projection target price (reach this = stop tracking)
var array<int>   hwm_start = array.new_int()    // bar the projection confirmed (line x1)
var array<float> hwm_best  = array.new_float()  // best favorable price reached (the high-water mark)
var array<line>  hwm_lines = array.new_line()   // the per-projection dotted line

// === Per-bar candle metrics (honor the body / doji / direction filters) ===
float bH = use_body ? math.max(open, close) : high   // "high-like" extreme for run tracking
float bL = use_body ? math.min(open, close) : low    // "low-like" extreme for run tracking
bool is_bull = close > open
bool is_bear = close < open
float rng = high - low
bool is_doji = rng > 0 ? math.abs(close - open) / rng <= doji_max_body / 100 : true
float atr_val = ta.atr(atr_filter_len)
bool big_bar = atr_filter and not na(atr_val) and ta.tr > atr_filter_mult * atr_val   // volatility-spike bar
bool bull_engulf = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]   // bullish engulfing (confirms a down-run)
bool bear_engulf = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]   // bearish engulfing (confirms an up-run)

bool down_rev = false   // this bar breaks a shown down-run (bullish reversal → up projection)
bool up_rev = false      // this bar breaks a shown up-run (bearish reversal → down projection)
if bar_index == 0
    d_anchor_bar := 0
    d_anchor_high := bH
    d_low := bL
    d_low_bar := 0
    d_pivot_bh := bH
    u_anchor_bar := 0
    u_anchor_low := bL
    u_high := bH
    u_high_bar := 0
    u_pivot_bl := bL
else
    // ---- DOWN run: no new (body) highs ----
    if bH > (break_clears_pivot ? d_pivot_bh : bH[1])
        // higher high → reversal of a shown down-run: mark it, then reset at this new peak.
        // Projection splits at the break bar: pivot→break stays DOTTED, break→endpoint is a SOLID ARROW.
        bool d_break_ok = (not require_engulf or bull_engulf) and (not limit_break_dist or bar_index - d_low_bar <= break_max_bars)
        if not d_skip and d_count >= length and d_break_ok
            down_rev := true
            int c_bar = 2 * d_low_bar - d_anchor_bar
            if show_proj
                int leg = d_low_bar - d_anchor_bar
                if bar_index < c_bar
                    // normal: dotted realized (pivot→break) + solid arrow (break→endpoint)
                    float y_break = leg != 0 ? d_low + (float(bar_index - d_low_bar) / float(leg)) * (d_anchor_high - d_low) : d_anchor_high
                    if na(d_preview)
                        d_preview := line.new(d_low_bar, d_low, bar_index, y_break, xloc.bar_index, extend.none, up_proj_col, line.style_dotted, line_w)
                    else
                        d_preview.set_xy2(bar_index, y_break)
                    line.new(bar_index, y_break, c_bar, d_anchor_high, xloc.bar_index, extend.none, up_proj_col, line.style_arrow_right, line_w)
                else
                    // late break (at/after the endpoint): one forward arrow from the pivot to the target
                    if not na(d_preview)
                        d_preview.delete()
                    d_preview := na
                    line.new(d_low_bar, d_low, c_bar, d_anchor_high, xloc.bar_index, extend.none, up_proj_col, line.style_arrow_right, line_w)
            // record the active target for the live readout (move measured from the pivot low)
            at_target := d_anchor_high
            at_pivot := d_low
            at_bar := c_bar
            at_col := up_proj_col
            if show_hwm
                array.push(hwm_dir, 1)
                array.push(hwm_piv, d_low)
                array.push(hwm_tgt, d_anchor_high)
                array.push(hwm_start, bar_index)
                array.push(hwm_best, high)
                array.push(hwm_lines, line.new(bar_index, high, bar_index, high, xloc.bar_index, extend.none, up_proj_col, line.style_dotted, 2))
            if show_stats
                array.push(p_dir, 1)
                array.push(p_target, d_anchor_high)
                array.push(p_entry, close)
                array.push(p_pivot, d_low)
                array.push(p_eta, c_bar)
                array.push(p_start, bar_index)
                array.push(p_runlen, d_low_bar - d_anchor_bar)
                array.push(p_maxprog, 0.0)
                array.push(p_maxall, 0.0)
        d_preview := na   // trimmed dotted segment persists; fresh preview for the next run
        d_anchor_bar := bar_index
        d_anchor_high := bH
        d_count := 0
        d_low := bL
        d_low_bar := bar_index
        d_pivot_bh := bH
        d_line := na
        // the new down-run realizes a shown up-projection if an active, non-skipped up-run owns this peak
        d_skip := skip_realized and u_count >= length and not u_skip
    else if (require_dir and not is_bear) or (doji_breaks and is_doji) or big_bar or (require_extend and not (bL < bL[1]))
        // a non-bearish, doji, oversized, or non-lower-low bar invalidates the down-run → drop its drawings, re-anchor here, no reversal
        if not na(d_preview)
            d_preview.delete()
        if not na(d_line)
            d_line.delete()
        d_preview := na
        d_line := na
        d_anchor_bar := bar_index
        d_anchor_high := bH
        d_count := 0
        d_low := bL
        d_low_bar := bar_index
        d_pivot_bh := bH
        d_skip := false
    else
        d_count += 1
        if na(d_low) or bL < d_low
            d_low := bL
            d_low_bar := bar_index
            d_pivot_bh := bH
        if show_trend and not d_skip and d_count >= length
            if na(d_line)
                d_line := line.new(d_anchor_bar, d_anchor_high, d_low_bar, d_low, xloc.bar_index, extend.none, up_proj_col, line.style_dashed, line_w)
            else
                d_line.set_xy1(d_anchor_bar, d_anchor_high)
                d_line.set_xy2(d_low_bar, d_low)
        // dotted preview of where the projection would land if the high broke now (until confirmed)
        if show_proj and not d_skip and d_count >= length
            int pc_bar = 2 * d_low_bar - d_anchor_bar
            if na(d_preview)
                d_preview := line.new(d_low_bar, d_low, pc_bar, d_anchor_high, xloc.bar_index, extend.none, up_proj_col, line.style_dotted, line_w)
            else
                d_preview.set_xy1(d_low_bar, d_low)
                d_preview.set_xy2(pc_bar, d_anchor_high)

    // ---- UP run: no new (body) lows ----
    if bL < (break_clears_pivot ? u_pivot_bl : bL[1])
        // lower low → reversal of a shown up-run: mark it, then reset at this new trough.
        // Projection splits at the break bar: pivot→break stays DOTTED, break→endpoint is a SOLID ARROW.
        bool u_break_ok = (not require_engulf or bear_engulf) and (not limit_break_dist or bar_index - u_high_bar <= break_max_bars)
        if not u_skip and u_count >= length and u_break_ok
            up_rev := true
            int c_bar = 2 * u_high_bar - u_anchor_bar
            if show_proj
                int leg = u_high_bar - u_anchor_bar
                if bar_index < c_bar
                    // normal: dotted realized (pivot→break) + solid arrow (break→endpoint)
                    float y_break = leg != 0 ? u_high + (float(bar_index - u_high_bar) / float(leg)) * (u_anchor_low - u_high) : u_anchor_low
                    if na(u_preview)
                        u_preview := line.new(u_high_bar, u_high, bar_index, y_break, xloc.bar_index, extend.none, down_proj_col, line.style_dotted, line_w)
                    else
                        u_preview.set_xy2(bar_index, y_break)
                    line.new(bar_index, y_break, c_bar, u_anchor_low, xloc.bar_index, extend.none, down_proj_col, line.style_arrow_right, line_w)
                else
                    // late break (at/after the endpoint): one forward arrow from the pivot to the target
                    if not na(u_preview)
                        u_preview.delete()
                    u_preview := na
                    line.new(u_high_bar, u_high, c_bar, u_anchor_low, xloc.bar_index, extend.none, down_proj_col, line.style_arrow_right, line_w)
            // record the active target for the live readout (move measured from the pivot high)
            at_target := u_anchor_low
            at_pivot := u_high
            at_bar := c_bar
            at_col := down_proj_col
            if show_hwm
                array.push(hwm_dir, -1)
                array.push(hwm_piv, u_high)
                array.push(hwm_tgt, u_anchor_low)
                array.push(hwm_start, bar_index)
                array.push(hwm_best, low)
                array.push(hwm_lines, line.new(bar_index, low, bar_index, low, xloc.bar_index, extend.none, down_proj_col, line.style_dotted, 2))
            if show_stats
                array.push(p_dir, -1)
                array.push(p_target, u_anchor_low)
                array.push(p_entry, close)
                array.push(p_pivot, u_high)
                array.push(p_eta, c_bar)
                array.push(p_start, bar_index)
                array.push(p_runlen, u_high_bar - u_anchor_bar)
                array.push(p_maxprog, 0.0)
                array.push(p_maxall, 0.0)
        u_preview := na   // trimmed dotted segment persists; fresh preview for the next run
        u_anchor_bar := bar_index
        u_anchor_low := bL
        u_count := 0
        u_high := bH
        u_high_bar := bar_index
        u_pivot_bl := bL
        u_line := na
        // the new up-run realizes a shown down-projection if an active, non-skipped down-run owns this trough
        u_skip := skip_realized and d_count >= length and not d_skip
    else if (require_dir and not is_bull) or (doji_breaks and is_doji) or big_bar or (require_extend and not (bH > bH[1]))
        // a non-bullish, doji, oversized, or non-higher-high bar invalidates the up-run → drop its drawings, re-anchor here, no reversal
        if not na(u_preview)
            u_preview.delete()
        if not na(u_line)
            u_line.delete()
        u_preview := na
        u_line := na
        u_anchor_bar := bar_index
        u_anchor_low := bL
        u_count := 0
        u_high := bH
        u_high_bar := bar_index
        u_pivot_bl := bL
        u_skip := false
    else
        u_count += 1
        if na(u_high) or bH > u_high
            u_high := bH
            u_high_bar := bar_index
            u_pivot_bl := bL
        if show_trend and not u_skip and u_count >= length
            if na(u_line)
                u_line := line.new(u_anchor_bar, u_anchor_low, u_high_bar, u_high, xloc.bar_index, extend.none, down_proj_col, line.style_dashed, line_w)
            else
                u_line.set_xy1(u_anchor_bar, u_anchor_low)
                u_line.set_xy2(u_high_bar, u_high)
        // dotted preview of where the projection would land if the low broke now (until confirmed)
        if show_proj and not u_skip and u_count >= length
            int pc_bar = 2 * u_high_bar - u_anchor_bar
            if na(u_preview)
                u_preview := line.new(u_high_bar, u_high, pc_bar, u_anchor_low, xloc.bar_index, extend.none, down_proj_col, line.style_dotted, line_w)
            else
                u_preview.set_xy1(u_high_bar, u_high)
                u_preview.set_xy2(pc_bar, u_anchor_low)

// === Reversal markers (on the candle that breaks a tracked run) ===
// 'DCB' text only (no triangle); numeric font size (points) so it's freely tunable, not capped at size.tiny.
if show_rev and down_rev
    label.new(bar_index, low, 'DCB', xloc.bar_index, yloc.belowbar, color(na), label.style_none, chart.fg_color, size = 12, text_font_family = font.family_monospace)
if show_rev and up_rev
    label.new(bar_index, high, 'DCB', xloc.bar_index, yloc.abovebar, color(na), label.style_none, chart.fg_color, size = 12, text_font_family = font.family_monospace)

// === Log DCB reversal events (Pine logs pane) ===
if down_rev
    log.info('Dead Cat Bounce bullish reversal — up projection to {0} ({1} pts, {2}%)', str.tostring(at_target, format.mintick), str.tostring(math.abs(at_pivot - at_target), format.mintick), str.tostring(at_pivot != 0 ? math.abs(at_pivot - at_target) / at_pivot * 100 : 0, '#.##'))
if up_rev
    log.info('Dead Cat Bounce bearish reversal — down projection to {0} ({1} pts, {2}%)', str.tostring(at_target, format.mintick), str.tostring(math.abs(at_pivot - at_target), format.mintick), str.tostring(at_pivot != 0 ? math.abs(at_pivot - at_target) / at_pivot * 100 : 0, '#.##'))

// === Fib level grid: persistent horizontal levels of the latest reversal's measured move ===
// Redrawn only when a new reversal confirms (down_rev / up_rev), so the most-recent reversal's
// levels stay on the chart — extended to the right — even after its projection drawings clear.
// Pivot = 0.0, target = 1.0; labels ride the right edge so the ratios stay readable.
var array<line>  fib_lines  = array.new_line()
var array<label> fib_labels = array.new_label()
if show_fibs and (down_rev or up_rev) and not na(at_pivot) and not na(at_target)
    // clear the previous reversal's grid
    if array.size(fib_lines) > 0
        for i = array.size(fib_lines) - 1 to 0
            line.delete(array.get(fib_lines, i))
        array.clear(fib_lines)
    if array.size(fib_labels) > 0
        for i = array.size(fib_labels) - 1 to 0
            label.delete(array.get(fib_labels, i))
        array.clear(fib_labels)
    // standard retracement set, plus optional extensions beyond the target
    array<float> levels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
    if fib_show_ext
        array.push(levels, 1.272)
        array.push(levels, 1.414)
        array.push(levels, 1.618)
        array.push(levels, 2.0)
        array.push(levels, 2.618)
    float span = at_target - at_pivot   // signed: positive for up-projections, negative for down
    for i = 0 to array.size(levels) - 1
        float f = array.get(levels, i)
        float y = at_pivot + f * span
        array.push(fib_lines, line.new(bar_index, y, bar_index + 1, y, xloc.bar_index, extend.right, color.new(chart.fg_color, fib_transp), fib_style, 1))
        if fib_lbl
            array.push(fib_labels, label.new(bar_index, y, str.tostring(f, '0.0##') + '   ' + str.tostring(y, format.mintick), xloc.bar_index, yloc.price, color(na), label.style_label_left, chart.fg_color, size = size.small, text_font_family = font.family_monospace))

// pin the labels to the right edge so they stay visible as price advances past the reversal
if show_fibs and fib_lbl and array.size(fib_labels) > 0
    for i = 0 to array.size(fib_labels) - 1
        label.set_x(array.get(fib_labels, i), bar_index)

// =====================================================================================
// STRATEGY EXECUTION — DCB reversals drive entries; the ported framework drives exits.
// =====================================================================================
// Snapshot position state for the exit handlers.
updateState(state, global_atr)

// Trade filters: backtest date range AND an active session (or no session enabled).
can_trade = backtest_range.inRange() and anySessionActive(session1, session2, session3)

// ENTRIES — one position at a time (flat only). down_rev → long, up_rev → short.
// process_orders_on_close=true fills the entry on the breakout bar's close.
if strategy.position_size == 0 and can_trade
    if down_rev
        strategy.entry('Long', strategy.long, alert_message = i_alert_long)
    else if up_rev
        strategy.entry('Short', strategy.short, alert_message = i_alert_short)

// EXITS — Risk Settings (SL, trailing stop, breakeven) + Profit Settings (TP, trailing TP).
manageLongExits(state, risk_settings, profit_settings, alert_message = i_alert_exit, atr = global_atr)
manageShortExits(state, risk_settings, profit_settings, alert_message = i_alert_exit, atr = global_atr)

// Session-end and backtest-end closes.
closeOnSessionEnd(session1, session2, session3)
closeOutsideBacktestRange(backtest_range)

// Entry signal plots (connectable as a source/input in another script)
plot(down_rev ? 1 : 0, 'Long Entry Signal', color = color.new(color.lime, 100), display = display.data_window)
plot(up_rev ? 1 : 0, 'Short Entry Signal', color = color.new(color.red, 100), display = display.data_window)

// === Live target readout at the most-recent confirmed projection's endpoint ===
bool target_on = show_target and not na(at_target) and (lbl_price or lbl_points or lbl_pct)
if not target_on
    if not na(at_label)
        at_label.delete()
        at_label := na
else
    float move_pts = math.abs(at_pivot - at_target)                      // full projected move, pivot → target (fixed once confirmed)
    float move_pct = at_pivot != 0 ? move_pts / at_pivot * 100 : 0       // that move as % of price (same basis as the ruler tool)
    string txt = ''
    if lbl_price
        txt += str.tostring(at_target, format.mintick)
    if lbl_points
        txt += (txt != '' ? '\n' : '') + str.tostring(move_pts, format.mintick) + ' pts'
    if lbl_pct
        txt += (txt != '' ? '\n' : '') + str.tostring(move_pct, '#.##') + '%'
    int lx = math.max(bar_index - 9000, math.min(at_bar, bar_index + 480)) // keep on-chart vs bar_index limits
    if na(at_label)
        at_label := label.new(lx, at_target, txt, xloc.bar_index, yloc.price, color(na), label.style_label_left, at_col, size = lbl_size, textalign = text.align_left, text_font_family = font.family_monospace)
    else
        at_label.set_xy(lx, at_target)
        at_label.set_text(txt)
        at_label.set_color(color(na))
        at_label.set_textcolor(at_col)

// === High-water mark: extend each projection's dotted line to its best favorable price ===
// One line per projection (it stays put). Tracking continues until price reaches the projection's
// target price or breaks past the pivot, then the line freezes in place.
if show_hwm and array.size(hwm_dir) > 0
    for i = array.size(hwm_dir) - 1 to 0
        int hdir = array.get(hwm_dir, i)
        float hpiv = array.get(hwm_piv, i)
        float htgt = array.get(hwm_tgt, i)
        int hst = array.get(hwm_start, i)
        float best = array.get(hwm_best, i)
        line hln = array.get(hwm_lines, i)
        float nb = hdir == 1 ? math.max(best, high) : math.min(best, low)
        array.set(hwm_best, i, nb)
        hln.set_xy1(hst, nb)
        hln.set_xy2(bar_index, nb)
        bool broke_pivot = hdir == 1 ? low < hpiv : high > hpiv
        bool reached_tgt = hdir == 1 ? high >= htgt : low <= htgt
        if broke_pivot or reached_tgt
            // freeze the line (leave it drawn) and stop tracking this projection
            array.remove(hwm_dir, i)
            array.remove(hwm_piv, i)
            array.remove(hwm_tgt, i)
            array.remove(hwm_start, i)
            array.remove(hwm_best, i)
            array.remove(hwm_lines, i)

// === Stats: track progress to the predicted bar; finalize on full-target hit or pivot retrace ===
// Up to the ETA, record the best Fib fraction of the move price covered (feeds the reach rows).
// Progress is measured from the pivot: 0.0 = the swing pivot, 1.0 = the full measured-move target.
// A projection resolves when it reaches the full target (on-time if by the ETA, else late) or
// retraces past the pivot first (fail). Target hit takes priority if both happen on one bar.
if show_stats and array.size(p_dir) > 0
    for i = array.size(p_dir) - 1 to 0
        int dir = array.get(p_dir, i)
        float tgt = array.get(p_target, i)
        float piv = array.get(p_pivot, i)
        int eta = array.get(p_eta, i)
        int st = array.get(p_start, i)
        float rl = float(array.get(p_runlen, i))
        float move = dir == 1 ? tgt - piv : piv - tgt              // full measured move, pivot → target
        float prog = move != 0 ? (dir == 1 ? high - piv : piv - low) / move : 0   // Fib fraction reached
        if bar_index <= eta
            array.set(p_maxprog, i, math.max(array.get(p_maxprog, i), prog))
        array.set(p_maxall, i, math.max(array.get(p_maxall, i), prog))
        bool hit = dir == 1 ? high >= tgt : low <= tgt
        bool invalid = dir == 1 ? low < piv : high > piv
        if hit or invalid
            float mp = array.get(p_maxprog, i)
            float ma = array.get(p_maxall, i)
            float f1 = lvl1
            float f2 = lvl2
            float f3 = lvl3
            n_total += 1
            n_ontime += mp >= 1 ? 1 : 0
            n_late += mp < 1 and ma >= 1 ? 1 : 0
            n_fail += ma < 1 ? 1 : 0
            n_h1 += mp >= f1 ? 1 : 0
            n_lt1 += mp < f1 and ma >= f1 ? 1 : 0
            n_h2 += mp >= f2 ? 1 : 0
            n_lt2 += mp < f2 and ma >= f2 ? 1 : 0
            n_h3 += mp >= f3 ? 1 : 0
            n_lt3 += mp < f3 and ma >= f3 ? 1 : 0
            if hit
                array.push(b2t, float(bar_index - st))
                array.push(rl_succ, rl)
            else
                array.push(rl_fail, rl)
            array.remove(p_dir, i)
            array.remove(p_target, i)
            array.remove(p_entry, i)
            array.remove(p_pivot, i)
            array.remove(p_eta, i)
            array.remove(p_start, i)
            array.remove(p_runlen, i)
            array.remove(p_maxprog, i)
            array.remove(p_maxall, i)

// === Stats table (bottom-right): reach × timing matrix ===
pct(int c) => n_total > 0 ? str.tostring(100.0 * c / n_total, '#.#') + '%' : '–'
if show_stats and barstate.islast
    float m_b2t = array.median(b2t)
    float m_rls = array.median(rl_succ)
    float m_rlf = array.median(rl_fail)
    string s_b2t = na(m_b2t) ? '–' : str.tostring(m_b2t, '#.#')
    string s_run = (na(m_rls) ? '–' : str.tostring(m_rls, '#.#')) + ' / ' + (na(m_rlf) ? '–' : str.tostring(m_rlf, '#.#'))
    string lf1 = str.tostring(lvl1, '#.###')
    string lf2 = str.tostring(lvl2, '#.###')
    string lf3 = str.tostring(lvl3, '#.###')
    color win_col = #26a69a
    color late_col = #f0b90b
    color loss_col = #ef5350
    color hdr_col = color.new(chart.fg_color, 35)
    string tip_reach = "Each row is a Fibonacci level of the projected move (1.0 = the full pivot→target measured move)."
    string tip_bybar = "Reached this Fib level of the move on or before the predicted bar."
    string tip_late = "Reached this Fib level after the predicted bar, before any retrace."
    string tip_ever = "Reached this Fib level at all before retracing (by-bar + late)."
    string tip_fail = "Never reached the full target — gave back the move first."
    string tip_b2t = "Median bars from the signal to the full target (wins)."
    string tip_run = "Median run length before the signal — wins / losses."
    string tip_n = "Finished signals counted (in-progress excluded)."
    if na(stats_tbl)
        stats_tbl := table.new(position.bottom_right, 4, 9, bgcolor = color.new(chart.bg_color, 10), frame_color = color.new(chart.fg_color, 60), frame_width = 1, border_color = color.new(chart.fg_color, 80), border_width = 1)
    // header row
    table.cell(stats_tbl, 0, 0, 'Reach', text_color = hdr_col, text_size = size.normal, text_halign = text.align_left, tooltip = tip_reach)
    table.cell(stats_tbl, 1, 0, 'By bar', text_color = hdr_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_bybar)
    table.cell(stats_tbl, 2, 0, 'Late', text_color = hdr_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_late)
    table.cell(stats_tbl, 3, 0, 'Ever', text_color = hdr_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_ever)
    // matrix: 1.0 (full target) then the three configurable Fib levels
    table.cell(stats_tbl, 0, 1, '1.0', text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_reach)
    table.cell(stats_tbl, 1, 1, pct(n_ontime), text_color = win_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_bybar)
    table.cell(stats_tbl, 2, 1, pct(n_late), text_color = late_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_late)
    table.cell(stats_tbl, 3, 1, pct(n_ontime + n_late), text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_ever)
    table.cell(stats_tbl, 0, 2, lf1, text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_reach)
    table.cell(stats_tbl, 1, 2, pct(n_h1), text_color = win_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_bybar)
    table.cell(stats_tbl, 2, 2, pct(n_lt1), text_color = late_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_late)
    table.cell(stats_tbl, 3, 2, pct(n_h1 + n_lt1), text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_ever)
    table.cell(stats_tbl, 0, 3, lf2, text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_reach)
    table.cell(stats_tbl, 1, 3, pct(n_h2), text_color = win_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_bybar)
    table.cell(stats_tbl, 2, 3, pct(n_lt2), text_color = late_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_late)
    table.cell(stats_tbl, 3, 3, pct(n_h2 + n_lt2), text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_ever)
    table.cell(stats_tbl, 0, 4, lf3, text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_reach)
    table.cell(stats_tbl, 1, 4, pct(n_h3), text_color = win_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_bybar)
    table.cell(stats_tbl, 2, 4, pct(n_lt3), text_color = late_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_late)
    table.cell(stats_tbl, 3, 4, pct(n_h3 + n_lt3), text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_ever)
    // footer: headline + context (label left, value far right)
    table.cell(stats_tbl, 0, 5, 'Failed', text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_fail)
    table.cell(stats_tbl, 3, 5, pct(n_fail), text_color = loss_col, text_size = size.normal, text_halign = text.align_right, tooltip = tip_fail)
    table.cell(stats_tbl, 0, 6, 'Bars to target', text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_b2t)
    table.cell(stats_tbl, 3, 6, s_b2t, text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_b2t)
    table.cell(stats_tbl, 0, 7, 'Run W / L', text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_run)
    table.cell(stats_tbl, 3, 7, s_run, text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_run)
    table.cell(stats_tbl, 0, 8, 'Samples', text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_left, tooltip = tip_n)
    table.cell(stats_tbl, 3, 8, str.tostring(n_total), text_color = chart.fg_color, text_size = size.normal, text_halign = text.align_right, tooltip = tip_n)

// =====================================================================================
// POSITION VISUALIZATION (ported Design framework) — entry / stop / target lines,
// trailing & breakeven triggers, live PnL labels, risk/reward fills, session shading.
// =====================================================================================
bool in_position = strategy.position_size != 0
float pos_qty = math.abs(strategy.position_size)
float entry = strategy.position_avg_price
bool is_long = strategy.position_size > 0
float current_profit = is_long ? (risk_settings.trigger_price == 'Current' ? high - entry : close - entry) : (risk_settings.trigger_price == 'Current' ? entry - low : entry - close)

// Persistent state for stop/target (can change during position)
var float viz_stop = na
var float viz_target = na
var float viz_be_trig = na
var float viz_be_lockin = na
var float viz_trail_trig = na
var float viz_trail_tp_trig = na
var float viz_trail_tp_level = na

// Persistent labels (left side - static)
var label lbl_sl = na
var label lbl_tp = na
var label lbl_be_trig = na
var label lbl_trail_trig = na
var label lbl_trail_tp_trig = na

// Persistent labels (right side - live PnL)
var label lbl_pnl = na
var label lbl_sl_pnl = na
var label lbl_tp_pnl = na
var label lbl_be_lockin_pnl = na

// Track trigger activation for visualization
var bool viz_be_triggered = false
var bool viz_trail_triggered = false
var bool viz_trail_tp_triggered = false

bool new_position = strategy.position_size != 0 and strategy.position_size[1] == 0
bool reversed_position = (strategy.position_size > 0 and strategy.position_size[1] < 0) or (strategy.position_size < 0 and strategy.position_size[1] > 0)
bool trade_closed_this_bar = strategy.closedtrades > strategy.closedtrades[1]
bool pyramid_entry = in_position and not new_position and not reversed_position and strategy.position_avg_price != strategy.position_avg_price[1]
bool position_changed = in_position and (new_position or reversed_position or trade_closed_this_bar or pyramid_entry)
bool position_closed = strategy.position_size == 0 and strategy.position_size[1] != 0

formatVal(float val, string unit) =>
    switch unit
        'Dollars' => '$' + str.tostring(val, format.volume)
        'PnL' => '$' + str.tostring(val, format.volume)
        'Percent' => str.tostring(val) + '%'
        'Ticks' => str.tostring(val) + 't'
        'Points' => str.tostring(val) + 'pt'
        => str.tostring(val)

formatPnL(float pnl) =>
    string sign = pnl >= 0 ? '+' : ''
    sign + '$' + str.tostring(math.abs(pnl), format.volume)

// Initialize on new position or reversal
if position_changed
    label.delete(lbl_sl)
    label.delete(lbl_tp)
    label.delete(lbl_be_trig)
    label.delete(lbl_trail_trig)
    label.delete(lbl_trail_tp_trig)
    label.delete(lbl_pnl)
    label.delete(lbl_sl_pnl)
    label.delete(lbl_tp_pnl)
    label.delete(lbl_be_lockin_pnl)
    viz_be_triggered := false
    viz_trail_triggered := false
    viz_trail_tp_triggered := false

    float viz_atr = not na(state.entry_atr) ? state.entry_atr : global_atr
    float sl_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.sl_value).toPrice(entry, pos_qty, viz_atr)
    float tp_dist = UnitConverter.new(profit_settings.tp_unit, profit_settings.tp_value).toPrice(entry, pos_qty, viz_atr)
    float be_act_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.breakeven_activation).toPrice(entry, pos_qty, viz_atr)
    float be_lockin_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.breakeven_profit).toPrice(entry, pos_qty, viz_atr)
    float trail_act_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.trail_activation).toPrice(entry, pos_qty, viz_atr)
    float trail_tp_act_dist = UnitConverter.new(profit_settings.tp_unit, profit_settings.trail_tp_activation).toPrice(entry, pos_qty, viz_atr)

    viz_stop := risk_settings.use_stop_loss ? (is_long ? entry - sl_dist : entry + sl_dist) : na
    viz_target := profit_settings.use_take_profit ? (is_long ? entry + tp_dist : entry - tp_dist) : na
    viz_be_trig := risk_settings.use_breakeven ? (is_long ? entry + be_act_dist : entry - be_act_dist) : na
    viz_be_lockin := risk_settings.use_breakeven ? (is_long ? entry + be_lockin_dist : entry - be_lockin_dist) : na
    viz_trail_trig := risk_settings.use_trailing_stop ? (is_long ? entry + trail_act_dist : entry - trail_act_dist) : na
    viz_trail_tp_trig := profit_settings.use_trailing_tp ? (is_long ? entry + trail_tp_act_dist : entry - trail_tp_act_dist) : na

    log.info('ENTRY {0} @ {1} | SL: {2} | TP: {3} | Qty: {4}', is_long ? 'LONG' : 'SHORT', entry, viz_stop, viz_target, pos_qty)

    if i_show_levels and i_show_labels
        int lbl_x = bar_index - 2
        string sl_txt = i_show_values ? 'SL ' + formatVal(risk_settings.sl_value, risk_settings.sl_unit) : 'SL'
        string tp_txt = i_show_values ? 'TP ' + formatVal(profit_settings.tp_value, profit_settings.tp_unit) : 'TP'
        string be_txt = i_show_values ? 'BE▸ ' + formatVal(risk_settings.breakeven_activation, risk_settings.sl_unit) : 'BE▸'
        string trail_txt = i_show_values ? 'SL▸ ' + formatVal(risk_settings.trail_activation, risk_settings.sl_unit) : 'SL▸'
        string trail_tp_txt = i_show_values ? 'TP▸ ' + formatVal(profit_settings.trail_tp_activation, profit_settings.tp_unit) : 'TP▸'
        if not na(viz_stop)
            lbl_sl := label.new(lbl_x, viz_stop, sl_txt, xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_right, i_color_sl, 12, text.align_left, font.family_monospace)
        if not na(viz_target)
            lbl_tp := label.new(lbl_x, viz_target, tp_txt, xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_right, i_color_tp, 12, text.align_left, font.family_monospace)
        if not na(viz_be_trig) and i_show_triggers
            lbl_be_trig := label.new(lbl_x, viz_be_trig, be_txt, xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_right, i_color_be_trig, 11, text.align_left, font.family_monospace)
        if not na(viz_trail_trig) and i_show_triggers
            lbl_trail_trig := label.new(lbl_x, viz_trail_trig, trail_txt, xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_right, i_color_sl, 11, text.align_left, font.family_monospace)
        if not na(viz_trail_tp_trig) and i_show_triggers
            lbl_trail_tp_trig := label.new(lbl_x, viz_trail_tp_trig, trail_tp_txt, xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_right, i_color_tp, 11, text.align_left, font.family_monospace)

    if i_show_levels and i_show_labels
        float current_pnl = strategy.openprofit
        float sl_pnl = not na(viz_stop) ? (is_long ? viz_stop - entry : entry - viz_stop) * pos_qty * syminfo.pointvalue : na
        float tp_pnl = not na(viz_target) ? (is_long ? viz_target - entry : entry - viz_target) * pos_qty * syminfo.pointvalue : na
        color pnl_color = current_pnl > 0 ? i_color_tp : current_pnl < 0 ? i_color_sl : chart.fg_color
        lbl_pnl := label.new(bar_index + 1, close, formatPnL(current_pnl), xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_left, pnl_color, 12, text.align_right, font.family_monospace)
        if not na(viz_stop)
            lbl_sl_pnl := label.new(bar_index + 1, viz_stop, formatPnL(sl_pnl), xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_left, i_color_sl, 12, text.align_right, font.family_monospace)
        if not na(viz_target)
            lbl_tp_pnl := label.new(bar_index + 1, viz_target, formatPnL(tp_pnl), xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_left, i_color_tp, 12, text.align_right, font.family_monospace)

// Detect trade closure using strategy.closedtrades
bool trade_just_closed = strategy.closedtrades > strategy.closedtrades[1]
float actual_exit_price = trade_just_closed ? strategy.closedtrades.exit_price(strategy.closedtrades - 1) : na
float actual_entry_price = trade_just_closed ? strategy.closedtrades.entry_price(strategy.closedtrades - 1) : na
float actual_pnl = trade_just_closed ? strategy.closedtrades.profit(strategy.closedtrades - 1) : na
bool was_long = trade_just_closed ? strategy.closedtrades.size(strategy.closedtrades - 1) > 0 : false

bool exited_at_loss = false
bool exited_at_profit = false
if trade_just_closed
    if was_long
        exited_at_loss := actual_exit_price < actual_entry_price
        exited_at_profit := actual_exit_price >= actual_entry_price
    else
        exited_at_loss := actual_exit_price > actual_entry_price
        exited_at_profit := actual_exit_price <= actual_entry_price

if trade_just_closed
    string exit_type = exited_at_loss ? 'SL' : 'TP'
    log.info('EXIT {0} @ {1} | Entry: {2} | PnL: {3}', exit_type, actual_exit_price, actual_entry_price, actual_pnl)

bool exit_hit_this_bar = position_closed

// Update stop/target while in position (for trailing/breakeven)
if in_position and not position_changed and not exit_hit_this_bar
    float update_atr = not na(state.entry_atr) ? state.entry_atr : global_atr
    float be_act_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.breakeven_activation).toPrice(entry, pos_qty, update_atr)
    float be_profit_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.breakeven_profit).toPrice(entry, pos_qty, update_atr)

    if risk_settings.use_breakeven and current_profit >= be_act_dist
        viz_stop := is_long ? entry + be_profit_dist : entry - be_profit_dist
        if not viz_be_triggered
            viz_be_triggered := true
            log.info('BE TRIGGERED | Profit: {0} | New SL: {1}', current_profit, viz_stop)

    if state.trail_stop_active and not na(state.current_trail_stop)
        viz_stop := state.current_trail_stop
        if not viz_trail_triggered
            viz_trail_triggered := true
            log.info('TRAIL STOP TRIGGERED | SL now trailing @ {0}', viz_stop)

    if state.trail_tp_active and not na(state.current_trail_tp)
        viz_trail_tp_level := state.current_trail_tp
        if not viz_trail_tp_triggered
            viz_trail_tp_triggered := true
            log.info('TRAIL TP TRIGGERED | TP now trailing @ {0}', viz_trail_tp_level)

// Update right-side PnL labels every bar while in position
if in_position and i_show_levels and i_show_labels
    float current_pnl = strategy.openprofit
    float sl_pnl = not na(viz_stop) ? (is_long ? viz_stop - entry : entry - viz_stop) * pos_qty * syminfo.pointvalue : na
    float tp_level_for_pnl = not na(viz_trail_tp_level) ? viz_trail_tp_level : viz_target
    float tp_pnl = not na(tp_level_for_pnl) ? (is_long ? tp_level_for_pnl - entry : entry - tp_level_for_pnl) * pos_qty * syminfo.pointvalue : na
    float be_lockin_pnl = not na(viz_be_lockin) ? (is_long ? viz_be_lockin - entry : entry - viz_be_lockin) * pos_qty * syminfo.pointvalue : na
    color pnl_color = current_pnl > 0 ? i_color_tp : current_pnl < 0 ? i_color_sl : chart.fg_color

    if not na(lbl_pnl)
        label.set_xy(lbl_pnl, bar_index + 1, close)
        label.set_text(lbl_pnl, formatPnL(current_pnl))
        label.set_textcolor(lbl_pnl, pnl_color)

    if not na(lbl_sl_pnl) and not na(viz_stop)
        label.set_xy(lbl_sl_pnl, bar_index + 1, viz_stop)
        label.set_text(lbl_sl_pnl, formatPnL(sl_pnl))

    if not na(lbl_tp_pnl) and not na(tp_level_for_pnl)
        label.set_xy(lbl_tp_pnl, bar_index + 1, tp_level_for_pnl)
        label.set_text(lbl_tp_pnl, formatPnL(tp_pnl))

    if viz_be_triggered and not na(viz_be_lockin) and i_show_triggers
        if na(lbl_be_lockin_pnl)
            lbl_be_lockin_pnl := label.new(bar_index + 1, viz_be_lockin, formatPnL(be_lockin_pnl), xloc.bar_index, yloc.price, color.new(chart.bg_color, 100), label.style_label_left, i_color_be_trig, 12, text.align_right, font.family_monospace)
        else
            label.set_xy(lbl_be_lockin_pnl, bar_index + 1, viz_be_lockin)
            label.set_text(lbl_be_lockin_pnl, formatPnL(be_lockin_pnl))

// Log position closed (for session close or other non-SL/TP exits)
if position_closed and not exited_at_loss and not exited_at_profit
    log.info('EXIT CLOSED | Entry: {0} | Final PnL: {1}', entry[1], strategy.netprofit - strategy.netprofit[1])

// Delete right-side PnL labels when position closes
if position_closed or exit_hit_this_bar
    label.delete(lbl_pnl)
    label.delete(lbl_sl_pnl)
    label.delete(lbl_tp_pnl)
    label.delete(lbl_be_lockin_pnl)
    lbl_pnl := na
    lbl_sl_pnl := na
    lbl_tp_pnl := na
    lbl_be_lockin_pnl := na

// Reset plot values one bar AFTER exit (use [1] to delay) - but NOT if we just set new values
if exit_hit_this_bar[1] and not position_changed
    viz_stop := na
    viz_target := na
    viz_be_trig := na
    viz_be_lockin := na
    viz_trail_trig := na
    viz_trail_tp_trig := na
    viz_trail_tp_level := na
    viz_be_triggered := false
    viz_trail_triggered := false
    viz_trail_tp_triggered := false

// Plot values - hide on reversal bar (to avoid zigzag), but show on new/reentry position
bool show_viz = in_position and not reversed_position and (new_position or trade_closed_this_bar or pyramid_entry or not exit_hit_this_bar[1])

float plot_entry = show_viz and i_show_levels ? entry : na
float plot_stop = show_viz and i_show_levels ? viz_stop : na
float plot_target = show_viz and i_show_levels ? viz_target : na
float plot_be_trig = show_viz and i_show_levels and i_show_triggers and (not viz_be_triggered or not viz_be_triggered[1]) ? viz_be_trig : na
float plot_be_lockin = show_viz and i_show_levels and i_show_triggers and viz_be_triggered ? viz_be_lockin : na
float plot_be_lockin_fill = show_viz and i_show_levels and i_show_triggers and (not viz_be_triggered or not viz_be_triggered[1]) ? viz_be_lockin : na
float plot_trail_trig = show_viz and i_show_levels and i_show_triggers and (not viz_trail_triggered or not viz_trail_triggered[1]) ? viz_trail_trig : na
float plot_trail_tp_trig = show_viz and i_show_levels and i_show_triggers and (not viz_trail_tp_triggered or not viz_trail_tp_triggered[1]) ? viz_trail_tp_trig : na
float plot_trail_tp_level = show_viz and i_show_levels and viz_trail_tp_triggered ? viz_trail_tp_level : na

p_entry_plot = plot(plot_entry, 'Entry', i_color_entry, 1, plot.style_linebr, linestyle = plot.linestyle_dotted)
p_stop_plot = plot(plot_stop, 'Stop Loss', i_color_sl, 2, plot.style_linebr)
p_target_plot = plot(plot_target, 'Take Profit', i_color_tp, 2, plot.style_linebr)

p_be_trig_plot = plot(plot_be_trig, 'BE Trigger', i_color_be_trig, 1, plot.style_linebr, linestyle = plot.linestyle_dotted)
plot(plot_be_lockin, 'BE Lock-In', i_color_be_trig, 1, plot.style_linebr, linestyle = plot.linestyle_dashed)

plot(plot_trail_trig, 'Trail Trigger', i_color_sl, 1, plot.style_linebr, linestyle = plot.linestyle_dotted)
plot(plot_trail_tp_trig, 'Trail TP Trigger', i_color_tp, 1, plot.style_linebr, linestyle = plot.linestyle_dotted)
plot(plot_trail_tp_level, 'Trail TP Level', i_color_tp, 1, plot.style_linebr, linestyle = plot.linestyle_dashed)

p_be_lockin_fill = plot(plot_be_lockin_fill, 'BE Lock-In Fill', color.new(color.white, 100), 1, plot.style_linebr)

fill(p_entry_plot, p_stop_plot, color.new(i_color_sl, 92), title = 'Risk Zone')
fill(p_entry_plot, p_target_plot, color.new(i_color_tp, 92), title = 'Reward Zone')
fill(p_be_trig_plot, p_be_lockin_fill, color.new(i_color_be_trig, 95), title = 'BE Zone')

// ── Session / backtest background shading ──
any_session_enabled = session1.use or session2.use or session3.use
any_session_active = session1.inSession() or session2.inSession() or session3.inSession()
session_bg_show = i_show_session_bg and any_session_enabled
session_bg_condition = i_session_bg_mode == 'In Session' ? any_session_active : not any_session_active
bgcolor(session_bg_show and session_bg_condition ? color.new(i_session_bg_color, 95) : na, title = 'Session Shading')
bgcolor(backtest_range.use and not backtest_range.inRange() ? color.new(color.gray, 85) : na, title = 'Outside Backtest Range')
