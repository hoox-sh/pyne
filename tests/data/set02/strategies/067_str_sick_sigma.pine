//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}

//@description Detects statistical sigma events (extreme moves) and trades them with configurable direction (mean reversion or momentum).
strategy('[TradersPost] Sick Sigma', 'Sick Sigma', overlay = true, initial_capital = 2000, margin_long = 0, margin_short = 0, use_bar_magnifier = true, calc_on_every_tick = true)

// ============================================================================
// TYPES (from exit-orders framework)
// ============================================================================

//@type Converts values between different unit systems
type UnitConverter
    string unit_type   // 'Dollars' | 'PnL' | 'Percent' | 'Ticks' | 'Points' | 'ATR'
    float value

//@type Risk management settings
type RiskSettings
    bool use_stop_loss = false
    string sl_unit = 'Dollars'
    float sl_value = 100.0
    bool use_trailing_stop = false
    float trail_activation = 50.0
    float trail_offset = 25.0
    bool use_breakeven = false
    float breakeven_activation = 100.0
    float breakeven_profit = 50.0
    string trigger_price = 'Current'

//@type Profit management settings
type ProfitSettings
    bool use_take_profit = false
    string tp_unit = 'Dollars'
    float tp_value = 200.0
    bool use_trailing_tp = false
    float trail_tp_activation = 100.0
    float trail_tp_offset = 50.0
    string trigger_price = 'Current'

//@type Trading session configuration
type SessionSettings
    bool use = false
    string session = '0930-1600'
    string timezone = 'America/New_York'
    bool close_at_end = false

//@type Backtest date range configuration
type BacktestRange
    bool use = false
    int start_time = 0
    int end_time = 0

//@type Entry configuration settings
type EntrySettings
    string direction = 'Both'
    string order_type = 'Market'
    float limit_offset = 0.0
    string limit_offset_unit = 'Ticks'
    string position_mode = 'Single'

//@type Mutable strategy state
type StrategyState
    bool in_long = false
    bool in_short = false
    float entry_price = na
    float entry_atr = na
    float highest_since_entry = na
    float lowest_since_entry = na
    bool trail_stop_active = false
    bool trail_tp_active = false
    bool be_active = false
    float current_trail_stop = na
    float current_trail_tp = na
    float highest_since_trail_tp = na
    float lowest_since_trail_tp = na

// ============================================================================
// METHODS
// ============================================================================

method toPrice(UnitConverter uc, float entry_price, float qty, float atr = na) =>
    float result = 0.0
    switch uc.unit_type
        'Dollars' => result := uc.value
        'PnL' => result := qty > 0 and syminfo.pointvalue > 0 ? uc.value / (qty * syminfo.pointvalue) : 0.0
        'Percent' => result := entry_price * (uc.value / 100)
        'Ticks' => result := uc.value * syminfo.mintick
        'Points' => result := uc.value * syminfo.pointvalue
        'ATR' => result := not na(atr) ? uc.value * atr : 0.0
    result

method toTicks(UnitConverter uc, float entry_price, float qty, float atr = na) =>
    float price_dist = uc.toPrice(entry_price, qty, atr)
    int ticks = math.round(price_dist / syminfo.mintick)
    ticks

method inSession(SessionSettings ss) =>
    ss.use and not na(time(timeframe.period, ss.session, ss.timezone))

method sessionEnded(SessionSettings ss) =>
    if ss.use and ss.close_at_end
        was_in = not na(time(timeframe.period, ss.session, ss.timezone)[1])
        now_out = na(time(timeframe.period, ss.session, ss.timezone))
        (was_in and now_out) or session.islastbar
    else
        false

method inRange(BacktestRange br) =>
    if br.use
        (br.start_time == 0 or time >= br.start_time) and (br.end_time == 0 or time <= br.end_time)
    else
        true

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

updateState(StrategyState state, float atr = na) =>
    state.in_long := strategy.position_size > 0
    state.in_short := strategy.position_size < 0
    if strategy.position_size != 0 and strategy.position_size[1] == 0
        state.entry_price := strategy.position_avg_price
        state.entry_atr := atr
        state.highest_since_entry := high
        state.lowest_since_entry := low
        state.trail_stop_active := false
        state.trail_tp_active := false
        state.be_active := false
        state.current_trail_stop := na
        state.current_trail_tp := na
        state.highest_since_trail_tp := na
        state.lowest_since_trail_tp := na
    if state.in_long
        state.highest_since_entry := math.max(nz(state.highest_since_entry, high), high)
    if state.in_short
        state.lowest_since_entry := math.min(nz(state.lowest_since_entry, low), low)
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        state.entry_price := na
        state.entry_atr := na
        state.highest_since_entry := na
        state.lowest_since_entry := na
        state.trail_stop_active := false
        state.trail_tp_active := false
        state.be_active := false
        state.current_trail_stop := na
        state.current_trail_tp := na
        state.highest_since_trail_tp := na
        state.lowest_since_trail_tp := na
    state

anySessionActive(SessionSettings session1, SessionSettings session2, SessionSettings session3) =>
    any_enabled = session1.use or session2.use or session3.use
    not any_enabled or session1.inSession() or session2.inSession() or session3.inSession()

anySessionEnded(SessionSettings session1, SessionSettings session2, SessionSettings session3) =>
    session1.sessionEnded() or session2.sessionEnded() or session3.sessionEnded()

closeOnSessionEnd(SessionSettings session1, SessionSettings session2, SessionSettings session3, string comment = 'Session End') =>
    if anySessionEnded(session1, session2, session3) and strategy.position_size != 0
        strategy.close_all(comment = comment)

closeOutsideBacktestRange(BacktestRange br, string comment = 'Backtest End') =>
    if br.use and time > br.end_time and strategy.position_size != 0
        strategy.close_all(comment = comment)

enterLong(bool signal, EntrySettings settings, bool can_trade, string entry_id = 'Long', string comment = na, string alert_message = na, float atr = na) =>
    can_long = settings.direction == 'Long' or settings.direction == 'Both'
    can_enter = switch settings.position_mode
        'Single' => strategy.position_size == 0
        'Reversals' => strategy.position_size <= 0
        'Pyramid' => strategy.position_size >= 0
        => strategy.position_size == 0  // default
    bool entered = false
    if signal and can_long and can_enter and can_trade
        if settings.order_type == 'Market'
            strategy.entry(entry_id, strategy.long, comment = comment, alert_message = alert_message)
            entered := true
        else
            limit_uc = UnitConverter.new(settings.limit_offset_unit, settings.limit_offset)
            limit_offset_price = limit_uc.toPrice(close, 1, atr)
            strategy.entry(entry_id, strategy.long, limit = close - limit_offset_price, comment = comment, alert_message = alert_message)
            entered := true
    entered

enterShort(bool signal, EntrySettings settings, bool can_trade, string entry_id = 'Short', string comment = na, string alert_message = na, float atr = na) =>
    can_short = settings.direction == 'Short' or settings.direction == 'Both'
    can_enter = switch settings.position_mode
        'Single' => strategy.position_size == 0
        'Reversals' => strategy.position_size >= 0
        'Pyramid' => strategy.position_size <= 0
        => strategy.position_size == 0  // default
    bool entered = false
    if signal and can_short and can_enter and can_trade
        if settings.order_type == 'Market'
            strategy.entry(entry_id, strategy.short, comment = comment, alert_message = alert_message)
            entered := true
        else
            limit_uc = UnitConverter.new(settings.limit_offset_unit, settings.limit_offset)
            limit_offset_price = limit_uc.toPrice(close, 1, atr)
            strategy.entry(entry_id, strategy.short, limit = close + limit_offset_price, comment = comment, alert_message = alert_message)
            entered := true
    entered

manageLongExits(StrategyState state, RiskSettings risk, ProfitSettings profit, string entry_id = 'Long', string exit_id = 'Long Exit', string sl_comment = 'SL', string tp_comment = 'TP', string trail_comment = 'Trail SL', string trail_tp_comment = 'Trail TP', string be_comment = 'BE', string alert_message = na, float atr = na) =>
    float pos_qty = math.abs(strategy.position_size)
    if state.in_long and pos_qty > 0
        float entry_price = strategy.position_avg_price
        float effective_atr = not na(state.entry_atr) ? state.entry_atr : atr
        float sl_distance = UnitConverter.new(risk.sl_unit, risk.sl_value).toPrice(entry_price, pos_qty, effective_atr)
        float tp_distance = UnitConverter.new(profit.tp_unit, profit.tp_value).toPrice(entry_price, pos_qty, effective_atr)
        float trail_activation_dist = UnitConverter.new(risk.sl_unit, risk.trail_activation).toPrice(entry_price, pos_qty, effective_atr)
        float trail_offset_dist = UnitConverter.new(risk.sl_unit, risk.trail_offset).toPrice(entry_price, pos_qty, effective_atr)
        float trail_tp_activation_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_activation).toPrice(entry_price, pos_qty, effective_atr)
        int trail_tp_offset_ticks = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toTicks(entry_price, pos_qty, effective_atr)
        float be_activation_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_activation).toPrice(entry_price, pos_qty, effective_atr)
        float be_profit_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_profit).toPrice(entry_price, pos_qty, effective_atr)
        float sl_price = entry_price - sl_distance
        float tp_price = entry_price + tp_distance
        float trail_tp_activation_price = entry_price + trail_tp_activation_dist
        float risk_trigger_profit = risk.trigger_price == 'Current' ? high - entry_price : close - entry_price
        float profit_trigger_profit = profit.trigger_price == 'Current' ? high - entry_price : close - entry_price
        if risk.use_trailing_stop and risk_trigger_profit >= trail_activation_dist
            state.trail_stop_active := true
        if state.trail_stop_active
            float new_trail = state.highest_since_entry - trail_offset_dist
            if na(state.current_trail_stop) or new_trail > state.current_trail_stop
                state.current_trail_stop := new_trail
        float trail_tp_offset_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toPrice(entry_price, pos_qty, effective_atr)
        if profit.use_trailing_tp and profit_trigger_profit >= trail_tp_activation_dist
            if not state.trail_tp_active
                state.highest_since_trail_tp := high
            state.trail_tp_active := true
        if state.trail_tp_active
            if high > state.highest_since_trail_tp
                state.highest_since_trail_tp := high
            float new_trail_tp = state.highest_since_trail_tp - trail_tp_offset_dist
            if na(state.current_trail_tp) or new_trail_tp > state.current_trail_tp
                state.current_trail_tp := new_trail_tp
        float effective_stop = na
        string stop_comment = na
        if risk.use_stop_loss
            effective_stop := sl_price
            stop_comment := sl_comment
        float be_stop = entry_price + be_profit_dist
        if risk.use_breakeven and risk_trigger_profit >= be_activation_dist
            state.be_active := true
        if state.be_active
            if na(effective_stop) or be_stop > effective_stop
                effective_stop := be_stop
                stop_comment := be_comment
        if state.trail_stop_active and not na(state.current_trail_stop)
            if na(effective_stop) or state.current_trail_stop > effective_stop
                effective_stop := state.current_trail_stop
                stop_comment := trail_comment
        if profit.use_trailing_tp
            float effective_limit = profit.use_take_profit ? tp_price : na
            strategy.exit(exit_id, from_entry = entry_id, qty_percent = 100, stop = effective_stop, limit = effective_limit, trail_price = trail_tp_activation_price, trail_offset = trail_tp_offset_ticks, comment_loss = stop_comment, comment_profit = tp_comment, comment_trailing = trail_tp_comment, alert_message = alert_message)
        else
            float effective_limit = profit.use_take_profit ? tp_price : na
            if not na(effective_stop) or not na(effective_limit)
                strategy.exit(exit_id, from_entry = entry_id, qty_percent = 100, stop = effective_stop, limit = effective_limit, comment_loss = stop_comment, comment_profit = tp_comment, alert_message = alert_message)

manageShortExits(StrategyState state, RiskSettings risk, ProfitSettings profit, string entry_id = 'Short', string exit_id = 'Short Exit', string sl_comment = 'SL', string tp_comment = 'TP', string trail_comment = 'Trail SL', string trail_tp_comment = 'Trail TP', string be_comment = 'BE', string alert_message = na, float atr = na) =>
    float pos_qty = math.abs(strategy.position_size)
    if state.in_short and pos_qty > 0
        float entry_price = strategy.position_avg_price
        float effective_atr = not na(state.entry_atr) ? state.entry_atr : atr
        float sl_distance = UnitConverter.new(risk.sl_unit, risk.sl_value).toPrice(entry_price, pos_qty, effective_atr)
        float tp_distance = UnitConverter.new(profit.tp_unit, profit.tp_value).toPrice(entry_price, pos_qty, effective_atr)
        float trail_activation_dist = UnitConverter.new(risk.sl_unit, risk.trail_activation).toPrice(entry_price, pos_qty, effective_atr)
        float trail_offset_dist = UnitConverter.new(risk.sl_unit, risk.trail_offset).toPrice(entry_price, pos_qty, effective_atr)
        float trail_tp_activation_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_activation).toPrice(entry_price, pos_qty, effective_atr)
        int trail_tp_offset_ticks = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toTicks(entry_price, pos_qty, effective_atr)
        float be_activation_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_activation).toPrice(entry_price, pos_qty, effective_atr)
        float be_profit_dist = UnitConverter.new(risk.sl_unit, risk.breakeven_profit).toPrice(entry_price, pos_qty, effective_atr)
        float sl_price = entry_price + sl_distance
        float tp_price = entry_price - tp_distance
        float trail_tp_activation_price = entry_price - trail_tp_activation_dist
        float risk_trigger_profit = risk.trigger_price == 'Current' ? entry_price - low : entry_price - close
        float profit_trigger_profit = profit.trigger_price == 'Current' ? entry_price - low : entry_price - close
        if risk.use_trailing_stop and risk_trigger_profit >= trail_activation_dist
            state.trail_stop_active := true
        if state.trail_stop_active
            float new_trail = state.lowest_since_entry + trail_offset_dist
            if na(state.current_trail_stop) or new_trail < state.current_trail_stop
                state.current_trail_stop := new_trail
        if profit.use_trailing_tp and profit_trigger_profit >= trail_tp_activation_dist
            if not state.trail_tp_active
                state.lowest_since_trail_tp := low
            state.trail_tp_active := true
        if state.trail_tp_active
            if low < state.lowest_since_trail_tp
                state.lowest_since_trail_tp := low
            float trail_tp_offset_dist = UnitConverter.new(profit.tp_unit, profit.trail_tp_offset).toPrice(entry_price, pos_qty, effective_atr)
            float new_trail_tp = state.lowest_since_trail_tp + trail_tp_offset_dist
            if na(state.current_trail_tp) or new_trail_tp < state.current_trail_tp
                state.current_trail_tp := new_trail_tp
        float effective_stop = na
        string stop_comment = na
        if risk.use_stop_loss
            effective_stop := sl_price
            stop_comment := sl_comment
        float be_stop = entry_price - be_profit_dist
        if risk.use_breakeven and risk_trigger_profit >= be_activation_dist
            state.be_active := true
        if state.be_active
            if na(effective_stop) or be_stop < effective_stop
                effective_stop := be_stop
                stop_comment := be_comment
        if state.trail_stop_active and not na(state.current_trail_stop)
            if na(effective_stop) or state.current_trail_stop < effective_stop
                effective_stop := state.current_trail_stop
                stop_comment := trail_comment
        if profit.use_trailing_tp
            float effective_limit = profit.use_take_profit ? tp_price : na
            strategy.exit(exit_id, from_entry = entry_id, qty_percent = 100, stop = effective_stop, limit = effective_limit, trail_price = trail_tp_activation_price, trail_offset = trail_tp_offset_ticks, comment_loss = stop_comment, comment_profit = tp_comment, comment_trailing = trail_tp_comment, alert_message = alert_message)
        else
            float effective_limit = profit.use_take_profit ? tp_price : na
            if not na(effective_stop) or not na(effective_limit)
                strategy.exit(exit_id, from_entry = entry_id, qty_percent = 100, stop = effective_stop, limit = effective_limit, comment_loss = stop_comment, comment_profit = tp_comment, alert_message = alert_message)

// ============================================================================
// INPUT GROUPS
// ============================================================================

string g_sigma = 'Sigma Settings'
string g_exit = 'Exit Mode'
string g_global = 'Global Settings'
string g_entry = 'Entry Settings'
string g_risk = 'Risk Settings'
string g_profit = 'Profit Settings'
string g_sessions = 'Sessions'
string g_backtest = 'Backtest Range'
string g_design = 'Design'
string g_alerts = 'Alerts'

// ============================================================================
// SIGMA SETTINGS (core calculation only)
// ============================================================================

i_sigma_threshold = input.float(3.0, 'Sigma Threshold', minval = 0.5, maxval = 10.0, step = 0.5, group = g_sigma, tooltip = 'Entry trigger level in standard deviations from the mean.\n\n• 1σ = ~68% of price action\n• 2σ = ~95% of price action\n• 3σ = ~99.7% of price action\n\nHigher values = fewer but more extreme signals.')
i_sigma_timeframe = input.timeframe('', '└ Timeframe', group = g_sigma, tooltip = 'Timeframe for calculating mean and standard deviation.\n\nLeave empty to use chart timeframe.\n\nExample: Use "1D" on a 2H chart to calculate sigma bands from daily data.')
i_max_sigma = input.float(10.0, '└ Max Sigma', minval = 1.0, maxval = 10.0, step = 0.5, group = g_sigma, tooltip = 'Highest sigma level to display on the chart.\n\nBands will be drawn from 0 (mean) up to this level.\n\nSet higher than your entry threshold to see context beyond entry points.')
i_num_bands = input.int(5, '└ Number of Bands', minval = 1, maxval = 10, group = g_sigma, tooltip = 'How many sigma bands to draw between 0 and Max Sigma.\n\nExample: Max=10, Bands=5 draws lines at 2σ, 4σ, 6σ, 8σ, and 10σ.')
i_calc_mode = input.string('All History', 'Calculation Mode', options = ['Rolling', 'All History'], group = g_sigma, tooltip = 'How to calculate mean and standard deviation:\n\n• All History: Uses entire chart history for stable, slowly-adapting bands\n\n• Rolling: Uses recent bars only (set by Lookback Period) for faster-adapting bands')
i_lookback_period = input.int(20, '└ Lookback Period', minval = 5, maxval = 200, group = g_sigma, tooltip = 'Number of bars to use for Rolling mode calculation.\n\nOnly applies when Calculation Mode = Rolling.\n\nSmaller = more reactive bands\nLarger = smoother, more stable bands')

// ============================================================================
// EXIT MODE SETTINGS
// ============================================================================

i_exit_mode = input.string('Price Crosses Mean', 'Exit Mode', options = ['Price Crosses Mean', 'First Pullback', 'Band Trailing', 'Band Slope Reversal', 'Bars Since Entry'], group = g_exit, tooltip = 'Primary exit condition:\n\n• Price Crosses Mean: Exit when price returns to the mean line\n\n• First Pullback: Exit on first candle that closes against the trade\n\n• Band Trailing: Exit when price closes back inside the entry band\n\n• Band Slope Reversal: Exit when band slope reverses + price confirms\n\n• Bars Since Entry: Exit after a fixed number of bars')
i_exit_bars = input.int(10, '└ Exit After Bars', minval = 1, maxval = 100, group = g_exit, tooltip = 'Number of bars to hold position before exiting.\n\nOnly applies when Exit Mode = Bars Since Entry.')
i_use_band_exit = input.bool(true, 'Use Band Exit', inline = 'bandexit', group = g_exit, tooltip = 'Additional exit trigger based on sigma band levels.\n\nWorks alongside Exit Mode (OR logic) - whichever triggers first closes the trade.\n\nExample: Enter at 3σ, exit at 2σ when price pulls back.')
i_exit_band_offset = input.float(1.0, '', minval = 0.5, maxval = 5.0, step = 0.5, inline = 'bandexit', group = g_exit, tooltip = 'Sigma levels below entry threshold to trigger exit.\n\nExit Band = Entry Threshold - Offset\n\nExample: Threshold=2, Offset=1 → exits at 1σ band')

// ============================================================================
// GLOBAL SETTINGS
// ============================================================================

i_global_unit = input.string('PnL', 'Default Unit', options = ['Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], group = g_global, tooltip = 'Default measurement unit for SL/TP when set to "Global":\n\n• Dollars: Price distance ($10 = $10 move)\n• PnL: Profit/loss in account currency\n• Percent: % of entry price\n• Ticks: Minimum price increments\n• Points: Contract point value\n• ATR: Multiples of Average True Range')
i_atr_period = input.int(14, 'ATR Period', minval = 1, group = g_global, tooltip = 'Period for Average True Range calculation.\n\nUsed when any setting uses ATR as its unit.\n\n14 is the standard default.')
i_global_tz = input.string('America/New_York', 'Timezone', options = ['America/New_York', 'America/Chicago', 'America/Los_Angeles', 'Europe/London', 'Europe/Berlin', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Asia/Singapore', 'Australia/Sydney', 'UTC'], group = g_global, tooltip = 'Timezone for session time calculations.\n\nAffects when trading sessions start/end.')
i_trigger_price = input.string('Current', 'Trigger Price', options = ['Current', 'Close'], group = g_global, tooltip = 'Which price activates trailing stops and breakeven:\n\n• Current: Uses high/low of current bar (more responsive)\n\n• Close: Only triggers on bar close (avoids wicks)')

global_atr = ta.atr(i_atr_period)

resolveUnit(string unit) => unit == 'Global' ? i_global_unit : unit

// ============================================================================
// BACKTEST RANGE
// ============================================================================

i_use_backtest_range = input.bool(false, 'Use Date Range', inline = 'bt', group = g_backtest, tooltip = 'Limit backtest to specific date range.\n\nUseful for testing on recent data or specific market conditions.')
i_backtest_preset = input.string('Custom', '', options = ['Last 7 Days', 'This Month', 'This Quarter', 'This Year', 'Custom'], inline = 'bt', group = g_backtest, active = i_use_backtest_range, tooltip = 'Quick date range presets:\n\n• Last 7 Days: Rolling week\n• This Month/Quarter/Year: Calendar periods\n• Custom: Set specific start/end dates')
i_backtest_start = input.time(timestamp('01 Jan 2020 00:00 +0000'), 'Start Date', group = g_backtest, active = i_use_backtest_range and i_backtest_preset == 'Custom', tooltip = 'Backtest start date.\n\nOnly applies when preset = Custom.')
i_backtest_end = input.time(timestamp('31 Dec 2030 23:59 +0000'), 'End Date', group = g_backtest, active = i_use_backtest_range and i_backtest_preset == 'Custom', tooltip = 'Backtest end date.\n\nOnly applies when preset = Custom.')

getBacktestStart() =>
    int result = i_backtest_start
    if i_backtest_preset == 'Last 7 Days'
        result := timenow - 7 * 24 * 60 * 60 * 1000
    else if i_backtest_preset == 'This Month'
        result := timestamp(year(timenow), month(timenow), 1, 0, 0, 0)
    else if i_backtest_preset == 'This Quarter'
        int q_month = month(timenow) <= 3 ? 1 : month(timenow) <= 6 ? 4 : month(timenow) <= 9 ? 7 : 10
        result := timestamp(year(timenow), q_month, 1, 0, 0, 0)
    else if i_backtest_preset == 'This Year'
        result := timestamp(year(timenow), 1, 1, 0, 0, 0)
    result

backtest_start = getBacktestStart()
backtest_end = i_backtest_preset == 'Custom' ? i_backtest_end : timenow
backtest_range = BacktestRange.new(i_use_backtest_range, backtest_start, backtest_end)

// ============================================================================
// ENTRY SETTINGS
// ============================================================================

i_direction = input.string('Both', 'Direction', options = ['Long', 'Short', 'Both'], inline = 'dir', group = g_entry, tooltip = 'Which trade directions to allow:\n\n• Long: Only buy signals\n• Short: Only sell signals\n• Both: Trade in both directions')
i_order_type = input.string('Market', '', options = ['Market', 'Limit'], inline = 'dir', group = g_entry, tooltip = 'Order type for entries:\n\n• Market: Enter immediately at current price\n• Limit: Enter at a better price (offset from signal)')
i_color_entry = input.color(color.gray, '', inline = 'dir', group = g_entry)
i_trade_style = input.string('Momentum', 'Trade Style', options = ['Momentum', 'Mean Reversion'], group = g_entry, tooltip = 'How to interpret sigma band crosses:\n\n• Momentum: Trade WITH the move\n  → Long when price breaks above upper band\n  → Short when price breaks below lower band\n\n• Mean Reversion: Trade AGAINST the move\n  → Short when price breaks above upper band (expect reversion)\n  → Long when price breaks below lower band (expect bounce)')
i_limit_offset = input.float(5, '└ Limit Offset', minval = 0, step = 0.5, inline = 'limit', group = g_entry, active = i_order_type == 'Limit', tooltip = 'Distance from signal price for limit order.\n\nFor longs: Limit = Signal Price - Offset\nFor shorts: Limit = Signal Price + Offset')
i_limit_offset_unit = input.string('Ticks', '', options = ['Dollars', 'Percent', 'Ticks', 'Points', 'ATR'], inline = 'limit', group = g_entry, active = i_order_type == 'Limit')
i_position_mode = input.string('Single', 'Position Mode', options = ['Single', 'Reversals', 'Pyramid'], group = g_entry, tooltip = 'How to handle multiple signals:\n\n• Single: One position at a time, wait for exit\n\n• Reversals: Flip direction on opposite signal\n\n• Pyramid: Add to position on same-direction signals')

entry_settings = EntrySettings.new(i_direction, i_order_type, i_limit_offset, i_limit_offset_unit, i_position_mode)

// ============================================================================
// RISK SETTINGS
// ============================================================================

i_use_sl = input.bool(false, 'Use Stop Loss', inline = 'sl', group = g_risk, tooltip = 'Enable fixed stop loss to limit maximum loss per trade.')
i_sl_value = input.float(200, '', minval = 0.01, step = 0.5, inline = 'sl', group = g_risk, active = i_use_sl, tooltip = 'Stop loss distance from entry price.\n\nUses the unit selected to the right (or Global default).')
i_sl_unit = input.string('Global', '', options = ['Global', 'Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], inline = 'sl', group = g_risk, active = i_use_sl)
i_color_sl = input.color(color.red, '', inline = 'sl', group = g_risk)

i_use_trail = input.bool(false, '└ Trailing  ›', inline = 'trail', group = g_risk, tooltip = 'Enable trailing stop that follows price to lock in profits.\n\nActivates after price moves favorably by Trigger amount, then trails at Offset distance.')
i_trail_activation = input.float(500, 'Trigger', minval = 0, step = 0.5, inline = 'trail', group = g_risk, active = i_use_trail, tooltip = 'Profit required to activate trailing stop.\n\nUses same unit as Stop Loss.')
i_trail_offset = input.float(250, 'Offset', minval = 0.01, step = 0.5, inline = 'trail', group = g_risk, active = i_use_trail, tooltip = 'Distance trailing stop follows behind price.\n\nSmaller = tighter trail, more likely to be stopped out\nLarger = looser trail, gives more room')

i_use_breakeven = input.bool(false, '└ BE  ›', inline = 'be', group = g_risk, tooltip = 'Move stop loss to breakeven (or small profit) after reaching trigger.\n\nProtects against giving back gains on winning trades.')
i_breakeven_activation = input.float(1000, 'Trigger', minval = 0, step = 0.5, inline = 'be', group = g_risk, active = i_use_breakeven, tooltip = 'Profit required before moving stop to breakeven.\n\nUses same unit as Stop Loss.')
i_breakeven_profit = input.float(500, 'Lock In', minval = 0, step = 0.5, inline = 'be', group = g_risk, active = i_use_breakeven, tooltip = 'Small profit to lock in when breakeven activates.\n\nSet to 0 for true breakeven, or positive value to guarantee profit.')
i_color_be_trig = input.color(#ff9900ba, '', inline = 'be', group = g_risk)

risk_settings = RiskSettings.new(i_use_sl, resolveUnit(i_sl_unit), i_sl_value, i_use_trail, i_trail_activation, i_trail_offset, i_use_breakeven, i_breakeven_activation, i_breakeven_profit, i_trigger_price)

// ============================================================================
// PROFIT SETTINGS
// ============================================================================

i_use_tp = input.bool(false, 'Use Take Profit', inline = 'tp', group = g_profit, tooltip = 'Enable fixed take profit to automatically exit at target.')
i_tp_value = input.float(200, '', minval = 0.01, step = 0.5, inline = 'tp', group = g_profit, active = i_use_tp, tooltip = 'Take profit distance from entry price.\n\nUses the unit selected to the right (or Global default).')
i_tp_unit = input.string('Global', '', options = ['Global', 'Dollars', 'PnL', 'Percent', 'Ticks', 'Points', 'ATR'], inline = 'tp', group = g_profit, active = i_use_tp)
i_color_tp = input.color(color.green, '', inline = 'tp', group = g_profit)

i_use_trail_tp = input.bool(false, '└ Trailing  ›', inline = 'trail_tp', group = g_profit, tooltip = 'Enable trailing take profit that rises with price.\n\nLets winners run while locking in gains.\n\nActivates after reaching Trigger, then trails at Offset distance.')
i_trail_tp_activation = input.float(1000, 'Trigger', minval = 0, step = 0.5, inline = 'trail_tp', group = g_profit, active = i_use_trail_tp, tooltip = 'Profit required to activate trailing take profit.\n\nUses same unit as Take Profit.')
i_trail_tp_offset = input.float(500, 'Offset', minval = 0.01, step = 0.5, inline = 'trail_tp', group = g_profit, active = i_use_trail_tp, tooltip = 'Distance trailing TP follows behind highest profit.\n\nIf price pulls back this much from peak, position closes.')

profit_settings = ProfitSettings.new(i_use_tp, resolveUnit(i_tp_unit), i_tp_value, i_use_trail_tp, i_trail_tp_activation, i_trail_tp_offset, i_trigger_price)

// ============================================================================
// SESSION SETTINGS
// ============================================================================

i_use_session1 = input.bool(false, 'Session 1', inline = 's1', group = g_sessions, tooltip = 'Enable trading session filter.\n\nWhen enabled, trades only occur during defined session times.\n\nTime format: HHMM-HHMM (24hr)\n\nUses timezone from Global Settings.')
i_session1 = input.session('0930-1600', '', inline = 's1', group = g_sessions, active = i_use_session1)
i_session1_close = input.bool(false, 'Close', inline = 's1', group = g_sessions, active = i_use_session1, tooltip = 'Close all positions when this session ends.')

i_use_session2 = input.bool(false, 'Session 2', inline = 's2', group = g_sessions, tooltip = 'Enable second trading session.\n\nUseful for trading multiple sessions (e.g., NY + Asia).')
i_session2 = input.session('1900-0400', '', inline = 's2', group = g_sessions, active = i_use_session2)
i_session2_close = input.bool(false, 'Close', inline = 's2', group = g_sessions, active = i_use_session2, tooltip = 'Close all positions when this session ends.')

i_use_session3 = input.bool(false, 'Session 3', inline = 's3', group = g_sessions, tooltip = 'Enable third trading session.')
i_session3 = input.session('0300-1100', '', inline = 's3', group = g_sessions, active = i_use_session3)
i_session3_close = input.bool(false, 'Close', inline = 's3', group = g_sessions, active = i_use_session3, tooltip = 'Close all positions when this session ends.')

session1 = SessionSettings.new(i_use_session1, i_session1, i_global_tz, i_session1_close)
session2 = SessionSettings.new(i_use_session2, i_session2, i_global_tz, i_session2_close)
session3 = SessionSettings.new(i_use_session3, i_session3, i_global_tz, i_session3_close)

// ============================================================================
// DESIGN SETTINGS
// ============================================================================

i_show_bands = input.bool(true, 'Show Sigma Bands', group = g_design, tooltip = 'Display sigma bands on the chart.\n\nBands show standard deviation levels from the mean.\n\nUseful for visualizing where entries/exits trigger.')
i_band_color = input.color(color.blue, '└ Band Color', group = g_design, tooltip = 'Color for sigma band lines.')
i_show_debug = input.bool(false, 'Show Debug Panel', group = g_design, tooltip = 'Display debug table with current values:\n\n• Price\n• Mean\n• Upper/Lower sigma levels\n• Current signal state\n\nUseful for understanding strategy behavior.')

// ============================================================================
// ALERT MESSAGES
// ============================================================================

i_alert_long_raw = input.text_area('', 'Long Entry', group = g_alerts, tooltip = 'Custom alert message for long entries.\n\nLeave empty to use default.\n\nSupports TradingView placeholders like {{ticker}}, {{close}}, etc.\n\nFor TradersPost: paste your webhook JSON here.')
i_alert_short_raw = input.text_area('', 'Short Entry', group = g_alerts, tooltip = 'Custom alert message for short entries.\n\nLeave empty to use default.\n\nSupports TradingView placeholders.')
i_alert_exit_raw = input.text_area('', 'Exit', group = g_alerts, tooltip = 'Custom alert message for all exits.\n\nLeave empty to use default.\n\nSent for SL, TP, and signal-based exits.')

i_alert_long = i_alert_long_raw == '' ? na : i_alert_long_raw
i_alert_short = i_alert_short_raw == '' ? na : i_alert_short_raw
i_alert_exit = i_alert_exit_raw == '' ? na : i_alert_exit_raw

// ============================================================================
// SIGMA BAND CALCULATION
// ============================================================================

// Cumulative price statistics (for All History mode)
var float priceCumSum = 0.0
var float priceCumSumSq = 0.0
var int priceCumCount = 0

priceCumCount += 1
priceCumSum += close
priceCumSumSq += close * close

priceCumMean = priceCumCount > 0 ? priceCumSum / priceCumCount : close
priceCumVariance = priceCumCount > 1 ? (priceCumSumSq / priceCumCount) - (priceCumMean * priceCumMean) : 0.0
priceCumStdev = math.sqrt(math.max(priceCumVariance, 0))

// Calculate bands for current timeframe (rolling mode)
calcSigmaBands() =>
    float pMean = ta.sma(close, i_lookback_period)
    float pStdev = ta.stdev(close, i_lookback_period)
    [pMean, pStdev]

// Get mean and stdev based on calculation mode (gaps_off for calculations)
[priceMean, priceStdev] = if i_calc_mode == 'All History'
    [priceCumMean, priceCumStdev]
else if i_sigma_timeframe == ''
    calcSigmaBands()
else
    request.security(syminfo.tickerid, i_sigma_timeframe, calcSigmaBands(), lookahead = barmerge.lookahead_off)

// Get mean and stdev for plotting (gaps_on for smooth visuals)
[priceMean_plot, priceStdev_plot] = if i_calc_mode == 'All History'
    [priceCumMean, priceCumStdev]
else if i_sigma_timeframe == ''
    calcSigmaBands()
else
    request.security(syminfo.tickerid, i_sigma_timeframe, calcSigmaBands(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_on)

// Calculate sigma bands (for calculations)
upperSigma = priceMean + priceStdev * i_sigma_threshold
lowerSigma = priceMean - priceStdev * i_sigma_threshold

// Calculate sigma bands (for plotting)
upperSigma_plot = priceMean_plot + priceStdev_plot * i_sigma_threshold
lowerSigma_plot = priceMean_plot - priceStdev_plot * i_sigma_threshold

// Entry signals: price crossing sigma bands
priceAboveUpper = close > upperSigma
priceBelowLower = close < lowerSigma

// Crossover detection
crossAboveUpper = priceAboveUpper and not priceAboveUpper[1]  // Price crosses above upper band
crossBelowLower = priceBelowLower and not priceBelowLower[1]  // Price crosses below lower band

// Apply trade style logic
// Momentum: trade with the move (long on upper cross, short on lower cross)
// Mean Reversion: trade against the move (short on upper cross, long on lower cross)
long_signal = i_trade_style == 'Momentum' ? crossAboveUpper : crossBelowLower
short_signal = i_trade_style == 'Momentum' ? crossBelowLower : crossAboveUpper

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

var StrategyState state = StrategyState.new()
updateState(state, global_atr)

can_trade = backtest_range.inRange() and anySessionActive(session1, session2, session3)

// Entries - simple direct calls
if long_signal and strategy.position_size == 0
    strategy.entry('Long', strategy.long, alert_message = i_alert_long)
if short_signal and strategy.position_size == 0
    strategy.entry('Short', strategy.short, alert_message = i_alert_short)

// Exits
manageLongExits(state, risk_settings, profit_settings, alert_message = i_alert_exit, atr = global_atr)
manageShortExits(state, risk_settings, profit_settings, alert_message = i_alert_exit, atr = global_atr)

// Track bars since entry
var int barsSinceEntry = 0
if strategy.position_size != 0 and strategy.position_size[1] == 0
    barsSinceEntry := 0
else if strategy.position_size != 0
    barsSinceEntry += 1

// Exit conditions for each mode
// 1. Price Crosses Mean: exit when price closes on wrong side of mean
exitLong_mean = close < priceMean
exitShort_mean = close > priceMean

// 2. First Pullback: exit on first opposing candle close
exitLong_pullback = close < low[1]
exitShort_pullback = close > high[1]

// 3. Band Trailing: exit when price closes inside the bands
exitLong_band = close < upperSigma
exitShort_band = close > lowerSigma

// 4. Band Slope Reversal: exit when band slope reverses + price confirms
upperBandSlope = upperSigma - upperSigma[1]
lowerBandSlope = lowerSigma - lowerSigma[1]
exitLong_slope = upperBandSlope < 0 and close < low[1]
exitShort_slope = lowerBandSlope > 0 and close > high[1]

// 5. Bars Since Entry: exit after N bars
exitLong_bars = barsSinceEntry >= i_exit_bars
exitShort_bars = barsSinceEntry >= i_exit_bars

// 6. Band Exit: exit when price crosses a lower sigma band
// Calculate exit band level (entry sigma - offset)
float exitSigmaLevel = i_sigma_threshold - i_exit_band_offset
float exitBandLong = priceMean + priceStdev * exitSigmaLevel   // For longs: exit when drops to this band
float exitBandShort = priceMean - priceStdev * exitSigmaLevel  // For shorts: exit when rises to this band
exitLong_bandLevel = i_use_band_exit and close < exitBandLong
exitShort_bandLevel = i_use_band_exit and close > exitBandShort

// Select exit based on mode
exitLong = switch i_exit_mode
    'Price Crosses Mean' => exitLong_mean
    'First Pullback' => exitLong_pullback
    'Band Trailing' => exitLong_band
    'Band Slope Reversal' => exitLong_slope
    'Bars Since Entry' => exitLong_bars
    => false

exitShort = switch i_exit_mode
    'Price Crosses Mean' => exitShort_mean
    'First Pullback' => exitShort_pullback
    'Band Trailing' => exitShort_band
    'Band Slope Reversal' => exitShort_slope
    'Bars Since Entry' => exitShort_bars
    => false

// Apply exits (mode exit OR band exit - whichever triggers first)
if strategy.position_size > 0 and (exitLong or exitLong_bandLevel)
    string exitComment = exitLong_bandLevel and not exitLong ? 'Band Exit' : i_exit_mode
    strategy.close('Long', comment = exitComment, alert_message = i_alert_exit)
if strategy.position_size < 0 and (exitShort or exitShort_bandLevel)
    string exitComment = exitShort_bandLevel and not exitShort ? 'Band Exit' : i_exit_mode
    strategy.close('Short', comment = exitComment, alert_message = i_alert_exit)

// Session/backtest closes
closeOnSessionEnd(session1, session2, session3)
closeOutsideBacktestRange(backtest_range)

// ============================================================================
// VISUALIZATION
// ============================================================================

// ============================================================================
// SIGMA BAND VISUALIZATION
// ============================================================================

// Plot mean line (using gaps_on version for smooth visuals)
plot(priceMean_plot, 'Mean', color.orange, 1)

// Store mean/stdev values incrementally (no historical reference needed)
// Limit to 10000 points (polyline maximum)
var array<float> storedMean = array.new<float>()
var array<float> storedStdev = array.new<float>()
var array<int> storedTime = array.new<int>()
int maxPolylinePoints = 10000

// Add current bar's values to arrays (using gaps_on version for smooth bands)
if not na(priceMean_plot) and not na(priceStdev_plot)
    array.push(storedMean, priceMean_plot)
    array.push(storedStdev, priceStdev_plot)
    array.push(storedTime, time)
    // Keep arrays at max size by removing oldest points
    if array.size(storedMean) > maxPolylinePoints
        array.shift(storedMean)
        array.shift(storedStdev)
        array.shift(storedTime)

// Dynamic polyline bands
var array<polyline> bandPolylines = array.new<polyline>()
var array<label> bandLabels = array.new<label>()

sigmaStep = i_max_sigma / i_num_bands

if barstate.islast and i_show_bands
    // Delete old polylines and labels
    for pl in bandPolylines
        polyline.delete(pl)
    array.clear(bandPolylines)

    for lbl in bandLabels
        label.delete(lbl)
    array.clear(bandLabels)

    int numPoints = array.size(storedMean)

    // Create polylines for each band level
    for bandNum = 1 to i_num_bands
        float sigmaLevel = sigmaStep * bandNum

        // Create point arrays for upper and lower bands
        var upperPoints = array.new<chart.point>()
        var lowerPoints = array.new<chart.point>()
        array.clear(upperPoints)
        array.clear(lowerPoints)

        // Build points from stored values (no historical reference!)
        for i = 0 to numPoints - 1
            float meanVal = array.get(storedMean, i)
            float stdevVal = array.get(storedStdev, i)
            int timeVal = array.get(storedTime, i)

            float upperPrice = meanVal + stdevVal * sigmaLevel
            float lowerPrice = meanVal - stdevVal * sigmaLevel

            array.push(upperPoints, chart.point.from_time(timeVal, upperPrice))
            array.push(lowerPoints, chart.point.from_time(timeVal, lowerPrice))

        // Create polylines
        if array.size(upperPoints) > 1
            array.push(bandPolylines, polyline.new(upperPoints, xloc = xloc.bar_time, line_color = i_band_color, line_style = line.style_dotted, line_width = 2))
            array.push(bandPolylines, polyline.new(lowerPoints, xloc = xloc.bar_time, line_color = i_band_color, line_style = line.style_dotted, line_width = 2))

        // Create labels (use _plot versions for visual consistency)
        float currentUpper = priceMean_plot + priceStdev_plot * sigmaLevel
        float currentLower = priceMean_plot - priceStdev_plot * sigmaLevel
        string sigmaText = str.tostring(sigmaLevel, '#.##') + 'σ'

        array.push(bandLabels, label.new(bar_index + 7, currentUpper, '+' + sigmaText, style = label.style_none, textcolor = chart.fg_color, size = size.normal))
        array.push(bandLabels, label.new(bar_index + 7, currentLower, '-' + sigmaText, style = label.style_none, textcolor = chart.fg_color, size = size.normal))

// ============================================================================
// POSITION LEVEL PLOTS
// ============================================================================

bool in_position = strategy.position_size != 0
float entry_price = strategy.position_avg_price
bool is_long = strategy.position_size > 0
float pos_qty = math.abs(strategy.position_size)
float effective_atr = not na(state.entry_atr) ? state.entry_atr : global_atr

float sl_dist = UnitConverter.new(risk_settings.sl_unit, risk_settings.sl_value).toPrice(entry_price, pos_qty, effective_atr)
float tp_dist = UnitConverter.new(profit_settings.tp_unit, profit_settings.tp_value).toPrice(entry_price, pos_qty, effective_atr)

float plot_entry = in_position ? entry_price : na
float plot_sl = in_position and risk_settings.use_stop_loss ? (is_long ? entry_price - sl_dist : entry_price + sl_dist) : na
float plot_tp = in_position and profit_settings.use_take_profit ? (is_long ? entry_price + tp_dist : entry_price - tp_dist) : na

p_entry = plot(plot_entry, 'Entry', color.gray, 1, plot.style_linebr)
p_sl = plot(plot_sl, 'Stop Loss', color.red, 2, plot.style_linebr)
p_tp = plot(plot_tp, 'Take Profit', color.green, 2, plot.style_linebr)

fill(p_entry, p_sl, color.new(color.red, 90), title = 'Risk Zone')
fill(p_entry, p_tp, color.new(color.green, 90), title = 'Reward Zone')

// ============================================================================
// DEBUG PANEL
// ============================================================================

var table debugTable = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast and i_show_debug
    table.cell(debugTable, 0, 0, 'Price', text_color = color.white, text_size = size.small)
    table.cell(debugTable, 1, 0, str.tostring(close, '#.##'), text_color = color.white, text_size = size.small)

    table.cell(debugTable, 0, 1, 'Mean', text_color = color.white, text_size = size.small)
    table.cell(debugTable, 1, 1, str.tostring(priceMean, '#.##'), text_color = color.white, text_size = size.small)

    table.cell(debugTable, 0, 2, 'Upper σ', text_color = color.white, text_size = size.small)
    table.cell(debugTable, 1, 2, str.tostring(upperSigma, '#.##'), text_color = color.green, text_size = size.small)

    table.cell(debugTable, 0, 3, 'Lower σ', text_color = color.white, text_size = size.small)
    table.cell(debugTable, 1, 3, str.tostring(lowerSigma, '#.##'), text_color = color.red, text_size = size.small)

    table.cell(debugTable, 0, 4, 'Signal', text_color = color.white, text_size = size.small)
    string signalText = long_signal ? 'LONG' : short_signal ? 'SHORT' : priceAboveUpper ? 'Above +σ' : priceBelowLower ? 'Below -σ' : 'In Range'
    color signalColor = long_signal ? color.green : short_signal ? color.red : priceAboveUpper or priceBelowLower ? color.yellow : color.gray
    table.cell(debugTable, 1, 4, signalText, text_color = signalColor, text_size = size.small)
