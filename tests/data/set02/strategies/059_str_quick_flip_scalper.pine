// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/projects/quick-flip-scalper.pine
// content_hash: f7ba1683ac360243
// collected: 2026-07-27
// built with PineScript Agents by TradersPost
//@version=6
// =============================================================================
// QUICK FLIP SCALPER  ("ONE CANDLE" opening-range liquidity fade)
// Source concept: ProRealAlgos / Carl  — https://youtu.be/XFtayhPIdEs
//
// The first N minutes after the session open often print a fast, aggressive
// "liquidity / manipulation" candle that traps retail and lets institutions
// fill size. The edge is FADING it:
//   1. Box the opening-range (OR) candle (first 15 min) and extend it forward.
//   2. Confirm it is a liquidity candle: OR range >= 25% of the DAILY ATR(14).
//   3. Fade it. Green OR -> look for a BEARISH reversal ABOVE the box (short).
//                Red   OR -> look for a BULLISH reversal BELOW the box (long).
//      Reversal = hammer / inverted-hammer or engulfing, within 90 min of open.
//      Stop = reversal candle extreme.  Target = far side of the box.
//
// DESIGN / NON-REPAINT NOTES
//   * Runs overlay=false: the ATR + liquidity-threshold oscillator lives in a
//     bottom pane, while every price-chart drawing (OR box, window box, signals,
//     stop/target, table) uses force_overlay=true to render on the main chart.
//   * Intended to run on a <= 5-min chart (a warning shows otherwise).
//   * Daily ATR uses the PRIOR completed daily bar -> known at the open, no repaint.
//   * OR is finalized only after the window closes; patterns confirm on bar close;
//     market entries fill next bar -> no lookahead.
//
// LIMITATIONS (read before trusting the backtest)
//   * Candle "quality" is discretionary in the video; here it is approximated
//     with tunable wick/body ratios and will not perfectly match a human eye.
//   * Session is fully generic: YOU set the open. For NQ/ES RTH use 0930-1600;
//     for the pre-open variant use 0915-1600. Futures pre-open behaves
//     differently than the CFD example in the video.
//   * Assumes an intraday execution timeframe; daily-ATR + OR logic is
//     meaningless on daily-or-higher charts.
// =============================================================================
//@strategy_alert_message {{strategy.order.alert_message}}
strategy("Quick Flip Scalper",
     shorttitle="QFS",
     overlay=false,
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     calc_on_order_fills=false,
     process_orders_on_close=false,
     max_boxes_count=500,
     max_labels_count=500,
     max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================
// --- Session ---------------------------------------------------------------
sessionInput = input.session("0930-1600", "Session",
     tooltip="Trading session that defines the open. NQ/ES RTH = 0930-1600. " +
     "For the video's pre-open variant use 0915-1600.",
     group="Session")
tzInput = input.string("America/New_York", "Time Zone",
     tooltip="IANA time zone for the session (e.g. America/New_York, America/Chicago, Europe/London).",
     group="Session")
orTF = input.timeframe("15", "Opening-Range Timeframe",
     options=["1", "2", "3", "5", "10", "15", "30", "45", "60", "120", "240"],
     tooltip="The liquidity candle = the first candle of this timeframe after the open " +
     "(video default = 15). The range is measured from your real session open, so it " +
     "stays correct even with a non-standard open like 0915.",
     group="Session")
// Convert the selected opening-range timeframe to minutes, anchored to the session open.
orMinutes = timeframe.in_seconds(orTF) / 60.0
windowMinutes = input.int(90, "Trade Window (min from open)", minval=1,
     tooltip="Only take setups within this many minutes of the open. Video default = 90.",
     group="Session")
closeAtSessionEnd = input.bool(true, "Flatten at Session End",
     tooltip="Close any open position when the session ends (no overnight holds).",
     group="Session")

// --- Liquidity filter ------------------------------------------------------
atrLen = input.int(14, "ATR Length", minval=1,
     tooltip="Length of the DAILY ATR used to size the market's average range.",
     group="Liquidity Filter")
atrTF = input.timeframe("D", "ATR Timeframe",
     tooltip="Timeframe for the ATR. Video uses Daily.",
     group="Liquidity Filter")
thresholdPct = input.float(25.0, "Qualify Threshold (% of ATR)", minval=1, maxval=200,
     tooltip="OR candle qualifies as a liquidity candle if its range is at least " +
     "this % of the daily ATR. Video default = 25%.",
     group="Liquidity Filter")

// --- Patterns --------------------------------------------------------------
enableHammer = input.bool(true, "Hammer / Inverted Hammer",
     tooltip="Enable hammer (bullish) and inverted-hammer (bearish) reversals.",
     group="Reversal Patterns")
enableEngulf = input.bool(true, "Engulfing",
     tooltip="Enable bullish / bearish engulfing reversals.",
     group="Reversal Patterns")
hammerRatio = input.float(2.0, "Hammer Wick : Body Ratio", minval=1.0, step=0.1,
     tooltip="Minimum ratio of the dominant wick to the candle body for a hammer.",
     group="Reversal Patterns")
upperWickMax = input.float(0.5, "Opposite-Wick : Dominant-Wick Max", minval=0.0, maxval=1.0, step=0.05,
     tooltip="Max size of the opposite wick relative to the dominant wick (keeps hammers clean).",
     group="Reversal Patterns")

// --- Entry / Exit ----------------------------------------------------------
entryMode = input.string("Pattern-specific", "Entry Mechanic",
     options=["Pattern-specific", "Next bar open"],
     tooltip="Pattern-specific: hammer -> market next bar; engulfing -> stop order at " +
     "the engulfed candle's extreme (video method). Next bar open: market entry for all.",
     group="Entry / Exit")
rrOverride = input.float(0.0, "Risk:Reward Override (0 = use box)", minval=0.0, step=0.1,
     tooltip="0 = target the far side of the box (video). Otherwise target = risk x this multiple.",
     group="Entry / Exit")
useBreakeven = input.bool(false, "Move Stop to Breakeven",
     tooltip="Move the stop to entry once price travels the trigger % toward the target.",
     group="Entry / Exit")
beTrigger = input.float(50.0, "Breakeven Trigger (% to target)", minval=1, maxval=100,
     tooltip="How far toward the target (in %) price must travel before the stop moves to entry.",
     group="Entry / Exit")
maxTrades = input.int(1, "Max Setups per Session", minval=1,
     tooltip="Cap on setups taken per session. Video takes one.",
     group="Entry / Exit")

// --- Visuals ---------------------------------------------------------------
showBox = input.bool(true, "Show Opening-Range Box", group="Visuals")
showSignals = input.bool(true, "Show Reversal Signals", group="Visuals")
showLevels = input.bool(true, "Show Stop / Target Lines", group="Visuals")
showTable = input.bool(true, "Show Status Table", group="Visuals")
shadeQual = input.int(90, "OR Box Fill Transparency", minval=0, maxval=100,
     tooltip="Fill transparency of the opening-range box (100 = invisible). The trade-window box is drawn fainter.",
     group="Visuals")
bullCol = input.color(color.green, "Bullish / Target",
     tooltip="Long signals and the take-profit line.", group="Visuals")
bearCol = input.color(color.red, "Bearish / Stop",
     tooltip="Short signals and the stop-loss line.", group="Visuals")
liqCol = input.color(color.orange, "Liquidity / OR Box",
     tooltip="The opening-range box, the threshold line, and the qualifying area fill.",
     group="Visuals")

// ============================================================================
// DAILY ATR (prior completed value -> known at open, non-repainting)
// ============================================================================
dailyATR = request.security(syminfo.tickerid, atrTF, ta.atr(atrLen)[1],
     lookahead=barmerge.lookahead_off)

// ============================================================================
// SESSION / OPENING-RANGE STATE
// ============================================================================
sessBar = time(timeframe.period, sessionInput, tzInput)
inSession = not na(sessBar)
newSession = inSession and na(sessBar[1])

var float orHigh = na
var float orLow = na
var float orOpenPrice = na
var float orClose = na
var float orRange = na
var int   openBarTime = na
var bool  orActive = false
var bool  orDone = false
var bool  qualifies = false
var int   orDir = 0            // 1 = green OR, -1 = red OR
var int   sessionTrades = 0    // setups taken this session (capped by maxTrades)
var bool  exitPlaced = false
var float activeSL = na
var float activeTPbox = na
var float activeTP = na

float minutesSinceOpen = na(openBarTime) ? na : (time - openBarTime) / 60000.0

if newSession
    // Reset all per-session state and seed the OR with the first bar.
    orHigh := high
    orLow := low
    orOpenPrice := open
    orClose := close
    orActive := true
    orDone := false
    qualifies := false
    orDir := 0
    orRange := na
    openBarTime := time
    sessionTrades := 0
    exitPlaced := false
    activeSL := na
    activeTPbox := na
    activeTP := na
else
    if orActive
        if minutesSinceOpen < orMinutes
            // Still building the opening-range candle.
            orHigh := math.max(orHigh, high)
            orLow := math.min(orLow, low)
            orClose := close
        else
            // Window closed -> finalize the OR candle.
            orActive := false
            orDone := true
            orDir := orClose >= orOpenPrice ? 1 : -1
            orRange := orHigh - orLow
            qualifies := orRange >= (thresholdPct / 100.0) * dailyATR

// ============================================================================
// REVERSAL PATTERNS (confirmed on bar close)
// ============================================================================
float body = math.abs(close - open)
float rng  = high - low
float upWick = high - math.max(open, close)
float dnWick = math.min(open, close) - low

isHammer    = rng > 0 and body > 0 and dnWick >= hammerRatio * body and upWick <= dnWick * upperWickMax
isInvHammer = rng > 0 and body > 0 and upWick >= hammerRatio * body and dnWick <= upWick * upperWickMax
bullEngulf  = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf  = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// ============================================================================
// SETUP GATING
// ============================================================================
inWindow = orDone and minutesSinceOpen >= orMinutes and minutesSinceOpen <= windowMinutes
tradeReady = inSession and inWindow and qualifies and sessionTrades < maxTrades and strategy.position_size == 0

longBias  = orDir == -1        // red OR -> fade below with a bullish reversal
shortBias = orDir == 1         // green OR -> fade above with a bearish reversal

longOutside  = low < orLow     // price extended below the box
shortOutside = high > orHigh    // price extended above the box

longHammer = enableHammer and isHammer
longEngulf = enableEngulf and bullEngulf
shortHammer = enableHammer and isInvHammer
shortEngulf = enableEngulf and bearEngulf

enterLong  = tradeReady and longBias  and longOutside  and (longHammer or longEngulf)
enterShort = tradeReady and shortBias and shortOutside and (shortHammer or shortEngulf)

// ============================================================================
// ENTRIES
// ============================================================================
if enterLong
    sessionTrades += 1
    activeSL := low
    activeTPbox := orHigh
    useStop = entryMode == "Pattern-specific" and longEngulf and not longHammer
    if useStop
        strategy.entry("QFS Long", strategy.long, stop=high[1],
             alert_message="QFS long: bullish engulfing fade below OR box")
    else
        strategy.entry("QFS Long", strategy.long,
             alert_message="QFS long: bullish reversal fade below OR box")

if enterShort
    sessionTrades += 1
    activeSL := high
    activeTPbox := orLow
    useStop = entryMode == "Pattern-specific" and shortEngulf and not shortHammer
    if useStop
        strategy.entry("QFS Short", strategy.short, stop=low[1],
             alert_message="QFS short: bearish engulfing fade above OR box")
    else
        strategy.entry("QFS Short", strategy.short,
             alert_message="QFS short: bearish reversal fade above OR box")

// ============================================================================
// EXITS (bracket once filled + optional breakeven)
// ============================================================================
if strategy.position_size != 0 and not exitPlaced
    entryP = strategy.position_avg_price
    isLongPos = strategy.position_size > 0
    risk = math.abs(entryP - activeSL)
    activeTP := rrOverride > 0 ? (isLongPos ? entryP + rrOverride * risk : entryP - rrOverride * risk) : activeTPbox
    strategy.exit("QFS Exit", stop=activeSL, limit=activeTP,
         alert_message="QFS exit: stop or target hit")
    exitPlaced := true

if useBreakeven and exitPlaced and strategy.position_size != 0
    entryP = strategy.position_avg_price
    isLongPos = strategy.position_size > 0
    trig = entryP + (beTrigger / 100.0) * (activeTP - entryP)
    hit = isLongPos ? high >= trig : low <= trig
    if hit
        strategy.exit("QFS Exit", stop=entryP, limit=activeTP,
             alert_message="QFS exit: breakeven stop or target")

// Re-arm the bracket once flat again, so a subsequent setup (maxTrades > 1)
// gets its own stop/target instead of inheriting the previous trade's.
if strategy.position_size == 0 and exitPlaced
    exitPlaced := false

// ============================================================================
// HOUSEKEEPING: cancel stale orders / flatten at session end
// ============================================================================
windowExpired = orDone and minutesSinceOpen > windowMinutes
if windowExpired and strategy.position_size == 0
    strategy.cancel("QFS Long")
    strategy.cancel("QFS Short")

sessionEnded = not inSession and inSession[1]
if sessionEnded and closeAtSessionEnd and strategy.position_size != 0
    strategy.close_all(comment="Session End")

// ============================================================================
// ATR OSCILLATOR PANE  (bottom pane — script runs overlay=false)
//   Everything is normalized to "% of the daily ATR" so the scale stays small
//   and the decision is a single glance:
//   * Dashed line = the liquidity threshold (thresholdPct, e.g. 25%).
//   * Area        = the opening range as a % of the daily ATR (live while it
//     builds, held across the trade window). Bright when it clears the
//     threshold (liquidity candle), dim when it does not.
//   * Label       = the raw daily ATR value, so the absolute number is visible.
// ============================================================================
float orLive = orActive ? (orHigh - orLow) : (orDone and inWindow ? orRange : na)
float orPct  = na(dailyATR) or dailyATR == 0 ? na : orLive / dailyATR * 100.0
color orCol  = orActive ? color.new(color.gray, 65) : qualifies ? color.new(liqCol, 82) : color.new(color.gray, 88)

bgcolor(qualifies and inSession ? color.new(liqCol, 94) : na, title="Liquidity Qualified")
hline(0, "Baseline", color=color.new(color.gray, 88))
hline(thresholdPct, "Liquidity Threshold (% ATR)", color=color.new(liqCol, 0),
     linestyle=hline.style_dashed, linewidth=1)
plot(orPct, "OR % of ATR", color=orCol, style=plot.style_area, histbase=0)

// Raw daily-ATR readout in the pane (the histogram is normalized, so show the number).
var label atrLbl = na
label.delete(atrLbl)
if barstate.islast
    atrLbl := label.new(bar_index, thresholdPct,
         "ATR " + str.tostring(dailyATR, format.mintick) +
         (na(orPct) ? "" : "   OR " + str.tostring(orPct, "#.#") + "%"),
         style=label.style_label_right,
         color=color.new(color.gray, 75),
         textcolor=color.new(color.white, 0),
         size=size.small)

// ============================================================================
// VISUALS
//   Green = long / target, red = short / stop, amber = liquidity (OR + threshold).
//   All price-chart drawings use force_overlay=true so they render on the main
//   chart while the ATR plots stay in this indicator's own pane.
// ============================================================================
// Opening-range box, drawn once per session when the OR finalizes.
boxJustDone = orDone and not orDone[1]
if showBox and boxJustDone
    orEndTime = openBarTime + int(orMinutes * 60000)
    winEndTime = openBarTime + int(windowMinutes * 60000)
    qBorder = qualifies ? color.new(liqCol, 0) : color.new(color.gray, 45)
    qFill = qualifies ? color.new(liqCol, shadeQual) : color.new(color.gray, math.min(100, shadeQual + 6))
    // (1) The actual opening-range candle: dashed box at its true width.
    box.new(left=openBarTime,
         top=orHigh,
         right=orEndTime,
         bottom=orLow,
         xloc=xloc.bar_time,
         border_color=qBorder,
         border_width=1,
         border_style=line.style_dashed,
         bgcolor=qFill,
         text=qualifies ? "OR " + str.tostring(orRange, format.mintick) + " ✓" : "OR " + str.tostring(orRange, format.mintick),
         text_color=qualifies ? color.new(liqCol, 0) : color.new(color.gray, 20),
         text_size=size.small,
         text_halign=text.align_center,
         text_valign=text.align_center,
         force_overlay=true)
    // (2) The trade window: fainter dotted box at the OR levels, extended forward.
    box.new(left=orEndTime,
         top=orHigh,
         right=winEndTime,
         bottom=orLow,
         xloc=xloc.bar_time,
         border_color=color.new(color.gray, 65),
         border_width=1,
         border_style=line.style_dotted,
         bgcolor=color.new(color.gray, math.min(100, shadeQual + 8)),
         text="window " + str.tostring(windowMinutes) + "m",
         text_color=color.new(color.gray, 35),
         text_size=size.tiny,
         text_halign=text.align_right,
         text_valign=text.align_bottom,
         force_overlay=true)

// Reversal signal markers: green = long (fade up), red = short (fade down).
plotshape(showSignals and enterLong ? orLow : na, title="Long Signal",
     style=shape.triangleup, location=location.absolute, color=bullCol,
     size=size.tiny, offset=0, force_overlay=true)
plotshape(showSignals and enterShort ? orHigh : na, title="Short Signal",
     style=shape.triangledown, location=location.absolute, color=bearCol,
     size=size.tiny, offset=0, force_overlay=true)

// Active stop (red) / target (green) lines while in a trade.
plotStop = showLevels and strategy.position_size != 0 ? activeSL : na
plotTgt  = showLevels and strategy.position_size != 0 ? activeTP : na
plot(plotStop, "Stop", color=bearCol, style=plot.style_linebr, linewidth=1, force_overlay=true)
plot(plotTgt, "Target", color=bullCol, style=plot.style_linebr, linewidth=1, force_overlay=true)

// ============================================================================
// STATUS + PERFORMANCE TABLE
// ============================================================================
var table t = table.new(position.top_right, 2, 11,
     border_width=1, border_color=color.new(color.gray, 40),
     frame_color=color.new(color.gray, 40), frame_width=1, force_overlay=true)

tfOK = timeframe.in_seconds() <= 300
cellBg = color.new(color.gray, 85)
hdrBg = color.new(color.gray, 65)

f_row(int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color=color.new(color.white, 15), text_size=size.small, bgcolor=hdrBg, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=size.small, bgcolor=cellBg, text_halign=text.align_right)

if showTable and barstate.islast
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : na
    biasTxt = not orDone ? "—" : orDir == 1 ? "Short (fade ↑)" : "Long (fade ↓)"
    f_row(0, "Quick Flip Scalper", tfOK ? "ready" : "⚠ use ≤5m", tfOK ? color.new(color.white, 0) : color.new(color.orange, 0))
    f_row(1, "Session · OR", sessionInput + " · " + orTF + "m", color.new(color.white, 10))
    f_row(2, "Daily ATR(" + str.tostring(atrLen) + ")", str.tostring(dailyATR, format.mintick), color.new(color.white, 10))
    f_row(3, "Threshold (" + str.tostring(thresholdPct, "#.#") + "%)", str.tostring((thresholdPct / 100.0) * dailyATR, format.mintick), color.new(color.white, 10))
    f_row(4, "OR Range", na(orRange) ? "—" : str.tostring(orRange, format.mintick), color.new(color.white, 10))
    f_row(5, "Qualifies", not orDone ? "building…" : qualifies ? "YES ✓" : "no", qualifies ? liqCol : color.new(color.gray, 20))
    f_row(6, "Bias", biasTxt, not orDone ? color.new(color.white, 10) : orDir == 1 ? bearCol : bullCol)
    f_row(7, "Closed Trades", str.tostring(strategy.closedtrades), color.new(color.white, 10))
    f_row(8, "Win Rate", na(winRate) ? "—" : str.tostring(winRate, "#.#") + "%", color.new(color.white, 10))
    f_row(9, "Profit Factor", strategy.grossloss > 0 ? str.tostring(strategy.grossprofit / strategy.grossloss, "#.##") : "—", color.new(color.white, 10))
    f_row(10, "Net P/L", str.tostring(strategy.netprofit, format.mintick), strategy.netprofit >= 0 ? bullCol : bearCol)
