//@version=6
// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/templates/utilities/debug-panel.pine
// content_hash: e90c0cee482fe1d5
// collected: 2026-07-27
indicator("Debug Panel Template", shorttitle="Debug", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
// Panel Settings
showPanel = input.bool(true, "Show Debug Panel", group="Panel")
panelPosition = input.string("top_right", "Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Panel")
panelSize = input.string("normal", "Text Size", options=["tiny", "small", "normal", "large"], group="Panel")
panelBgColor = input.color(color.new(color.black, 70), "Background", group="Panel")
panelTextColor = input.color(color.white, "Text Color", group="Panel")

// What to Display
showPriceInfo = input.bool(true, "Price Info", group="Display")
showBarInfo = input.bool(true, "Bar Info", group="Display")
showVolumeInfo = input.bool(true, "Volume Info", group="Display")
showTechnicals = input.bool(true, "Technical Levels", group="Display")
showCustom = input.bool(true, "Custom Values", group="Display")

// Technical Settings
maLength = input.int(20, "MA Length", minval=1, group="Technicals")
atrLength = input.int(14, "ATR Length", minval=1, group="Technicals")
rsiLength = input.int(14, "RSI Length", minval=1, group="Technicals")

// ============================================================================
// CUSTOM DEBUG VALUES
// Add your own variables to track here
// ============================================================================
// Example custom values - replace with your own
customValue1 = close - open          // Candle body size
customValue2 = ta.ema(close, 9)      // Fast EMA
customValue3 = ta.rsi(close, 14)     // RSI value
customLabel1 = "Body Size"
customLabel2 = "EMA(9)"
customLabel3 = "RSI(14)"

// ============================================================================
// CALCULATIONS
// ============================================================================
// Price calculations
priceChange = close - close[1]
priceChangePct = priceChange / close[1] * 100

// Bar calculations
isGreen = close > open
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
totalRange = high - low

// Volume calculations
avgVolume = ta.sma(volume, 20)
volumeRatio = volume / avgVolume
isHighVolume = volumeRatio > 1.5

// Technical calculations
ma = ta.sma(close, maLength)
atr = ta.atr(atrLength)
rsi = ta.rsi(close, rsiLength)

// Position relative to MA
distFromMA = close - ma
distFromMAPct = distFromMA / ma * 100

// ============================================================================
// DEBUG PANEL
// ============================================================================
var table debugTable = na

if showPanel and barstate.islast
    // Determine text size
    txtSize = switch panelSize
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large

    // Calculate rows needed
    rows = 1  // Header
    if showPriceInfo
        rows += 3
    if showBarInfo
        rows += 4
    if showVolumeInfo
        rows += 2
    if showTechnicals
        rows += 4
    if showCustom
        rows += 3

    debugTable := table.new(str.lower(panelPosition), 2, rows, bgcolor=panelBgColor, border_width=1)

    row = 0

    // Header
    table.cell(debugTable, 0, row, "DEBUG PANEL", text_color=color.yellow, text_size=txtSize)
    table.cell(debugTable, 1, row, str.tostring(timenow, "HH:mm:ss"), text_color=panelTextColor, text_size=txtSize)
    row += 1

    // Price Info
    if showPriceInfo
        table.cell(debugTable, 0, row, "Price", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(close, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Change", text_color=panelTextColor, text_size=txtSize)
        changeColor = priceChange >= 0 ? color.green : color.red
        table.cell(debugTable, 1, row, str.tostring(priceChange, format.mintick) + " (" + str.tostring(priceChangePct, "#.##") + "%)", text_color=changeColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Spread", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(high - low, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

    // Bar Info
    if showBarInfo
        table.cell(debugTable, 0, row, "Bar Type", text_color=panelTextColor, text_size=txtSize)
        barColor = isGreen ? color.green : color.red
        table.cell(debugTable, 1, row, isGreen ? "BULLISH" : "BEARISH", text_color=barColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Body", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(bodySize, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Upper Wick", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(upperWick, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Lower Wick", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(lowerWick, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

    // Volume Info
    if showVolumeInfo
        table.cell(debugTable, 0, row, "Volume", text_color=panelTextColor, text_size=txtSize)
        volColor = isHighVolume ? color.yellow : panelTextColor
        table.cell(debugTable, 1, row, str.tostring(volume, format.volume), text_color=volColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Vol Ratio", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(volumeRatio, "#.##") + "x avg", text_color=volColor, text_size=txtSize)
        row += 1

    // Technical Levels
    if showTechnicals
        table.cell(debugTable, 0, row, "MA(" + str.tostring(maLength) + ")", text_color=panelTextColor, text_size=txtSize)
        maColor = close > ma ? color.green : color.red
        table.cell(debugTable, 1, row, str.tostring(ma, format.mintick), text_color=maColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "Dist from MA", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(distFromMAPct, "#.##") + "%", text_color=maColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "ATR(" + str.tostring(atrLength) + ")", text_color=panelTextColor, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(atr, format.mintick), text_color=panelTextColor, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, "RSI(" + str.tostring(rsiLength) + ")", text_color=panelTextColor, text_size=txtSize)
        rsiColor = rsi > 70 ? color.red : rsi < 30 ? color.green : panelTextColor
        table.cell(debugTable, 1, row, str.tostring(rsi, "#.#"), text_color=rsiColor, text_size=txtSize)
        row += 1

    // Custom Values
    if showCustom
        table.cell(debugTable, 0, row, customLabel1, text_color=color.aqua, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(customValue1, format.mintick), text_color=color.aqua, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, customLabel2, text_color=color.aqua, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(customValue2, format.mintick), text_color=color.aqua, text_size=txtSize)
        row += 1

        table.cell(debugTable, 0, row, customLabel3, text_color=color.aqua, text_size=txtSize)
        table.cell(debugTable, 1, row, str.tostring(customValue3, "#.##"), text_color=color.aqua, text_size=txtSize)

// ============================================================================
// VISUAL AIDS
// ============================================================================
// MA line
plot(ma, "MA", color=color.blue, linewidth=1)

// ATR bands (optional visual reference)
plot(close + atr, "ATR Upper", color=color.new(color.gray, 70), style=plot.style_circles)
plot(close - atr, "ATR Lower", color=color.new(color.gray, 70), style=plot.style_circles)
