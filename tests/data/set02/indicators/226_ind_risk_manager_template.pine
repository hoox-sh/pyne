//@version=6
// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/templates/utilities/risk-manager.pine
// content_hash: 8a5de16b4aab9fc8
// collected: 2026-07-27
indicator("Risk Manager Template", shorttitle="Risk", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
// Account Settings
accountSize = input.float(10000, "Account Size ($)", minval=100, group="Account", tooltip="Your total trading account size")
riskPercent = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=10, step=0.1, group="Account", tooltip="Maximum percentage to risk per trade")
maxDailyRisk = input.float(3.0, "Max Daily Risk (%)", minval=0.5, maxval=20, step=0.5, group="Account", tooltip="Maximum total risk per day")

// Stop Loss Settings
stopType = input.string("ATR", "Stop Loss Type", options=["ATR", "Percent", "Fixed Points", "Swing Low/High"], group="Stop Loss")
atrMultiplier = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.5, group="Stop Loss")
atrLength = input.int(14, "ATR Length", minval=1, group="Stop Loss")
stopPercent = input.float(2.0, "Stop Loss %", minval=0.1, maxval=10, step=0.1, group="Stop Loss")
stopPoints = input.float(50, "Stop Points", minval=1, group="Stop Loss")
swingLookback = input.int(10, "Swing Lookback", minval=3, maxval=50, group="Stop Loss")

// Take Profit Settings
useTP = input.bool(true, "Use Take Profit", group="Take Profit")
rrRatio = input.float(2.0, "Risk:Reward Ratio", minval=0.5, maxval=10, step=0.5, group="Take Profit")
usePartialTP = input.bool(false, "Use Partial Take Profit", group="Take Profit")
partialTPPercent = input.float(50, "Close % at TP1", minval=10, maxval=90, step=10, group="Take Profit")
partialRR1 = input.float(1.0, "TP1 R:R", minval=0.5, maxval=5.0, step=0.5, group="Take Profit")

// Position Direction
isLong = input.bool(true, "Long Position", group="Position", tooltip="Toggle for long or short position calculations")

// Display Settings
showTable = input.bool(true, "Show Risk Table", group="Display")
showLevels = input.bool(true, "Show Price Levels", group="Display")
tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Display")

// ============================================================================
// CALCULATIONS
// ============================================================================
// ATR calculation
atr = ta.atr(atrLength)

// Swing levels
swingLow = ta.lowest(low, swingLookback)
swingHigh = ta.highest(high, swingLookback)

// Calculate stop loss distance
stopDistance = switch stopType
    "ATR" => atr * atrMultiplier
    "Percent" => close * stopPercent / 100
    "Fixed Points" => stopPoints * syminfo.mintick
    "Swing Low/High" => isLong ? close - swingLow : swingHigh - close

// Stop loss price
stopLossPrice = isLong ? close - stopDistance : close + stopDistance

// Risk calculations
riskAmount = accountSize * riskPercent / 100
maxDailyRiskAmount = accountSize * maxDailyRisk / 100

// Position sizing
pointValue = syminfo.pointvalue
tickValue = syminfo.mintick * pointValue
stopDistancePoints = stopDistance / syminfo.mintick

// Calculate position size (contracts/shares)
positionSize = riskAmount / (stopDistance * pointValue / syminfo.mintick)
roundedPosition = math.floor(positionSize)

// Position value
positionValue = roundedPosition * close * pointValue

// Actual risk with rounded position
actualRisk = roundedPosition * stopDistance * pointValue / syminfo.mintick
actualRiskPercent = actualRisk / accountSize * 100

// Take profit levels
tp1Distance = stopDistance * (usePartialTP ? partialRR1 : rrRatio)
tp2Distance = stopDistance * rrRatio
tp1Price = isLong ? close + tp1Distance : close - tp1Distance
tp2Price = isLong ? close + tp2Distance : close - tp2Distance

// Potential profit
potentialProfit = roundedPosition * tp2Distance * pointValue / syminfo.mintick
potentialProfitPercent = potentialProfit / accountSize * 100

// ============================================================================
// RISK TABLE
// ============================================================================
var table riskTable = na

if showTable and barstate.islast
    riskTable := table.new(str.lower(tablePosition), 2, 12, bgcolor=color.new(color.black, 70), border_width=1)

    row = 0

    // Header
    table.cell(riskTable, 0, row, "RISK MANAGER", text_color=color.yellow, text_size=size.normal)
    table.cell(riskTable, 1, row, isLong ? "LONG" : "SHORT", text_color=isLong ? color.green : color.red, text_size=size.normal)
    row += 1

    // Entry price
    table.cell(riskTable, 0, row, "Entry Price", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, str.tostring(close, format.mintick), text_color=color.white, text_size=size.small)
    row += 1

    // Stop loss
    table.cell(riskTable, 0, row, "Stop Loss", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, str.tostring(stopLossPrice, format.mintick), text_color=color.red, text_size=size.small)
    row += 1

    // Stop distance
    table.cell(riskTable, 0, row, "Stop Distance", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, str.tostring(stopDistance, format.mintick) + " (" + str.tostring(stopDistance/close*100, "#.##") + "%)", text_color=color.white, text_size=size.small)
    row += 1

    // Take profit
    if useTP
        table.cell(riskTable, 0, row, usePartialTP ? "TP1 / TP2" : "Take Profit", text_color=color.white, text_size=size.small)
        tpText = usePartialTP ? str.tostring(tp1Price, format.mintick) + " / " + str.tostring(tp2Price, format.mintick) : str.tostring(tp2Price, format.mintick)
        table.cell(riskTable, 1, row, tpText, text_color=color.green, text_size=size.small)
        row += 1

    // Position size
    table.cell(riskTable, 0, row, "Position Size", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, str.tostring(roundedPosition) + " units", text_color=color.aqua, text_size=size.small)
    row += 1

    // Position value
    table.cell(riskTable, 0, row, "Position Value", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, "$" + str.tostring(positionValue, "#,###.##"), text_color=color.white, text_size=size.small)
    row += 1

    // Risk amount
    table.cell(riskTable, 0, row, "Risk Amount", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, "$" + str.tostring(actualRisk, "#.##") + " (" + str.tostring(actualRiskPercent, "#.##") + "%)", text_color=color.orange, text_size=size.small)
    row += 1

    // Potential profit
    if useTP
        table.cell(riskTable, 0, row, "Potential Profit", text_color=color.white, text_size=size.small)
        table.cell(riskTable, 1, row, "$" + str.tostring(potentialProfit, "#.##") + " (" + str.tostring(potentialProfitPercent, "#.##") + "%)", text_color=color.green, text_size=size.small)
        row += 1

    // R:R Ratio
    table.cell(riskTable, 0, row, "Risk:Reward", text_color=color.white, text_size=size.small)
    table.cell(riskTable, 1, row, "1:" + str.tostring(rrRatio), text_color=color.white, text_size=size.small)
    row += 1

    // Daily risk remaining
    table.cell(riskTable, 0, row, "Daily Risk Left", text_color=color.white, text_size=size.small)
    remainingRisk = maxDailyRiskAmount - actualRisk
    remainingColor = remainingRisk > actualRisk ? color.green : color.orange
    table.cell(riskTable, 1, row, "$" + str.tostring(remainingRisk, "#.##"), text_color=remainingColor, text_size=size.small)

// ============================================================================
// PRICE LEVELS
// ============================================================================
if showLevels
    // Entry level
    entryLine = line.new(bar_index - 20, close, bar_index + 10, close, color=color.white, style=line.style_solid, width=2)
    line.delete(entryLine[1])

    // Stop loss level
    slLine = line.new(bar_index - 20, stopLossPrice, bar_index + 10, stopLossPrice, color=color.red, style=line.style_dashed, width=2)
    line.delete(slLine[1])

    // Take profit levels
    if useTP
        tp1Line = line.new(bar_index - 20, tp1Price, bar_index + 10, tp1Price, color=color.green, style=line.style_dashed, width=1)
        line.delete(tp1Line[1])

        if usePartialTP
            tp2Line = line.new(bar_index - 20, tp2Price, bar_index + 10, tp2Price, color=color.green, style=line.style_solid, width=2)
            line.delete(tp2Line[1])

    // Labels
    entryLabel = label.new(bar_index + 5, close, "Entry", color=color.new(color.white, 70), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.delete(entryLabel[1])

    slLabel = label.new(bar_index + 5, stopLossPrice, "Stop", color=color.new(color.red, 70), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.delete(slLabel[1])

    if useTP
        tpLabel = label.new(bar_index + 5, tp2Price, "TP", color=color.new(color.green, 70), textcolor=color.white, style=label.style_label_left, size=size.small)
        label.delete(tpLabel[1])

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(actualRiskPercent > riskPercent * 1.1, "Risk Exceeded", "Position risk exceeds target risk percentage")
alertcondition(actualRisk > maxDailyRiskAmount, "Daily Risk Limit", "Trade would exceed maximum daily risk")
