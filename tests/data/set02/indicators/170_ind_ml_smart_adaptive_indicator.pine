//@version=6
// set02 corpus entry
// source_repo: tradingview-ml-signals
// source_path: tradingview-ml-signals/ML_Smart_Indicator.pine
// content_hash: 7efc40e3658d031e
// collected: 2026-07-27
indicator("ML Smart Adaptive Indicator", shorttitle="ML-SAI", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// ML Smart Adaptive Indicator for TradingView
// Читает сигналы ML-модели из Pine Seeds (GitHub репозиторий)
// ══════════════════════════════════════════════════════════════════════════════

// ─── Inputs ─────────────────────────────────────────────────────────────────
group_ml = "ML Signal Source"
repo_name = input.string("GeekRabbit007/tradingview-ml-signals", "Pine Seeds Repo", group=group_ml, tooltip="GitHub репозиторий для Pine Seeds")
symbol_file = input.string("BTCUSDT_1", "Signal File (ticker_timeframe)", group=group_ml)
signal_threshold = input.float(0.65, "Min Confidence", minval=0.5, maxval=1.0, step=0.05, group=group_ml)

group_display = "Display Settings"
show_predictions = input.bool(true, "Show Prediction Arrows", group=group_display)
show_trend_zones = input.bool(true, "Show Trend Zones", group=group_display)
show_anomaly_markers = input.bool(true, "Show Anomaly Markers", group=group_display)
show_confidence_panel = input.bool(true, "Show Confidence Panel", group=group_display)

// ─── Pine Seeds Data Request ──────────────────────────────────────────────────
// Формат CSV: time,open,high,low,close,volume
// где: close = signal (-1,0,1), volume = confidence
float ml_signal_raw = request.seed(repo_name, symbol_file, close)
float ml_confidence = request.seed(repo_name, symbol_file, volume)
float ml_strength = request.seed(repo_name, symbol_file, high)   // high = strength
float ml_anomaly = request.seed(repo_name, symbol_file, low)   // low = anomaly_score
float ml_pred_price = request.seed(repo_name, symbol_file, open) // open = predicted_price

// ─── Обработка сигналов ──────────────────────────────────────────────────────
var float last_signal = 0
var float last_conf = 0
var float last_strength = 0
var float last_anomaly = 0

if not na(ml_signal_raw)
    last_signal := ml_signal_raw
    last_conf := ml_confidence
    last_strength := ml_strength
    last_anomaly := ml_anomaly

bool is_buy = last_signal > 0.5 and last_conf >= signal_threshold
bool is_sell = last_signal < -0.5 and last_conf >= signal_threshold
bool is_hold = not is_buy and not is_sell
bool is_anomaly = last_anomaly < -0.3

// ─── Визуализация ─────────────────────────────────────────────────────────────
plotshape(is_buy and show_predictions, title="ML Buy", style=shape.triangleup, 
         location=location.belowbar, color=color.new(color.green, 0), size=size.normal, 
         text="ML", textcolor=color.white)

plotshape(is_sell and show_predictions, title="ML Sell", style=shape.triangledown, 
         location=location.abovebar, color=color.new(color.red, 0), size=size.normal, 
         text="ML", textcolor=color.white)

bgcolor(is_buy and show_trend_zones ? color.new(color.green, 90) : 
        is_sell and show_trend_zones ? color.new(color.red, 90) : 
        show_trend_zones ? color.new(color.gray, 95) : na, 
        title="Trend Zone")

plotshape(is_anomaly and show_anomaly_markers, title="Anomaly", style=shape.diamond, 
         location=location.absolute, color=color.new(color.orange, 0), size=size.small,
         text="⚡", textcolor=color.white, offset=0)

plot(ml_pred_price > 0 ? ml_pred_price : na, title="Predicted Price", 
     color=color.new(color.purple, 0), style=plot.style_line, linewidth=2)

// ─── Информационная панель ────────────────────────────────────────────────────
var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), 
                               border_width=1, border_color=color.gray)

if barstate.islast and show_confidence_panel
    table.cell(info_table, 0, 0, "ML Signal", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, is_buy ? "BUY" : is_sell ? "SELL" : "HOLD", 
              text_color=is_buy ? color.green : is_sell ? color.red : color.gray, text_size=size.small)

    table.cell(info_table, 0, 1, "Confidence", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(last_conf, "#.##"), 
              text_color=last_conf > 0.8 ? color.green : last_conf > 0.6 ? color.yellow : color.red, 
              text_size=size.small)

    table.cell(info_table, 0, 2, "Strength", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(last_strength, "#.##"), 
              text_color=last_strength > 0 ? color.green : color.red, text_size=size.small)

    table.cell(info_table, 0, 3, "Trend", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 3, last_signal > 0 ? "UP" : last_signal < 0 ? "DOWN" : "SIDE", 
              text_color=color.white, text_size=size.small)

    table.cell(info_table, 0, 4, "Anomaly", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 4, is_anomaly ? "YES ⚠️" : "No", 
              text_color=is_anomaly ? color.orange : color.gray, text_size=size.small)

    table.cell(info_table, 0, 5, "Model", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 5, "v" + str.tostring(int(last_conf * 100)), 
              text_color=color.white, text_size=size.small)

// ─── Алерты (только статичные сообщения — Pine Script не поддерживает series в alertcondition) ─
alertcondition(is_buy, title="ML Buy Signal", message="ML BUY signal on {{ticker}}")
alertcondition(is_sell, title="ML Sell Signal", message="ML SELL signal on {{ticker}}")
alertcondition(is_anomaly, title="ML Anomaly Detected", message="ML ANOMALY detected on {{ticker}}")
