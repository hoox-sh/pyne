//@version=6
// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/templates/indicators/support-resistance.pine
// content_hash: e4a7e27c83454c82
// collected: 2026-07-27
indicator("Support & Resistance Template", shorttitle="S/R", overlay=true, max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================
// Detection Settings
pivotLength = input.int(10, "Pivot Length", minval=2, maxval=50, group="Detection", tooltip="Bars on each side to confirm pivot")
strengthThreshold = input.int(2, "Minimum Touches", minval=1, maxval=10, group="Detection", tooltip="Minimum touches to confirm level")
priceZone = input.float(0.5, "Zone Width (%)", minval=0.1, maxval=5.0, step=0.1, group="Detection", tooltip="Percentage width for grouping similar levels")

// Display Settings
maxLevels = input.int(5, "Max Levels to Show", minval=1, maxval=20, group="Display")
extendLines = input.bool(true, "Extend Lines Right", group="Display")
showZones = input.bool(true, "Show Zones", group="Display")
showLabels = input.bool(true, "Show Labels", group="Display")

// Visual Settings
supportColor = input.color(color.green, "Support Color", group="Visual")
resistanceColor = input.color(color.red, "Resistance Color", group="Visual")
lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group="Visual")
zoneTransparency = input.int(90, "Zone Transparency", minval=50, maxval=99, group="Visual")

// ============================================================================
// USER DEFINED TYPES
// ============================================================================
type Level
    float price
    int touches
    int firstBar
    bool isSupport
    line ln
    box zone

// ============================================================================
// VARIABLES
// ============================================================================
var Level[] supportLevels = array.new<Level>()
var Level[] resistanceLevels = array.new<Level>()

// ============================================================================
// FUNCTIONS
// ============================================================================
// Check if price is within zone of level
isNearLevel(price, levelPrice) =>
    zoneSize = levelPrice * priceZone / 100
    math.abs(price - levelPrice) <= zoneSize

// Find or create level
findLevel(levels, price, isSupport) =>
    found = false
    for i = 0 to array.size(levels) - 1
        if i < array.size(levels)
            lvl = array.get(levels, i)
            if isNearLevel(price, lvl.price)
                lvl.touches += 1
                lvl.price := (lvl.price * (lvl.touches - 1) + price) / lvl.touches
                found := true
                break

    if not found
        newLevel = Level.new()
        newLevel.price := price
        newLevel.touches := 1
        newLevel.firstBar := bar_index
        newLevel.isSupport := isSupport
        array.push(levels, newLevel)
    found

// Remove weakest level if over limit
trimLevels(levels, limit) =>
    if array.size(levels) > limit
        minTouches = 999999
        minIdx = -1
        for i = 0 to array.size(levels) - 1
            lvl = array.get(levels, i)
            if lvl.touches < minTouches
                minTouches := lvl.touches
                minIdx := i
        if minIdx >= 0
            removedLevel = array.get(levels, minIdx)
            if not na(removedLevel.ln)
                line.delete(removedLevel.ln)
            if not na(removedLevel.zone)
                box.delete(removedLevel.zone)
            array.remove(levels, minIdx)

// ============================================================================
// CALCULATIONS
// ============================================================================
// Detect pivot highs and lows
pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
pivotLow = ta.pivotlow(low, pivotLength, pivotLength)

// Add new resistance level
if not na(pivotHigh)
    findLevel(resistanceLevels, pivotHigh, false)
    trimLevels(resistanceLevels, maxLevels)

// Add new support level
if not na(pivotLow)
    findLevel(supportLevels, pivotLow, true)
    trimLevels(supportLevels, maxLevels)

// ============================================================================
// DRAWING
// ============================================================================
// Draw support levels
for i = 0 to array.size(supportLevels) - 1
    if i < array.size(supportLevels)
        lvl = array.get(supportLevels, i)
        if lvl.touches >= strengthThreshold
            // Delete old drawings
            if not na(lvl.ln)
                line.delete(lvl.ln)
            if not na(lvl.zone)
                box.delete(lvl.zone)

            // Draw new line
            extend = extendLines ? extend.right : extend.none
            lvl.ln := line.new(lvl.firstBar, lvl.price, bar_index, lvl.price, color=supportColor, width=lineWidth, extend=extend)

            // Draw zone
            if showZones
                zoneSize = lvl.price * priceZone / 100
                lvl.zone := box.new(lvl.firstBar, lvl.price + zoneSize, bar_index, lvl.price - zoneSize, bgcolor=color.new(supportColor, zoneTransparency), border_color=na)

// Draw resistance levels
for i = 0 to array.size(resistanceLevels) - 1
    if i < array.size(resistanceLevels)
        lvl = array.get(resistanceLevels, i)
        if lvl.touches >= strengthThreshold
            // Delete old drawings
            if not na(lvl.ln)
                line.delete(lvl.ln)
            if not na(lvl.zone)
                box.delete(lvl.zone)

            // Draw new line
            extend = extendLines ? extend.right : extend.none
            lvl.ln := line.new(lvl.firstBar, lvl.price, bar_index, lvl.price, color=resistanceColor, width=lineWidth, extend=extend)

            // Draw zone
            if showZones
                zoneSize = lvl.price * priceZone / 100
                lvl.zone := box.new(lvl.firstBar, lvl.price + zoneSize, bar_index, lvl.price - zoneSize, bgcolor=color.new(resistanceColor, zoneTransparency), border_color=na)

// ============================================================================
// ALERTS
// ============================================================================
// Check for price approaching levels
nearSupport = false
nearResistance = false
approachZone = 0.3  // Percentage for approach detection

for i = 0 to array.size(supportLevels) - 1
    if i < array.size(supportLevels)
        lvl = array.get(supportLevels, i)
        if lvl.touches >= strengthThreshold and math.abs(close - lvl.price) / lvl.price * 100 < approachZone
            nearSupport := true

for i = 0 to array.size(resistanceLevels) - 1
    if i < array.size(resistanceLevels)
        lvl = array.get(resistanceLevels, i)
        if lvl.touches >= strengthThreshold and math.abs(close - lvl.price) / lvl.price * 100 < approachZone
            nearResistance := true

alertcondition(nearSupport, "Approaching Support", "Price approaching support level")
alertcondition(nearResistance, "Approaching Resistance", "Price approaching resistance level")
