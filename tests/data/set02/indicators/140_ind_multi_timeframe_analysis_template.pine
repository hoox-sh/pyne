//@version=6
// set02 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/templates/indicators/multi-timeframe.pine
// content_hash: 5c69bee4961893da
// collected: 2026-07-27
indicator("Multi-Timeframe Analysis Template", shorttitle="MTF", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
// Timeframe Settings
tf1 = input.timeframe("15", "Timeframe 1", group="Timeframes", tooltip="First higher timeframe")
tf2 = input.timeframe("60", "Timeframe 2", group="Timeframes", tooltip="Second higher timeframe")
tf3 = input.timeframe("240", "Timeframe 3", group="Timeframes", tooltip="Third higher timeframe")
tf4 = input.timeframe("D", "Timeframe 4", group="Timeframes", tooltip="Fourth higher timeframe")

// Indicator Settings
maLength = input.int(20, "MA Length", minval=1, group="Indicator", tooltip="Moving average period")
maType = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA"], group="Indicator")
rsiLength = input.int(14, "RSI Length", minval=1, group="Indicator")
rsiOB = input.int(70, "RSI Overbought", minval=50, maxval=100, group="Indicator")
rsiOS = input.int(30, "RSI Oversold", minval=0, maxval=50, group="Indicator")

// Visual Settings
showTable = input.bool(true, "Show MTF Table", group="Visual")
tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Visual")
bullColor = input.color(color.green, "Bullish Color", group="Visual")
bearColor = input.color(color.red, "Bearish Color", group="Visual")
neutralColor = input.color(color.gray, "Neutral Color", group="Visual")

// ============================================================================
// FUNCTIONS
// ============================================================================
// MA calculation function
calcMA(src, len, type) =>
    switch type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)

// Get bias for a timeframe
getBias(tf) =>
    maVal = request.security(syminfo.tickerid, tf, calcMA(close, maLength, maType), lookahead=barmerge.lookahead_off)
    rsiVal = request.security(syminfo.tickerid, tf, ta.rsi(close, rsiLength), lookahead=barmerge.lookahead_off)
    closeVal = request.security(syminfo.tickerid, tf, close, lookahead=barmerge.lookahead_off)

    maBias = closeVal > maVal ? 1 : closeVal < maVal ? -1 : 0
    rsiBias = rsiVal > rsiOB ? -1 : rsiVal < rsiOS ? 1 : 0

    [maBias, rsiBias, rsiVal]

// ============================================================================
// CALCULATIONS
// ============================================================================
// Current timeframe
currentMA = calcMA(close, maLength, maType)
currentRSI = ta.rsi(close, rsiLength)
currentMaBias = close > currentMA ? 1 : close < currentMA ? -1 : 0
currentRsiBias = currentRSI > rsiOB ? -1 : currentRSI < rsiOS ? 1 : 0

// Higher timeframes
[tf1MaBias, tf1RsiBias, tf1Rsi] = getBias(tf1)
[tf2MaBias, tf2RsiBias, tf2Rsi] = getBias(tf2)
[tf3MaBias, tf3RsiBias, tf3Rsi] = getBias(tf3)
[tf4MaBias, tf4RsiBias, tf4Rsi] = getBias(tf4)

// Overall bias calculation
totalBias = currentMaBias + tf1MaBias + tf2MaBias + tf3MaBias + tf4MaBias
overallBullish = totalBias >= 3
overallBearish = totalBias <= -3

// ============================================================================
// TABLE DISPLAY
// ============================================================================
var table mtfTable = na

if showTable and barstate.islast
    mtfTable := table.new(str.lower(tablePosition), 4, 6, bgcolor=color.new(color.black, 70), border_width=1)

    // Headers
    table.cell(mtfTable, 0, 0, "Timeframe", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 0, "MA Bias", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 2, 0, "RSI", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 0, "RSI Bias", text_color=color.white, text_size=size.small)

    // Helper function for bias color
    biasColor(bias) => bias > 0 ? bullColor : bias < 0 ? bearColor : neutralColor
    biasText(bias) => bias > 0 ? "BULL" : bias < 0 ? "BEAR" : "NEUTRAL"

    // Current TF row
    table.cell(mtfTable, 0, 1, "Current", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 1, biasText(currentMaBias), text_color=biasColor(currentMaBias), text_size=size.small)
    table.cell(mtfTable, 2, 1, str.tostring(currentRSI, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 1, biasText(currentRsiBias), text_color=biasColor(currentRsiBias), text_size=size.small)

    // TF1 row
    table.cell(mtfTable, 0, 2, tf1, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 2, biasText(tf1MaBias), text_color=biasColor(tf1MaBias), text_size=size.small)
    table.cell(mtfTable, 2, 2, str.tostring(tf1Rsi, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 2, biasText(tf1RsiBias), text_color=biasColor(tf1RsiBias), text_size=size.small)

    // TF2 row
    table.cell(mtfTable, 0, 3, tf2, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 3, biasText(tf2MaBias), text_color=biasColor(tf2MaBias), text_size=size.small)
    table.cell(mtfTable, 2, 3, str.tostring(tf2Rsi, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 3, biasText(tf2RsiBias), text_color=biasColor(tf2RsiBias), text_size=size.small)

    // TF3 row
    table.cell(mtfTable, 0, 4, tf3, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 4, biasText(tf3MaBias), text_color=biasColor(tf3MaBias), text_size=size.small)
    table.cell(mtfTable, 2, 4, str.tostring(tf3Rsi, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 4, biasText(tf3RsiBias), text_color=biasColor(tf3RsiBias), text_size=size.small)

    // TF4 row
    table.cell(mtfTable, 0, 5, tf4, text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 5, biasText(tf4MaBias), text_color=biasColor(tf4MaBias), text_size=size.small)
    table.cell(mtfTable, 2, 5, str.tostring(tf4Rsi, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 3, 5, biasText(tf4RsiBias), text_color=biasColor(tf4RsiBias), text_size=size.small)

// ============================================================================
// PLOTS
// ============================================================================
plot(currentMA, "Current MA", color=color.blue, linewidth=2)

// Background for overall bias
bgcolor(overallBullish ? color.new(bullColor, 90) : overallBearish ? color.new(bearColor, 90) : na)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(overallBullish, "MTF Bullish Alignment", "All timeframes showing bullish bias")
alertcondition(overallBearish, "MTF Bearish Alignment", "All timeframes showing bearish bias")
