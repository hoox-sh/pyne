//@version=6
// set02 corpus entry
// source_repo: TraderOracle-TradingView
// source_path: TraderOracle-TradingView/VolImb.pine
// content_hash: 6278a9036032e496
// collected: 2026-07-27
indicator(title="VolImb Dots", shorttitle="VolImb Dots", overlay=true, max_bars_back = 1000, max_lines_count = 500, max_labels_count = 500)

redCandle = close < open
greenCandle = close > open

if (redCandle and barstate.isconfirmed)
    if (redCandle[1] and open < close[1])
        plotshape(1, title="E", text="E", location=location.abovebar, style=shape.labeldown, size=size.tiny, color=color.red, textcolor=color.white)

if (greenCandle and barstate.isconfirmed)
    if (greenCandle[1] and open > close[1])
        plotshape(1, title="E", text="E", location=location.belowbar, style=shape.labelup, size=size.tiny, color=color.green, textcolor=color.white)

alertcondition(bNewGap, "Volume Imbalance Drop", "Volume Imbalance Drop")
