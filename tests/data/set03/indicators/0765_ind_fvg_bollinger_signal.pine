// set03 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/projects/fvg-bollinger-signal.pine
// content_hash: 293f5b0fdef4a306
// collected: 2026-07-27
// built with PineScript Agents by TradersPost
//@version=6
indicator(title="TylerG FVG BB Reversal",
     shorttitle="TylerG FVG BB",
     overlay=true,
     max_boxes_count=500,
     max_labels_count=50)

// ============================================================================
// INPUTS
// ============================================================================

// Bollinger Bands Settings
bbGroup = "Bollinger Bands"
bbLength = input.int(50, "Length", minval=1, group=bbGroup,
     tooltip="Number of bars for Bollinger Band calculation")
bbMAType = input.string("EMA", "Basis MA Type", options=["SMA", "EMA", "RMA", "WMA"],
     group=bbGroup, tooltip="Moving average type for the basis line")
bbSource = input.source(close, "Source", group=bbGroup,
     tooltip="Source for Bollinger Band calculation")
bbStdDev = input.float(2.0, "StdDev", minval=0.1, step=0.1,
     group=bbGroup, tooltip="Standard deviation multiplier for band width")
bbOffset = input.int(0, "Offset", minval=-500, maxval=500, group=bbGroup,
     tooltip="Offset the Bollinger Bands forward or backward")

// FVG Settings
fvgGroup = "Fair Value Gap Settings"
showBullishFVG = input.bool(true, "Show Bullish FVGs Outside BB", group=fvgGroup,
     tooltip="Display bullish FVGs that form above the upper Bollinger Band")
showBearishFVG = input.bool(true, "Show Bearish FVGs Outside BB", group=fvgGroup,
     tooltip="Display bearish FVGs that form below the lower Bollinger Band")

// Signal Settings
signalGroup = "Signal Settings"
fvgThreshold = input.int(3, "FVG Count for Signal", minval=1, maxval=5,
     group=signalGroup, tooltip="Number of FVGs outside bands required to generate prepare signal")
mitigationType = input.string("Close Through", "FVG Mitigation Type",
     options=["Touch", "Cross Through", "Close Through"],
     group=signalGroup,
     tooltip="When FVG boxes stop extending: Touch: Price enters FVG gap | Cross Through: Price crosses entire gap | Close Through: Candle closes through gap")
signalType = input.string("On FVG Mitigation", "Signal Trigger",
     options=["On FVG Mitigation", "Price Back in BB"],
     group=signalGroup,
     tooltip="On FVG Mitigation: BUY/SELL fires when first FVG is mitigated | Price Back in BB: BUY/SELL fires when price closes back inside Bollinger Bands")
resetOnSignal = input.bool(true, "Reset Count on Signal", group=signalGroup,
     tooltip="Reset FVG counter after signal fires")
requireConsecutive = input.bool(true, "Require Consecutive FVGs", group=signalGroup,
     tooltip="Only count FVGs that are separated by at least 1 candle gap (prevents overlapping FVG patterns from counting multiple times)")
fvgExpiryBars = input.int(15, "FVG Expiry (Bars)", minval=1, maxval=100, group=signalGroup,
     tooltip="FVG must be mitigated within this many bars from creation, or signal is invalidated")
showExpiryZone = input.bool(true, "Show Expiry Zone", group=signalGroup,
     tooltip="Draw subtle line showing when FVG expires")
waitForConfirmation = input.bool(true, "Wait for Bar Confirmation", group=signalGroup,
     tooltip="Only trigger FVG detection, signals, and alerts after bar closes (recommended to avoid repainting)")

// Color Settings
colorGroup = "Colors"
bullishFVGColor = input.color(color.new(color.green, 80), "Bullish FVG",
     group=colorGroup)
bearishFVGColor = input.color(color.new(color.red, 80), "Bearish FVG",
     group=colorGroup)
bbUpperColor = input.color(color.new(color.blue, 0), "BB Upper Band",
     group=colorGroup)
bbMiddleColor = input.color(color.new(color.gray, 0), "BB Middle Band",
     group=colorGroup)
bbLowerColor = input.color(color.new(color.blue, 0), "BB Lower Band",
     group=colorGroup)

// Alert Settings
alertGroup = "Alerts"
enableAlerts = input.bool(true, "Enable Alerts", group=alertGroup)

// Multi-Timeframe Dashboard Settings
dashboardGroup = "Multi-Timeframe Dashboard"
showDashboard = input.bool(true, "Show Dashboard", group=dashboardGroup,
     tooltip="Display multi-timeframe FVG status dashboard")
dashboardPosition = input.string("Top Right", "Dashboard Position",
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"],
     group=dashboardGroup)
enableTF1 = input.bool(true, "Enable Timeframe 1", group=dashboardGroup)
tf1 = input.timeframe("5", "Timeframe 1", group=dashboardGroup)
enableTF2 = input.bool(true, "Enable Timeframe 2", group=dashboardGroup)
tf2 = input.timeframe("15", "Timeframe 2", group=dashboardGroup)
enableTF3 = input.bool(true, "Enable Timeframe 3", group=dashboardGroup)
tf3 = input.timeframe("60", "Timeframe 3", group=dashboardGroup)
enableTF4 = input.bool(false, "Enable Timeframe 4", group=dashboardGroup)
tf4 = input.timeframe("240", "Timeframe 4", group=dashboardGroup)
enableTF5 = input.bool(false, "Enable Timeframe 5", group=dashboardGroup)
tf5 = input.timeframe("D", "Timeframe 5", group=dashboardGroup)
enableMTFAlerts = input.bool(true, "Enable Multi-Timeframe Alerts", group=dashboardGroup,
     tooltip="Enable alerts for all active timeframes")

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Function to calculate FVG metrics for any timeframe
// Returns: [bullishCount, bearishCount, prepBuyActive, prepSellActive, barsSincePrepBuy, barsSincePrepSell,
//           prepBuySignal, prepSellSignal, bullishFVGOutside, bearishFVGOutside, bullishFVGTop, bullishFVGBottom,
//           bearishFVGTop, bearishFVGBottom, bbUpper, bbLower, bbBasis]
f_calculateFVGMetrics() =>
    // Bollinger Bands calculation
    _bbBasis = switch bbMAType
        "SMA" => ta.sma(bbSource, bbLength)
        "EMA" => ta.ema(bbSource, bbLength)
        "RMA" => ta.rma(bbSource, bbLength)
        "WMA" => ta.wma(bbSource, bbLength)
        => ta.ema(bbSource, bbLength)

    _bbDev = ta.stdev(bbSource, bbLength)
    _bbUpper = _bbBasis + bbStdDev * _bbDev
    _bbLower = _bbBasis - bbStdDev * _bbDev

    // FVG Detection
    _bullishFVG = low > high[2]
    _bullishFVGTop = _bullishFVG ? low : na
    _bullishFVGBottom = _bullishFVG ? high[2] : na

    _bearishFVG = high < low[2]
    _bearishFVGTop = _bearishFVG ? low[2] : na
    _bearishFVGBottom = _bearishFVG ? high : na

    // Check if FVG is outside Bollinger Bands
    _bullishFVGOutside = _bullishFVG and (low > _bbUpper[1] or high[2] > _bbUpper[1]) and low[1] > _bbUpper[1]
    _bearishFVGOutside = _bearishFVG and (high < _bbLower[1] or low[2] < _bbLower[1]) and high[1] < _bbLower[1]

    // Track FVG counts using var for persistence
    var int _bullishFVGCount = 0
    var int _bearishFVGCount = 0
    var int _lastBullishFVGBar = -999
    var int _lastBearishFVGBar = -999

    // Track prepare states
    var bool _prepareBuyActive = false
    var bool _prepareSellActive = false
    var int _prepareBuyBar = -1
    var int _prepareSellBar = -1

    // Reset counters when price closes back inside Bollinger Bands
    if close >= _bbLower and close <= _bbUpper
        _bullishFVGCount := 0
        _bearishFVGCount := 0
        _lastBullishFVGBar := -999
        _lastBearishFVGBar := -999

    // Handle consecutive FVG requirement
    if requireConsecutive
        if _bullishFVGCount > 0 and _lastBullishFVGBar >= 0
            if not _bullishFVGOutside or (bar_index - _lastBullishFVGBar != 1)
                if bar_index != _lastBullishFVGBar
                    _bullishFVGCount := 0
                    _lastBullishFVGBar := -999

        if _bearishFVGCount > 0 and _lastBearishFVGBar >= 0
            if not _bearishFVGOutside or (bar_index - _lastBearishFVGBar != 1)
                if bar_index != _lastBearishFVGBar
                    _bearishFVGCount := 0
                    _lastBearishFVGBar := -999

    // Increment counters when FVG occurs outside bands
    if _bullishFVGOutside and (not waitForConfirmation or barstate.isconfirmed)
        _canCount = not requireConsecutive or _lastBullishFVGBar < 0 or (bar_index - _lastBullishFVGBar == 1)
        if _canCount
            _bullishFVGCount += 1
            _lastBullishFVGBar := bar_index

    if _bearishFVGOutside and (not waitForConfirmation or barstate.isconfirmed)
        _canCount = not requireConsecutive or _lastBearishFVGBar < 0 or (bar_index - _lastBearishFVGBar == 1)
        if _canCount
            _bearishFVGCount += 1
            _lastBearishFVGBar := bar_index

    // Generate prepare signals
    _prepareBuySignal = _bearishFVGCount >= fvgThreshold and not _prepareBuyActive
    _prepareSellSignal = _bullishFVGCount >= fvgThreshold and not _prepareSellActive

    // Activate prepare states
    if _prepareBuySignal and (not waitForConfirmation or barstate.isconfirmed)
        _prepareBuyActive := true
        _prepareBuyBar := bar_index

    if _prepareSellSignal and (not waitForConfirmation or barstate.isconfirmed)
        _prepareSellActive := true
        _prepareSellBar := bar_index

    // Calculate bars since prep signals
    _barsSincePrepBuy = _prepareBuyActive ? bar_index - _prepareBuyBar : -1
    _barsSincePrepSell = _prepareSellActive ? bar_index - _prepareSellBar : -1

    // Auto-reset prepare states only when expiry time is reached
    // Mitigation-based resets are handled by the chart code after checking FVG arrays
    if _prepareBuyActive and _barsSincePrepBuy > fvgExpiryBars
        _prepareBuyActive := false
        _prepareBuyBar := -1
        _bearishFVGCount := 0
        _lastBearishFVGBar := -999

    if _prepareSellActive and _barsSincePrepSell > fvgExpiryBars
        _prepareSellActive := false
        _prepareSellBar := -1
        _bullishFVGCount := 0
        _lastBullishFVGBar := -999

    // Return comprehensive metrics (17 values)
    [_bullishFVGCount, _bearishFVGCount, _prepareBuyActive, _prepareSellActive, _barsSincePrepBuy, _barsSincePrepSell,
     _prepareBuySignal, _prepareSellSignal, _bullishFVGOutside, _bearishFVGOutside, _bullishFVGTop, _bullishFVGBottom,
     _bearishFVGTop, _bearishFVGBottom, _bbUpper, _bbLower, _bbBasis]

// Simplified function for MTF dashboard - returns only 6 values to avoid tuple size limits
f_getMTFDashboardData() =>
    [_bullishFVGCount, _bearishFVGCount, _prepareBuyActive, _prepareSellActive, _barsSincePrepBuy, _barsSincePrepSell,
     _prepareBuySignal, _prepareSellSignal, _bullishFVGOutside, _bearishFVGOutside, _bullishFVGTop, _bullishFVGBottom,
     _bearishFVGTop, _bearishFVGBottom, _bbUpper, _bbLower, _bbBasis] = f_calculateFVGMetrics()
    [_bullishFVGCount, _bearishFVGCount, _prepareBuyActive, _prepareSellActive, _barsSincePrepBuy, _barsSincePrepSell]

// ============================================================================
// CALCULATIONS
// ============================================================================

// Store the chart's timeframe on first bar to detect security() context
var string chartTF = timeframe.period
// Detect if we're on the chart timeframe (not in a security() call)
isChartTimeframe = timeframe.period == chartTF

// Call function to get all metrics for chart timeframe
[bullishFVGCount, bearishFVGCount, prepareBuyActive, prepareSellActive, barsSincePrepBuy, barsSincePrepSell,
 prepareBuySignal, prepareSellSignal, bullishFVGOutside, bearishFVGOutside, bullishFVGTop, bullishFVGBottom,
 bearishFVGTop, bearishFVGBottom, bbUpper, bbLower, bbBasis] = f_calculateFVGMetrics()

// Arrays to track active FVG boxes for mitigation (chart timeframe only)
var array<box> bullishFVGBoxes = array.new<box>()
var array<float> bullishFVGTops = array.new<float>()
var array<float> bullishFVGBottoms = array.new<float>()
var array<int> bullishFVGCreationBars = array.new<int>()
var array<line> bullishFVGExpiryLines = array.new<line>()

var array<box> bearishFVGBoxes = array.new<box>()
var array<float> bearishFVGTops = array.new<float>()
var array<float> bearishFVGBottoms = array.new<float>()
var array<int> bearishFVGCreationBars = array.new<int>()
var array<line> bearishFVGExpiryLines = array.new<line>()

// Actual BUY/SELL signals fire when first FVG mitigated (handled in mitigation section below)
var bool buySignal = false
var bool sellSignal = false
buySignal := false
sellSignal := false

// Log when prep signals activate
if prepareBuySignal
    log.info("PREPARE BUY activated! bearishFVGCount={0}, threshold={1}", bearishFVGCount, fvgThreshold)

if prepareSellSignal
    log.info("PREPARE SELL activated! bullishFVGCount={0}, threshold={1}", bullishFVGCount, fvgThreshold)

// ============================================================================
// MULTI-TIMEFRAME DATA FETCHING
// ============================================================================

// Fetch FVG metrics from each timeframe using request.security()
// Using simplified function that returns only 6 values (avoids Pine Script tuple size limits)

// Timeframe 1
[tf1BullCount, tf1BearCount, tf1PrepBuy, tf1PrepSell, tf1BarsSincePrepBuy, tf1BarsSincePrepSell] = request.security(syminfo.tickerid, tf1, f_getMTFDashboardData())

// Timeframe 2
[tf2BullCount, tf2BearCount, tf2PrepBuy, tf2PrepSell, tf2BarsSincePrepBuy, tf2BarsSincePrepSell] = request.security(syminfo.tickerid, tf2, f_getMTFDashboardData())

// Timeframe 3
[tf3BullCount, tf3BearCount, tf3PrepBuy, tf3PrepSell, tf3BarsSincePrepBuy, tf3BarsSincePrepSell] = request.security(syminfo.tickerid, tf3, f_getMTFDashboardData())

// Timeframe 4
[tf4BullCount, tf4BearCount, tf4PrepBuy, tf4PrepSell, tf4BarsSincePrepBuy, tf4BarsSincePrepSell] = request.security(syminfo.tickerid, tf4, f_getMTFDashboardData())

// Timeframe 5
[tf5BullCount, tf5BearCount, tf5PrepBuy, tf5PrepSell, tf5BarsSincePrepBuy, tf5BarsSincePrepSell] = request.security(syminfo.tickerid, tf5, f_getMTFDashboardData())

// ============================================================================
// PLOTS
// ============================================================================

// Plot Bollinger Bands
p_upper = plot(bbUpper, "BB Upper", color=bbUpperColor, linewidth=1, offset=bbOffset)
p_basis = plot(bbBasis, "BB Middle", color=bbMiddleColor, linewidth=1, offset=bbOffset)
p_lower = plot(bbLower, "BB Lower", color=bbLowerColor, linewidth=1, offset=bbOffset)

// Fill between bands
fill(p_upper, p_lower, color=color.new(color.blue, 95), title="BB Fill")

// Check for "Price Back in BB" signal type
if signalType == "Price Back in BB"
    if prepareBuyActive and close >= bbLower and close <= bbUpper
        buySignal := true

    if prepareSellActive and close >= bbLower and close <= bbUpper
        sellSignal := true

// Check for FVG mitigation, expiry, and update boxes
// Use data arrays (not box arrays) so this works in all timeframe contexts
if array.size(bullishFVGTops) > 0
    for i = array.size(bullishFVGTops) - 1 to 0
        boxTop = array.get(bullishFVGTops, i)
        boxBottom = array.get(bullishFVGBottoms, i)
        creationBar = array.get(bullishFVGCreationBars, i)
        barsElapsed = bar_index - creationBar
        isExpired = barsElapsed > fvgExpiryBars

        // Determine if bullish FVG is mitigated based on selected type
        // Bullish FVG: gap from high[2] (bottom) to low (top)
        isMitigated = false
        if mitigationType == "Touch"
            isMitigated := low <= boxTop  // Price touches top of gap
        else if mitigationType == "Cross Through"
            isMitigated := low <= boxBottom  // Price crosses through entire gap
        else if mitigationType == "Close Through"
            isMitigated := close <= boxBottom  // Candle closes through gap

        // Fire signal only if mitigated within expiry window
        if isMitigated and not isExpired
            // Fire SELL signal if we're in prepare sell state AND signal type is "On FVG Mitigation"
            if prepareSellActive and signalType == "On FVG Mitigation"
                sellSignal := true

        // Remove FVG if mitigated or expired
        if isMitigated or isExpired
            // Update visual elements on chart timeframe only
            if isChartTimeframe and array.size(bullishFVGBoxes) > i
                fvgBox = array.get(bullishFVGBoxes, i)
                box.set_right(fvgBox, time)
                box.set_extend(fvgBox, extend.none)
                // Delete expiry line if exists
                if array.size(bullishFVGExpiryLines) > i
                    expiryLine = array.get(bullishFVGExpiryLines, i)
                    if not na(expiryLine)
                        line.delete(expiryLine)
                    array.remove(bullishFVGExpiryLines, i)
                array.remove(bullishFVGBoxes, i)
            // Remove data arrays in all contexts
            array.remove(bullishFVGTops, i)
            array.remove(bullishFVGBottoms, i)
            array.remove(bullishFVGCreationBars, i)

if array.size(bearishFVGTops) > 0
    for i = array.size(bearishFVGTops) - 1 to 0
        boxTop = array.get(bearishFVGTops, i)
        boxBottom = array.get(bearishFVGBottoms, i)
        creationBar = array.get(bearishFVGCreationBars, i)
        barsElapsed = bar_index - creationBar
        isExpired = barsElapsed > fvgExpiryBars

        // Determine if bearish FVG is mitigated based on selected type
        // Bearish FVG: gap from high (bottom) to low[2] (top)
        isMitigated = false
        if mitigationType == "Touch"
            isMitigated := high >= boxBottom  // Price touches bottom of gap
        else if mitigationType == "Cross Through"
            isMitigated := high >= boxTop  // Price crosses through entire gap
        else if mitigationType == "Close Through"
            isMitigated := close >= boxTop  // Candle closes through gap

        // Fire signal only if mitigated within expiry window
        if isMitigated and not isExpired
            // Fire BUY signal if we're in prepare buy state AND signal type is "On FVG Mitigation"
            if prepareBuyActive and signalType == "On FVG Mitigation"
                buySignal := true

        // Remove FVG if mitigated or expired
        if isMitigated or isExpired
            // Update visual elements on chart timeframe only
            if isChartTimeframe and array.size(bearishFVGBoxes) > i
                fvgBox = array.get(bearishFVGBoxes, i)
                box.set_right(fvgBox, time)
                box.set_extend(fvgBox, extend.none)
                // Delete expiry line if exists
                if array.size(bearishFVGExpiryLines) > i
                    expiryLine = array.get(bearishFVGExpiryLines, i)
                    if not na(expiryLine)
                        line.delete(expiryLine)
                    array.remove(bearishFVGExpiryLines, i)
                array.remove(bearishFVGBoxes, i)
            // Remove data arrays in all contexts
            array.remove(bearishFVGTops, i)
            array.remove(bearishFVGBottoms, i)
            array.remove(bearishFVGCreationBars, i)

// Draw FVG boxes with time-based coordinates - only show FVGs outside BB
// Only draw on chart timeframe and on confirmed bars if waitForConfirmation is enabled
if isChartTimeframe and (not waitForConfirmation or barstate.isconfirmed)
    if bullishFVGOutside and showBullishFVG
        // Calculate expiry time for box right edge using time() with bars_back parameter
        expiryTime = time(timeframe.period, "", -fvgExpiryBars)
        newBox = box.new(time[2], bullishFVGBottom, expiryTime, bullishFVGTop,
             xloc=xloc.bar_time, extend=extend.none,
             border_color=color.new(color.green, 50),
             bgcolor=bullishFVGColor, border_width=1)
        array.push(bullishFVGBoxes, newBox)
        array.push(bullishFVGExpiryLines, na)  // Placeholder, will draw line later if needed

    if bearishFVGOutside and showBearishFVG
        // Calculate expiry time for box right edge using time() with bars_back parameter
        expiryTime = time(timeframe.period, "", -fvgExpiryBars)
        newBox = box.new(time[2], bearishFVGBottom, expiryTime, bearishFVGTop,
             xloc=xloc.bar_time, extend=extend.none,
             border_color=color.new(color.red, 50),
             bgcolor=bearishFVGColor, border_width=1)
        array.push(bearishFVGBoxes, newBox)
        array.push(bearishFVGExpiryLines, na)  // Placeholder, will draw line later if needed

// Track FVG data in all contexts (for scanner)
// Only track on confirmed bars if waitForConfirmation is enabled
if bullishFVGOutside and showBullishFVG and (not waitForConfirmation or barstate.isconfirmed)
    array.push(bullishFVGTops, bullishFVGTop)
    array.push(bullishFVGBottoms, bullishFVGBottom)
    array.push(bullishFVGCreationBars, bar_index)

if bearishFVGOutside and showBearishFVG and (not waitForConfirmation or barstate.isconfirmed)
    array.push(bearishFVGTops, bearishFVGTop)
    array.push(bearishFVGBottoms, bearishFVGBottom)
    array.push(bearishFVGCreationBars, bar_index)

// Draw expiry line on last FVG when prepare signal is active (closest to price)
// This runs AFTER FVGs are added to arrays so we get the correct most recent FVG
if isChartTimeframe and showExpiryZone
    // For bullish FVGs (prepare sell active)
    if prepareSellActive and array.size(bullishFVGTops) > 0 and array.size(bullishFVGBoxes) > 0
        // Get the last (most recent) FVG that needs to be mitigated - closest to current price
        lastIndex = array.size(bullishFVGBoxes) - 1
        lastTop = array.get(bullishFVGTops, lastIndex)
        lastBottom = array.get(bullishFVGBottoms, lastIndex)
        lastCreationBar = array.get(bullishFVGCreationBars, lastIndex)

        // Determine line position based on mitigation type
        // For bullish FVG (sell signal): Touch = top edge, Cross/Close Through = bottom edge
        linePrice = mitigationType == "Touch" ? lastTop : lastBottom

        // Delete ALL old expiry lines first
        for i = 0 to array.size(bullishFVGExpiryLines) - 1
            oldLine = array.get(bullishFVGExpiryLines, i)
            if not na(oldLine)
                line.delete(oldLine)
            array.set(bullishFVGExpiryLines, i, na)

        // Draw new expiry line only on the last FVG
        barsAgo = bar_index - lastCreationBar
        creationTime = time(timeframe.period, "", barsAgo)
        expiryTime = time(timeframe.period, "", barsAgo - fvgExpiryBars)
        expiryLine = line.new(creationTime, linePrice, expiryTime, linePrice,
             xloc=xloc.bar_time, color=color.new(color.orange, 30),
             style=line.style_dotted, width=2)
        array.set(bullishFVGExpiryLines, lastIndex, expiryLine)

    // For bearish FVGs (prepare buy active)
    if prepareBuyActive and array.size(bearishFVGTops) > 0 and array.size(bearishFVGBoxes) > 0
        // Get the last (most recent) FVG that needs to be mitigated - closest to current price
        lastIndex = array.size(bearishFVGBoxes) - 1
        lastTop = array.get(bearishFVGTops, lastIndex)
        lastBottom = array.get(bearishFVGBottoms, lastIndex)
        lastCreationBar = array.get(bearishFVGCreationBars, lastIndex)

        // Determine line position based on mitigation type
        // For bearish FVG (buy signal): Touch = bottom edge, Cross/Close Through = top edge
        linePrice = mitigationType == "Touch" ? lastBottom : lastTop

        // Delete ALL old expiry lines first
        for i = 0 to array.size(bearishFVGExpiryLines) - 1
            oldLine = array.get(bearishFVGExpiryLines, i)
            if not na(oldLine)
                line.delete(oldLine)
            array.set(bearishFVGExpiryLines, i, na)

        // Draw new expiry line only on the last FVG
        barsAgo = bar_index - lastCreationBar
        creationTime = time(timeframe.period, "", barsAgo)
        expiryTime = time(timeframe.period, "", barsAgo - fvgExpiryBars)
        expiryLine = line.new(creationTime, linePrice, expiryTime, linePrice,
             xloc=xloc.bar_time, color=color.new(color.orange, 30),
             style=line.style_dotted, width=2)
        array.set(bearishFVGExpiryLines, lastIndex, expiryLine)

// Create labels and log when signals fire
// Only draw labels on confirmed bars if waitForConfirmation is enabled
// Prepare signals
if prepareBuySignal and (not waitForConfirmation or barstate.isconfirmed)
    label.new(bar_index, low,
         text="Prep",
         style=label.style_label_up,
         color=color.new(color.green, 50),
         textcolor=color.white,
         size=size.small)
    log.info("PREPARE BUY Signal at bar {0}: {1} bearish FVGs below lower BB (Price: {2})",
         bar_index, fvgThreshold, close)

if prepareSellSignal and (not waitForConfirmation or barstate.isconfirmed)
    label.new(bar_index, high,
         text="Prep",
         style=label.style_label_down,
         color=color.new(color.red, 50),
         textcolor=color.white,
         size=size.small)
    log.info("PREPARE SELL Signal at bar {0}: {1} bullish FVGs above upper BB (Price: {2})",
         bar_index, fvgThreshold, close)

// Actual BUY/SELL signals on FVG mitigation
if buySignal and (not waitForConfirmation or barstate.isconfirmed)
    label.new(bar_index, low,
         text="BUY",
         style=label.style_label_up,
         color=color.new(color.green, 20),
         textcolor=color.white,
         size=size.normal)
    log.info("BUY Signal at bar {0}: First bearish FVG mitigated (Price: {1})",
         bar_index, close)

if sellSignal and (not waitForConfirmation or barstate.isconfirmed)
    label.new(bar_index, high,
         text="SELL",
         style=label.style_label_down,
         color=color.new(color.red, 20),
         textcolor=color.white,
         size=size.normal)
    log.info("SELL Signal at bar {0}: First bullish FVG mitigated (Price: {1})",
         bar_index, close)

// ============================================================================
// ALERTS
// ============================================================================

// Alert conditions
// Only fire alerts on confirmed bars if waitForConfirmation is enabled
if enableAlerts and prepareBuySignal and (not waitForConfirmation or barstate.isconfirmed)
    alert("PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs below lower BB",
         alert.freq_once_per_bar)

if enableAlerts and prepareSellSignal and (not waitForConfirmation or barstate.isconfirmed)
    alert("PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs above upper BB",
         alert.freq_once_per_bar)

if enableAlerts and buySignal and (not waitForConfirmation or barstate.isconfirmed)
    alert("BUY Signal: First bearish FVG mitigated - Enter long",
         alert.freq_once_per_bar)

if enableAlerts and sellSignal and (not waitForConfirmation or barstate.isconfirmed)
    alert("SELL Signal: First bullish FVG mitigated - Enter short",
         alert.freq_once_per_bar)

// General alert condition for creating alerts in TradingView UI
alertcondition(prepareBuySignal and (not waitForConfirmation or barstate.isconfirmed), "Prepare BUY Signal",
     "PREPARE BUY: Multiple bearish FVGs below lower BB")

alertcondition(prepareSellSignal and (not waitForConfirmation or barstate.isconfirmed), "Prepare SELL Signal",
     "PREPARE SELL: Multiple bullish FVGs above upper BB")

alertcondition(buySignal and (not waitForConfirmation or barstate.isconfirmed), "BUY Signal",
     "BUY: First FVG mitigated")

alertcondition(sellSignal and (not waitForConfirmation or barstate.isconfirmed), "SELL Signal",
     "SELL: First FVG mitigated")

alertcondition((buySignal or sellSignal) and (not waitForConfirmation or barstate.isconfirmed), "Any Entry Signal",
     "BUY or SELL Signal Triggered")

// ============================================================================
// MULTI-TIMEFRAME ALERTS
// ============================================================================

// Detect new prepare signals for each timeframe (using ta.barssince to detect transitions)
tf1PrepBuyNew = enableTF1 and enableMTFAlerts and tf1PrepBuy and (not tf1PrepBuy[1] or barstate.isfirst)
tf1PrepSellNew = enableTF1 and enableMTFAlerts and tf1PrepSell and (not tf1PrepSell[1] or barstate.isfirst)

tf2PrepBuyNew = enableTF2 and enableMTFAlerts and tf2PrepBuy and (not tf2PrepBuy[1] or barstate.isfirst)
tf2PrepSellNew = enableTF2 and enableMTFAlerts and tf2PrepSell and (not tf2PrepSell[1] or barstate.isfirst)

tf3PrepBuyNew = enableTF3 and enableMTFAlerts and tf3PrepBuy and (not tf3PrepBuy[1] or barstate.isfirst)
tf3PrepSellNew = enableTF3 and enableMTFAlerts and tf3PrepSell and (not tf3PrepSell[1] or barstate.isfirst)

tf4PrepBuyNew = enableTF4 and enableMTFAlerts and tf4PrepBuy and (not tf4PrepBuy[1] or barstate.isfirst)
tf4PrepSellNew = enableTF4 and enableMTFAlerts and tf4PrepSell and (not tf4PrepSell[1] or barstate.isfirst)

tf5PrepBuyNew = enableTF5 and enableMTFAlerts and tf5PrepBuy and (not tf5PrepBuy[1] or barstate.isfirst)
tf5PrepSellNew = enableTF5 and enableMTFAlerts and tf5PrepSell and (not tf5PrepSell[1] or barstate.isfirst)

// Alert conditions for each timeframe
if tf1PrepBuyNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf1 + " PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs detected", alert.freq_once_per_bar)

if tf1PrepSellNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf1 + " PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs detected", alert.freq_once_per_bar)

if tf2PrepBuyNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf2 + " PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs detected", alert.freq_once_per_bar)

if tf2PrepSellNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf2 + " PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs detected", alert.freq_once_per_bar)

if tf3PrepBuyNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf3 + " PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs detected", alert.freq_once_per_bar)

if tf3PrepSellNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf3 + " PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs detected", alert.freq_once_per_bar)

if tf4PrepBuyNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf4 + " PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs detected", alert.freq_once_per_bar)

if tf4PrepSellNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf4 + " PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs detected", alert.freq_once_per_bar)

if tf5PrepBuyNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf5 + " PREPARE BUY: " + str.tostring(fvgThreshold) + " bearish FVGs detected", alert.freq_once_per_bar)

if tf5PrepSellNew and (not waitForConfirmation or barstate.isconfirmed)
    alert("TF " + tf5 + " PREPARE SELL: " + str.tostring(fvgThreshold) + " bullish FVGs detected", alert.freq_once_per_bar)

// Alert conditions for TradingView UI
// Note: alertcondition() requires const strings, so we use generic messages
alertcondition(tf1PrepBuyNew, "TF1 Prepare BUY", "Timeframe 1: PREPARE BUY")
alertcondition(tf1PrepSellNew, "TF1 Prepare SELL", "Timeframe 1: PREPARE SELL")
alertcondition(tf2PrepBuyNew, "TF2 Prepare BUY", "Timeframe 2: PREPARE BUY")
alertcondition(tf2PrepSellNew, "TF2 Prepare SELL", "Timeframe 2: PREPARE SELL")
alertcondition(tf3PrepBuyNew, "TF3 Prepare BUY", "Timeframe 3: PREPARE BUY")
alertcondition(tf3PrepSellNew, "TF3 Prepare SELL", "Timeframe 3: PREPARE SELL")
alertcondition(tf4PrepBuyNew, "TF4 Prepare BUY", "Timeframe 4: PREPARE BUY")
alertcondition(tf4PrepSellNew, "TF4 Prepare SELL", "Timeframe 4: PREPARE SELL")
alertcondition(tf5PrepBuyNew, "TF5 Prepare BUY", "Timeframe 5: PREPARE BUY")
alertcondition(tf5PrepSellNew, "TF5 Prepare SELL", "Timeframe 5: PREPARE SELL")

// ============================================================================
// MULTI-TIMEFRAME DASHBOARD
// ============================================================================

// Function to get table position from string
f_getTablePosition(posString) =>
    switch posString
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right

// Create dashboard table if enabled
if showDashboard and barstate.islast
    // Count how many timeframes are enabled
    tfCount = (enableTF1 ? 1 : 0) + (enableTF2 ? 1 : 0) + (enableTF3 ? 1 : 0) + (enableTF4 ? 1 : 0) + (enableTF5 ? 1 : 0)

    // Create table: 6 columns (TF, Bull FVGs, Bear FVGs, Prep Buy, Prep Sell, Bars Since) + header row + data rows
    var table dashboard = table.new(f_getTablePosition(dashboardPosition), 6, tfCount + 1,
         border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    // Clear table
    table.clear(dashboard, 0, 0, 5, tfCount)

    // Header row
    table.cell(dashboard, 0, 0, "TF", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(dashboard, 1, 0, "Bull FVGs", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(dashboard, 2, 0, "Bear FVGs", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(dashboard, 3, 0, "Prep Buy", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(dashboard, 4, 0, "Prep Sell", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)
    table.cell(dashboard, 5, 0, "Bars Ago", text_color=color.white, bgcolor=color.new(color.gray, 30), text_size=size.small)

    // Data rows
    var int rowIndex = 1
    rowIndex := 1

    // Timeframe 1
    if enableTF1
        table.cell(dashboard, 0, rowIndex, tf1, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
        table.cell(dashboard, 1, rowIndex, str.tostring(tf1BullCount), text_color=color.white,
             bgcolor=tf1BullCount > 0 ? color.new(color.green, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 2, rowIndex, str.tostring(tf1BearCount), text_color=color.white,
             bgcolor=tf1BearCount > 0 ? color.new(color.red, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 3, rowIndex, tf1PrepBuy ? "✓" : "-", text_color=color.white,
             bgcolor=tf1PrepBuy ? color.new(color.green, 50) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 4, rowIndex, tf1PrepSell ? "✓" : "-", text_color=color.white,
             bgcolor=tf1PrepSell ? color.new(color.red, 50) : color.new(color.gray, 80), text_size=size.small)
        barsAgoText = tf1PrepBuy ? str.tostring(tf1BarsSincePrepBuy) : tf1PrepSell ? str.tostring(tf1BarsSincePrepSell) : "-"
        table.cell(dashboard, 5, rowIndex, barsAgoText, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        rowIndex += 1

    // Timeframe 2
    if enableTF2
        table.cell(dashboard, 0, rowIndex, tf2, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
        table.cell(dashboard, 1, rowIndex, str.tostring(tf2BullCount), text_color=color.white,
             bgcolor=tf2BullCount > 0 ? color.new(color.green, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 2, rowIndex, str.tostring(tf2BearCount), text_color=color.white,
             bgcolor=tf2BearCount > 0 ? color.new(color.red, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 3, rowIndex, tf2PrepBuy ? "✓" : "-", text_color=color.white,
             bgcolor=tf2PrepBuy ? color.new(color.green, 50) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 4, rowIndex, tf2PrepSell ? "✓" : "-", text_color=color.white,
             bgcolor=tf2PrepSell ? color.new(color.red, 50) : color.new(color.gray, 80), text_size=size.small)
        barsAgoText = tf2PrepBuy ? str.tostring(tf2BarsSincePrepBuy) : tf2PrepSell ? str.tostring(tf2BarsSincePrepSell) : "-"
        table.cell(dashboard, 5, rowIndex, barsAgoText, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        rowIndex += 1

    // Timeframe 3
    if enableTF3
        table.cell(dashboard, 0, rowIndex, tf3, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
        table.cell(dashboard, 1, rowIndex, str.tostring(tf3BullCount), text_color=color.white,
             bgcolor=tf3BullCount > 0 ? color.new(color.green, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 2, rowIndex, str.tostring(tf3BearCount), text_color=color.white,
             bgcolor=tf3BearCount > 0 ? color.new(color.red, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 3, rowIndex, tf3PrepBuy ? "✓" : "-", text_color=color.white,
             bgcolor=tf3PrepBuy ? color.new(color.green, 50) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 4, rowIndex, tf3PrepSell ? "✓" : "-", text_color=color.white,
             bgcolor=tf3PrepSell ? color.new(color.red, 50) : color.new(color.gray, 80), text_size=size.small)
        barsAgoText = tf3PrepBuy ? str.tostring(tf3BarsSincePrepBuy) : tf3PrepSell ? str.tostring(tf3BarsSincePrepSell) : "-"
        table.cell(dashboard, 5, rowIndex, barsAgoText, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        rowIndex += 1

    // Timeframe 4
    if enableTF4
        table.cell(dashboard, 0, rowIndex, tf4, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
        table.cell(dashboard, 1, rowIndex, str.tostring(tf4BullCount), text_color=color.white,
             bgcolor=tf4BullCount > 0 ? color.new(color.green, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 2, rowIndex, str.tostring(tf4BearCount), text_color=color.white,
             bgcolor=tf4BearCount > 0 ? color.new(color.red, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 3, rowIndex, tf4PrepBuy ? "✓" : "-", text_color=color.white,
             bgcolor=tf4PrepBuy ? color.new(color.green, 50) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 4, rowIndex, tf4PrepSell ? "✓" : "-", text_color=color.white,
             bgcolor=tf4PrepSell ? color.new(color.red, 50) : color.new(color.gray, 80), text_size=size.small)
        barsAgoText = tf4PrepBuy ? str.tostring(tf4BarsSincePrepBuy) : tf4PrepSell ? str.tostring(tf4BarsSincePrepSell) : "-"
        table.cell(dashboard, 5, rowIndex, barsAgoText, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        rowIndex += 1

    // Timeframe 5
    if enableTF5
        table.cell(dashboard, 0, rowIndex, tf5, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
        table.cell(dashboard, 1, rowIndex, str.tostring(tf5BullCount), text_color=color.white,
             bgcolor=tf5BullCount > 0 ? color.new(color.green, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 2, rowIndex, str.tostring(tf5BearCount), text_color=color.white,
             bgcolor=tf5BearCount > 0 ? color.new(color.red, 70) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 3, rowIndex, tf5PrepBuy ? "✓" : "-", text_color=color.white,
             bgcolor=tf5PrepBuy ? color.new(color.green, 50) : color.new(color.gray, 80), text_size=size.small)
        table.cell(dashboard, 4, rowIndex, tf5PrepSell ? "✓" : "-", text_color=color.white,
             bgcolor=tf5PrepSell ? color.new(color.red, 50) : color.new(color.gray, 80), text_size=size.small)
        barsAgoText = tf5PrepBuy ? str.tostring(tf5BarsSincePrepBuy) : tf5PrepSell ? str.tostring(tf5BarsSincePrepSell) : "-"
        table.cell(dashboard, 5, rowIndex, barsAgoText, text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
        rowIndex += 1
