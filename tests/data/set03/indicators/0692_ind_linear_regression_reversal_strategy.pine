// set03 corpus entry
// source_repo: pinescript-agents
// source_path: pinescript-agents/projects/linear-regression-reversal-strategy.pine
// content_hash: 0bcc0fd2af8e2eaa
// collected: 2026-07-27
// built with PineScript Agents by TradersPost
//@version=6
indicator("Linear Regression Reversal Strategy",
     shorttitle="LR Reversal",
     overlay=true,
     max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// Time Selection
startTime = input.time(timestamp("2024-01-01 00:00"),
     "Start Time",
     tooltip="Click to select the beginning candle for regression calculation on the chart",
     confirm=true,
     group="Time Selection")

endTime = input.time(timestamp("2024-12-31 23:59"),
     "End Time",
     tooltip="Click to select the ending candle for regression calculation on the chart",
     confirm=true,
     group="Time Selection")

// Regression Settings
ignoreWicks = input.bool(false,
     "Ignore Wicks",
     tooltip="When enabled, uses candle body midpoint (average of open/close) instead of wicks.\nThis reduces noise from price extremes and focuses on body momentum.\nWhen disabled, uses the 'Price Source' setting below.",
     group="Regression Settings")

priceSource = input.source(close,
     "Price Source",
     tooltip="Price data for regression when 'Ignore Wicks' is disabled.\nOptions: close, open, high, low, hl2, hlc3, ohlc4, hlcc4.\nNote: This setting is ignored when 'Ignore Wicks' is enabled.",
     group="Regression Settings")

showUpperChannel = input.bool(true,
     "Upper Deviation",
     inline="upper",
     group="Regression Settings")

upperDeviation = input.float(2.0,
     "",
     minval=0.1,
     step=0.1,
     inline="upper",
     tooltip="Standard deviation multiplier for upper channel",
     group="Regression Settings")

showLowerChannel = input.bool(true,
     "Lower Deviation",
     inline="lower",
     group="Regression Settings")

lowerDeviation = input.float(2.0,
     "",
     minval=0.1,
     step=0.1,
     inline="lower",
     tooltip="Standard deviation multiplier for lower channel",
     group="Regression Settings")

// Visual Settings
regressionColor = input.color(#2962FF,
     "Regression Line Color",
     group="Visual Settings")

regressionFillColor = input.color(color.new(#2962FF, 90),
     "Regression Background Color",
     tooltip="Fill color between regression channels",
     group="Visual Settings")

upperChannelColor = input.color(color.new(#26a69a, 50),
     "Upper Channel Color",
     group="Visual Settings")

lowerChannelColor = input.color(color.new(#ef5350, 50),
     "Lower Channel Color",
     group="Visual Settings")

lineWidth = input.int(2,
     "Line Width",
     minval=1,
     maxval=5,
     tooltip="Width for all regression and channel lines",
     group="Visual Settings")

showLabel = input.bool(true,
     "Show Pearson R Label",
     tooltip="Display Pearson R coefficient on chart",
     group="Visual Settings")

labelStyle = input.string("Minimal",
     "Label Style",
     options=["Minimal", "Detailed"],
     tooltip="Minimal shows just R value, Detailed shows full statistics",
     group="Visual Settings")

labelPosition = input.string("Right",
     "Label Position",
     options=["Left", "Right", "Center"],
     tooltip="Position of Pearson R label along the regression line",
     group="Visual Settings")

showStatsTable = input.bool(false,
     "Show Statistics Table",
     tooltip="Display a table with regression statistics in the corner",
     group="Visual Settings")

tablePosition = input.string("Top Right",
     "Table Position",
     options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"],
     tooltip="Position of the statistics table on chart",
     group="Visual Settings")

// ============================================================================
// CONSTANTS
// ============================================================================

var int MAX_ARRAY_SIZE = 50000

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

isInRange(barTime, startT, endT) =>
    barTime >= startT and barTime <= endT

calcMean(arr, size) =>
    sum = 0.0
    for i = 0 to size - 1
        sum += array.get(arr, i)
    sum / size

calcPearsonR(xArr, yArr, size, xMean, yMean) =>
    covariance = 0.0
    xVariance = 0.0
    yVariance = 0.0
    for i = 0 to size - 1
        xDiff = array.get(xArr, i) - xMean
        yDiff = array.get(yArr, i) - yMean
        covariance += xDiff * yDiff
        xVariance += xDiff * xDiff
        yVariance += yDiff * yDiff
    denominator = math.sqrt(xVariance * yVariance)
    denominator != 0 ? covariance / denominator : 0.0

calcLinearRegression(xArr, yArr, size, xMean, yMean) =>
    numerator = 0.0
    denominator = 0.0
    for i = 0 to size - 1
        xDiff = array.get(xArr, i) - xMean
        yDiff = array.get(yArr, i) - yMean
        numerator += xDiff * yDiff
        denominator += xDiff * xDiff
    slope = denominator != 0 ? numerator / denominator : 0.0
    intercept = yMean - slope * xMean
    [slope, intercept]

// ============================================================================
// CALCULATIONS
// ============================================================================

effectivePrice = ignoreWicks ? math.avg(open, close) : priceSource

// Initialize arrays and variables for regression
var array<float> xValues = array.new<float>()
var array<float> yValues = array.new<float>()
var float regSlope = na
var float regIntercept = na
var float regPearsonR = na
var float regStdDev = na
var int regRangeSize = 0
var int regFirstBarIndex = na
var int regLastBarIndex = na

// Collect data points for regression (only within time range)
if isInRange(time, startTime, endTime)
    if na(regFirstBarIndex)
        regFirstBarIndex := bar_index
    regLastBarIndex := bar_index

    if array.size(xValues) < MAX_ARRAY_SIZE
        array.push(xValues, float(bar_index))
        array.push(yValues, effectivePrice)
        regRangeSize := array.size(xValues)

// Calculate regression
if regRangeSize >= 2
    xMean = calcMean(xValues, regRangeSize)
    yMean = calcMean(yValues, regRangeSize)

    [calcSlope, calcIntercept] = calcLinearRegression(xValues, yValues, regRangeSize, xMean, yMean)
    regSlope := calcSlope
    regIntercept := calcIntercept
    regPearsonR := calcPearsonR(xValues, yValues, regRangeSize, xMean, yMean)

    sumSquaredResiduals = 0.0
    for i = 0 to regRangeSize - 1
        xVal = array.get(xValues, i)
        yVal = array.get(yValues, i)
        predicted = regSlope * xVal + regIntercept
        residual = yVal - predicted
        sumSquaredResiduals += residual * residual

    regStdDev := math.sqrt(sumSquaredResiduals / regRangeSize)

// ============================================================================
// DRAWING LINES
// ============================================================================

var line regressionLine = na
var line upperChannelLine = na
var line lowerChannelLine = na
var linefill channelFill = na

if barstate.islast
    if not na(regressionLine)
        line.delete(regressionLine)
    if not na(upperChannelLine)
        line.delete(upperChannelLine)
    if not na(lowerChannelLine)
        line.delete(lowerChannelLine)
    if not na(channelFill)
        linefill.delete(channelFill)

// Draw regression and channel lines
if regRangeSize >= 2 and barstate.islast
    startY = regSlope * regFirstBarIndex + regIntercept
    endY = regSlope * regLastBarIndex + regIntercept

    regressionLine := line.new(regFirstBarIndex, startY, regLastBarIndex, endY, color=regressionColor, width=lineWidth, style=line.style_solid)

    if showUpperChannel
        upperStartY = startY + upperDeviation * regStdDev
        upperEndY = endY + upperDeviation * regStdDev
        upperChannelLine := line.new(regFirstBarIndex, upperStartY, regLastBarIndex, upperEndY, color=upperChannelColor, width=lineWidth, style=line.style_solid)

    if showLowerChannel
        lowerStartY = startY - lowerDeviation * regStdDev
        lowerEndY = endY - lowerDeviation * regStdDev
        lowerChannelLine := line.new(regFirstBarIndex, lowerStartY, regLastBarIndex, lowerEndY, color=lowerChannelColor, width=lineWidth, style=line.style_solid)

    if showUpperChannel and showLowerChannel
        channelFill := linefill.new(upperChannelLine, lowerChannelLine, color=regressionFillColor)

// ============================================================================
// PEARSON R LABEL
// ============================================================================

var label pearsonLabel = na
if not na(pearsonLabel)
    label.delete(pearsonLabel)

if showLabel and regRangeSize >= 2 and barstate.islast and not na(regPearsonR)
    labelX = labelPosition == "Left" ? regFirstBarIndex : labelPosition == "Right" ? regLastBarIndex : int(math.avg(regFirstBarIndex, regLastBarIndex))

    labelRegY = regSlope * labelX + regIntercept
    labelY = labelRegY + (showUpperChannel ? upperDeviation * regStdDev : regStdDev)

    rValue = regPearsonR
    labelColor = math.abs(rValue) >= 0.8 ? color.new(color.green, 20) : math.abs(rValue) >= 0.5 ? color.new(color.orange, 20) : color.new(color.red, 20)

    labelText = if labelStyle == "Minimal"
        str.format("R: {0,number,#.####}", rValue)
    else
        interpretation = math.abs(rValue) >= 0.8 ? "Strong" : math.abs(rValue) >= 0.5 ? "Moderate" : "Weak"
        direction = rValue >= 0 ? "Positive" : "Negative"
        str.format("{0} {1}\nR: {2,number,#.####}\nR²: {3,number,#.####}\nBars: {4}", direction, interpretation, rValue, rValue * rValue, regRangeSize)

    pearsonLabel := label.new(labelX, labelY, text=labelText, style=label.style_label_down, color=labelColor, textcolor=color.white, size=labelStyle == "Minimal" ? size.small : size.normal, textalign=text.align_center)

// ============================================================================
// ALERTS
// ============================================================================

strongCorrelation = regRangeSize >= 2 and math.abs(regPearsonR) >= 0.8

alertcondition(strongCorrelation, title="Strong Correlation Detected", message="Pearson R = {{plot_0}}")

// ============================================================================
// PLOTS (for data window)
// ============================================================================

plot(regPearsonR, title="Pearson R", display=display.data_window)
plot(regSlope, title="Slope", display=display.data_window)
plot(regRangeSize, title="Sample Size", display=display.data_window)

// ============================================================================
// STATISTICS TABLE
// ============================================================================

var table statsTable = na
if not na(statsTable)
    table.delete(statsTable)

if showStatsTable and barstate.islast and regRangeSize >= 2
    tablePos = tablePosition == "Top Left" ? position.top_left : tablePosition == "Top Right" ? position.top_right : tablePosition == "Bottom Left" ? position.bottom_left : position.bottom_right

    statsTable := table.new(tablePos, 2, 5, bgcolor=color.new(color.black, 85), border_width=1, border_color=color.new(color.gray, 50))

    table.cell(statsTable, 0, 0, "Regression Statistics", text_color=color.white, text_size=size.normal, bgcolor=color.new(#2962FF, 70))
    table.merge_cells(statsTable, 0, 0, 1, 0)

    table.cell(statsTable, 0, 1, "Pearson R", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 1, str.format("{0,number,#.####}", regPearsonR), text_color=color.white, text_size=size.small)

    table.cell(statsTable, 0, 2, "R²", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 2, str.format("{0,number,#.####}", regPearsonR * regPearsonR), text_color=color.white, text_size=size.small)

    table.cell(statsTable, 0, 3, "Slope", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 3, str.format("{0,number,#.######}", regSlope), text_color=color.white, text_size=size.small)

    table.cell(statsTable, 0, 4, "Bars", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 4, str.tostring(regRangeSize), text_color=color.white, text_size=size.small)

// ============================================================================
// WARNINGS
// ============================================================================

var label warningLabel = na
if not na(warningLabel)
    label.delete(warningLabel)

if barstate.islast and regRangeSize < 2 and isInRange(time, startTime, endTime)
    warningLabel := label.new(bar_index, high, text="⚠ Insufficient data for regression\nNeed at least 2 data points", style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.normal)

if barstate.islast and startTime >= endTime
    warningLabel := label.new(bar_index, high, text="⚠ Invalid time range\nStart time must be before end time", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)
