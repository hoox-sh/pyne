// built with PineScript Agents by TradersPost
//@version=6

// ============================================================================
// AUTO FIBONACCI (RETRACEMENT + EXTENSION)
// ----------------------------------------------------------------------------
// Merges TradingView's native Auto Fib Retracement and Auto Fib Extension into
// ONE overlay. From a single detected swing it draws the full ratio set:
// retracements (0 -> 1) AND extensions in both directions (>1 and <0), so you
// see pullback zones and how far price may run either way from one anchor.
//
// HISTORY (the headline feature): when a new swing forms, the old Fib set is
// NOT discarded. It is frozen into a faded "stair-step" segment spanning only
// the time it was the active swing, while the new set takes over live. You keep
// a visible record of where price reacted before instead of losing it.
//
// ANCHOR MODES:
//   * Auto Pivot       - zigzag pivots (Depth + optional ATR deviation filter).
//   * Timeframe Anchored - capture each completed period's high/low (e.g. "D").
//
// DISPLAY: full levels, "Markers Only" (decluttered - hides lines, drops a
// marker when price rejects off a key level), or both.
//
// COLOR: monochromatic by default (one base hue; key levels brighter/bolder,
// extensions dashed) to avoid the native rainbow. Per-level colors available.
//
// REPAINTING: Auto-Pivot anchors confirm `Depth` bars after the swing (standard
// for pivot detection). Timeframe mode uses the COMPLETED prior period
// (lookahead_off). The live set's right edge extends each bar BY DESIGN; level
// prices are frozen at anchor creation. Markers evaluate on confirmed bars.
// ============================================================================

indicator("Auto Fibonacci (Retracement + Extension)", "Auto Fib", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500,
     max_bars_back=500)

// ============================================================================
// INPUTS
// ============================================================================

// --- Anchor -----------------------------------------------------------------
gAnchor = "Anchor"
anchorMode = input.string("Auto Pivot", "Anchor Mode",
     options=["Auto Pivot", "Timeframe Anchored"],
     tooltip="How the swing (high & low) is found. 'Auto Pivot' uses zigzag pivot detection on the chart timeframe. 'Timeframe Anchored' rebuilds the Fib from each completed higher-timeframe period's high/low.",
     group=gAnchor)
pivotDepth = input.int(15, "Pivot Depth", minval=2, maxval=100,
     active = anchorMode == "Auto Pivot",
     tooltip="Bars to the left AND right required to confirm a swing pivot. Larger = fewer, more significant swings. Note: a pivot only confirms this many bars after it forms.",
     group=gAnchor)
useDeviation = input.bool(false, "Use Deviation Filter",
     active = anchorMode == "Auto Pivot",
     tooltip="Reject a new pivot unless the swing range from the opposite pivot is at least Deviation x ATR(14). Filters out tiny noise swings.",
     group=gAnchor)
devMult = input.float(3.0, "Deviation (ATR mult)", minval=0.0, step=0.5,
     active = anchorMode == "Auto Pivot" and useDeviation,
     group=gAnchor)
anchorTF = input.timeframe("D", "Anchor Timeframe",
     active = anchorMode == "Timeframe Anchored",
     tooltip="Only used in 'Timeframe Anchored' mode. Each time this timeframe closes, the just-completed period's high & low become the new Fib anchor.",
     group=gAnchor)

// --- History ----------------------------------------------------------------
gHist = "History"
historyDepth = input.int(3, "History Depth", minval=0, maxval=8,
     tooltip="How many PRIOR Fib sets to keep on the chart as faded stair-step segments. 0 = only the live set.",
     group=gHist)
fadeStep = input.int(15, "Extra Fade Per Age (%)", minval=0, maxval=30,
     tooltip="Each older history set gets this much more transparency than the one after it.",
     group=gHist)
historyWidth = input.int(1, "Historical Line Width", minval=1, maxval=3,
     group=gHist)

// --- Display ----------------------------------------------------------------
gDisp = "Display"
displayMode = input.string("Both", "Display Mode",
     options=["Levels", "Markers Only", "Both"],
     tooltip="'Levels' = lines only. 'Markers Only' = hide all lines, just mark bounces off key levels (decluttered). 'Both' = lines + markers.",
     group=gDisp)
extendRight = input.bool(true, "Extend Live Set Right", group=gDisp)
rightBars = input.int(20, "Right Extension (bars)", minval=0, maxval=200,
     active = extendRight,
     group=gDisp)
lineWidth = input.int(1, "Live Line Width", minval=1, maxval=4, group=gDisp)
showRatios = input.bool(true, "Show Level Ratios", group=gDisp)
showPrices = input.bool(true, "Show Prices", group=gDisp)
labelPos = input.string("Right", "Label Position", options=["Left", "Right"],
     group=gDisp)
showFills = input.bool(true, "Show Band Fills", group=gDisp)
fillTransp = input.int(90, "Band Fill Transparency", minval=0, maxval=100,
     active = showFills,
     group=gDisp)

// --- Color ------------------------------------------------------------------
gColor = "Color"
monoMode = input.bool(true, "Monochrome (off = native colors)",
     tooltip="ON (recommended): all levels use one Base Color; key levels render brighter/bolder and extensions are dashed. OFF: use the per-level colors below, rendered as uniform solid lines exactly like TradingView's native Auto Fib.",
     group=gColor)
baseColor = input.color(color.new(color.gray, 0), "Base Color",
     active = monoMode,
     group=gColor)
nonKeyTransp = input.int(35, "Non-Key Transparency", minval=0, maxval=90,
     active = monoMode,
     tooltip="Transparency applied to non-key levels in monochrome mode so key levels stand out.",
     group=gColor)

// --- Markers ----------------------------------------------------------------
gMark = "Markers"
tolMode = input.string("Ticks", "Tolerance Mode", options=["Ticks", "% of Range"],
     tooltip="How close price must get to a key level to count as a touch.",
     group=gMark)
tolTicks = input.int(4, "Tolerance (ticks)", minval=0,
     active = tolMode == "Ticks",
     group=gMark)
tolPct = input.float(2.0, "Tolerance (% of swing range)", minval=0.0, step=0.1,
     active = tolMode == "% of Range",
     group=gMark)

// --- Alerts -----------------------------------------------------------------
gAlert = "Alerts"
alertCrossOn = input.bool(true, "Alert: Level Crossings", group=gAlert)
alertKeyOnly = input.bool(false, "Crossings: Key Levels Only",
     active = alertCrossOn,
     group=gAlert)
alertBounceOn = input.bool(true, "Alert: Bounces / Reversals", group=gAlert)

// --- Levels (enable + per-level color) --------------------------------------
// Per-level color defaults match TradingView's native Auto Fib palette exactly.
gLv = "Levels"
en_n0618 = input.bool(false, "-0.618", inline="n0618", group=gLv)
co_n0618 = input.color(#009688, "", inline="n0618", group=gLv)
en_n0382 = input.bool(false, "-0.382", inline="n0382", group=gLv)
co_n0382 = input.color(#81c784, "", inline="n0382", group=gLv)
en_n0236 = input.bool(false, "-0.236", inline="n0236", group=gLv)
co_n0236 = input.color(#f44336, "", inline="n0236", group=gLv)
en_0     = input.bool(true,  "0",      inline="p0",    group=gLv)
co_0     = input.color(#787b86, "", inline="p0",    group=gLv)
en_0236  = input.bool(true,  "0.236",  inline="p0236", group=gLv)
co_0236  = input.color(#f44336, "", inline="p0236", group=gLv)
en_0382  = input.bool(true,  "0.382",  inline="p0382", group=gLv)
co_0382  = input.color(#81c784, "", inline="p0382", group=gLv)
en_05    = input.bool(true,  "0.5",    inline="p05",   group=gLv)
co_05    = input.color(#4caf50, "", inline="p05",   group=gLv)
en_0618  = input.bool(true,  "0.618",  inline="p0618", group=gLv)
co_0618  = input.color(#009688, "", inline="p0618", group=gLv)
en_0786  = input.bool(true,  "0.786",  inline="p0786", group=gLv)
co_0786  = input.color(#64b5f6, "", inline="p0786", group=gLv)
en_1     = input.bool(true,  "1",      inline="p1",    group=gLv)
co_1     = input.color(#787b86, "", inline="p1",    group=gLv)
en_1272  = input.bool(false, "1.272",  inline="p1272", group=gLv)
co_1272  = input.color(#81c784, "", inline="p1272", group=gLv)
en_1414  = input.bool(false, "1.414",  inline="p1414", group=gLv)
co_1414  = input.color(#f44336, "", inline="p1414", group=gLv)
en_1618  = input.bool(true,  "1.618",  inline="p1618", group=gLv)
co_1618  = input.color(#2962ff, "", inline="p1618", group=gLv)
en_2618  = input.bool(true,  "2.618",  inline="p2618", group=gLv)
co_2618  = input.color(#f44336, "", inline="p2618", group=gLv)
en_3618  = input.bool(true,  "3.618",  inline="p3618", group=gLv)
co_3618  = input.color(#9c27b0, "", inline="p3618", group=gLv)
en_4236  = input.bool(true,  "4.236",  inline="p4236", group=gLv)
co_4236  = input.color(#e91e63, "", inline="p4236", group=gLv)

// ============================================================================
// USER DEFINED TYPES
// ============================================================================

// Config for a single Fibonacci ratio (built once from the inputs above).
type FibLevel
    float ratio
    bool  enabled
    color col
    bool  isKey      // part of the key subset (markers + key-only alerts)

// One anchored Fibonacci instance - either the live set or a frozen history set.
type FibSet
    float hiPrice
    float loPrice
    int   hiTime          // bar_time of the swing high
    int   loTime          // bar_time of the swing low
    bool  newIsHigh       // true if the HIGH is the more recent extreme
    int   startTime       // when this set became the active swing
    int   endTime         // when the next set replaced it (na while live)
    bool  isLive
    array<line>     lines
    array<label>    labels
    array<linefill> fills
    array<float>    ratios   // ratio of each drawn line (parallel to `lines`)
    array<color>    baseCols // base color of each drawn line (parallel to `lines`)

// ============================================================================
// LEVEL CONFIG
// ============================================================================
// Key levels (used for markers and "key levels only" alerts): 0.382/0.5/0.618/0.786.

buildConfig() =>
    a = array.new<FibLevel>()
    array.push(a, FibLevel.new(-0.618, en_n0618, co_n0618, false))
    array.push(a, FibLevel.new(-0.382, en_n0382, co_n0382, false))
    array.push(a, FibLevel.new(-0.236, en_n0236, co_n0236, false))
    array.push(a, FibLevel.new(0.0,    en_0,     co_0,     false))
    array.push(a, FibLevel.new(0.236,  en_0236,  co_0236,  false))
    array.push(a, FibLevel.new(0.382,  en_0382,  co_0382,  true))
    array.push(a, FibLevel.new(0.5,    en_05,    co_05,    true))
    array.push(a, FibLevel.new(0.618,  en_0618,  co_0618,  true))
    array.push(a, FibLevel.new(0.786,  en_0786,  co_0786,  true))
    array.push(a, FibLevel.new(1.0,    en_1,     co_1,     false))
    array.push(a, FibLevel.new(1.272,  en_1272,  co_1272,  false))
    array.push(a, FibLevel.new(1.414,  en_1414,  co_1414,  false))
    array.push(a, FibLevel.new(1.618,  en_1618,  co_1618,  false))
    array.push(a, FibLevel.new(2.618,  en_2618,  co_2618,  false))
    array.push(a, FibLevel.new(3.618,  en_3618,  co_3618,  false))
    array.push(a, FibLevel.new(4.236,  en_4236,  co_4236,  false))
    a

var array<FibLevel> cfg = buildConfig()
var array<FibSet> history = array.new<FibSet>()
var FibSet live = na

// Bar duration in ms (for projecting the live right edge).
var int barMs = na
if not na(time) and not na(time[1])
    barMs := time - time[1]
barMsSafe = na(barMs) ? (timeframe.in_seconds(timeframe.period) * 1000) : barMs

// ============================================================================
// HELPER FUNCTIONS / METHODS
// ============================================================================

// Map a ratio to a price. 0 = older anchor, 1 = newer anchor, so >1 projects
// beyond the newer extreme (trend continuation) and <0 beyond the older one.
priceForRatio(FibSet s, float r) =>
    pNew = s.newIsHigh ? s.hiPrice : s.loPrice
    pOld = s.newIsHigh ? s.loPrice : s.hiPrice
    pOld + r * (pNew - pOld)

// Color for a level, honoring monochrome mode.
levelColor(FibLevel lv) =>
    monoMode ? color.new(baseColor, lv.isKey ? 0 : nonKeyTransp) : color.new(lv.col, 0)

// Label text: "0.618 (30127.75)" depending on toggles.
levelText(float r, float price) =>
    rt = showRatios ? str.tostring(r) : ""
    pt = showPrices ? "(" + str.tostring(price, format.mintick) + ")" : ""
    sep = (showRatios and showPrices) ? " " : ""
    rt + sep + pt

// Tolerance band (price units) for marker touch detection.
tolerance(FibSet s) =>
    rng = math.abs(s.hiPrice - s.loPrice)
    tolMode == "Ticks" ? tolTicks * syminfo.mintick : rng * tolPct / 100.0

// Right-edge time for the live set.
liveRightTime() =>
    extendRight ? time + barMsSafe * rightBars : time

// Delete every drawing owned by a set and clear its arrays.
method clearAll(FibSet s) =>
    if not na(s.fills)
        for f in s.fills
            linefill.delete(f)
        array.clear(s.fills)
    if not na(s.labels)
        for lb in s.labels
            label.delete(lb)
        array.clear(s.labels)
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        array.clear(s.lines)

// Build all visuals for a (live) set. Skips everything in "Markers Only" mode.
method draw(FibSet s) =>
    if displayMode != "Markers Only"
        rt = liveRightTime()
        lblX = labelPos == "Right" ? rt : s.startTime
        for lv in cfg
            if lv.enabled
                price = priceForRatio(s, lv.ratio)
                col = levelColor(lv)
                // Mono mode dashes extensions + bolds key levels; native-color mode is uniform solid.
                isExt = lv.ratio < 0.0 or lv.ratio > 1.0
                lstyle = (monoMode and isExt) ? line.style_dashed : line.style_solid
                lwid = (monoMode and lv.isKey) ? lineWidth + 1 : lineWidth
                ln = line.new(s.startTime, price, rt, price, xloc=xloc.bar_time,
                     color=col, width=lwid, style=lstyle)
                array.push(s.lines, ln)
                array.push(s.ratios, lv.ratio)
                array.push(s.baseCols, monoMode ? baseColor : lv.col)
                if showRatios or showPrices
                    lb = label.new(lblX, price, levelText(lv.ratio, price),
                         xloc=xloc.bar_time, style=label.style_none, textcolor=col,
                         color=color.new(color.black, 100), size=size.small)
                    array.push(s.labels, lb)
        // Band fills between adjacent enabled levels.
        if showFills
            n = array.size(s.lines)
            if n > 1
                for i = 0 to n - 2
                    a = array.get(s.lines, i)
                    b = array.get(s.lines, i + 1)
                    fc = array.get(s.baseCols, i)
                    f = linefill.new(a, b, color.new(fc, fillTransp))
                    array.push(s.fills, f)

// Freeze a live set into history: stop it where the next set begins, strip
// labels + fills, keep the lines (faded later by refadeHistory).
method freeze(FibSet s, int endT) =>
    s.endTime := endT
    s.isLive := false
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, endT)
    if not na(s.fills)
        for f in s.fills
            linefill.delete(f)
        array.clear(s.fills)
    if not na(s.labels)
        for lb in s.labels
            label.delete(lb)
        array.clear(s.labels)

// Extend the live set's right edge each bar.
method updateRight(FibSet s) =>
    if displayMode != "Markers Only" and not na(s.lines)
        rt = liveRightTime()
        for ln in s.lines
            line.set_x2(ln, rt)
        if labelPos == "Right" and not na(s.labels)
            for lb in s.labels
                label.set_x(lb, rt)

// Re-apply per-age fade/width across all history sets.
refadeHistory() =>
    cnt = array.size(history)
    for [i, s] in history
        ageRank = cnt - 1 - i        // 0 = most recent history set
        transp = int(math.min(95, 45 + ageRank * fadeStep))
        if not na(s.lines)
            for [j, ln] in s.lines
                bc = array.get(s.baseCols, j)
                line.set_color(ln, color.new(bc, transp))
                line.set_width(ln, historyWidth)

// ============================================================================
// ANCHOR DETECTION
// ============================================================================

// Computed globally every bar (kept out of local scope for stable series state).
atrVal = ta.atr(14)
ph = ta.pivothigh(high, pivotDepth, pivotDepth)
pl = ta.pivotlow(low, pivotDepth, pivotDepth)
[tfH, tfL, tfO, tfC] = request.security(syminfo.tickerid, anchorTF,
     [high[1], low[1], open[1], close[1]], lookahead=barmerge.lookahead_off)

var float lastPH = na
var int   lastPHTime = na
var float lastPL = na
var int   lastPLTime = na

bool  foundAnchor = false
float aH = na
float aL = na
int   aHTime = na
int   aLTime = na

if anchorMode == "Auto Pivot"
    if not na(ph)
        passDev = not useDeviation or na(lastPL) or math.abs(ph - lastPL) >= devMult * atrVal
        if passDev
            lastPH := ph
            lastPHTime := time[pivotDepth]
            foundAnchor := true
    if not na(pl)
        passDev = not useDeviation or na(lastPH) or math.abs(lastPH - pl) >= devMult * atrVal
        if passDev
            lastPL := pl
            lastPLTime := time[pivotDepth]
            foundAnchor := true
    foundAnchor := foundAnchor and not na(lastPH) and not na(lastPL)
    aH := lastPH
    aL := lastPL
    aHTime := lastPHTime
    aLTime := lastPLTime
else
    // Timeframe Anchored: use the COMPLETED prior period.
    if timeframe.change(anchorTF) and not na(tfH) and not na(tfL)
        foundAnchor := true
        aH := tfH
        aL := tfL
        // Closed up => high is the more recent extreme; else low is.
        upClose = tfC >= tfO
        aHTime := upClose ? time : time - 1
        aLTime := upClose ? time - 1 : time

bool newIsHigh = aHTime >= aLTime

// A genuinely new anchor differs from the live set's anchor.
newAnchor = foundAnchor and (na(live) or aH != live.hiPrice or aL != live.loPrice
     or aHTime != live.hiTime or aLTime != live.loTime)

// ============================================================================
// MAIN LOGIC: stair-step transition + live update
// ============================================================================

if newAnchor
    newStart = math.max(aHTime, aLTime)
    // Demote current live set into history.
    if not na(live)
        live.freeze(newStart)
        array.push(history, live)
        // Trim oldest beyond the cap.
        while array.size(history) > historyDepth
            old = array.shift(history)
            old.clearAll()
    // Create + draw the new live set.
    live := FibSet.new(aH, aL, aHTime, aLTime, newIsHigh, newStart, na, true,
         array.new<line>(), array.new<label>(), array.new<linefill>(),
         array.new<float>(), array.new<color>())
    live.draw()
    refadeHistory()

// Every bar: extend the live set to the right (prices stay frozen).
if not na(live)
    live.updateRight()

// ============================================================================
// MARKERS + ALERTS
// ============================================================================

bounceUp = false
bounceDown = false

if not na(live) and barstate.isconfirmed
    tol = tolerance(live)
    for lv in cfg
        if lv.enabled
            price = priceForRatio(live, lv.ratio)
            // --- Crossing alerts (any enabled level) ---
            if alertCrossOn and not newAnchor and (not alertKeyOnly or lv.isKey)
                crossedUp = close[1] <= price and close > price
                crossedDn = close[1] >= price and close < price
                if crossedUp or crossedDn
                    dir = crossedUp ? "up" : "down"
                    msg = str.format("Auto Fib: {0} crossed {1} ratio {2} @ {3}",
                         syminfo.ticker, dir, str.tostring(lv.ratio),
                         str.tostring(close, format.mintick))
                    alert(msg, alert.freq_once_per_bar_close)
            // --- Touch + close-back markers/alerts (key levels only) ---
            if lv.isKey
                rejUp = low <= price + tol and close > price and close[1] >= price
                rejDn = high >= price - tol and close < price and close[1] <= price
                if rejUp
                    bounceUp := true
                if rejDn
                    bounceDown := true
                if alertBounceOn and (rejUp or rejDn)
                    side = rejUp ? "support" : "resistance"
                    bmsg = str.format("Auto Fib: {0} bounced off {1} ratio {2} @ {3}",
                         syminfo.ticker, side, str.tostring(lv.ratio),
                         str.tostring(close, format.mintick))
                    alert(bmsg, alert.freq_once_per_bar_close)

// Markers render in "Markers Only" and "Both" modes.
showMarkers = displayMode != "Levels"
plotshape(showMarkers and bounceUp, "Bounce Up", shape.triangleup,
     location.belowbar, color.new(color.green, 0), size=size.tiny)
plotshape(showMarkers and bounceDown, "Bounce Down", shape.triangledown,
     location.abovebar, color.new(color.red, 0), size=size.tiny)
