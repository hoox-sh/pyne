study("Alpha-Decreasing Exponential Moving Average", shorttitle="ADEMA", overlay=true)

alpha = 2 / (int(bar_index) + 1)

ema = close
ema := alpha * ema + (1 - alpha) * nz(ema[1], ema)

plot(ema, title="ADEMA", linewidth=2, color=color.orange)
