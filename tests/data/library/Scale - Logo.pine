//@version=6

// @description This script is part of the Library Progressbar - Showcase. You can find it under: https://www.tradingview.com/script/RRwvtQAQ-Progressbar/
indicator("[CLX] Scale - Logo", overlay = true)

import cryptolinx/Motion/12 as m

const int Y_OFFSET = 500

// Override/Extending Built-In isset Function
method isset(string _src, string _rep) => na(_src) or _src == string(na) ? _rep : _src
method isset(float _src, float _rep) => na(_src) ? _rep : _src
method isset(int _src, int _rep) => na(_src) ? _rep : _src

// Simple Animated Logo/Tag Idea
method render(
 map <string, label>    this,
 string                 logoSize        = size.huge,
 string                 tag1Size        = size.normal,
 string                 tag2Size        = size.small,
 color                  logoColor       = #FFFFFF,
 color                  tag1Color       = #cccccc36,
 color                  tag2Color       = color.gray,
 color                  decorColor      = color.aqua,
 string                 logoText        = 'SCALE.',
 string                 taglineText     = '- A Pine Script™ Library -',
 string                 subLogoTopText  = 'v.4.x',
 string                 subLogoBtmText  = '▰▱▱',
 int                    xOffset         = 0,
 float                  yOffset         = 0
 ) => 
    if barstate.isfirst   
    // --
        this.put(
         "subLogoTop",      
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = subLogoTopText + '\n\n\n\n\n\n', 
          size              = tag2Size, 
          color             = #00000000, 
          textcolor         = tag2Color, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_left
          )
         )
        // --
        this.put(
         "logo",           
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = logoText, 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = logoColor, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        // --
        this.put(
         "subLogoBtm",     
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '\n\n\n' + subLogoBtmText, 
          size              = tag1Size, 
          color             = #00000000, 
          textcolor         = decorColor, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        // --
        this.put(
         "tagline",        
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '\n\n\n\n\n' + taglineText, 
          size              = tag1Size, 
          color             = #00000000, 
          textcolor         = tag1Color, 
          text_font_family  = font.family_default, 
          style             = label.style_label_up, 
          textalign         = text.align_left
          )
         )
        // --
        this.put(
         "decorUpperRight", 
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '└', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_upper_right, 
          textalign         = text.align_left
          )
         )
        // --
        this.put("decorUpperLeft",  
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '┘', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_upper_left, 
          textalign         = text.align_left
          )
         )
        // --
        this.put("decorLowerRight", 
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '┌', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_lower_right, 
          textalign         = text.align_left
          )
         )
        // --
        this.put("decorLowerLeft",
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '┐', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_lower_left, 
          textalign         = text.align_left
          )
         )
        // >>
    this

// Update Logo
method update(
 map <string, label> this,
 string              newLogoText        = na,
 string              newSubLogoBtmText  = na
 ) =>
    // --
    if barstate.islast or barstate.isrealtime
        for key in this.keys()
            this.get(key).set_xy(bar_index, Y_OFFSET)
        this.get("logo").set_text(newLogoText.isset(this.get("logo").get_text()))
        this.get("subLogoBtm").set_text(newSubLogoBtmText.isset(this.get("subLogoBtm").get_text()))
    // >>
    this
// }


// M
var m.keyframe subLogoKf = m.keyframe.new(1, 3)
const string logoText = 'SCALE.'
const string subLogoBtmText = '▰▱▱'
var m.option _opt = m.option.new(_prefix = '\n\n\n')
var map <string, label> logo = map.new<string, label>()
logo
 .render()
 .update(
  logoText,
  subLogoKf.transition(_seq = subLogoBtmText, _fx = 'marquee', __opt = _opt)
  )
