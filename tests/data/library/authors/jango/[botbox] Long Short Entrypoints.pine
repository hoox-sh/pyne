//@version=4


study("[botbox] Long/Short Entrypoints", "[botbox] Long/Short Entrypoints", overlay=true)



//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////

ema1 = input(title="Lenght EMA #1", type=input.integer, defval=10)
ema2 = input(title="Lenght EMA #2", type=input.integer, defval=20)



//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #7b1fa2
cdr = #7e57c2	
cbr = #512da8

// Idle, Sideward
cly = #ffa726


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


a = ema(close, ema1)
b = ema(close, ema2)

long_ma = cross(a, b) and a > b
short_ma = cross(b, a) and a < b
last_signal = 0

long_final = long_ma
short_final = short_ma

last_signal := long_final ? 1 : short_final ? -1 : last_signal[1]

// Plotting
plotshape(long_final, "Buy-Signal", shape.triangleup, location.abovebar, color.yellow, 0, 0)
plotshape(short_final, "Sell-Signal", shape.triangleup, location.belowbar, color.yellow, 0, 0)

// Plotting
// plotshape(long_final, style=shape.arrowup, color=color.yellow, location=location.belowbar, text="LONG")

// variables
src_c = close
src_l = low

// MA visibility
ma8_c = sma(src_c, 8)
ma13_c = sma(src_c, 13)
ma21_c = sma(src_c, 21)
ma34_c = sma(src_c, 34)
ma55_c = sma(src_c, 55)
ma_diff = ma8_c / (ma13_c * 100) * 100

pc_8 = iff(ma8_c > ma55_c and src_c > ma55_c and ma8_c > ma13_c and src_l > ma8_c, color.aqua, color.black)
pc_13 = iff(ma13_c > ma55_c and src_c > ma55_c and ma13_c > ma21_c and src_l > ma21_c, color.fuchsia, color.black)
pc_21 = iff(ma21_c > ma55_c and src_c > ma55_c and ma21_c > ma34_c and src_l > ma34_c, color.purple, color.black)
pc_34 = iff(ma34_c > ma55_c and src_c > ma55_c and ma34_c > ma55_c and src_l > ma55_c, color.maroon, color.black)
pc_55 = iff(src_c > ma55_c and src_l > ma55_c, color.yellow, color.gray)


// StochRS
rsi = rsi(close, 14)
k = sma(stoch(rsi, rsi, rsi, 14), 3)
d = sma(k, 3)

//MACD
fast = 1
slow = 2
fastMA = ema(close, fast)
slowMA = ema(close, slow)
macd = fastMA - slowMA
signal = sma(macd, 9)
mac_diff = macd / (signal * 100) * 100
histo = macd - signal

buy_signal = ma_diff < 0.998 and macd < 0 and macd[1] < macd and macd != signal and histo < 5 and 
   k < 40 and k != d and rsi < 40 and mac_diff < 1.5
sell_signal = macd > 0 and macd[1] > macd and macd != signal and histo > -5 and k > 60 and 
   k != d and rsi > 60 and mac_diff < 2

//plotting shapes for signals
plotshape(sell_signal, style=shape.arrowdown, color=color.white, location=location.abovebar, text="SHORT")
plotshape(sell_signal, "Sell-Signal", shape.triangleup, location.belowbar, color.yellow, 0, 0)

//alert messages , can add autoview code
alertcondition(long_final, title='Buy-Signal', message='BUY NOW')
alertcondition(sell_signal, title='Sell-Signal', message='SELL NOW')
