study("Trailing Stop Test", "Trailing Stop Loss Test", true, format.inherit, 2)

ATR = atr(input(defval=14, title="ATR", type=input.integer))[1]
Multip = input(defval=1.5, title="Multiplier", type=input.float)

Longstop = low - ATR * Multip
Shortstop = high + ATR * Multip

plot(Longstop, "Long Stop Loss")
plot(Shortstop, "Short Stop Loss")
