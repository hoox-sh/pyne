//////////////////////////////////////////////////////////////////////////
//-- START TRADING INFO PANEL
//////////////////////////////////////////////////////////////////////////


__SRC                           = input(defval=close,title="Get last price from",type=input.source) 

var label __PANEL_INFO          = na
var __TEXT               = ""

__POSX                          = bar_index[0]
__POSY                          = close

//-- Draw infopanels
//--@return         label
f_draw_infopanel(_x, _y, _line, _text, _color) =>
    _rep_text = ""
    for _l = 0 to _line
        _rep_text := _rep_text + "\n"
    _rep_text := _rep_text + _text
    var label _la = na
    label.delete(_la)
    _la := label.new(x=_x, y=_y, text=_rep_text, xloc=xloc.bar_time, yloc=yloc.price, color=color.black, style=label.style_labelup, textcolor=_color, size=size.large)

f_draw_label(x,y,_text,_textcolor, _size) =>
    var label Label = na
    label.delete(Label)
    Label := label.new(x, y, _text, color=color.new(color.white, 20), textcolor=_textcolor, style=label.style_none, yloc=yloc.price, xloc=xloc.bar_index, size=_size)

f_res_to_str(res) =>
    iff(res=="60", "H1", iff(res=="120", "H2", iff(res=="240","H4", iff(res=="480","H8", res))))

f_format_text(str) =>
    str + "\n"

f_print_spaces(nb) =>
    var str = ""
    for i = 0 to nb
        str := str + " "
    str

//-- TEXT LAYOUT
text_first                      = "┌──────────────────────────" + "\n"
text_before                     = ""
text_after                      = ""
text_last                       = "└──────────────────────────" + "\n"

spacer                          = f_print_spaces(70)

//-- CHANGE PRICE
text_change_price_before        = ""
text_change_price_after         = "%" + "\n"
value_change_price_1            = __SRC / close
value_change_price_2            = value_change_price_1 >= 1.0 ? (value_change_price_1 - 1) * 100 : value_change_price_1 <= 1.0 ? (1 - value_change_price_1) * 100 : 0.0
value_change_price_3            = value_change_price_2 - 0.15
text_change_price               = tostring(value_change_price_3,"##.##")

__TEXT                         :=                spacer     +   text_first
__TEXT                         := __TEXT    +    spacer     +   text_before     +   text_change_price_before     +   text_change_price       +   text_change_price_after     +   text_after
__TEXT                         := __TEXT    +    spacer     +   text_last

__TEXT                         := f_format_text(__TEXT)   

label.delete(__PANEL_INFO[1])
__PANEL_INFO                   := f_draw_label(bar_index[0], __POSY, __TEXT, color.white, size.normal) 
