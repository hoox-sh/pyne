//-- Function to draw base lines on chart.
f_limit_lines(_length)=>
    int _base_t = time + int(change(time) * _length)
    int _start_t = time - int(change(time) * _length)
    
    var line _start = na
    var line _end = na
    line.delete(_start)
    line.delete(_end)
    _start := line.new(
             x1 = _base_t, y1 = i_pr_low, 
             x2 = _base_t, y2 = i_pr_high,
             xloc=xloc.bar_time, extend=extend.none, 
             color=color.new(color.silver, 0), style=line.style_solid, width=1
             )
    _end := line.new(
             x1 = _start_t, y1 = i_pr_low, 
             x2 = _start_t, y2 = i_pr_high,
             xloc=xloc.bar_time, extend=extend.none, 
             color=color.new(color.silver, 0), style=line.style_solid, width=1
             )

f_limit_lines(i_pr_window)