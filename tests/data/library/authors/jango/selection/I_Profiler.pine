//@version=4
study("Profiler","Profiler", overlay=true)

i_pr_show_numerical_values = input(defval=false, title="PR: Numerical Values(debug purposes)")
i_pr_window = input(defval=100, title="PR: Window period to pool values", type=input.integer, minval=0)
i_pr_high = highest(i_pr_window)
i_pr_low = lowest(i_pr_window)
i_pr_r = i_pr_high - i_pr_low

//-- Check if value x nears y within error
f_AlmostEqual(_x, _y, _error) => abs(_x - _y) <= _error

f_check_range(_src, _l, _h, _r, _length, _percent_of_range, _error)=>
    int _hits = 0
    float _volume = 0.0
    for _i = 0 to _length
        _v = _src[_i] - _l
        _isequal = _v > _r * (_percent_of_range - _error) and _v < _r * (_percent_of_range + _error)//f_AlmostEqual(_v, _r * _percent_of_range, _error)
        if _isequal
            _hits := _hits + 1
            _volume := _volume + volume[_i]
    [_volume, _hits]

i_pr_error = 0.025
i_pr_src = ohlc4
[v000, r000] = f_check_range(i_pr_src, i_pr_low, i_pr_high, i_pr_r, i_pr_window, 0.025, i_pr_error)
[v001, r001] = f_check_range(i_pr_src, i_pr_low, i_pr_high, i_pr_r, i_pr_window, 0.075, i_pr_error)
