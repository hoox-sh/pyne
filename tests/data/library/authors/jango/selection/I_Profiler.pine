    i_pr_tex := i_pr_tex + "\n" + "011: " + tostring(r011, "#") + " - " + tostring(v011, "#")
    i_pr_tex := i_pr_tex + "\n" + "012: " + tostring(r012, "#") + " - " + tostring(v012, "#")
