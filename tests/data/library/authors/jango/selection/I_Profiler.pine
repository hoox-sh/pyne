i_pr_sum_r = r000 + r001 + r002 + r003 + r004 + r005 + r006 + r007 + r008 + r009 + r010 + r011 + r012 + r013 + r014 + r015 + r016 + r017 + r018 + r019
i_pr_sum_v = v000 + v001 + v002 + v003 + v004 + v005 + v006 + v007 + v008 + v009 + v010 + v011 + v012 + v013 + v014 + v015 + v016 + v017 + v018 + v019

