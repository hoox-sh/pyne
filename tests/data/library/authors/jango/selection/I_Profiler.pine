    i_pr_tex := i_pr_tex + "\n" + "019: " + tostring(r019, "#") + " - " + tostring(v019, "#")
    var label la = na
    label.delete(la)
    la := label.new(bar_index[i_pr_window], open[i_pr_window], i_pr_tex)

//-- Function to draw price level Bars on the profiler.
f_line(_price_rate, _volume_rate, _level, _length)=>
    float _lvl = i_pr_low + i_pr_r * _level
    int _base_t = time + int(change(time) * max(100, _length))
    int _target_p = _base_t - int((change(time) * _length) * _price_rate)
    int _target_v = _base_t - int((change(time) * _length) * _volume_rate)
    var line _li1 = na
    var line _li2 = na
    line.delete(_li1)
    line.delete(_li2)
    _li1 := line.new(
             x1 = _base_t, y1 = _lvl, 
             x2 = _target_p, y2 = _lvl,
             xloc=xloc.bar_time, extend=extend.none, 
             color=color.new(color.gray, 20), style=line.style_solid, width=10
             )
    _li2 := line.new(
             x1 = _base_t, y1 = _lvl, 
             x2 = _target_v, y2 = _lvl,
             xloc=xloc.bar_time, extend=extend.none, 
             color=color.new(color.maroon, 20), style=line.style_solid, width=4
             )


f_line(r000/i_pr_sum_r, v000/i_pr_sum_v, 0.025, i_pr_window)
f_line(r001/i_pr_sum_r, v001/i_pr_sum_v, 0.075, i_pr_window)
