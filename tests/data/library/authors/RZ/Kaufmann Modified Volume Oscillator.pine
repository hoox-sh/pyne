
//@version=4
// i just modify something in this script https://www.tradingview.com/script/qnbpqJ0D-Kaufman-Adaptive-Correlation-Oscillator/
study("Kaufman modified volume Oscillator")
length = input(14),prefiltering = input(false)
//----
er = abs(change(volume,length))/sum(abs(change(volume)),length)
kama(x)=>
    a = 0.
    a := er*x+(1-er)*nz(a[1],x)
st(x)=>sqrt(kama(x*x) - pow(kama(x),2))
//----
src = close
n = bar_index
a = kama(n*src) - kama(n)*kama(src)
b = st(n)*st(src)
x = a-b/volume
//----
plot(0)
//
len=input(25)
signal = ema(x,len)
//  Plotting: 
barColor =x >= 0 and x > signal ? color.teal : x > 0 and x < signal ? color.lime : x < 0 and x < signal ? color.red : color.orange
plot(signal, color=color.aqua, linewidth=3)
plot(x, color=barColor, style=plot.style_histogram, linewidth=3)


//plot(signal, color=color.aqua, linewidth=3)
//barcolor(barColor)
bgcolor(barColor == color.teal or barColor == color.lime ? color.green : color.red)
zero=input(0)
down = crossunder(x, signal) 
up = crossover(x, signal) 
plotshape(up, title='UP', style=shape.xcross, color=color.green, location=location.bottom, textcolor=color.black, text="UP", transp = 0, size = size.tiny)
plotshape(down , title='down', style=shape.cross, color=color.red, location=location.top, textcolor=color.black, text="Down", transp = 0, size = size.tiny)

/////// Alerts /////
alertcondition(down,title="down")
alertcondition(up,title="up")
