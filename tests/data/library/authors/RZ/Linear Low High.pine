//label_p_p = label.new(bar_index, P, text=show_value ? ("P"  + " " + tostring(nround(P))) : "P",  style= label.style_none)
//label_s1 = label.new(bar_index, S1, text=show_value ? ("S1" + " " + tostring(nround(S1))) : "S1", style= label.style_none)
//label_r1 = label.new(bar_index, R1, text=show_value ? ("R1" + " " + tostring(nround(R1))) : "R1", style= label.style_none)

//label.delete(label_p_p[1])
