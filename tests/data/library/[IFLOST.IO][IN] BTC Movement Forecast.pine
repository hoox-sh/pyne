//   |{------------------------------------------------------------------||
//   ||   Start of Script


//////////////////////////////////////////////////////////////////////////
// Position Size for ATR Trailing Stop Strategy, originally by Sylvain Vervoort 
// The related article is copyrighted material from Stocks & Commodities Jun 2009 
// Previous branch was developed by River to add Wick Protection to HPotter's version, and then calculate position size based on the distance between stop and entry.
// This script is a forked and edited version developted by @jango_blockchained to forecast upcoming movments.
//////////////////////////////////////////////////////////////////////////


//      ____________    ____  ___________________ 
//     /  _/ ____/ /   / __ \/ ___/_  __/  _/ __ \
//     / // /_  / /   / / / /\__ \ / /  / // / / /
//   _/ // __/ / /___/ /_/ /___/ // / _/ // /_/ /  
//  /___/_/   /_____/\____//____//_(_)___/\____/  
// 
//  EVERYTHING IS POSSIBLE, BY THE POWER OF DATA.


//@version=2
//@authors                      = Jan Goischke & Dennis Hilpmann


//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] Risk Reward Panel
//////////////////////////////////////////////////////////////////////////


study(
 title                          = "[IFLOST.IO][IN] BTC Movement Forecast by ATR Position Size",
 shorttitle                     = "[IFLOST.IO][IN] BTC Movement Forecast",
 overlay                        = false,
 precision                      = 6
 )


//////////////////////////////////////////////////////////////////////////
//-- INPUTS
//////////////////////////////////////////////////////////////////////////


nATRPeriod                      = input(5, title="ATR Period")
nATRMultip                      = input(4, title="ATR Multiplier")
length                          = input(30, "#Periods of Wick Protection", minval=2, type=integer)
bType                           = input(0, "Max [1] or Avg Wick Protection [0]", minval=0, maxval=1, type=integer)
equity                          = input(1, "Equity on Account", type=float)
equitycurrency                  = input(0, "Equity Currency [0=BTC,1=USD]", minval=0, maxval=1,type=integer)
pricecurrency                   = input(1, "Price Currency [0=BTC,1=USD]", minval=0, maxval=1, type=integer)
riskpercent                     = input(1, "Risk Percentage of Equity", minval=0.1, maxval=100, type=float)
manualentry                     = input(0, "Manual (Average) Entry at ", minval=0, type=float)
manualstop                      = input(0, "Manual Stop at", minval=0, type=float)
feepercent                      = input(0.15, "Fee Percentage for Combined Buy&Sell", minval=0, type=float)
forecast_offset                 = input(5, "Forecast Offset", minval=0, maxval=10,type=integer)


//////////////////////////////////////////////////////////////////////////
//-- SECURITY HT
//////////////////////////////////////////////////////////////////////////


btcusdsym                       = input("BITMEX:XBTUSD", "BTCUSD Symbol")
btcprice                        = security(btcusdsym, "1", close)


//////////////////////////////////////////////////////////////////////////
//-- COLORS
//////////////////////////////////////////////////////////////////////////


//--__buy, Upward
col_green_1               = #4EF9FF
col_green_1_90            = #4EF9FF
col_green_2               = #3CADB1
col_green_3               = #26c6da  
col_green_4               = #afff00
col_green_5               = #CFD80E
col_green_6               = #90c818

//-- __sell, Downward
col_red_1                 = #7b1fa2
col_red_1_90              = #7b1fa2 
col_red_2                 = #7e57c2
col_red_3                 = #512da8
col_red_4                 = #7300de
col_red_5                 = #4a148c
col_red_6                 = #2d2456
//-- Idle, Sideward
col_yellow_1              = #ffa726
col_yellow_2              = #f57c00

col_light_1               = #FFFFFF
col_light_1_50            = #FFFFFF

col_dark_1                = #000000
col_dark_1_50             = #000000


//////////////////////////////////////////////////////////////////////////
//-- CALCULATION
//////////////////////////////////////////////////////////////////////////


avgupperwick                    = sma(close[1] <= open[1] ? high[1] - open[1] : high[1] - close[1], length)
maxupperwick                    = highest(close[1] <= open[1] ? high[1] - open[1] : high[1] - close[1], length)
avglowerwick                    = sma(close[1] > open[1] ? open[1] - low[1] : close[1] - low[1], length)
maxlowerwick                    = highest(close[1] > open[1] ? open[1] - low[1] : close[1] - low[1], length)
upperwick                      = bType == 0 ? avgupperwick : maxupperwick
lowerwick                       = bType == 0 ? avglowerwick : maxlowerwick

xATR                           = atr(nATRPeriod)
nLoss                           = nATRMultip * xATR 

upperband                      = iff(high < nz(upperband[1], 0) and high[1] < nz(upperband[1], 0), min(nz(upperband[1]), high + nLoss + upperwick), high + nLoss + upperwick)
lowerband                       = iff(low > nz(lowerband[1], 0) and low[1] > nz(lowerband[1], 0), max(nz(lowerband[1]), low - nLoss - lowerwick), low - nLoss - lowerwick) 
xATRTrailingStop                = iff(low > nz(xATRTrailingStop[1], 0) and low[1] > nz(xATRTrailingStop[1], 0), max(nz(xATRTrailingStop[1]), low - nLoss - lowerwick),
                                 iff(high < nz(xATRTrailingStop[1], 0) and high[1] < nz(xATRTrailingStop[1], 0), min(nz(xATRTrailingStop[1]), high + nLoss + upperwick), 
                                  iff(low <= nz(xATRTrailingStop[1], 0) and close[1] > nz(xATRTrailingStop[1], 0), upperband[1], iff(high >= nz(xATRTrailingStop[1], 0) and close[1] < nz(xATRTrailingStop[1], 0), lowerband[1],0))))

shortstop                       = (manualstop > 0 and manualstop > close) ? manualstop : upperband
longstop                        = (manualstop > 0 and manualstop < close) ? manualstop : lowerband
entry                           = (manualentry > 0) ? manualentry : close

distancetoshortstop             = (shortstop - entry) / entry
distancetolongstop              = (entry - longstop) / entry

riskamount                      = equity * (riskpercent / 100) * (equitycurrency == 0 ? (pricecurrency == 0 ? 1 / entry : btcprice) : (pricecurrency == 0 ? (1 / btcprice)/entry : 1))

mult                            = equitycurrency == 0 ? (pricecurrency == 0 ? 1 / entry : btcprice) : (pricecurrency == 0 ? ((1 / btcprice) / entry) : 1)

ethusdcontractsize              = 0.000001 * close * btcprice
ethcorrectionfactor             = tickerid == "BITMEX:ETHUSD" ? 1 / ethusdcontractsize: 1

shortpositionsize               = ethcorrectionfactor * riskamount / (distancetoshortstop + (feepercent / 100))
longpositionsize                = ethcorrectionfactor * riskamount / (distancetolongstop + (feepercent / 100))


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


plot(longpositionsize, color=col_green_1, title="Long Size", offset=forecast_offset, style=circles, linewidth=3)
plot(shortpositionsize, color=col_red_1, title="Short Size", offset=forecast_offset, style=circles, linewidth=3)
plot(longpositionsize, color=col_green_1, title="Long Size", offset=forecast_offset)
plot(shortpositionsize, color=col_red_1, title="Short Size", offset=forecast_offset)
plot(longpositionsize/(equity*mult), title="Long Cross Leverage", color=col_light_1_50, linewidth=1)
plot(shortpositionsize/(equity*mult), title="Short Cross Leverage", color=col_light_1_50, linewidth=1)


//-- } End of Script