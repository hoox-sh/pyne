//@version=3
//
// Acknowledgements:
    // Original Godmode Authors: 
        // @Legion, @LazyBear, @Ni6HTH4wK, @xSilas
        // Drop a line if you use or modify this code.
    // Godmode 3.1.4: @SNOW_CITY
    // Godmode 3.2: @sco77m4r7in and @oh92 
    // Godmode3.2+LSMA: @scilentor
    // Godmode 4.0.0-4.0.1: @chrysopoetics
    // Jurik Moving Average: @everget
    // Constance Brown Composite Index RSI: @LazyBear
    // Wavetrend Oscillator: @fskrypt
    // TTM Squeeze: @Greeny
    // True TSI/RSI: @cI8DH and @chrysopoetics
    // Laguerre RSI (Self-Adjusting Alpha with Fractals Energy): @everget
    // RSI Shaded: @mortdiggiddy
    
// Minimal Godmode v2.0:
    // 6 BTC pairs/exchanges (instead of 11) to reduce loading time from the pinescript security() function 
    // Volume Composite for engine calculation 
    // TTM Squeeze on Wavetrend Signal
    // Constance Brown Composite Index RSI (CBCI) 
    // TrueTSI (Godmode 4.0.0 implementation)
    // Laguerre RSI (LRSI)
// Minimal Godmode v2.1:
    // Removed TTM Squeeze and Volume Composite
    // EMA for Wavetrend Signal
    // Multi-exchange for BTC no longer the default
    // mg engine toggle for CBCI, Laguerre RSI, and TTSI
    // Wavetrend Histogram component toggle
    
vtag = "2.1"    
study(title="Minimal Godmode" + vtag, shorttitle="mg" + vtag,overlay=false)

n1 = input(17, "Custom Channel Length")
n2 = input(6, "Custom Average Length")
n3 = input(4, "Custom Short Length")

// Preset 
gm_preset = input(defval="17-6-4 (SNOW_CITY)", options=["17-6-4 (SNOW_CITY)","9-26-13 (Original GM)","Custom"],title="Godmode Preset") 
if gm_preset == "17-6-4 (SNOW_CITY)"
// GM 3.1.4 (SNOW_CITY)
    n1 := 17
    n2 := 6
    n3 := 4
else
    if gm_preset == "9-26-13 (Original GM)"
    // Original GM 
        n1 := 9
        n2 := 26
        n3 := 13
    else
        if gm_preset == "Custom"
            n1 := n1
            n2 := n2
            n3 := n3

use_mg = input(type=bool, defval=true, title="Use mg engine (CBCI, Laguerre RSI, and TTSI)")
use_wt_hist_component = input(type=bool, defval=true, title="Wavetrend Histogram Component")
use_wt_hist = input(type=bool, defval=false, title="Wavetrend Histogram")

// Source
multi = input(type=bool, defval=false, title="Multi-exchange (BTC Trading only)")
src0 = hlc3 
src1 = security("BITFINEX:BTCUSD", period, src0), src2 = security("BITTREX:BTCUSD", period, src0),
src3 = security("BITMEX:XBTUSD", period, src0), src4 = security("COINBASE:BTCUSD", period, src0),
src5 = security("BINANCE:BTCUSDT", period, src0), src6 = security("HUOBI:BTCUSDT", period, src0)

// Engine
ttsi(_src, _len0, _len1) =>
    pc = change(_src) / avg(_src, _src[1])
    ma0 = ema(pc, _len0)
    ma1 = ema(ma0, _len1)
    apc = abs(_src - _src[1])
    ma2 = ema(apc, _len0)
    ma3 = ema(ma2, _len1)
    ttsi = 100 * (ma1 / ma3)
    
tci(src) => ema((src - ema(src, n1)) / (0.025 * ema(abs(src - ema(src, n1)), n1)), n2)+50
mf(src) => rsi(sum(volume  * (change(src) <= 0 ? 0 : src), n3), sum(volume * (change(src) >= 0 ? 0 : src), n3))
willy(src) => 60 * (src - highest(src, n2)) / (highest(src, n2) - lowest(src, n2)) + 80
csi(src) => avg(rsi(src, n3),tsi(src0,n1,n2)*50+50)
csi_mg(src) => avg(rsi(src, n3),ttsi(src0,n1,n2)*50+50)

//----CBCI
cbci (src) =>
    r = rsi(src,n3)
    rsidelta = mom(r, n2)
    rsisma = ema(rsi(src, n3), n3) //sma --> ema
    s = rsidelta+rsisma
//----LRSI
f_lrsi(_src) =>
    applyFractalsEnergy = false
    alpha = 0.7
    OC = (_src + nz(_src[1])) / 2
    HC = max(highest(_src,n1), nz(_src[1]))
    LC = min(lowest(_src,n1), nz(_src[1]))
    feSrc = (OC + HC + LC + _src) / 4
    feAlpha = log(sum((HC - LC) / (highest(n1) - lowest(n1)), n1)) / log(n1)
    lrsiAlpha = applyFractalsEnergy ? feAlpha : alpha
    L0 = 0.0
    L0 := lrsiAlpha * (applyFractalsEnergy ? feSrc : _src) + (1 - lrsiAlpha) * nz(L0[1])
    L1 = 0.0
    L1 := -(1 - lrsiAlpha) * L0 + nz(L0[1]) + (1 - lrsiAlpha) * nz(L1[1])
    L2 = 0.0
    L2 := -(1 - lrsiAlpha) * L1 + nz(L1[1]) + (1 - lrsiAlpha) * nz(L2[1])
    L3 = 0.0
    L3 := -(1 - lrsiAlpha) * L2 + nz(L2[1]) + (1 - lrsiAlpha) * nz(L3[1])
    CU = 0.0
    CU := (L0 >= L1 ? L0 - L1 : 0) + (L1 >= L2 ? L1 - L2 : 0) + (L2 >= L3 ? L2 - L3 : 0)
    CD = 0.0
    CD := (L0 >= L1 ? 0 : L1 - L0) + (L1 >= L2 ? 0 : L2 - L1) + (L2 >= L3 ? 0 : L3 - L2)
    lrsi = CU + CD != 0 ? 100 * CU / (CU + CD) : CU / (CU + CD) 

godmode(src) => 
   avg(tci(src),csi(src),mf(src),willy(src))
tradition(src) => 
  avg(tci(src),mf(src),rsi(src, n3))

godmode_mg(src) => 
   avg(tci(src),csi_mg(src),mf(src),willy(src),cbci(src),f_lrsi(src))
tradition_mg(src) => 
   avg(tci(src),mf(src),rsi(src, n3),cbci(src),f_lrsi(src))

wt1 =
   multi ?
   avg(avg(godmode_mg(src0),godmode_mg(src1),godmode_mg(src2),godmode_mg(src3),godmode_mg(src4),godmode_mg(src5)),godmode_mg(src6)) :
   tradition_mg (src0)  
if use_mg == false
    wt1 := multi ? avg(avg(godmode(src0),godmode(src1),godmode(src2),godmode(src3),godmode(src4),godmode(src5)),godmode(src6)) : tradition (src0) 

jma(src, length, power, phase) => 
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = pow(beta, power)
    e0 = 0.0
    e1 = 0.0
    e2 = 0.0
    jma = 0.0
    phaseRatio = phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100 + 1.5
    e0 := (1 - alpha) * src + alpha * nz(e0[1])
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 := pow(1 - alpha, 2) * (e0 + phaseRatio * e1 - nz(jma[1])) + pow(alpha, 2) * nz(e2[1])
    jma := nz(jma[1]) + e2
 
ma_type = input(defval="SMA", options=["SMA", "EMA","JMA"],title="Wavetrend Signal Smoothing") 

ma(smoothing, src, length,power,phase) => 
    if smoothing == "SMA"
        sma(src, length)
    else
        if smoothing == "EMA"
            ema(src, length)
        else
            if smoothing == "JMA"
                jma(src,length, power, phase)
                
wt2 = ma(ma_type,wt1,6,1,50)
extended = wt2<20? wt2+5 : wt2>80 ? wt2-5 : na
extended_ttm = wt2<=50? wt2-8 : wt2>=51 ? wt2+8 : na

////
htop        = hline (100, title="Top Line",linestyle=dotted, linewidth=1, color=color(#00BFFF,100))
// hmid1       = hline (80, title="Upper Limit",linestyle=dashed,linewidth=1)
// hmid2       = hline (20, title="Lower Limit",linestyle=dashed,linewidth=1)
hline(80, title = "Upper Limit", linestyle = solid, color = #4444B0CC)
hline(20, title = "Lower Limit", linestyle = solid, color = #4444B0CC)
hbottom     = hline (0, title="Top Line",linestyle=dotted, linewidth=1, color=color(#00BFFF,100)) 

color2 = wt1 < 20 ? color(green,30) : wt1 > 80 ? color(red,40) : color(gray,50) //#88888855
plot(use_wt_hist ? ema((wt1-wt2)*2+50,n3) : na, color=aqua, style=area, transp=80, histbase=50,title="Wavetrend Histogram")
plot(use_wt_hist_component ? ema((wt1-wt2)*2+50,n3) : na, title = "Wave Histogram Component", histbase = 50, style = histogram, linewidth = 2, color = color2,transp=50)
plot(wt1, color=#33FF33FF,transp=0, title="Raw Wavetrend",linewidth=1,transp=0)
plot(wt2, color=#FF3333FF,transp=20,title="Wavetrend Signal",linewidth=2,transp=0)
plot(extended, title="Wavetrend Caution", color=yellow, style=circles,linewidth=2,transp=0)





