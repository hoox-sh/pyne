import cryptolinx/MotionDEV/32 as motion

// Override/Extending Built-In isset Function
method isset(string _src, string _rep) => na(_src) or _src == string(na) ? _rep : _src
method isset(float _src, float _rep) => na(_src) ? _rep : _src
method isset(int _src, int _rep) => na(_src) ? _rep : _src

// Simple Animated Logo/Tag Idea
method render(
 map <string, label>    this,
 string                 logoSize        = size.huge,
 string                 tag1Size        = size.normal,
 string                 tag2Size        = size.small,
 color                  logoColor       = #FFFFFF,
 color                  tag1Color       = #CCCCCC,
 color                  tag2Color       = color.gray,
 color                  decorColor      = color.aqua,
 string                 logoText        = 'SCALE.',
 string                 taglineText     = '- A Pine Script™ Showcase -',
 string                 subLogoTopText  = 'v.3.x',
 string                 subLogoBtmText  = '▰▱▱',
 int                    xOffset         = 0,
 float                  yOffset         = 0
 ) => 
    if barstate.isfirst   
    // --
        this.put(
         "subLogoTop",      
         label.new(
          x                 = bar_index + xOffset, 
          y                 = yOffset, 
          text              = subLogoTopText + '\n\n\n\n\n\n', 
          size              = tag2Size, 
          color             = #00000000, 
          textcolor         = tag2Color, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_left
          )
         )
        // --
        this.put(
         "logo",           
         label.new(
          x                 = bar_index + xOffset, 
          y                 = yOffset, 
          text              = logoText, 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = logoColor, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        // --
        this.put(
         "subLogoBtm",     
         label.new(
          x                 = bar_index + xOffset, 
          y                 = yOffset, 
          text              = '\n\n\n' + subLogoBtmText, 
          size              = tag1Size, 
          color             = #00000000, 
          textcolor         = decorColor, 
          text_font_family  = font.family_default, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        // --
        this.put(
         "tagline",        
         label.new(
          x                 = bar_index + xOffset, 
          y                 = yOffset, 
          text              = '\n\n\n\n\n' + taglineText, 
          size              = tag1Size, 
          color             = #00000000, 
          textcolor         = tag1Color, 
          text_font_family  = font.family_default, 
          style             = label.style_label_up, 
          textalign         = text.align_left
          )
         )
        // --
        // this.put(
        //  "decorUpperRight", 
        //  label.new(
        //   x                 = bar_index + xOffset, 
        //   y                 = yOffset, 
        //   text              = '└', 
        //   size              = logoSize, 
        //   color             = #00000000, 
        //   textcolor         = color.new(decorColor, 75), 
        //   text_font_family  = font.family_default, 
        //   style             = label.style_label_upper_right, 
        //   textalign         = text.align_left
        //   )
        //  )
        // // --
        // this.put("decorUpperLeft",  
        //  label.new(
        //   x                 = bar_index + xOffset, 
        //   y                 = yOffset, 
        //   text              = '┘', 
        //   size              = logoSize, 
        //   color             = #00000000, 
        //   textcolor         = color.new(decorColor, 75), 
        //   text_font_family  = font.family_default, 
        //   style             = label.style_label_upper_left, 
        //   textalign         = text.align_left
        //   )
        //  )
        // --
        // this.put("decorLowerRight", 
        //  label.new(
        //   x                 = bar_index + xOffset, 
        //   y                 = yOffset, 
        //   text              = '┌', 
        //   size              = logoSize, 
        //   color             = #00000000, 
        //   textcolor         = color.new(decorColor, 75), 
        //   text_font_family  = font.family_default, 
        //   style             = label.style_label_lower_right, 
        //   textalign         = text.align_left
        //   )
        //  )
        // // --
        // this.put("decorLowerLeft",  
        //  label.new(
        //   x                 = bar_index + xOffset, 
        //   y                 = yOffset, 
        //   text              = '┐', 
        //   size              = logoSize, 
        //   color             = #00000000, 
        //   textcolor         = color.new(decorColor, 75), 
        //   text_font_family  = font.family_default, 
        //   style             = label.style_label_lower_left, 
        //   textalign         = text.align_left
        //   )
        //  )
        this.put("decorLowerRight", 
         label.new(
          x                 = bar_index + xOffset, 
          y                 = yOffset, 
          text              = '〔⦗   ', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_right, 
          textalign         = text.align_right
          )
         )
        // --
        this.put("decorLowerLeft",  
         label.new(
          x                 = bar_index,
          y                 = yOffset, 
          text              = '   ⦘〕', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = color.new(decorColor, 75), 
          text_font_family  = font.family_default, 
          style             = label.style_label_left, 
          textalign         = text.align_left
          )
         )
        // >>
    this

// Update Logo
method update(
 map <string, label> this,
 string              newLogoText        = na,
 string              newSubLogoBtmText  = na,
 int                 xOffset            = 0
 ) =>
    // --
    if barstate.islast or barstate.isrealtime
        for key in this.keys()
            this.get(key).set_xy(bar_index + xOffset, close)
        this.get("logo").set_text(newLogoText.isset(this.get("logo").get_text()))
        this.get("subLogoBtm").set_text(newSubLogoBtmText.isset(this.get("subLogoBtm").get_text()))
    // >>
    this
// }


// Motion
var motion.keyframe subLogoKf = motion.keyframe.new(1, 3)
const string logoText = 'SCALE.'
const string subLogoBtmText = '▰▱▱'
// string subLogoBtmText = subLogoKf.transition(
//  _fx = 'marquee',
//  _seq = '▰▱▱▱▰▱▱▱▰',
//  _prefix = '\n\n\n',
//  _subLen = 3, 
//  _autoplay = true
//  )
var map <string, label> logo = map.new<string, label>()
logo.render().update(logoText, subLogoBtmText.fx('marquee', __opt = motion.option.new(prefix = '\n\n\n')), 30)
