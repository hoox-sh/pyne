//@version=3 

// Original Script > @Daveatt/David Attias 
// Edits > @jango_blockchained

//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] Duoble SMA Cross v1.7
//////////////////////////////////////////////////////////////////////////


study("[IFLOST.io] Double SMA Cross v1.7", shorttitle="[IFLOST.io] Double SMA Cross v1.7", overlay=true) 


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


length_ma1 = input(14, title = "MA 1", type=integer) 
length_ma2 = input(25, title = "MA 2", type=integer) 


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


MA1 = sma(close, length_ma1) 
MA2 = sma(close, length_ma2) 

macrossover = crossover(MA1, MA2) 
macrossunder = crossunder(MA1, MA2) 


//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


// Plots the crosses 
plotshape(macrossover, title='MA Crossover', style=shape.arrowup, location=location.belowbar, size=size.normal, color=clg, textcolor=clg, text="MA Cross", transp = 0) 
plotshape(macrossunder, title='MA Crossunder', style=shape.arrowdown, location=location.abovebar, size=size.normal, color=clr, textcolor=clr, text="MA Cross", transp = 0) 


//////////////////////////////////////////////////////////////////////////
// Signals for Trade Manager
//////////////////////////////////////////////////////////////////////////


// Signal plot to be used as external 
// if crossover, sends 1, otherwise sends -1 

Signal = macrossover ? 1 : macrossunder ? -1 : na 
plot(Signal, title="Trade Manager Signal") 