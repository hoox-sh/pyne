//@version=4
// Reference:
    // "Technical Analysis for Trading Professionals" by Constance Brown 
        // Chapter 7: Price Projections By Reverse Engineering Indicators, p.169-183
        // Chapter 8: Price Objectives Derived From Positive and Negative Reversals In The RSI, p.185-209
        
study(title="RSI Projection v1", format=format.price, precision=2)
band1 = hline(70)
band0 = hline(30)
fill(band1, band0, color=color.purple, transp=90)
src = close, len = input(14, minval=1, title="Length")
up = rma(max(change(src), 0), len)
down = rma(-min(change(src), 0), len)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

low1_len = input(6)
w = lowest(rsi,low1_len)
low2_len = input(14)
x = lowest(rsi,low2_len)
if x >= w == false
    for i = 1 to len
        x := lowest(rsi,low2_len)
hme_len = input(10)
y = highest(rsi,hme_len)
if y > x == false or y > w == false
    for i = 1 to len
        y := highest(rsi,hme_len)

// w_valuewhen = valuewhen(w,close,0)
// y_valuewhen = valuewhen(y,close,0)
// x_valuewhen = valuewhen(x,close,0)

pp_prs =(x-w) + y
// pp_prs_close =(x_valuewhen-w_valuewhen) + y_valuewhen

high1_len = input(6)
w2 = highest(rsi,high1_len)
high2_len = input(14)
x2 = highest(rsi,high2_len)
if x2 <= w2 == false
    for i = 1 to len
        x2 := lowest(rsi,high2_len)
lme_len = input(10)
y2 = lowest(rsi,lme_len)
if y2 < x2 == false or y2 < w2 == false
    for i = 1 to len
        y2 := highest(rsi,lme_len)
pp_nrs = y - (x-w)

plot(rsi, color=color.purple,transp=0)
plot(pp_prs, color=color.orange,offset=1,transp=0)
plot(pp_nrs, color=color.blue,offset=1,transp=0)




