/// ———— User Input {
//
// IMPORTANT: Example Type. NOT REQUIRED.
//
// @type       The user input object.
// @field      fx                  The selected transition effect.
// @field      play                A boolean indicating whether the effect should be played.
// @field      frequency           The frequency at which the effect should be executed.
// @field      intv                The interval at which the effect should be executed.
// @field      mu                  The multiplier for the interval.
// @field      step                The number of steps per execution.
// @field      fx_length           The length of the effect.
// @field      extern              An optional external update number.
// @field      max_loops           The maximum number of loops for the effect.
// @field      sub_start           The start index for the subsequence.
// @field      sub_length          The length of the subsequence.
// @field      reverse             A boolean indicating whether the effect should be reversed.
// @field      bounce              A boolean indicating whether the effect should bounce.
// @field      reset               A boolean indicating whether the effect should reset on every bar.
// @field      prefix              The prefix for the effect.
// @field      txt                 The text for the effect.
// @field      font_family         The font family for the effect.
// @field      format              The text format.
// @field      ws                  The trailing white space for the effect.
// @field      suffix              The suffix for the effect.
// @field      color_steps         The number of steps for the color effect.
// @field      color_bounce        A boolean indicating whether the color effect should bounce.
// @field      color_from          The initial color for the color effect.
// @field      color_to            The final color for the color effect.
// @field      multi_transition    A boolean indicating whether the effect should be a multi-transition.
// @field      start_on            The start condition for the effect.
// @field      calculation         The calculation mode for the effect.
type user_input
    // --
    string      fx
    bool        play
    string      frequency
    int         intv
    int         mu
    int         step
    int         fx_length
    int         extern
    int         max_loops
    int         sub_start
    int         sub_length
    bool        reverse
    bool        bounce
    bool        reset
    bool        refill
    string      prefix
    string      txt
    string      font_family
    int         ws
    string      suffix
    int         color_steps
    bool        color_bounce
    color       color_from
    color       color_to
    bool        multi_transition
    string      start_on
    string      calculation
// --
// @variable    The user input object.
var user_input __input = user_input.new(
 fx                 = input.string('spot', title = 'Transition FX', options = ['marquee', 'spot', 'blink', 'blend_in_right', 'blend_out_right', 'blend_in_left', 'blend_out_left', 'slide_in_left', 'slide_in_right', 'slide_out_left', 'slide_out_right', 'hide', 'show'], group = 'ACTION'),
 play               = input.bool(true, title = 'Play', group = 'ACTION'),
 frequency          = input.string('on_tick', title = 'Frequency', options = ['on_tick', 'on_time', 'on_index', 'on_input'], group = 'TIMING'),
 intv               = input.int(1, title = 'Interval (' + DELTA + 't)', step = 1, minval = 1, maxval = 100, tooltip = 'Delta Time [1;∞[', group = 'TIMING'),
 start_on           = input.string('now', title = 'Effect Start', options = ['now', 'on_open', 'on_close'], group = 'TIMING'),
 mu                 = input.int(1000, title = '▸ On Time > Fineness (' + MU + ')', step = 50, minval = 50, maxval = 2000, tooltip = 'Lower Value = Higher Frequency.\n\nDefault: 1000', group = 'TIMING'),
 extern             = input.int(0, title = '▸ On Input > External Update No', tooltip = 'For development purpose.', group = 'TIMING'),
 step               = input.int(1, title = 'Steps Per Execution', step = 1, minval = 1, maxval = 20, group = 'PREFERENCES', tooltip = 'Default: 1'),
 fx_length          = input.int(1, title = 'FX Length', step = 1, minval = 1, maxval = 20, group = 'PREFERENCES', tooltip = 'Default: 1'),
 max_loops          = input.int(0, title = 'Max. Loops', step = 1, minval = 0, maxval = 100, tooltip = 'Default:\nOn Single Transition > 0 (infinite)\nOn Multi Transition > 1', group = 'PREFERENCES'),
 sub_start          = input.int(0, title = 'Subsequence Start', step = 1, minval = 0, maxval = 20, tooltip = 'Default: 0 (auto)\n\n[ABCDEF]GHI...\n|      |\n0     5', group = 'PREFERENCES'),
 sub_length         = input.int(0, title = 'Subsequence Length', step = 1, minval = 0, maxval = 20, group = 'PREFERENCES', tooltip = 'Default: 0 (auto)'),
 refill             = input.bool(true, title = 'Placeholder / Refill', group = 'PREFERENCES', tooltip = 'Default: true'),
 reverse            = input.bool(false, title = 'Reverse', group = 'PREFERENCES', tooltip = 'Works only on effects without preset direction:\nmarquee | spot | blink'),
 bounce             = input.bool(false, title = 'Bounce', group = 'PREFERENCES', tooltip = 'When set to true, the series transitions to the max value, and then bounces back in reverse order.'),
 reset              = input.bool(false, title = 'Reset On Every Bar', group = 'PREFERENCES', tooltip = 'If true, the effect resets on each new bar.\n\nDefault: false'),
 prefix             = input.string('', title = 'Prefix', group = 'CONTENT'),
 txt                = input.string('ABCDEFGHIJKLMNOPQRSTUVWXYZ', title = 'Text', group = 'CONTENT'),
 font_family        = input.string(font.family_monospace, title = 'Font Family', options = [font.family_default, font.family_monospace], group = 'CONTENT'),
 ws                 = input.int(0, title = 'Trailing White Space', step = 1, minval = 0, maxval = 10, group = 'CONTENT'),
 suffix             = input.string('', title = 'Suffix', group = 'CONTENT'),
 color_steps        = input.int(14, title = 'Gradient Steps', step = 1, minval = 1, maxval = 20, group = 'COLOR', tooltip = 'If you want to setup a bounced effect for a given length, you need to calculate your steps as follow:\n\n(Length / 2) + 1\n\nIf you want to know how long your bounced effect will be:\n\n(Steps * 2) - 2'),
 color_bounce       = input.bool(true, title = 'Color Bounce', group = 'COLOR'),
 color_from         = input.color(color.rgb(0, 57, 212), title = 'Color From', group = 'COLOR'),
 color_to           = input.color(color.rgb(59, 209, 255), title = 'Color To', group = 'COLOR'),
 multi_transition   = input.bool(false, title = 'Multi-Transition Example', tooltip = 'Add an extra Blink FX with Max. Loops = 3 in front of the selected FX.', group = 'MULTI TRANSITION'),
 //exec_order         = input.string('stacked', title = 'Transition Type', options = ['sequential', 'parallel'], group = 'MULTI TRANSITION'),
 calculation        = 'relative' //input.string('relative', title = 'Calculation Mode', options=['relative','absolute'], group = 'ADVANCED/DEVELOPMENT'),
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Function Render Logo/Tag {
//
// @function   Creates a simple animated logo or tag.
// @param      _tagline     Optional string to use as the tagline. Default is '- A Pine Script™ Showcase -'.
// @param      _sizeLogo    Optional size parameter for the logo. Default is size.huge.
// @param      _sizeTag     Optional size parameter for the tagline. Default is size.normal.
// @param      _colorLogo   Optional color parameter for the logo. Default is #ff5252.
// @param      _colorTag    Optional color parameter for the tagline. Default is #ffffff96.
// @param      _colorDecor  Optional color parameter for decoration. Default is #ff525234.
// @param      _x           Optional integer specifying the X position. Default is bar_index.
// @param      _y           Optional float specifying the Y position. Default is 2100.
// @returns    `array <label>`
renderLogo(
 string _sizeLogo   = size.huge, 
 string _sizeTag    = size.normal, 
 color  _colorLogo  = #ff5252, 
 color  _colorTag   = #ffffff96, 
 color  _colorDecor = #ff525234, 
 string _tagline    = '- A Pine Script™ Showcase -',
 int    _x          = bar_index, 
 float  _y          = close
 ) =>
    // >>
    array.from(
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '',
      color             = #00000000,
      size              = _sizeLogo,
      style             = label.style_label_center,
      textcolor         = _colorLogo,
      textalign         = text.align_center,
      text_font_family  = font.family_default
     ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '└',
      color             = #00000000,
      size              = _sizeLogo,
      style             = label.style_label_upper_right,
      textcolor         = _colorDecor,
      textalign         = text.align_left,
      text_font_family  = font.family_default
      ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '┘',
      color             = #00000000,
      size              = _sizeLogo,
      style             = label.style_label_upper_left,
      textcolor         = _colorDecor,
      textalign         = text.align_left,
      text_font_family  = font.family_default
      ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '┌',
      color             = #00000000,
      size              = _sizeLogo,
      style             = label.style_label_lower_right,
      textcolor         = _colorDecor,
      textalign         = text.align_left,
      text_font_family  = font.family_default
      ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '┐',
      color             = #00000000,
      size              = _sizeLogo,
      style             = label.style_label_lower_left,
      textcolor         = _colorDecor,
      textalign         = text.align_left,
      text_font_family  = font.family_default
      ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = ' ',
      size              = _sizeLogo,
      color             = #00000000,
      textcolor         = color.new(_colorLogo, 75),
      text_font_family  = font.family_default,
      style             = label.style_label_down,
      textalign         = text.align_left
      ),
     label.new(
      x                 = _x,
      y                 = _y,
      text              = '\n\n\n\n\n' + _tagline,
      color             = #00000000,
      size              = size.small,
      style             = label.style_label_up,
      textcolor         = _colorTag,
      textalign         = text.align_left,
      text_font_family  = font.family_monospace
      )
     )
// }

// ———— Method for Updating Logo {
//
// @function    Updates the logo's properties.
// @param       _logo           Array of label objects constituting the logo.
// @param       _textLogo       Optional new text for the logo. Default is 'na'.
// @param       _textTagline    Optional new text for the tagline. Default is 'na'.
// @param       _x              Optional new X position. Default is bar_index.
// @param       _y              Optional new Y position. Default is 'na'.
// @returns     `void`          The function doesn't return any value.
method update(
 array <label>  _logo, 
 string         _textLogo       = na,
 string         _textTagline    = na,
 float          _y              = na,
 int            _x              = bar_index,
 color          _colorDecor     = na
 ) =>
    // --
    if barstate.islast
        for i = 0 to _logo.size() - 1
            label l = _logo.get(i)
            l.set_xy(
             _x.isset(l.get_x()), 
             _y.isset(l.get_y())
             )
        // --
        if not na(_colorDecor)
            for i = 1 to 4
                label l = _logo.get(i)
                l.set_textcolor(color.new(_colorDecor, 85))
        // --
        label l0 = _logo.get(0)
        label l3 = _logo.get(3)
        label l6 = _logo.get(6)
        l0.set_text(
         _textLogo.isset(l0.get_text())
         )
        l0.set_textcolor(_colorDecor)
        l6.set_text(
         _textTagline.isset(l6.get_text())
         )
    // >>
    // void
// }

// ———— Motion. ✨ {
//
// const string MONO_STRING = '⠵⠠⡜⡫⡃⡺⡵⡲⡰⡏'
const string TAGLINE = '~ A Pine Script™ {0} ~'
const array <string> LOGO_ARRAY = array.from('M ◞TION.','M◟ TION.','M◜ TION.','M ◝TION.')
// --
// var keyframe logoKf    = keyframe.new(intv = 1, steps = 8)
var keyframe logoColorKf = keyframe.new(1,1)
var keyframe taglineKf1  = keyframe.new(intv = 4, steps = 1)
var keyframe taglineKf2  = keyframe.new(intv = 1, steps = 1)
// --
series string taglineFX1 = taglineKf1.iteration(
 _seqArr = array.from('Showcase','Library'),
 __opt   = option.new( 
  prefix = 'A Pine Script™ ',
  refill = true
  )
 )
// --
series string taglineFX2 = taglineKf2.transition(
 _seq = taglineFX1,
 _fx = 'slide_in_right',
 __opt = option.new(
  max_loops = 1,
  prefix    = '\n\n\n\n' + '- ',
  suffix    = ' -'
  )
 )
// --
series color multicolor = 
 array.from(color.orange, color.fuchsia, color.aqua, color.yellow, color.navy)
 .fade(_steps = 8)
// --
series string logoFX = LOGO_ARRAY.motion(_join = false)
// --
var array<label> LOGO = renderLogo(size.huge, size.normal)
LOGO.update(logoFX, taglineFX2, 10, _colorDecor = multicolor)
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Label {
//
// @variable    An example `<label>` object.
var series label select = label.new(
 x                  = bar_index,
 y                  = 750,
 text               = 'Select FX',
 textcolor          = color.white,
 color              = #ffffff0b,
 size               = size.normal, 
 text_formatting    = text.format_italic,
 style              = label.style_label_center
 )
// @variable    An example `<label>` object.
var series label fx = label.new(
 x                  = bar_index,
 y                  = 700,
 text               = __input.fx,
 textcolor          = multicolor,
 color              = #ffffff0b,
 size               = size.normal,
 style              = label.style_label_center,
 textalign          = text.align_center,
 text_font_family   = font.family_default,
 text_formatting    = text.format_bold
 )
// @variable    An example `<label>` object.
var series label example = label.new(
 x                  = bar_index,
 y                  = 600,
 text               = __input.txt,
 textcolor          = chart.fg_color,
 color              = #ffffff0b,
 size               = 24,
 style              = label.style_label_center,
 textalign          = text.align_center,
 text_font_family   = __input.font_family
 )
// @variable    An example `<label>` object.
var series label info = label.new(
 x                  = bar_index,
 y                  = 400,
 text               = 'Add the script to your chart to experience its features! 🚀',
 textcolor          = chart.fg_color,
 color              = #ffffff0b,
 size               = size.large,
 style              = label.style_label_center
 )
// @variable    An example `<label>` object.
var series label openSource = label.new(
 x                  = bar_index,
 y                  = 300,
 text               = '🔋 Batteries Included',
 textcolor          = color.new(color.silver, 30),
 color              = #ffffff00,
 size               = size.small,
 style              = label.style_label_center
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Keyframes {
//
// @variable    The Color FX `<keyframe>` object.
var keyframe colorKf = keyframe.new(
 intv   = __input.intv,
 steps  = __input.step,
 exec   = __input.play
 )
// @variable    The Transition FX `<keyframe>` object.
var keyframe transitionKf = keyframe.new(
 intv   = __input.intv,
 steps  = __input.step,
 exec   = __input.play,
 extern = __input.extern
 )
// @variable    The Move FX `<keyframe>` object.
var keyframe moveKf  = keyframe.new()
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Option {
// 
// @variable    The global `<option>` object.
var option __opt = option.new(
 ws             = __input.ws,
 max_loops      = __input.max_loops,
 reverse        = __input.reverse,
 bounce         = __input.bounce,
 refill         = __input.refill,
 reset          = __input.reset,
 sub_length     = __input.sub_length,
 sub_start      = __input.sub_start,
 fx_length      = __input.fx_length,
 prefix         = __input.prefix,
 suffix         = __input.suffix
 )
// @variable    A modified copy of the global `<option>` object.
var option __opt2 = __opt.copy()
__opt2.max_loops := 3
// @variable    A copy of the global `<option>` object.
var option __opt3 = __opt.copy()
// @variable    A modified copy of the global `<option>` object.
var option __opt4 = __opt.copy()
__opt4.bounce := __input.color_bounce
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Timer {
//
// @variable    The global `<timer>` object.
var timer __timer = timer.new(
 frequency      = __input.frequency,
 start_on       = __input.start_on,
 mu             = __input.mu,
 calculation    = __input.calculation
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— FX {
//
if __input.multi_transition
    // --
    transitionKf.transition(
     _seq       = __input.txt,
     _fx        = 'blink',
     __opt      = __opt2,
     __timer    = __timer
     )
// @variable    Output of the executed effect.
series string myTransition = transitionKf.transition(
 _seq       = __input.txt,
 _fx        = __input.fx,
 __opt      = __opt3,
 __timer    = __timer
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

//———— Updates {
//
// @variable    X-axis anchor for example `<label>`.
series int x = bar_index
// --
select.set_xy(x, 7)
fx.set_xy(x, 6.5)
fx.set_text(__input.fx)
fx.set_textcolor(multicolor)
example.set_xy(x, 5)
example.set_text(myTransition)
openSource.set_xy(x, 0)
// }

