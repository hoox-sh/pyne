export method fadeIn(
 series label   this,
 series color   _colorTo,
 series color   _colorFrom  = #00000000,
 series bool    _bg         = false,
 series int     _steps      = 8,
 series int     _transpFrom = 100,
 series int     _transpTo   = 0,
 keyframe       __kf        = na,
 option         __opt       = na,
 timer          __timer     = na
 ) =>
    // --
    var keyframe kf = __kf.isset(keyframe.new())
    // --
    color gradientColor = kf.gradient(
     _colorFrom  = _colorFrom,
     _colorTo    = _colorTo,
     _steps      = _steps,
     _transpFrom = _transpFrom,
     _transpTo   = _transpTo,
     __opt       = __opt.isset(option.new()),
     __timer     = __timer.isset(timer.new())
     )
    // --
    switch _bg
        true => this.set_color(gradientColor)
        => this.set_textcolor(gradientColor)
    // >>
    this
