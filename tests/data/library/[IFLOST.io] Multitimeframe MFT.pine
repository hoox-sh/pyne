//@version=4


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


study("[IFLOST.io] Multitimeframe MFT", "[IFLOST.io] MFT", overlay = true)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


candleType = input("Candlestick", title = "Candle Type", options = ["Candlestick", "Heikin Ashi"])
dintval = input("60", title = "Candle Interval (5, 15, 60, 240, D, W, M, etc")

maType = input("EMA", title = "MA Type", options = ["EMA", "SMA"])
dintval2 = input("60", title = "MA Interval (5, 15, 60, 240, D, W, M, etc")

maSrc = input("Close", title = "MA Source", options = ["Close", "HL2", "HLC3", "OHLC4"])
maLen1 = input(21, title = "MA Fast Length")
maLen2 = input(55, title = "MA Slow Length")

//////////////////////////////////////////////////////////////////////////
// Misc
//////////////////////////////////////////////////////////////////////////

candleWidth = input(2, title = "Candle Body Line Thickness (1 - 4)", minval = 1, maxval = 4)
wickWidth = input(3, title = "Wick Thickness (1 - 4)", minval = 1, maxval = 4)
_opacity1 = input(100, title = "Candle Border Opacity (0 - 100)", minval = 0, maxval = 100, step = 10)
_opacity2 = input(20, title = "Historical Candle Fill Opacity (0 - 100)", minval = 0, maxval = 100, step = 10)
_opacity3 = input(85, title = "Historical Wick Fill Opacity (0 - 100)", minval = 0, maxval = 100, step = 10)
showCandles = input(true, title = "Show Recent Candles?")
showHistorical = input(true, title = "Show Historical Candles?")
showWick = input(true, title = "Show Wicks?")


//////////////////////////////////////////////////////////////////////////
// Setup
//////////////////////////////////////////////////////////////////////////


opacity = floor(_opacity1 / 10) * 10
opacity2 = floor(_opacity2 / 10) * 10
opacity3 = floor(_opacity3 / 10) * 10

// GLOBAL
bar = -1
bar := nz(bar[1]) + 1

start = security(syminfo.tickerid, dintval, time, lookahead = true)
newSession = iff(change(start), 1, 0)
sinceNew = nz(barssince(newSession), bar)

// fixes 15m and 60m futures gap sessions
oldSinceNew1 = valuewhen(newSession, sinceNew[1], 1)
oldSinceNew2 = valuewhen(newSession, sinceNew[1], 2)

barsInInt = 0
barsInInt := sinceNew > nz(barsInInt[1]) or newSession ? max(max(max(sinceNew, sinceNew[1]), oldSinceNew1), oldSinceNew2) : nz(barsInInt[1])

start2 = security(syminfo.tickerid, dintval2, time, lookahead = true)
newSession2 = iff(change(start2), 1, 0)
sinceNew2 = nz(barssince(newSession2), bar)

// fixes 15m and 60m futures gap sessions
oldSinceNew11 = valuewhen(newSession2, sinceNew2[1], 1)
oldSinceNew22 = valuewhen(newSession2, sinceNew2[1], 2)

barsInInt2 = 0
barsInInt2 := sinceNew2 > nz(barsInInt2[1]) or newSession2 ? max(max(max(sinceNew2, sinceNew2[1]), oldSinceNew11), oldSinceNew22) : nz(barsInInt2[1])

// auto detect renko

renkoBlock = abs(open - close)
renkoBlock := bar > 1 ? abs(open - close) == renkoBlock[1] and (close == high or close == low) ? renkoBlock[1] : -1 : abs(open - close) > 0 and (close == high or close == low) ? abs(open - close) : -1
isRenko = renkoBlock >= 0

isChartIntval = isRenko or (sinceNew == 0 and sinceNew[1] == 0 and sinceNew[2] == 0)
isChartIntval2 = isRenko or (sinceNew2 == 0 and sinceNew2[1] == 0 and sinceNew2[2] == 0)

eTF = isChartIntval or barsInInt == sinceNew
eTF2 = isChartIntval2 or barsInInt2 == sinceNew2

// STYLE

lineStyle = line.style_solid

//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D

upColor = clg
dnColor = clr
wickColor = color.gray

fillColorUp = clg
fillColorDn = clr
fillColorWick = clg


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


// MTF OHLC4

oo = open
oo := newSession ? open : nz(oo[1], open)

ll = low
ll := newSession ? low : min(low, nz(ll[1], low))

hh = high
hh := newSession ? high : max(high, nz(hh[1], high))

haClose = (oo + hh + ll + close) / 4

haOpen = open
haOpen := newSession ? (nz(haOpen[1]) + nz(haClose[1])) / 2 : nz(haOpen[1]) 

haHigh = max(hh, max(haOpen, haClose))
haLow = min(ll, min(haOpen, haClose))

o = candleType == "Candlestick" ? oo : haOpen
h = candleType == "Candlestick" ? hh : haHigh
l = candleType == "Candlestick" ? ll : haLow
c = candleType == "Candlestick" ? close : haClose

// cannot use change(time) or it casts to float, not allowed for line plots
// when this value 'dT' is used in the calculation of 'x2'
dT = time - time[1]
dT := time - time[1] < nz(dT[1]) ? time - time[1] : nz(dT[1], time - time[1])

gaps = 0
gaps := newSession ? 0 : time - time[1] > dT ? nz(gaps[1]) + ceil((time - time[1]) / dT) - 1 : nz(gaps[1])

// RECENT PLOTTER

getCandle() =>
    var line lOpen = na
    var line lHigh = na
    var line lLow = na
    var line lClose = na
    var line lOpenClose = na
    var line lCloseOpen = na
    var int x1 = 0
    
    col = c > o ? upColor : c < o ? dnColor : wickColor
        
    if not isChartIntval and showCandles
        if newSession
            x1 := time
            x2 = time + barsInInt * dT
            
            mid = floor((time + x2) / (2 * dT)) * dT
            
            lOpen := line.new(time, o, x2, o, xloc = xloc.bar_time, color = col, style = lineStyle, width = candleWidth)
            lClose := line.new(time, c, x2, c, xloc = xloc.bar_time, color = col, style = lineStyle, width = candleWidth)
            lOpenClose := line.new(time, o, time, c, xloc = xloc.bar_time, color = col, style = lineStyle, width = candleWidth)
            lCloseOpen := line.new(x2, o, x2, c, xloc = xloc.bar_time, color = col, style = lineStyle, width = candleWidth)
            
            // readjust for gaps
            
            line.set_x2(lOpen[1], time[1])
            line.set_x2(lClose[1], time[1])
            line.set_x1(lCloseOpen[1], time[1])
            line.set_x2(lCloseOpen[1], time[1])
                
            if showWick
                lLow := line.new(mid, o, mid, l, xloc = xloc.bar_time, color = wickColor, style = lineStyle, width = wickWidth)
                lHigh := line.new(mid, c, mid, h, xloc = xloc.bar_time, color = wickColor, style = lineStyle, width = wickWidth)
                
                // readjust for gaps
                
                mid1 = floor((x1[1] + time[1]) / (2 * dT)) * dT
                
                line.set_x1(lLow[1], mid1)
                line.set_x2(lLow[1], mid1)
                line.set_x1(lHigh[1], mid1)
                line.set_x2(lHigh[1], mid1)
        else
            // Reset x-values for gaps in prices
            
            // Right now we have to "fool" the line class into a new
            // x2 value for 1 bar and then reset it back again or
            // else it will repaint. Bug ticket submitted on this one.
            // The line class needs to actually detect a change in one
            // of the fields it caries (x1, x2, y1, y2, etc) to change it
            // so if you are giving it the same value it will not change.
            // We have to force this change in the case of price gaps
        
            x2 = change(gaps) > 0 ? x1 + barsInInt * dT + 1 : x1 + barsInInt * dT 
            // x2 = x1 + barsInInt * dT
            
            line.set_x2(lOpen, x2)
            line.set_x2(lClose, x2)
            line.set_x1(lCloseOpen, x2)
            line.set_x2(lCloseOpen, x2)
            
            if showWick
                mid = floor((x1 + x2) / (2 * dT)) * dT
                    
                line.set_x1(lLow, mid)
                line.set_x2(lLow, mid)
                line.set_x1(lHigh, mid)
                line.set_x2(lHigh, mid)
            
        if eTF
            // - max lines capped at 50, delete old candles so that fractions of a candle do not display
            // - at the last candle of the interval, delete all of the lines from a historical candle
            // depending on if wicks are showing since we can draw more lines when wicks = off
            toDelete1 = bar_index - valuewhen(newSession, bar_index - 1, 7)
            toDelete2 = bar_index - valuewhen(newSession, bar_index - 1, 11)
            toDelete = max(1, showWick ? toDelete1 : toDelete2)
            
            // NOTE: The commented out code below is causing a bug:
            // "Too many drawings, cannot clean oldest"
             
            // line.delete(lOpen[toDelete])
            // line.delete(lClose[toDelete])
            // line.delete(lOpenClose[toDelete])
            // line.delete(lCloseOpen[toDelete])
            // line.delete(lLow[toDelete])
            // line.delete(lHigh[toDelete])
    
        line.set_y1(lClose, c)
        line.set_y2(lClose, c)
        
        line.set_y2(lOpenClose, c)
        line.set_y2(lCloseOpen, c)
        
        line.set_color(lOpen, col)
        line.set_color(lClose, col)
        
        line.set_color(lOpenClose, col)
        line.set_color(lCloseOpen, col)
        
        if showWick
            line.set_y1(lLow, c > o ? o : c)
            line.set_y2(lLow, l)
            
            line.set_y1(lHigh, c > o ? c : o)
            line.set_y2(lHigh, h)
        
// Moving Average MTF
    
getMA(len) =>
    // SMA
    
    xClose = ohlc4
    xOpen = open
    xOpen := (nz(xOpen[1]) + nz(xClose[1])) / 2
    xHigh = max(high, max(xOpen, xClose))
    xLow = min(low, min(xOpen, xClose))
    
    src1 = maSrc == "Close" ? close : maSrc == "HL2" ? hl2 : maSrc == "HLC3" ? hlc3 : ohlc4
    src2 = maSrc == "Close" ? xClose : maSrc == "HL2" ? (xHigh + xLow) / 2 : maSrc == "HLC3" ? (xHigh + xLow + xClose) / 3 : (xOpen + xHigh + xLow + xClose) / 4
    src3 = maSrc == "Close" ? c : maSrc == "HL2" ? (h + l) / 2 : maSrc == "HLC3" ? (h + l + c) / 3 : (o + h + l + c) / 4
    
    sum11 = sum(src1, max(len - 1, 1))
    sum12 = sum(src2, max(len - 1, 1))
    sum21 = security(syminfo.tickerid, dintval2, sum11[1], lookahead = true) // get the sum of (length - 1) data 1 bar ago
    sum22 = security(syminfo.tickerid, dintval2, sum12[1], lookahead = true) // get the sum of (length - 1) data 1 bar ago
    sum = candleType == "Candlestick" ? sum21 : sum22
    
    sma = src1
    sma := isChartIntval2 ? sma(src1,  len) : eTF2 ? (sum + src3) /  len : nz(sma[1]) // merge with current candle
    
    // EMA
    
    ema = src1
    a = 2 / (len + 1)
    
    pEMA = src1
    pEMA := newSession2 or isChartIntval2 ? nz(ema[1]) : nz(pEMA[1])

    ema := eTF2 ? pEMA + a * (src3 - pEMA) : nz(ema[1])

    ma = maType == "EMA" ? ema : sma
    

//////////////////////////////////////////////////////////////////////////
// Live Candle Calculation
//////////////////////////////////////////////////////////////////////////


getCandle()


//////////////////////////////////////////////////////////////////////////
// HISTORICAL PLOTTER
//////////////////////////////////////////////////////////////////////////


// historical candles because we are limited to total lines per indicator

barsInSession = 0
barsInSession := eTF ? sinceNew + 1 : nz(barsInSession[1])

offset = 1

old = barsInInt + 1

old2 = 0
old2 := newSession ? sinceNew[1] + 1 : nz(old2[1], sinceNew)

minOld = min(bar_index, min(old, old2))

lastOpen = open
lastOpen := newSession ? o[minOld + 1] : nz(lastOpen[1])

lastOpen2 = open
lastOpen2 := newSession ? o[minOld + 1] : eTF ? o[minOld] : nz(lastOpen2[1])

lastHigh = high
lastHigh := newSession ? h[minOld + 1] : eTF ? h[minOld] : nz(lastHigh[1])

lastLow = low
lastLow := newSession ? l[minOld + 1] : eTF ? l[minOld] : nz(lastLow[1])

lastClose = close
lastClose := newSession ? c[minOld + 1] : nz(lastClose[1])

lastClose2 = close
lastClose2 := newSession ? c[minOld + 1] : eTF ? c[minOld] : nz(lastClose2[1])

noGaps = false
noGaps := newSession ? gaps[1] == 0 and old[1] == old2[1] : nz(noGaps[1], false)

op2 = plot(not isChartIntval and showHistorical ? lastOpen2 : na, title = "Historical Open (For Wicks)", color = #00000000, offset = -old - ceil(barsInInt / 2), editable = false)
cp2 = plot(not isChartIntval and showHistorical ? lastClose2 : na, title = "Historical Close (For Wicks)", color = #00000000, offset = -old - ceil(barsInInt / 2), editable = false)

op = plot(not isChartIntval and showHistorical ? lastOpen : na, title = "Historical Open", linewidth = min(4, candleWidth), color = newSession ? #00000000 : lastClose > lastOpen ? upColor : lastClose < lastOpen ? dnColor : wickColor, offset = -2 * old, editable = false)
hp = plot(not isChartIntval and showHistorical and showWick ? lastHigh : na, title = "Historical High", color = newSession and noGaps ? fillColorWick : #00000000, offset = -old - ceil(barsInInt / 2), editable = false)
lp = plot(not isChartIntval and showHistorical and showWick ? lastLow : na, title = "Historical Low", color = newSession and noGaps ? fillColorWick : #00000000, offset = -old - ceil(barsInInt / 2), editable = false)
cp = plot(not isChartIntval and showHistorical ? lastClose : na, title = "Historical Close", linewidth = min(4, candleWidth), color = newSession ? #00000000 : lastClose > lastOpen ? upColor : lastClose < lastOpen ? dnColor : wickColor, offset = -2 * old, editable = false)
 
fill(op, cp, title = "Historical Fill", color = newSession ? #00000000 : lastClose > lastOpen ? fillColorUp : lastClose < lastOpen ? fillColorDn : fillColorWick, editable = false)

fill(hp, cp2, title = "Historical Fill Wick Up 1", color = lastClose >= lastOpen and newSession and noGaps ? fillColorWick : #00000000, editable = false)
fill(hp, op2, title = "Historical Fill Wick Up 2", color = lastClose < lastOpen and newSession and noGaps ? fillColorWick : #00000000, editable = false)

fill(lp, op2, title = "Historical Fill Wick Down 1", color = lastClose >= lastOpen and newSession and noGaps ? fillColorWick : #00000000, editable = false)
fill(lp, cp2, title = "Historical Fill Wick Down 2", color = lastClose < lastOpen and newSession and noGaps ? fillColorWick : #00000000, editable = false)


//////////////////////////////////////////////////////////////////////////
// MTF Moving Averages
//////////////////////////////////////////////////////////////////////////


// fast = getMA(min(maLen1, maLen2))
// slow = getMA(max(maLen1, maLen2))

// maTrend = 1
// maTrend := crossover(fast, slow) ? 1 : crossunder(fast, slow) ? -1 : nz(maTrend[1], 1)

//f = plot(fast, title = "Moving Average Fast", color = maTrend > 0 ? cdg : cdr)
// s = plot(slow, title = "Moving Average Slow", color = maTrend > 0 ? clg : clr)

// fill(f, s, title = "Moving Average Fill", color = maTrend > 0 ? cbg : cbr)
        
