// @version=6
// @description Validate arguments for the Scale library.
library("ScaleValidator", overlay = true)


// ──── Constants {
//
// @variable    Error message for invalid format
const string ERROR_MSG = 'Invalid {1} Argument: {0}\n\nPossible {1} Arguments:\n{2}'
// }


//  ▪ ──── METHODS: SIMPLE BOOLEAN CHECKS
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Is Location Above {
//
// @function    Checks if location is above (top or abovebar).
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _location       Location string to check.
// @returns     `<bool>` True if location is above.
export method isLocationAbove(series string _location) =>
    // --
    array.includes(array.from(location.top, location.abovebar), _location)
// }

// ──── Is Position Above {
//
// @function    Checks if position is in the top row.
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _position       Position string to check.
// @returns     `<bool>` True if position is above.
export method isPositionAbove(series string _position) =>
    // --
    array.includes(array.from(position.top_left, position.top_center, position.top_right), _position)
// }

// ──── Is Position Center {
//
// @function    Checks if position is in the middle row.
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _position       Position string to check.
// @returns     `<bool>` True if position is center.
export method isPositionCenter(series string _position) =>
    // --
    array.includes(array.from(position.middle_left, position.middle_center, position.middle_right), _position)
// }

// ──── Is Location Below {
//
// @function    Checks if location is below (bottom or belowbar).
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _location       Location string to check.
// @returns     `<bool>` True if location is below.
export method isLocationBelow(series string _location) =>
    // --
    array.includes(array.from(location.bottom, location.belowbar), _location)
// }

// ──── Is Position Below {
//
// @function    Checks if position is in the bottom row.
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _position       Position string to check.
// @returns     `<bool>` True if position is below.
export method isPositionBelow(series string _position) =>
    // --
    array.includes(array.from(position.bottom_left, position.bottom_center, position.bottom_right), _position)
// }

// ──── Is Position Left {
//
// @function    Checks if position is in the left column.
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _position       Position string to check.
// @returns     `<bool>` True if position is left.
export method isPositionLeft(series string _position) =>
    // --
    array.includes(array.from(position.top_left, position.middle_left, position.bottom_left), _position)
// }

// ──── Is Position Right {
//
// @function    Checks if position is in the right column.
// ___
// [![method helper](https://img.shields.io/badge/method-helper-CCCCCC?style=flat-square)]()
// ___
// @param       _position       Position string to check.
// @returns     `<bool>` True if position is right.
export method isPositionRight(series string _position) =>
    // --
    array.includes(array.from(position.bottom_right, position.top_right, position.middle_right), _position)
// }


//  ▪ ──── METHODS: VALIDATION
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Is Valid Location {
//
// @function    Validates a location string. Throws runtime error if invalid.
// ___
// [![method validator](https://img.shields.io/badge/method-validator-1B97F3?style=flat-square)]()
// ___
// #### 📊 Valid Locations
// | Constant | Description |
// |----------|-------------|
// | `location.top` | Top of pane |
// | `location.bottom` | Bottom of pane |
// | `location.abovebar` | Above price bar |
// | `location.belowbar` | Below price bar |
// | `location.absolute` | Absolute position |
// ___
// @param       _location       Location string to validate.
// @returns     `<bool>` True if valid, else throws error.
export method isValidLocation(series string _location) =>
    // --
    array <string> arr = array.from(
     location.top,
     location.bottom,
     location.abovebar,
     location.belowbar,
     location.absolute
     )
    switch
        arr.includes(_location) => true
        => runtime.error(str.format(ERROR_MSG, _location, 'Location', arr))
         , false
// }

// ──── Is Valid Position {
//
// @function    Validates a position string. Throws runtime error if invalid.
// ___
// [![method validator](https://img.shields.io/badge/method-validator-1B97F3?style=flat-square)]()
// ___
// #### 📊 Valid Positions
// | Row | Left | Center | Right |
// |-----|------|--------|-------|
// | Top | `top_left` | `top_center` | `top_right` |
// | Mid | `middle_left` | `middle_center` | `middle_right` |
// | Bot | `bottom_left` | `bottom_center` | `bottom_right` |
// ___
// @param       _position       Position string to validate.
// @returns     `<bool>` True if valid, else throws error.
export method isValidPosition(series string _position) =>
    // --
    array <string> arr = array.from(
     position.top_left,
     position.top_center,
     position.top_right,
     position.middle_left, 
     position.middle_center,
     position.middle_right,
     position.bottom_left,
     position.bottom_center,
     position.bottom_right
     )
    switch
        arr.includes(_position) => true
        => runtime.error(str.format(ERROR_MSG, _position, 'Position', arr))
         , false
// }

// ──── Is Valid Format {
//
// @function    Validates a format string. Throws runtime error if invalid.
// ___
// [![method validator](https://img.shields.io/badge/method-validator-1B97F3?style=flat-square)]()
// ___
// #### 📊 Valid Formats
// | Constant | Description |
// |----------|-------------|
// | `format.inherit` | Inherit from parent |
// | `format.percent` | Percentage format |
// ___
// @param       _format         Format string to validate.
// @returns     `<bool>` True if valid, else throws error.
export method isValidFormat(series string _format) =>
    // --
    array <string> arr = array.from(format.inherit, format.percent)
    switch
        arr.includes(_format) => true
        => runtime.error(str.format(ERROR_MSG, _format, 'Format', arr))
         , false
// }

// ──── Is Valid Point Of View {
//
// @function    Validates a point of view (extend) string. Throws runtime error if invalid.
// ___
// [![method validator](https://img.shields.io/badge/method-validator-1B97F3?style=flat-square)]()
// ___
// #### 📊 Valid POV
// | Constant | Description |
// |----------|-------------|
// | `extend.both` | Extend in both directions |
// | `extend.left` | Extend to the left |
// | `extend.right` | Extend to the right |
// ___
// @param       _pointOfView    Point of view string to validate.
// @returns     `<bool>` True if valid, else throws error.
export method isValidPOV(series string _pointOfView) =>
    // --
    array <string> arr = array.from(extend.both, extend.left, extend.right)
    switch
        arr.includes(_pointOfView) => true
        => runtime.error(str.format(ERROR_MSG, _pointOfView, 'Point Of View (extend)', arr))
         , false
// }


