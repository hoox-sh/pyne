//@version=4

// Original Script > @everget (Alex Orekhov)
// Edit and Update to Pine Script 4 > @jango_blockchained


//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] Super Parabolic EMA
//////////////////////////////////////////////////////////////////////////


study("[IFLOST.io] Super Parabolic EMA", "[IFLOST.io] Super Parabolic EMA", true)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


// PSAR
float start = input(title="Start", type=input.float, step=0.001, defval=0.02)
float increment = input(title="Increment", type=input.float, step=0.001, defval=0.02)
float maximum = input(title="Maximum", type=input.float, step=0.01, defval=0.2)
int width = input(title="Point Width", type=input.integer, minval=1, defval=2)
bool highlightStartPoints = input(title="Highlight Start Points ?", defval=true, type=input.bool)

// SuperTrend
float st_factor = input(1.5, type = input.float)
int st_pd = input(5, minval = 1, maxval = 100, type = input.integer)

// Tripple EMA
int ema1_value = input (type=input.integer, title="EMA #1", defval=20,minval=1, maxval=400)
int ema2_value = input (type=input.integer, title="EMA #2", defval=50,minval=1, maxval=400)
int ema3_value = input (type=input.integer, title="EMA #3", defval=225,minval=1, maxval=400)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////

// PSAR
psar = sar(start, increment, maximum)
dir = psar < close ? 1 : -1

// SuperTrend
float up = hl2 - (st_factor * atr(st_pd))
dn = hl2 + (st_factor * atr(st_pd))
float trendup = 0.0
trendup := close[1] > trendup[1] ? max(up, trendup[1]) : up
float trenddown = 0.0
trenddown := close[1] < trenddown[1] ? min(dn, trenddown[1]) : dn
float trend = 0.0
trend := close > trenddown[1] ? 1 : close < trendup[1] ? -1 : nz(trend[1], 1)
float tsl = trend == 1 ? trendup : trenddown

// Tripple EMA
ema1 = ema(close,ema1_value)
ema2 = ema(close,ema2_value)
ema3 = ema(close,ema3_value)

// Combination
// Buy = 1; Sell = -1
bool trigger_ema = na
bool trigger_st = na
signal_ema = ema1 < ema2 and ema1 < ema3 ? 1 : ema1 > ema2 and ema1 > ema3 ? -1 : 0

signal_st = trend == 1 and trend[1] == -1 ? 1 : trend == -1 and trend[1] == 1 ? -1 : 0

//trigger_ema := trigger_ema[1] != signal_ema ? signal_ema : trigger_ema[1]



//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


// PSAR
psarColor = psar < close ? cdg : cdr
plot(psar, title="PSAR", style=plot.style_circles, linewidth=width, color=psarColor, transp=0)

plotshape(dir == 1 and dir[1] == -1 and highlightStartPoints ? psar : na, title="Long Stop Start", location=location.absolute, style=shape.circle, size=size.tiny, color=clg, transp=0)
plotshape(dir == -1 and dir[1] == 1 and highlightStartPoints ? psar : na, title="Short Stop Start", location=location.absolute, style=shape.circle, size=size.tiny, color=clr, transp=0)

// Supertrend
color linecolor = trend == 1 ? clg : clr
barcolor(trend == 1 ? clg : clr)
plot(tsl, color = linecolor, style = plot.style_line, linewidth = 2, title = "supertrend")
plotshape(cross(close, tsl) and close > tsl, "up arrow", shape.triangleup, location.belowbar, clg, 0, 0)
plotshape(cross(tsl, close) and close < tsl, "down arrow", shape.triangledown, location.abovebar, clr, 0, 0)
plotarrow(trend == 1 and trend[1] == -1 ? trend : na, title = "up entry arrow", colorup = clg, maxheight = 60, minheight = 50, transp = 0)
plotarrow(trend == -1 and trend[1] == 1 ? trend : na, title = "down entry arrow", colordown = clr, maxheight = 60, minheight = 50, transp = 0)

// Tripple EMA
plot(ema1_value > 0 ? ema1 : na, title = 'EMA #1', color=cly, transp=0, linewidth=3, style=plot.style_linebr)
plot(ema2_value > 0 ? ema2 : na, title = 'EMA #2', color=cbr, transp=0, linewidth=1)
plot(ema3_value > 0 ? ema3 : na, title = 'EMA #3', color=cbr, transp=0, linewidth=1)


//////////////////////////////////////////////////////////////////////////
// Alerts & Signals
//////////////////////////////////////////////////////////////////////////

// PSAR
changeCond = dir != dir[1]
alertcondition(changeCond, title="Alert on Parabolic SAR Direction Change", message="Parabolic SAR has changed direction!")

// SuperTrend
alertcondition(cross(close, tsl) and close > tsl, title = 'supertrend long', message = 'supertrend: long ')
alertcondition(cross(tsl, close) and close < tsl, title = 'supertrend short', message = 'supertrend: short ')

slong = trend == 1 and trend[1] == -1
alertcondition(slong, title = 'long', message = 'supertrend alert long')

sshort = trend == -1 and trend[1] == 1
alertcondition(sshort, title = 'short', message = 'supertrend alert short')


