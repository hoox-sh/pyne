//@version=4
study("[IFLOST.io] MTF Panel Analysis", "[IFLOST.io] MTF Panel Analysis", overlay = true)

f_newbar(_tf)=>change(time(_tf)) != 0

var o_monthly = 0.0
var o_weekly = 0.0
var o_daily = 0.0
var o_240 = 0.0
var o_60 = 0.0

// range
var float max_range = na
var float min_range = na
float range = max_range - min_range

// buy volume
var float v_b_monthly = na
var float v_b_weekly = na
var float v_b_daily = na
var float v_b_240 = na
var float v_b_60 = na
// sell volume
var float v_s_monthly = na
var float v_s_weekly = na
var float v_s_daily = na
var float v_s_240 = na
var float v_s_60 = na



//reset parameters:
if f_newbar("M")
    o_monthly := open
    
    max_range := na
    min_range := na

    v_b_monthly := na
    v_s_monthly := na

if f_newbar("W")
    o_weekly := open
    
    v_b_weekly := na
    v_s_weekly := na

if f_newbar("D")
    o_daily := open
    
    v_b_daily := na
    v_s_daily := na

if f_newbar("240")
    o_240 := open
    
    v_b_240 := na
    v_s_240 := na

if f_newbar("60")
    o_60 := open
    
    v_b_60 := na
    v_s_60 := na

// get max/min range
if na(max_range) or na(min_range)
    max_range := high
    min_range := low
else
    max_range := max(max_range[1], high)
    min_range := min(min_range[1], low)


plot(series=max_range, title="Max range:", color=#003399)
plot(series=min_range, title="Min range:", color=#003399)


// sum volume
if na(v_b_monthly) or na(v_s_monthly)
    if close > open
        v_b_monthly := volume
        v_s_monthly := 0.0
    else
        v_b_monthly := 0.0
        v_s_monthly := volume
else
    if close > open
        v_b_monthly := v_b_monthly[1] + volume
    else
        v_s_monthly := v_b_monthly[1] + volume

if na(v_b_weekly) or na(v_s_weekly)
    if close > open
        v_b_weekly := volume
        v_s_weekly := 0.0
    else
        v_b_weekly := 0.0
        v_s_weekly := volume
else
    if close > open
        v_b_weekly := v_b_weekly[1] + volume
    else
        v_s_weekly := v_b_weekly[1] + volume

if na(v_b_daily) or na(v_s_daily)
    if close > open
        v_b_daily := volume
        v_s_daily := 0.0
    else
        v_b_daily := 0.0
        v_s_daily := volume
else
    if close > open
        v_b_daily := v_b_daily[1] + volume
    else
        v_s_daily := v_b_daily[1] + volume

if na(v_b_240) or na(v_s_240)
    if close > open
        v_b_240 := volume
        v_s_240 := 0.0
    else
        v_b_240 := 0.0
        v_s_240 := volume
else
    if close > open
        v_b_240 := v_b_240[1] + volume
    else
        v_s_240 := v_b_240[1] + volume

if na(v_b_60) or na(v_s_60)
    if close > open
        v_b_60 := volume
        v_s_60 := 0.0
    else
        v_b_60 := 0.0
        v_s_60 := volume
else
    if close > open
        v_b_60 := v_b_60[1] + volume
    else
        v_s_60 := v_b_60[1] + volume

//calculate volume diferences:
v_monthly_diff = v_b_monthly - v_s_monthly
v_weekly_diff = v_b_weekly - v_s_weekly
v_daily_diff = v_b_daily - v_s_daily
v_240_diff = v_b_240 - v_s_240
v_60_diff = v_b_60 - v_s_60

max_volume = max(abs(v_monthly_diff), max(abs(v_weekly_diff), max(abs(v_daily_diff), max(abs(v_240_diff), abs(v_60_diff)))))

//calculate volume ranges to better show difference between buyers and sellers
v_adjusted_max = (max_range - range * 0.2) 

v_m_b_ratio = ((v_b_monthly*0.79)/(v_b_monthly + v_s_monthly))
v_m_s_ratio = ((v_s_monthly*0.79)/(v_b_monthly + v_s_monthly))
v_monthly_b = max(min_range, min_range + range * v_m_b_ratio)
v_monthly_s = min(v_adjusted_max, v_adjusted_max - range * v_m_s_ratio)
v_monthly_text = "M\n" + tostring(v_b_monthly, "#.##") + " - " + tostring(v_s_monthly, "#.##") + "\n" + tostring((v_b_monthly/v_s_monthly)*100, "#.##") + "%"

v_w_b_ratio = ((v_b_weekly*0.79)/(v_b_weekly + v_s_weekly))
v_w_s_ratio = ((v_s_weekly*0.79)/(v_b_weekly + v_s_weekly))
v_weekly_b = max(min_range, min_range + range * v_w_b_ratio)
v_weekly_s = min(v_adjusted_max, v_adjusted_max - range * v_w_s_ratio)
v_weekly_text = "W\n" + tostring(v_b_weekly, "#.##") + " - " + tostring(v_s_weekly, "#.##") + "\n" + tostring((v_b_weekly/v_s_weekly)*100, "#.##") + "%"

v_d_b_ratio = ((v_b_daily*0.79)/(v_b_daily + v_s_daily))
v_d_s_ratio = ((v_s_daily*0.79)/(v_b_daily + v_s_daily))
v_daily_b = max(min_range, min_range + range * v_d_b_ratio)
v_daily_s = min(v_adjusted_max, v_adjusted_max - range * v_d_s_ratio)
v_daily_text = "D\n" + tostring(v_b_daily, "#.##") + " - " + tostring(v_s_daily, "#.##") + "\n" + tostring((v_b_daily/v_s_daily)*100, "#.##") + "%"

v_240_b_ratio = ((v_b_240*0.79)/(v_b_240 + v_s_240))
v_240_s_ratio = ((v_s_240*0.79)/(v_b_240 + v_s_240))
v_240_b = max(min_range, min_range + range * v_240_b_ratio)
v_240_s = min(v_adjusted_max, v_adjusted_max - range * v_240_s_ratio)
v_240_text = "240'\n" + tostring(v_b_240, "#.##") + " - " + tostring(v_s_240, "#.##") + "\n" + tostring((v_b_240/v_s_240)*100, "#.##") + "%"

v_60_b_ratio = ((v_b_60*0.79)/(v_b_60 + v_s_60))
v_60_s_ratio = ((v_s_60*0.79)/(v_b_60 + v_s_60))
v_60_b = max(min_range, min_range + range * v_60_b_ratio)
v_60_s = min(v_adjusted_max, v_adjusted_max - range * v_60_s_ratio)
v_60_text = "60'\n" + tostring(v_b_60, "#.##") + " - " + tostring(v_s_60, "#.##") + "\n" + tostring((v_b_60/v_s_60)*100, "#.##") + "%"

// drawing functions:
//{
f_draw_title(_x, _y, _text, _color)=>
    var label _la = na
    label.delete(_la)
    _la := label.new(
             x=bar_index[_x], y=_y, 
             text=_text, 
             xloc=xloc.bar_index, yloc=yloc.price, color=_color, 
             style=label.style_none, textcolor=_color, size=size.large
             )

f_draw_momentum(_y2, _color, _width, _text)=>
    var line _li = na
    var label _la = na
    line.delete(_li)
    label.delete(_la)
    _li := line.new( 
             x1=bar_index[100], y1=_y2, 
             x2=bar_index, y2=close, 
             xloc=xloc.bar_index, extend=extend.none, 
             color=_color, style=line.style_solid, width=_width
             )
    _la := label.new(
             x=bar_index[105], y=_y2, 
             text=_text, 
             xloc=xloc.bar_index, yloc=yloc.price, color=_color, 
             style=label.style_none, textcolor=_color, size=size.normal
             )

f_draw_vol_lines(_x, _min, _max, _bvol, _svol, _text, _text_color)=>
    var line _li_b = na
    var line _li_s = na
    var label _la = na
    line.delete(_li_b)
    line.delete(_li_s)
    label.delete(_la)
    _li_b := line.new( 
             x1=bar_index[_x+1], y1=_min, 
             x2=bar_index[_x+1], y2=_bvol, 
             xloc=xloc.bar_index, extend=extend.none, 
             color=color.teal, style=line.style_solid, width=25
             )
    _li_s := line.new( 
             x1=bar_index[_x-1], y1=_max, 
             x2=bar_index[_x-1], y2=_svol, 
             xloc=xloc.bar_index, extend=extend.none, 
             color=color.orange, style=line.style_solid, width=25
             )
    _la := label.new(
             x=bar_index[_x], y=_max, 
             text=_text, 
             xloc=xloc.bar_index, yloc=yloc.price, color=_text_color, 
             style=label.style_none, textcolor=_text_color, size=size.small
             )

f_draw_vol_h_line(_x1, _x2, _lvl)=>
    var line _li = na
    line.delete(_li)
    _li := line.new( 
             x1=bar_index[_x1], y1=_lvl, 
             x2=bar_index[_x2], y2=_lvl, 
             xloc=xloc.bar_index, extend=extend.none, 
             color=color.gray, style=line.style_dashed, width=1
             )
 


f_draw_title(50, max_range, "Momentum", #6699ff)
f_draw_momentum(o_monthly, #003399, 5, "M")
f_draw_momentum(o_weekly, #0044cc, 4, "W")
f_draw_momentum(o_daily, #0055ff, 3, "D")
f_draw_momentum(o_240, #3377ff, 2, "240'")
f_draw_momentum(o_60, #6699ff, 1, "60'")
//}

f_draw_title(170, max_range, "Volume", #6699ff)
if not na(volume)
    f_draw_vol_lines(220, min_range, v_adjusted_max, v_monthly_b, v_monthly_s, v_monthly_text, #6699ff)
    f_draw_vol_lines(195, min_range, v_adjusted_max, v_weekly_b, v_weekly_s, v_weekly_text, #6699ff)
    f_draw_vol_lines(170, min_range, v_adjusted_max, v_daily_b, v_daily_s, v_daily_text, #6699ff)
    f_draw_vol_lines(145, min_range, v_adjusted_max, v_240_b, v_240_s, v_240_text, #6699ff)
    f_draw_vol_lines(120, min_range, v_adjusted_max, v_60_b, v_60_s, v_60_text, #6699ff)
    f_draw_vol_h_line(115, 225, min_range + (v_adjusted_max - min_range) * 0.5)
//plot(close)