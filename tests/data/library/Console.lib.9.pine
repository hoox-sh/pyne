// ——— 🔹 Method - Log #3/4 - Inline Logging { 
//
// Basic data types inline
//
// @function    Log a string using inline method chaining
// @param       this            The string to log
// @param       _console        The terminal object
// @param       _title          Optional title prefix
// @returns     string          The input string for chaining
export method log_inline(series string this, terminal _console, series string _title = '') =>
    _console.log(_title, this)
    this

// @function    Log an integer using inline method chaining
// @param       this            The integer to log
// @param       _console        The terminal object
// @param       _title          Optional title prefix
// @returns     int             The input integer for chaining
export method log_inline(series int this, terminal _console, series string _title = '') =>
    _console.log(_title, this.tostring())
    this

// @function    Log a float using inline method chaining with optional rounding
// @param       this            The float to log
// @param       _console        The terminal object
// @param       _round          Optional decimal places for rounding
// @param       _title          Optional title prefix
// @returns     float           The input float for chaining
export method log_inline(series float this, terminal _console, simple int _round = na, series string _title = '') =>
    _console.log(_title, this.round(_round).tostring())
    this

// @function    Log a boolean using inline method chaining
// @param       this            The boolean to log
// @param       _console        The terminal object
// @param       _title          Optional title prefix
// @returns     bool            The input boolean for chaining
export method log_inline(series bool this, terminal _console, series string _title = '') =>
    _console.log(_title, this.tostring())
    this

// @function    Log a color using inline method chaining with optional text formatting
// @param       this            The color to log
// @param       _console        The terminal object
// @param       _title          Optional title prefix
// @param       _text           Whether to apply text formatting (true) or background formatting (false)
// @returns     color           The input color for chaining
export method log_inline(series color this, terminal _console, series string _title = '', series bool _text = true) =>
    _console.log(_title, data.new(this.tostring(), opt_text_color = this, opt_bg_color = color.new(this, _text ? BG_OPACITY : 0)))
    this

