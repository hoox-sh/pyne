// ——— Console {
//
//@version=6
// @description     This script has evolved from its origins as a classic console script adaptation. \
//                  With the introduction of hybrid logs and direct logging to the app's native window, it now offers \
//                  enhanced flexibility and control over your logging experience.
library('Console', overlay = true)
// }


//  ▪ ——— GLOBALS
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— Brackets {
//
// @variable    An empty string.
const string EMPTY = ''
// @variable    A string with a single white space.
const string WS = ' '
// @variable    A string with a single white space.
const string SWS = ' '
// @variable    A block to use in color preview.
const string BL = '▮'
// @variable    A pin icon.
const string PIN = '🖈'
// @variable    Line Break.
const string BR = '\n'
// @variable    Equal.
const string EQL = '='
// @variable    Snippet #1.
const string SNP1 = WS + EQL + WS
// }

// ——— Defaults {
//
// @variable    Default background color opacity.
const int BG_OPACITY = 90
// }


//  ▪ ——— 🔶 EXPORT - SECONDARY TYPES
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— 🔸 Type Data {
//
// @type    Used to store the log information.
// @field   message                     The log message.
// @field   level                       The log type. 0 = na, 1 = info, 2 = warning, 3 = error, 4 = success. Default `na`.
// @field   opt_text_font_family        Text font family.
// @field   opt_text_size               Text size.
// @field   opt_text_color              Text color.
// @field   opt_bg_color                Background color.
// @field   idx                         Corresponding `bar_index`.
// @field   timestamp                   Corresponding timestamp.
export type data
	// --
	string message
	int level
	// --
	string opt_text_font_family
	string opt_text_size
	color opt_text_color
	color opt_bg_color
	// -- 
	int idx = bar_index
	int sub_indent = 0
	int timestamp = timenow
	// }

// ——— 🔸 Type - Insights {
//
// @type    The `<insights>` type.
// @field   total           Total log amount.
// @field   new             New log amount.
// @field   deleted         Deleted log amount per update or per bar.
// @field   cum_deleted     Cumulative deleted log amount.
export type insights
	// --
	int total = 0
	int new = 0
	int deleted = 0
	int cum_deleted = 0
	// }


//  ▪ ——— 🔷 EXPORT - PRIMARY TYPES
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— 🔹 Type Theme {
//
// |  HEX Color Transparency Codes                     |
// |-------------|------------|------------|-----------|
// |  100% - FF  |  75% - BF  |  50% - 80  | 25% - 40  |
// |   95% - F2  |  70% - B3  |  45% - 73  | 20% - 33  |
// |   90% - E6  |  65% - A6  |  40% - 66  | 15% - 26  |
// |   85% - D9  |  60% - 99  |  35% - 59  | 10% - 1A  |
// |   80% - CC  |  55% - 8C  |  30% - 4D  |  5% - 0D  |
// |      -      |     -      |     -      |  0% - 00  |
// --   
// @type    Can be used to define a theme for the console.
// @field   color_text                  The text color.
// @field   color_bg_table              The background color.
// @field   color_bg_cell               The background color.
// @field   color_frame                 The background color.
// @field   color_border                The border color.
// @field   color_info                  The info message color.
// @field   color_warning               The warning message color.
// @field   color_error                 The error message color.
// @field   color_success               The success message color.
// @field   frame_width                 Border width of the outer frame.
// @field   border_width                Width of the inner border. Can be sawed as line spacing.
export type theme
	// --
	color color_text = chart.fg_color
	color color_text_infobar = chart.fg_color
	color color_bg_table = #00000000
	color color_bg_cell = #0000001A
	color color_bg_infobar = #CCCCCC0D
	color color_frame = #CCCCCC0D
	color color_border = #00000000
	// --
	color color_info = #2962FFFF
	color color_warning = #FFEB3BFF
	color color_error = #FF5252FF
	color color_success = #4CAF55FF
	// --
	int frame_width = 1
	int border_width = 2
	// }

// ——— 🔹 Type Terminal {
//
// @type    The `<terminal>` type.
// @field   display                     Log output: `chart` > on chart | `logs` > native logs | `all` (default) > on chart + native logs
// @field   log_position                The terminal position.
// @field   max_logs                    Maximum amount of saved logs.
// @field   columns                     The number of columns.
// @field   rows                        Number of rows.
// @field   width                       Panel width to use. Should be dividable by columns or gets ceiled to the next lower value.
// @field   height                      Panel height to use.
// @field   __log                       Logs of the terminal
// @field   __sticky                    Logs of the terminal
// @field   __theme                     Color theme of the terminal.
// @field   __table                     Table to view as a console.
// @field   size                        Text size.
// @field   text_font_family            Text font family.
// @field   halign                      Horizontal alignment of the text.
// @field   valign                      Vertical alignment of the text.
// @field   prefix                      Optional prefix string, which will be shown at the start of each new line.
// @field   hide_on_empty               Optional parameter to hide the console view on empty logs.
// @field   show_no                     Optional parameter to show a line number at the beginning of each line.
// @field   ip                          Optional paramter to enable innercandle process logging without any code changes.
// @field   infobar                     Enable or disbale the infobar.
// @field   infobar_location            Optional location of the infobar. Valid: `location.top` / `location.bottom`.
// @field   infobar_format              Optional format string.
// @field   infobar_loader              Enable or disbale the infobar loader animation.
// @field   infobar_loader_string       Optional loader string.
// @field   __insights                  Data insights.
export type terminal
	// --
	string display = 'all'
	string log_position = position.bottom_right
	int max_logs = 1000
	int offset = 0
	// --
	int columns = 1
	int rows = 10
	// --
	int width = 25
	int height = 30
	// --
	array<data> __log
	array<data> __sticky
	// --
	theme __theme
	table __table
	// --
	string size = size.small
	string text_font_family = font.family_monospace
	string halign = text.align_left
	string valign = text.align_center
	// --
	bool hide_on_empty = true
	bool show_no = false
	// --
	string prefix = ''
	string delimiter = ':'
	string pseudo_delimiter = '|'
	// --
	bool indent = false
	int tab_size = 4
	int max_indent = 0
	// --
	bool ip = false
	// --
	bool infobar = false
	string infobar_location = location.top
	string infobar_format
	bool infobar_loader = true
	string infobar_loader_string = ''
	// --
	insights __insights
	// }


//  ▪ ——— 🔺 LIBRARY - HELPER METHODS
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— 🔺 Library Method - Is Set {
//
// @function    Replaces `na` values with a given value in a series.
// @param       _string             Source to check.
// @param       _replacement        The alternative value if `_src` is `na`.
// @returns     `<string>` 
method isset(series string this, series string _replacement) =>
    // >>
    na(this) ? _replacement : this
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _table              Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `<table>`
method isset(table this, table _replacement) =>
    // >>
    na(this) ? _replacement : this
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _color              Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `<color>`
method isset(series color _color, series color _replacement) =>
    // >>
    na(_color) ? _replacement : _color
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _arrayData          Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `array <data>`
method isset(array<data> _arrayData, array<data> _replacement) =>
    // >>
    na(_arrayData) ? _replacement : _arrayData
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _theme              Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `<data>`
method isset(theme _theme, theme _replacement) =>
    // >>
    na(_theme) ? _replacement : _theme
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _data               Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `<data>`
method isset(data _data, data _replacement) =>
    // >>
    na(_data) ? _replacement : _data
    // --
    // @function    Replaces `na` values with a given value in a series.
    // @param       _insights           Source to check.
    // @param       _replacement        The alternative value if `_src` is `na`.
    // @returns     `<data>`
method isset(insights _insights, insights _replacement) =>
    // >>
    na(_insights) ? _replacement : _insights
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Append String {
//
// @function    Append a string, if the source is not `na` and not `empty`.
// @param       this                Source to check.
// @param       _str                String to append.
// @returns     `<string>`
method append(series string this, series string _str) =>
    // >>
    not na(this) and not(this == EMPTY) ? this + _str : this
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Round {
//
// @function    Round a given `<float>` value. If `_round` is `na` the value will be untouched.
// @param       this                The `<terminal>` object.
// @param       _data               A `<data>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method round(series float this, simple int _round = na) =>
    // >>
    na(_round) ? this : math.round(this, _round)
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Push Data to Log {
//
// @function    Push a `<data>` object to the logs.
// @param       this                The `<terminal>` object.
// @param       _data               A `<data>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method pushData(terminal this, data __data) =>
    // --
    this.__log.push(__data)
    // >>
    this
    // --
    // @function    Push a `<data>` object to the logs.
    // @param       this                A `<data>` object.
    // @param       _console            The `<terminal>` object.
    // @returns     `<terminal>` Returns the updated terminal object.
method pushData(data this, terminal __console) =>
    // >>
    __console.pushData(this)
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Format Text {
//
// @function    Create a readable text format.
// @param       this                The `<terminal>` object.
// @returns     `<string>` The formated text.
method formatText(series string this) =>
    // --
    const string find1 = '['
    const string find2 = ']'
    const string repl1 = '\n    ▪ '
    // >>
    str.replace_all(str.replace_all(this, find1, repl1), find2, EMPTY)
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Is Valid Location {
//
// @function    Validate a location `<string>`.
// @param       this                The `<terminal>` object.
// @returns     `<string>` The formated text.
method isValidLocation(series string this) =>
    // >>
    array.from(location.top, location.bottom).includes(this)
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Get Start Index {
//
// @function    Calculates the the start index from inside the logs.
// @param       this                The `<terminal>` object.
// @param       _offset             Optional log offset.
// @returns     `<terminal>` Returns the updated terminal object.
method getStartIndex(terminal this) =>
    // @variable    Maximum amount of lines to show.
    series int lines = this.columns * (this.rows - (this.infobar ? 1 : 0) - this.__sticky.size())
    // @variable    Current `index` inside the logs array.
    series int idx = this.__log.size() < lines ? this.offset : this.__log.size() - lines + this.offset
    // >>
    idx <= 0 ? 0 : idx
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Create Table {
//
// @function    Create the log table.
// @param       this                The `<terminal>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method createTable(terminal this) =>
    // --
    if na(this.__table)
        // --
        this.__table := this.__table.isset(table.new(position = this.log_position, columns = this.columns, rows = this.rows, bgcolor = this.__theme.color_bg_table, frame_color = this.__theme.color_frame, border_color = this.__theme.color_border, frame_width = this.__theme.frame_width, border_width = this.__theme.border_width))
        // --
        this.height := math.ceil(this.height / this.rows) * this.rows
        this.width := math.ceil(this.width / this.columns) * this.columns
        // --
        for c = 0 to this.columns - 1 by 1
            for r = 0 to this.rows - 1 by 1
                // --
                table.cell(table_id = this.__table, column = c, row = r, text_font_family = this.text_font_family, text_valign = this.valign, text_halign = this.halign, text_size = this.size, height = int(this.height / this.rows), width = int(this.width / this.columns), bgcolor = this.__theme.color_bg_cell, text_color = this.__theme.color_text)
        // Friendly Reminder
        this.__table.cell_set_text(0, 0, 'Info: Use console.show() to show up your logs.')
    // >>
    this
    // }

// ——— 🔺 Library Method - Update Cell {
//
// @function    Update the table cell data.
// @param       this                The `<terminal>` object.
// @param       _column             The column index to update.
// @param       _row                The row index to update.
// @param       _idx                The log index to update.
// @returns     `<terminal>` Returns the updated terminal object.
method updateCell(terminal this, series int _column, series int _row, series int _idx = na, data __data = na) =>
    // @variable    Reference to the current `<data>` object. 
    data d = __data.isset(this.__log.get(_idx))
    // @variable    Reference to the `<theme>` object.
    theme t = this.__theme
    // @variable    Log message
    string msg = str.replace(d.message, this.pseudo_delimiter, this.delimiter + (this.indent ? str.repeat(WS, this.max_indent - d.sub_indent + this.tab_size) : EMPTY))
    // --
    // @variable    The formated log message including the line no. and prefix.
    series string formatedMsg = str.format('{0}{1}{2}', this.show_no and not na(_idx) ? str.tostring(_idx + 1, '000') + WS : EMPTY, this.prefix != EMPTY and not na(_idx) ? this.prefix + WS : EMPTY, msg)
    // @variable    The tooltip text of each log including the `bar_index` and `timestamp`.
    series string tt = str.format('#{1,number,#####}{0}{2}{0}{0}{3}', BR, d.idx, str.format_time(d.timestamp, 'HH:mm:ss', syminfo.timezone), msg.formatText())
    // @variable    Array with the default log level colors.
    [textColor, bgColor] = switch d.level
        1 => [t.color_info, color.new(t.color_info, BG_OPACITY)]
        2 => [t.color_warning, color.new(t.color_warning, BG_OPACITY)]
        3 => [t.color_error, color.new(t.color_error, BG_OPACITY)]
        4 => [t.color_success, color.new(t.color_success, BG_OPACITY)]
        => [t.color_text, t.color_bg_cell]
    // --
    this.__table.cell_set_bgcolor(_column, _row, d.opt_bg_color.isset(bgColor))
    this.__table.cell_set_text_color(_column, _row, d.opt_text_color.isset(textColor))
    this.__table.cell_set_text_font_family(_column, _row, d.opt_text_font_family.isset(this.text_font_family))
    this.__table.cell_set_text_size(_column, _row, d.opt_text_size.isset(this.size))
    this.__table.cell_set_text(_column, _row, formatedMsg)
    this.__table.cell_set_tooltip(_column, _row, tt)
    // >>
    this
// }


// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Method - Add Infobar {
//
// @function    Add a infobar to the `<terminal>`.
// @param       this                The `<terminal>` object.
// @param       _column             Column to add to.
// @param       _top                Option to add the infobar add the top or bottom of the `<terminal>`.
// @returns     `<terminal>` Returns the updated terminal object.
method addInfobar(terminal this, series int _column, series bool _top) =>
    // --
    if this.infobar
        // @variable    An ip-sensitive `array <string>`to store changes per update.
        varip series array<string> seq = str.split(this.infobar_loader_string, EMPTY)
        seq.unshift(seq.pop())
        // @variable    The infobar information.
        data d = data.new(message = str.format(this.infobar_format.isset((this.infobar_loader and _column == 0 ? '{11}{0}' : EMPTY) + 'c:{1}/{2}{0}r:{3,number,##}-{4,number,##}{0}l:{6,number,000}{0}d:{8}/{9}'), SWS, _column + 1, this.columns, _column * (this.rows - 1) + 1, (_column + 1) * (this.rows - 1), this.rows, this.__insights.total, this.max_logs, this.__insights.deleted, this.__insights.cum_deleted, this.display, seq.join()), opt_text_color = this.__theme.color_text_infobar, opt_bg_color = this.__theme.color_bg_infobar, opt_text_font_family = font.family_monospace) // secure white space (0) _column + 1,                                  // current column (1) this.columns,                                 // total columns (2) _column * (this.rows - 1) + 1,                // row from (3) (_column + 1) * (this.rows - 1),              // row to (4) this.rows,                                    // rows per column (5) this.__insights.total,                        // total logs (6) this.max_logs,                                // max logs (7) this.__insights.deleted,                      // deleted logs per bar (8) this.__insights.cum_deleted,                  // cumulative deleted logs (9) this.display,                                 // display type (10) seq.join()                                    // loader (tick based animation) (11) ), opt_text_color         = this.__theme.color_text_infobar, opt_bg_color           = this.__theme.color_bg_infobar, opt_text_font_family   = font.family_monospace )
        // --
        this.updateCell(_column = _column, _row = _top ? 0 : this.rows - 1, __data = d)
    // >>
    this
// }

// ——— 🔺 Method - Add Sticky Notes {
//
// @function    Add sticky notes to the `<terminal>`.
// @param       this                The `<terminal>` object.
// @param       _column             Column to add to.
// @returns     `<terminal>` Returns the updated terminal object.
method addStickyNotes(terminal this, series int _column) =>
    // --
    if this.__sticky.size() > 0
        for r = 0 to this.__sticky.size() - 1 by 1
            this.updateCell(_column = _column, _row = r + (this.infobar and this.infobar_location == location.top ? 1 : 0), __data = this.__sticky.get(r))
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Method - Send To Native Logs {
//
// @function    Send a `<data>` object to the native logs.
// @param       this                A `<data>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method sendToNativeLogs(data this) =>
    // @variable    The formated log message.
    series string msg = this.message.formatText()
    switch this.level
        2 => log.warning(msg)
        3 => log.error(msg)
        => log.info(msg)
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Method - Handle Native Logs {
//
// @function    Send all logs to the native logs.
// @param       this                The `<terminal>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method handleNativeLogs(terminal this) =>
    // --
    if this.display == 'all' or this.display == 'logs'
        // --
        for i = 0 to this.__log.size() - 1 by 1
            // --
            this.__log.get(i).sendToNativeLogs()
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------


// ——— 🔺 Method - Update IP Storage {
//
// @function    Update the innercandle process storage by concatinating an `varip array` with a \
//              standard `array` and assign it back to the udt-object per update.
// @param       this                The `<terminal>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method updateIpStorage(terminal this) =>
    // @variable    The crucial ipStorage variable, defined as a `varip array`, ensures persistent log data storage.
    varip array<data> ipStorage = array.new<data>()
    // --
    if this.ip and (barstate.isrealtime or barstate.islast)
        ipStorage.concat(this.__log)
        this.__log := ipStorage
        this.__log
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Insights {
//
// @function    Collect data for insights.
// @param       this                The `<terminal>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method insights(terminal this) =>
    // @variable    Reference to the `<insights>`object.
    insights i = this.__insights
    // @variable    The total log size before update.
    int lastTotal = i.total
    i.total := this.__log.size()
    i.new := i.total - lastTotal
    i.cum_deleted := int(ta.cum(i.deleted))
    // >>
    this
// }


// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Method - Housekeeping {
//
// @function    Clean up standard and ip logs.
// @param       this                The `<terminal>` object.
// @returns     `<terminal>` Returns the updated terminal object.
method housekeeping(terminal this) =>
    // @variable    Count the deleted log amount > per bar on standard logging and > per execution on ip logging.
    varip series int deleted = na
    deleted := not this.ip or barstate.isnew ? 0 : deleted
    // --
    while this.__log.size() > this.max_logs
        this.__log.shift()
        deleted := deleted + 1
        deleted
    // --
    this.__insights.deleted := deleted
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔺 Library Function - Default Array {
//
// @function    Function create the default array to use in the `.tostring()` method.
// @param       _size               The size of the corresponding data.
// @returns     `array <string>`
defaultArray(series int _size) =>
    // >>
    array.new<string>(1, str.format('array > size = {0}', _size))
// }

// ——— 🔺 Library Function - Default Array Matrix {
//
// @function    Function creates the default array to use in the `.tostring()` method.
// @param       _size               The size of the corresponding data.
// @returns     `array <string>`
defaultArrayMatrix(series int _columns, series int _rows) =>
    // >>
    array.new<string>(1, str.format('matrix > size = {0}x{1} ({2})', _columns, _rows, _columns * _rows))
// }


