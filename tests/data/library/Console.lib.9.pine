// @returns     `<terminal>` Returns the updated terminal object.
export method clearLog(terminal this) =>
    // --
    this.__log.clear()
    // >>
    this
// }


//  ▪ ——— 🔷 EXPORT: PRIMARY METHODS
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— 🔹 Method - Init Terminal {
//
// @function    Initialize a newly created `<terminal>` object.
// 
// #### Example
// > ```
// > terminal myConsole = Console.terminal.new().init()
// > // or
// > terminal myConsole = Console.terminal.new()
// > myConsole.init()
// > ```
// ___
// @param       this            The `<terminal>` object.
// @param       _theme          Optional theme.
// @returns     `<terminal>` Returns the updated terminal object.
export method init(terminal this, theme __theme = na) =>
    // --
    this.__theme := this.__theme.isset(__theme.isset(theme.new()))
    this.__log := this.__log.isset(array.new<data>())
    this.__sticky := this.__sticky.isset(array.new<data>())
    this.__insights := this.__insights.isset(insights.new())
    // --
    this.infobar := this.infobar and this.infobar_location.isValidLocation()
    // --
    this.tab_size := this.tab_size < 1 ? 1 : this.tab_size
    // --
    if this.display == 'all' or this.display == 'chart'
        this.createTable()
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔹 Method - Show {
//
// @function    Final method to show up the `<terminal>`.
// 
// #### Example 1
// > ```
// > // Place it at the end of your script or even after the last `log()` call.
// > console.show(_visible = true, _offset = 0)
// > ```
// ___
// #### Example 2
// > ```
// > show   = input.bool(true, 'Show Logs')
// > offset = input.int(0, 'Log No. Offset')
// > console.show(show, offset)
// > ```
// ___
// @param       this                The `<terminal>` object.
// @param       _visible            Show/Hide.
// @param       _offset             A offset to move througth the logs. 
// @returns     `<terminal>` Returns the updated terminal object.
export method show(terminal this, series bool _visible = true, series int _offset = 0) =>
    // --
    this.handleNativeLogs().updateIpStorage().housekeeping().insights()
    // --
    if this.display == 'all' or this.display == 'chart'
        // --
        this.createTable()
        this.offset := _offset
        // @variable    Current `index` inside the logs array.
        series int idx = this.getStartIndex()
        // @variable    True, if `infobar_location` is `location.top', false otherwise.
        series bool top = this.infobar_location == location.top
        // @variable    True, if the option `hide_on_empty` is `true` and no logs are registered. False otherwise.
        series bool hide = this.hide_on_empty ? this.__log.size() == 0 : false
        // --
        if barstate.islast or barstate.isrealtime and _visible and not hide
            // --
            for c = 0 to this.columns - 1 by 1
                this.addInfobar(c, top).addStickyNotes(c)
            // --
            for c = 0 to this.columns - 1 by 1
                for r = (this.infobar and top ? 1 : 0) + this.__sticky.size() to this.rows - (this.infobar and not top ? 2 : 1) by 1
                    // --
                    this.updateCell(c, r, idx)
                    // --
                    idx := idx + 1
                    if idx > this.__log.size() - 1
                        break
                // --
                if idx > this.__log.size() - 1
                    break
        // --
        else
            this.__table.delete()
    // >>
    this
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔹 Method - Add Empty Line {
//
// @function    Add an empty log to the console.
//
// #### Example
// > ```
// > myConsole.empty()
// > //
// > myConsole.empty().log('foo').empty()
// > //
// > // foo
// > //
// > ```
// ___
// @param       this    The terminal object.
// @returns     `<terminal>` Returns the updated terminal object.
export method empty(terminal this) =>
    // --
    this.__log.push(data.new(SWS))
    // >>
    this
    // }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔹 Method - Add Horizontal Divider {
//
// @function    Add an horizontal divider to the terminal.
//
// #### Example
// > ```
// > // Standard
// > myConsole.hr()               // --------------------
// >
// > // Chained
// > myConsole
// >  .hr('foo')                  // foo ----------------
// >  .log('bar')                 // bar
// >  .hr()                       // --------------------
// >
// > // Custom
// > myConsole
// >  .hr('my section', ':', 20)  // my section :::::::::
// >  .hr('my section', '=', 32)  // my section =====================
// > ```
// ___
// @param       this            The terminal object.
// @param       _show_no        If `true`, the terminal will show the log number.
// @returns     `<terminal>` Returns the updated terminal object.
export method hr(terminal this, series string _title = '', series string _str = '-', series int _length = 30) =>
    // @variable    The prefix `<string>` plus an additional white space, if set, empty otherwise.
    series string title = _title.append(WS)
    this.__log.push(data.new(title + str.repeat(_str, _length - str.length(title))))
    // >>
    this
    // }

