// ——— 🔹 Method - To String {
//
// Basic data types
//
// @function    Convert a string array to string representation
// @param       this            The array`<string>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<string> this) =>
    str.tostring(this)

// @function    Convert an integer array to string representation
// @param       this            The array`<int>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<int> this) =>
    str.tostring(this)

// @function    Convert a float array to string representation
// @param       this            The array`<float>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<float> this) =>
    str.tostring(this)

// @function    Convert a boolean array to string representation
// @param       this            The array`<bool>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<bool> this) =>
    str.tostring(this)

// Basic types
//
// @function    Convert an integer to string representation
// @param       this            The `<int>` to convert
// @returns     `<string>`      String representation of the integer
export method tostring(series int this) =>
    str.tostring(this)

// @function    Convert a float to string representation
// @param       this            The `<float>` to convert
// @returns     `<string>`      String representation of the float
export method tostring(series float this) =>
    str.tostring(this)

// @function    Convert a boolean to string representation
// @param       this            The `<bool>` to convert
// @returns     `<string>`      String representation of the boolean
export method tostring(series bool this) =>
    this ? 'true' : 'false'

// Chart objects
//
// @function    Convert a label to string representation
// @param       this            The `<label>` to convert
// @returns     `<string>`      String representation of the label
export method tostring(series label this) =>
    array.from('label', 'text' + SNP1 + this.get_text(), 'x' + SNP1 + this.get_x().tostring(), 'y' + SNP1 + this.get_y().tostring()).tostring()

// @function    Convert a line to string representation
// @param       this            The `<line>` to convert
// @returns     `<string>`      String representation of the line
export method tostring(series line this) =>
    array.from('line', 'x1' + SNP1 + this.get_x1().tostring(), 'x2' + SNP1 + this.get_x2().tostring(), 'y1' + SNP1 + this.get_y1().tostring(), 'y2' + SNP1 + this.get_y2().tostring()).tostring()

// @function    Convert a linefill to string representation
// @param       this            The `<linefill>` to convert
// @returns     `<string>`      String representation of the linefill
export method tostring(series linefill this) =>
    array.from('linefill', 'line1' + SNP1 + this.get_line1().tostring(), 'line2' + SNP1 + this.get_line2().tostring()).tostring()

// @function    Convert a box to string representation
// @param       this            The `<box>` to convert
// @returns     `<string>`      String representation of the box
export method tostring(series box this) =>
    array.from('box', 'top' + SNP1 + this.get_top().tostring(), 'bottom' + SNP1 + this.get_bottom().tostring(), 'left' + SNP1 + this.get_left().tostring(), 'right' + SNP1 + this.get_right().tostring()).tostring()

// @function    Convert a color to string representation
// @param       this            The `<color>` to convert
// @returns     `<string>`      String representation of the color
export method tostring(series color this) =>
    BL + array.from('color', 'r' + SNP1 + color.r(this).tostring(), 'g' + SNP1 + color.g(this).tostring(), 'b' + SNP1 + color.b(this).tostring()).tostring()

// @function    Convert a chart point to string representation
// @param       this            The `<chart.point>` to convert
// @returns     `<string>`      String representation of the chart point
export method tostring(series chart.point this) =>
    // Pseudo label to get the data from the chart.point.
    label l = label.new(point = this)
    int x = l.get_x()
    float y = l.get_y()
    label.delete(l)
    // --
    array.from('chart.point', 'x' + SNP1 + x.tostring(), 'y' + SNP1 + y.tostring()).tostring()

// Arrays of chart objects
//
// @function    Convert a color array to string representation
// @param       this            The array`<color>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<color> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for c in this
        tmp.push(c.tostring())
    tmp.tostring()

// @function    Convert a label array to string representation
// @param       this            The array`<label>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<label> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for l in this
        tmp.push(l.tostring())
    tmp.tostring()

// @function    Convert a line array to string representation
// @param       this            The array`<line>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<line> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for l in this
        tmp.push(l.tostring())
    tmp.tostring()

// @function    Convert a linefill array to string representation
// @param       this            The array`<linefill>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<linefill> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for lf in this
        tmp.push(lf.tostring())
    tmp.tostring()

// @function    Convert a box array to string representation
// @param       this            The array`<box>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<box> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for b in this
        tmp.push(b.tostring())
    tmp.tostring()

// @function    Convert a chart point array to string representation
// @param       this            The array`<chart.point>` to convert
// @returns     `<string>`      String representation of the array
export method tostring(array<chart.point> this) =>
    // @variable    An array, holding the stringified data.
    array<string> tmp = defaultArray(this.size())
    for cp in this
        tmp.push(cp.tostring())
    tmp.tostring()

// Matrices
//
// @function    Convert a string matrix to string representation
// @param       this            The matrix`<string>` to convert
// @returns     `<string>`      String representation of the matrix
export method tostring(matrix<string> this) =>
    // @variable    An array, holding the stringified row data.
    array<string> tmp = defaultArrayMatrix(this.columns(), this.rows())
    for r = 0 to this.rows() - 1 by 1
        // @variable    An array, holding the stringified column data.
        array<string> tmpCol = array.new<string>()
        for c = 0 to this.columns() - 1 by 1
            tmpCol.push(this.get(r, c))
        tmp.push(tmpCol.tostring())
    tmp.tostring()

// @function    Convert an integer matrix to string representation
// @param       this            The matrix`<int>` to convert
// @returns     `<string>`      String representation of the matrix
export method tostring(matrix<int> this) =>
    // @variable    An array, holding the stringified row data.
    array<string> tmp = defaultArrayMatrix(this.columns(), this.rows())
    for r = 0 to this.rows() - 1 by 1
        // @variable    An array, holding the stringified column data.
        array<string> tmpCol = array.new<string>()
        for c = 0 to this.columns() - 1 by 1
            tmpCol.push(this.get(r, c).tostring())
        tmp.push(tmpCol.tostring())
    tmp.tostring()

// @function    Convert a float matrix to string representation
// @param       this            The matrix`<float>` to convert
// @returns     `<string>`      String representation of the matrix
export method tostring(matrix<float> this) =>
    // @variable    An array, holding the stringified row data.
    array<string> tmp = defaultArrayMatrix(this.columns(), this.rows())
    for r = 0 to this.rows() - 1 by 1
        // @variable    An array, holding the stringified column data.
        array<string> tmpCol = array.new<string>()
        for c = 0 to this.columns() - 1 by 1
            tmpCol.push(this.get(r, c).tostring())
        tmp.push(tmpCol.tostring())
    tmp.tostring()

// @function    Convert a boolean matrix to string representation
// @param       this            The matrix`<bool>` to convert
// @returns     `<string>`      String representation of the matrix
export method tostring(matrix<bool> this) =>
    // @variable    An array, holding the stringified row data.
    array<string> tmp = defaultArrayMatrix(this.columns(), this.rows())
    for r = 0 to this.rows() - 1 by 1
        // @variable    An array, holding the stringified column data.
        array<string> tmpCol = array.new<string>()
        for c = 0 to this.columns() - 1 by 1
            tmpCol.push(this.get(r, c) ? 'true' : 'false')
        tmp.push(tmpCol.tostring())
    tmp.tostring()

