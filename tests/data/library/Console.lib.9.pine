// ——— 🔹 Method - Log #1/4 - Basic Terminal Logging { 
//
// Basic data types
//
// @function    Log a data object to the terminal
// @param       this            The terminal object
// @param       _data           The data object to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, data _data) =>
    this.pushData(_data)

// @function    Log a string to the terminal
// @param       this            The terminal object
// @param       _data           The string to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series string _data) =>
    this.pushData(data.new(_data))

// @function    Log an integer to the terminal
// @param       this            The terminal object
// @param       _data           The integer to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series int _data) =>
    this.log(_data.tostring())

// @function    Log a float to the terminal with optional rounding
// @param       this            The terminal object
// @param       _data           The float to log
// @param       _round          Optional decimal places for rounding
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series float _data, simple int _round = na) =>
    this.log(_data.round(_round).tostring())

// @function    Log a boolean to the terminal
// @param       this            The terminal object
// @param       _data           The boolean to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series bool _data) =>
    this.log(_data.tostring())

// @function    Log a color to the terminal with optional text formatting
// @param       this            The terminal object
// @param       _data           The color to log
// @param       _text           Whether to apply text formatting (true) or background formatting (false)
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series color _data, series bool _text = true) =>
    this.log(data.new(_data.tostring(), opt_text_color = _data, opt_bg_color = color.new(_data, _text ? BG_OPACITY : 0)))

// Chart objects
//
// @function    Log a label to the terminal
// @param       this            The terminal object
// @param       _data           The label to log
