// ——— 🔸 Method - Optional Level {
//
// @function    Change the `level` of the last log entry.
//
// #### Log Level
// [![0 na](https://img.shields.io/badge/0-na-grey?style=flat-square)]()
// [![1 info](https://img.shields.io/badge/1-info-2962ff?style=flat-square)]()
// [![2 warning](https://img.shields.io/badge/2-warning-FFEB3B?style=flat-square)]()
// [![3 error](https://img.shields.io/badge/3-error-FF5252?style=flat-square)]()
// [![4 success](https://img.shields.io/badge/4-success-4CAF55?style=flat-square)]()
// ___
// #### Example
// > ```
// > myConsole.log('foo').opt_lvl(1)
// > ```
// ___
// @param       this            The `<terminal>` object.
// @param       _lvl            The message level.
// @returns     `<terminal>` Returns the updated terminal object.
export method opt_lvl(terminal this, series int _lvl) =>
    // @variable    Reference to the last `<data>` object.
    data d = this.__log.last()
    d.level := _lvl > 4 ? 4 : _lvl < 0 ? 0 : _lvl
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔸 Method - Optional Condition {
//
// @function    Add a condition to the last log entry.
//
// #### Example
// > ```
// > myConsole.log('foo').opt_cond(bar_index % 2)
// > ```
// ___
// @param       this            The `<terminal>` object.
// @param       _cond           A `<bool>` condition. If `false` the log will be removed.
// @returns     `<terminal>` Returns the updated terminal object.
export method opt_cond(terminal this, series bool _cond = false) =>
    // --
    if _cond == false
        this.__log.pop()
    // >>
    this
// }

// ---------------------------------------------------------------------------------------------------------------------

// ——— 🔸 Method - Optional Sticky Note {
//
// @function    Temporary changes the level of the last log entry.
//
// #### Example
// > ```
// > myConsole.log('foo').opt_lvl(1)
// > ```
// ___
// @param       this            The `<terminal>` object.
// @param       _lvl            The temporary message level.
// @returns     `<terminal>` Returns the updated terminal object.
export method opt_sticky(terminal this, series int _lvl = 1) =>
    // --
    this.__sticky.push(this.__log.pop())
    // @variable    Reference to the last added sticky note.
    data d = this.__sticky.last()
    d.level := _lvl
    d.message := PIN + SWS + d.message
    // >>
    this
// }

