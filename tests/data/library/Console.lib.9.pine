// ——— 🔹 Method - Log #2/4 - Extended Terminal Logging with Title { 
//
// Basic data types with title
//
// @function    Log a data object with a title prefix
// @param       this            The terminal object
// @param       _title          The title prefix
// @param       _data           The data object to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series string _title, data _data) =>
    _data.message := _title.append(this.pseudo_delimiter).append(WS) + _data.message
    if this.indent
        _data.sub_indent := str.length(_title)
        this.max_indent := math.max(this.max_indent, _data.sub_indent)
        this.max_indent
    this.pushData(_data)

// @function    Log a string with a title prefix
// @param       this            The terminal object
// @param       _title          The title prefix
// @param       _data           The string to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series string _title, series string _data) =>
    data d = data.new(_title.append(this.pseudo_delimiter).append(WS) + _data)
    if this.indent
        d.sub_indent := str.length(_title)
        this.max_indent := math.max(this.max_indent, d.sub_indent)
        this.max_indent
    this.pushData(d)

// @function    Log an integer with a title prefix
// @param       this            The terminal object
// @param       _title          The title prefix
// @param       _data           The integer to log
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series string _title, series int _data) =>
    this.log(_title, _data.tostring())

// @function    Log a float with a title prefix and optional rounding
