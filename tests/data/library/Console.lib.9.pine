// @param       _data           The float to log
// @param       _round          Optional decimal places for rounding
// @returns     `<terminal>`    The updated terminal object
export method log(terminal this, series string _title, series float _data, simple int _round = na) =>
    this.log(_title, _data.round(_round).tostring())

