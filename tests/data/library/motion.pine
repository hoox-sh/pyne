// ———— Motion Library {
//
// @version=6
// @description     This library is designed to generate transition effects for strings, colors or positions, with \
//                  updates occurring on a per-tick basis. It emphasizes user-friendliness and customization options. \
//                  Additionally, it has been fine-tuned for optimal performance and minimal memory usage.
library("Motion", overlay = true)
// }


export enum FX
    marquee
    spot
    blink
    slide_in_left
    slide_in_right
    slide_out_left
    slide_out_right
    blend_in_left
    blend_in_right
    blend_out_left
    blend_out_right
    hide
    show
    transition
    fx
    iteration
    iterate
    movement
    move
    gradient
    fade
    fade_in
    fade_out

export enum Easing
    linear
    ease
    ease_in
    ease_out
    progressive
    exponential
    fibonacci

export enum Frequency
    on_tick
    on_time
    on_index
    on_input

export enum StartOn
    now
    on_open
    on_close

export enum Calculation
    relative
    absolute


//  ▪ EXPORT: 🅿 PRIMITIVE METHOD (FRAMEWORKLESS) ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ———— 🅿 Primitive Method - Motion {
//
// @function    A primitive method that provides the most efficient implementation for basic string manipulation \
//              and motion effects. Manipulates strings by rearranging elements based on specified parameters.
// ___
// [![method primitive](https://img.shields.io/badge/method-primitive-CCCCCC?style=flat-square)]()
// [![version simple string](https://img.shields.io/badge/version-simple_string-CCCCCC?style=flat-square)]()
// ___
// #### 📦 Import
// > ```pinescript
// > import cryptolinx/motion/$$VERSION as m
// > ```
// ___
// #### 🎯 Usage
// > ```pinescript
// > // Basic string rotation
// > string myText = "Hello"
// > label.new(bar_index, high, myText.motion())  // "elloH" -> "lloHe"
// >
// > // With custom delimiter and separator
// > string myText = "A>B>C>D"
// > label.new(bar_index, high, myText.motion(">", " "))  // "B C D A"
// > ```
// ___
// @param       this                The input string to manipulate.
// @param       _delimiter          Delimiter used to split the string.
// @param       _separator          Separator used to join elements.
// @param       _join               If true, joins elements; else returns last.
// @param       _reverse            If true, reverses element order.
// @returns     `<string>` The manipulated string series.
export method motion(
 simple string  this,
 series string  _delimiter  = '',
 series string  _separator  = '',
 series bool    _join       = true,
 series bool    _reverse    = false
 ) =>
    //@variable The animation string splitted into an array.
    varip array<string> seq = na
    // --
    switch
        na(seq) => seq := str.split(this, _delimiter)
        _reverse => seq.unshift(seq.pop())
        => seq.push(seq.shift())
    // >>
    _join ? seq.join(_separator) : seq.last()
// --
// @function    Method that provides the shortest possible implementation for commonly used string effects like \
//              iteration and marquee. \
//              This method manipulates a `series <string>` by rearranging its elements based on specified parameters.
//
// [![method primitive](https://img.shields.io/badge/method-primitive-CCCCCC?style=flat-square)]()
// [![version series string](https://img.shields.io/badge/version-series_string-CCCCCC?style=flat-square)]()
// ___
// #### Library Import
// > First, you need to import the motion library into your script. You should replace `$$VERSION_NUMBER` with \
// > the latest version number of the library and `$$ALIAS` with your chosen prefix. \
// > In this example, we use `m` as the prefix.
// > ```
// > import cryptolinx/motion/$$VERSION_NUMBER as $$ALIAS
// > ```
// ___
// @param       this                The input string series.
// @param       _delimiter          The delimiter used to split the string series (default is an empty string).
// @param       _separator          The separator used to join the string series (default is an empty string).
// @param       _join               A boolean indicating whether to join the split elements or return the last element (default is true).
// @param       _reverse            A boolean indicating whether to reverse the order of elements (default is false).
// @returns     `<string>` The manipulated string series.
export method motion(
 series string  this, 
 series string  _delimiter  = '',
 series string  _separator  = '',
 series bool    _join       = true,
 series bool    _reverse    = false
 ) =>
    // @variable     
    varip series string  og  = na
    varip array<string>  seq = na
    // --
    switch
        not (og == this) =>
           og  := this
         , seq := str.split(this, _delimiter)
        _reverse => 
           seq.unshift(seq.pop())
        => 
           seq.push(seq.shift())
    // >>
    _join ? seq.join(_separator) : seq.last()

// --
// @function    Method that provides the shortest possible implementation for commonly used string effects like \
//              iteration and marquee. \
//              This method manipulates a `series <string>` by rearranging its elements based on specified parameters.
//
// [![method primitive](https://img.shields.io/badge/method-primitive-CCCCCC?style=flat-square)]()
// [![version array string](https://img.shields.io/badge/version-array_string-CCCCCC?style=flat-square)]()
// ___
// #### Library Import
// > First, you need to import the motion library into your script. You should replace `$$VERSION_NUMBER` with \
// > the latest version number of the library and `$$ALIAS` with your chosen prefix. \
// > In this example, we use `m` as the prefix.
// > ```
// > import cryptolinx/motion/$$VERSION_NUMBER as $$ALIAS
// > ```
// ___
// @param       this                The input string series.
// @param       _separator          The separator used to join the string series (default is an empty string).
// @param       _join               A boolean indicating whether to join the split elements or return the last element (default is true).
// @param       _reverse            A boolean indicating whether to reverse the order of elements (default is false).
// @returns     `<string>` The manipulated string series.
export method motion(
 array<string> this,
 series string  _separator = '',
 series bool    _join       = true,
 series bool    _reverse    = false
 ) =>
    // @variable Used to check the
    varip series string  og  = na
    varip array<string>  seq = na
    // --
    switch
        not (og == this.join()) =>
           og  := this.join()
         , seq := this
        _reverse =>
           seq.unshift(seq.pop())
        =>
           seq.push(seq.shift())
    // >>
    _join ? seq.join(_separator) : seq.last()
// --
// @function    Method that provides the shortest possible implementation for commonly used string effects like \
//              iteration and marquee. \
//              This method manipulates an `array<float>` by rearranging its elements based on specified parameters.
//
// [![method primitive](https://img.shields.io/badge/method-primitive-CCCCCC?style=flat-square)]()
// [![version array float](https://img.shields.io/badge/version-array_float-CCCCCC?style=flat-square)]()
// ___
// #### Library Import
// > First, you need to import the motion library into your script. You should replace `$$VERSION_NUMBER` with \
// > the latest version number of the library and `$$ALIAS` with your chosen prefix. \
// > In this example, we use `m` as the prefix.
// > ```
// > import cryptolinx/motion/$$VERSION_NUMBER as $$ALIAS
// > ```
// ___
// @param       this                The input array of floats.
// @param       _reverse            A boolean indicating whether to reverse the order of elements (default is false).
// @returns     `<string>` The manipulated string series.
export method motion(
 array<float>   this,
 series bool    _reverse    = false
 ) =>
    // @variable An array of strings.
    varip array<float> seq = na
    switch 
        na(seq) => 
         seq := this
        _reverse => 
         seq.unshift(seq.pop())
        => 
         seq.push(seq.shift())
    // >>
    seq.last()
// --
// @function    Method that provides the shortest possible implementation for commonly used string effects like \
//              iteration and marquee. \
//              This method manipulates an `array<int>` by rearranging its elements based on specified parameters.
//
// [![method primitive](https://img.shields.io/badge/method-primitive-CCCCCC?style=flat-square)]()
// [![version array int](https://img.shields.io/badge/version-array_int-CCCCCC?style=flat-square)]()
// ___
// #### Library Import
// > First, you need to import the motion library into your script. You should replace `$$VERSION_NUMBER` with \
// > the latest version number of the library and `$$ALIAS` with your chosen prefix. \
// > In this example, we use `m` as the prefix.
// > ```
// > import cryptolinx/motion/$$VERSION_NUMBER as $$ALIAS
// > ```
// ___
// @param       this                The input array of integers.
// @param       _reverse            A boolean indicating whether to reverse the order of elements (default is false).
// @returns     `<string>` The manipulated string series.
export method motion(
 array<int>  this,
 series bool _reverse = false
 ) =>
    // @variable An array of strings.
    varip array<int> seq = na
    switch 
        na(seq) => 
         seq := this
        _reverse => 
         seq.unshift(seq.pop())
        => 
         seq.push(seq.shift())
    // >>
    seq.last()
