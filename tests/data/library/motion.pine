// ———— 🅿 Primitive Method {
//
//      # A lightweight, frameworkless implementation for basic string manipulation
//      # and motion effects. Provides core functionality without the overhead of
//      # the full framework, ideal for simple animation needs. 
//
//      # Series FX
//      |
//      | I: simple <string>, series <string>, array<string>
//      | O: <string>
//      |
//      ▸ 🅿 motion()        +4 ⇌
//      ▸ 🅿 run()           +1 ⇌
//      ▸ 🅿 easing()        +1 ⇌
// }

// ---------------------------------------------------------------------------------------------------------------------

// ———— 🔺 Framework - Library Methods {
//
//      # Internal library methods that provide core functionality for the framework.
//      # These methods handle essential operations like initialization, event
//      # handling, and state management. They serve as the foundation for higher-
//      # level framework features.
//
//      # Core Methods                          # Event Methods                         # State Methods  
//      |                                       |                                       |
//      | <keyframe>, <transition>              | <keyframe>, <transition>              | <keyframe>, <transition>
//      | <option>, <timer>                     |                                       | <option>, <timer>
//      |                                       |                                       |
//      ▸ 🔺 isset()                            ▸ 🔺 onInit()                           ▸ 🔺 oscillate()
//      ▸ 🔺 queue()                            ▸ 🔺 onProcess()                        ▸ 🔺 update()
//      ▸ 🔺 synchronize()                      ▸ 🔺 onTransition()                     ▸ 🔺 controller()
//      ▸ 🔺 load()                             ▸ 🔺 onDefaultIteration()               ▸ 🔺 populate()
//      ▸ 🔺 getInstances()                     ▸ 🔺 onConfirm()                        ▸ 🔺 observe()
//      ▸ 🔺 setStringLength()                  ▸ 🔺 onFinish()                         ▸ 🔺 confirm()
//      ▸ 🔺 setSubLength()                     ▸ 🔺 onReset()                          ▸ 🔺 finish()
//      ▸ 🔺 setFxLength()                      ▸ 🔺 onStart()                          ▸ 🔺 reset()
//      ▸ 🔺 setMaxLength()                     ▸ 🔺 onStop()                           ▸ 🔺 start()
//      ▸ 🔺 setOffset()                                                                ▸ 🔺 stop()
//
//      ▾ ...                                   ▾ ...                                   ▾ ...
// }



// ---------------------------------------------------------------------------------------------------------------------


// ———— 🔷 Framework - Primary Methods {
//
//      # Core framework methods that provide fundamental motion and transition
//      # capabilities. These methods offer direct access to the framework's main
//      # features and can be used to build complex animations and effects.
//      # Organized into Series FX, Content FX, Style FX, and Position FX categories
//      # for different animation needs.
//
//
//      # Content FX                            # Style FX                              # Position FX
//      |                                       |                                       |
//      | series <string>, array<string>       | series <color>, array<color>         | ~
//      | series <label>, series <line>         | series <label>, series <line>         | series <label>, series <line>
//      |                                       |                                       |
//      ▸ 🔹 transition()                       ▸ 🔹 gradient()                         ▸ 🔹 movement()
//      ▸ 🔹 iteration()
//
//      ▾ ...                                   ▾ ...                                   ▾ ...
// }

// ———— 🔶 Framework - Secondary Methods (simplified and user-orientated) {
//
//      # User-friendly wrapper methods that simplify access to common animation
//      # patterns. These methods provide easy-to-use interfaces for standard
//      # effects like marquee, slides, and fades, while abstracting away the
//      # complexity of the underlying framework. Includes controller methods
//      # for managing animation state.
//
//      ▾ ...                                   ▾ ...                                   ▾ ...
//      |                                       |                                       |
//      ▸ 🔸 iterate()      +3 ⇌                ▸ 🔸 fade()         +4 ⇌               ▸ 🔸 move()      +4 ⇌
//      ▸ 🔸 fx()           +3 ⇌                ▸ 🔸 fade_in()       +4 ⇌
//      |                                       ▸ 🔸 fade_out()      +4 ⇌
//      ├ ▸ marquee
//      ├ ▸ spot
//      ├ ▸ blink                    
//      ├ ▸ slideInLeft
//      ├ ▸ slideOutLeft
//      ├ ▸ slideOutRight
//      ├ ▸ slideInRight
//      ├ ▸ blendInLeft
//      ├ ▸ blendOutLeft
//      ├ ▸ blendInRight
//      ├ ▸ blendOutRight
//      ├ ▸ hide
//      └ ▸ show
//
//
//      # Controller Methods
//
//      | <keyframe>
//      | ~
//      |
//      ▸ 🔸 start()
//      ▸ 🔸 stop()
//      ▸ 🔸 reset()
// }

// ———— Framework Object Types {
//
//      ▸ <keyframe>
//      ├ ▸ <transition>
//      | └ ▸ <option>
//      └ ▸ <timer>
// }


