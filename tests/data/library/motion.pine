// > m.keyframe kf = m.keyframe.new()
// > // Invoking as a function
// > string mySequence = m.iterate(kf, myString, __opt = _, __timer = _)
// > // Invoking as a method on a string
// > string mySequence = kf.iterate(myString, __opt = _, __timer = _)
// > ```
// ___
// #### Multi Transition
