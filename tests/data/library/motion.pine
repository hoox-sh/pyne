// > ```
// > ```
// > color myColor = m.fade(kf, _colorFrom = color.blue, ...) // as function
// > color myColor = kf.fade(_colorFrom = color.blue, ...)        // as method
// > color myColor = color.blue.fade(color.red, kf, ...)         // as method
// > ```
