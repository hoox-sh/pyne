export method fade_in(
 series label   this,
 series color   _colorTo,
 series color   _colorFrom  = #00000000,
 series bool    _bg         = false,
 series int     _steps      = 8,
 series int     _transpFrom = 100,
 series int     _transpTo   = 0,
 keyframe       __kf        = na,
 option         __opt       = na,
 timer          __timer     = na
 ) =>
    // --
