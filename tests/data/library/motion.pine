/// ———— User Input {
//
// IMPORTANT: Example Type. NOT REQUIRED.
//
// @type       The user input object.
// @field      fx                  The selected transition effect.
// @field      play                A boolean indicating whether the effect should be played.
// @field      frequency           The frequency at which the effect should be executed.
// @field      intv                The interval at which the effect should be executed.
// @field      mu                  The multiplier for the interval.
// @field      step                The number of steps per execution.
// @field      fx_length           The length of the effect.
// @field      extern              An optional external update number.
// @field      max_loops           The maximum number of loops for the effect.
// @field      sub_start           The start index for the subsequence.
// @field      sub_length          The length of the subsequence.
// @field      reverse             A boolean indicating whether the effect should be reversed.
// @field      bounce              A boolean indicating whether the effect should bounce.
// @field      reset               A boolean indicating whether the effect should reset on every bar.
// @field      prefix              The prefix for the effect.
// @field      txt                 The text for the effect.
// @field      font_family         The font family for the effect.
// @field      format              The text format.
// @field      ws                  The trailing white space for the effect.
// @field      suffix              The suffix for the effect.
// @field      color_steps         The number of steps for the color effect.
// @field      color_bounce        A boolean indicating whether the color effect should bounce.
// @field      color_from          The initial color for the color effect.
// @field      color_to            The final color for the color effect.
// @field      multi_transition    A boolean indicating whether the effect should be a multi-transition.
// @field      start_on            The start condition for the effect.
// @field      calculation         The calculation mode for the effect.
type user_input
    // --
    string      fx
    Easing      easing
    bool        play
    Frequency   frequency
    int         intv
    int         mu
    int         step
    int         fx_length
    int         extern
    int         max_loops
    int         sub_start
    int         sub_length
    bool        reverse
    bool        bounce
    bool        reset
    bool        refill
    string      prefix
    string      txt
    string      font_family
    int         ws
    string      suffix
    int         color_steps
    bool        color_bounce
    color       color_0
    color       color_1
    color       color_2
    color       color_3
    color       color_4
    color       color_5
    bool        multi_transition
    StartOn     start_on
    Calculation calculation
    bool        console
    bool        console_ip
// --
// @variable    The user input object.
var user_input __input = user_input.new(
 fx                 = input.string('spot', title = 'Transition FX', options = ['marquee', 'spot', 'blink', 'blend_in_right', 'blend_out_right', 'blend_in_left', 'blend_out_left', 'slide_in_left', 'slide_in_right', 'slide_out_left', 'slide_out_right', 'hide', 'show'], tooltip = 'Select the transition effect to apply:\nmarquee: Scrolling text effect\nspot: Spotlight effect\nblink: Blinking effect\nblend_in/out: Fade in/out from sides\nslide_in/out: Slide in/out from sides\nhide/show: Simple visibility toggle', group = 'ACTION'),
 easing             = input.enum(Easing.linear, title='Easing', tooltip = 'Select the easing function for smooth transitions:\nlinear: Constant speed\nease: Smooth acceleration and deceleration\nease_in: Slow start, fast end\nease_out: Fast start, slow end\nprogressive: Accelerating progression\nexponential: Exponential growth\nfibonacci: Based on fibonacci sequence', group = 'ACTION'),
 play               = input.bool(true, title = 'Play', tooltip = 'Toggle animation playback. When disabled, the animation will pause in its current state.', group = 'ACTION'),
 frequency          = input.enum(Frequency.on_tick, title = 'Frequency', tooltip = 'Set how often the animation updates:\non_tick: Update every tick (smoothest)\non_time: Update based on real time\non_index: Update based on bar index\non_input: Update based on external input', group = 'TIMING'),
 intv               = input.int(1, title = 'Interval (' + DELTA + 't)', step = 1, minval = 1, maxval = 100, tooltip = 'Set frames between updates [1-100]. Higher values = slower animation.\nΔt represents the time delta between updates.', group = 'TIMING'),
 start_on           = input.enum(StartOn.now, title = 'Effect Start', tooltip = 'Choose when the animation begins:\nnow: Start immediately\non_open: Start at bar open\non_close: Start at bar close', group = 'TIMING'),
 mu                 = input.int(1000, title = '▸ On Time > Fineness (' + MU + ')', step = 50, minval = 50, maxval = 2000, tooltip = 'Fine-tune animation speed when using "on_time" frequency.\nLower values = faster updates (higher frequency)\nHigher values = slower updates (lower frequency)\nDefault: 1000', group = 'TIMING'),
 extern             = input.int(0, title = '▸ On Input > External Update No', tooltip = 'External update counter for custom animation control.\nOnly used when frequency is set to "on_input".\nIncrement this value to trigger the next animation frame.', group = 'TIMING'),
 step               = input.int(1, title = 'Steps Per Execution', step = 1, minval = 1, maxval = 20, tooltip = 'Number of positions to move per update [1-20].\nHigher values = faster movement but less smooth.\nDefault: 1 (smoothest movement)', group = 'PREFERENCES'),
 fx_length          = input.int(1, title = 'FX Length', step = 1, minval = 1, maxval = 20, tooltip = 'Length of the effect (e.g., spotlight width) [1-20].\nAffects how much of the text is affected at once.\nDefault: 1', group = 'PREFERENCES'),
 max_loops          = input.int(0, title = 'Max. Loops', step = 1, minval = 0, maxval = 100, tooltip = 'Maximum number of animation cycles [0-100]:\n0 = Infinite loops (for single transition)\n1 = Default for multi-transition\nHigher values = More repetitions', group = 'PREFERENCES'),
 sub_start          = input.int(0, title = 'Subsequence Start', step = 1, minval = 0, maxval = 20, tooltip = 'Starting position in text for the effect [0-20].\nExample: In "ABCDEFGHI"\n0 starts at A\n3 starts at D\nDefault: 0 (start)', group = 'PREFERENCES'),
 sub_length         = input.int(0, title = 'Subsequence Length', step = 1, minval = 0, maxval = 20, tooltip = 'Length of text segment to animate [0-20].\n0 = Full text length\n5 = Only animate 5 characters\nUseful for partial text effects', group = 'PREFERENCES'),
 refill             = input.bool(true, title = 'Placeholder / Refill', tooltip = 'When enabled, empty spaces are filled with whitespace.\nUseful for maintaining consistent text width during animations.\nDefault: true', group = 'PREFERENCES'),
 reverse            = input.bool(false, title = 'Reverse', tooltip = 'Reverse the animation direction.\nOnly affects directionally neutral effects:\nmarquee, spot, blink\nDefault: false', group = 'PREFERENCES'),
 bounce             = input.bool(false, title = 'Bounce', tooltip = 'Make the animation reverse at endpoints.\nExample: 1->2->3->2->1 instead of 1->2->3->1\nCreates a ping-pong effect.\nDefault: false', group = 'PREFERENCES'),
 reset              = input.bool(false, title = 'Reset On Every Bar', tooltip = 'Restart animation on each new bar.\nUseful for syncing with bar updates.\nWarning: May cause choppy animation.\nDefault: false', group = 'PREFERENCES'),
 prefix             = input.string('', title = 'Prefix', tooltip = 'Text to add before the animated text.\nExample: "$" for price values', group = 'CONTENT'),
 txt                = input.string('ABCDEFGHIJKLMNOPQRSTUVWXYZ', title = 'Text', tooltip = 'The main text to animate.\nCan be any string of characters.', group = 'CONTENT'),
 font_family        = input.string(font.family_monospace, title = 'Font Family', options = [font.family_default, font.family_monospace], tooltip = 'Choose text font style:\ndefault: Variable-width font\nmonospace: Fixed-width font (better for animations)', group = 'CONTENT'),
 ws                 = input.int(0, title = 'Trailing White Space', step = 1, minval = 0, maxval = 10, tooltip = 'Number of spaces to add after text [0-10].\nUseful for creating gaps between repeated text.\nDefault: 0', group = 'CONTENT'),
 suffix             = input.string('', title = 'Suffix', tooltip = 'Text to add after the animated text.\nExample: "%" for percentages', group = 'CONTENT'),
 color_steps        = input.int(8, title = 'Gradient Steps', step = 1, minval = 1, maxval = 20, tooltip = 'Number of color transitions in gradient [1-20].\nFor bounced effects:\nTotal length = (Steps * 2) - 2\nFor specific length (L): Steps = (L / 2) + 1', group = 'COLOR'),
 color_bounce       = input.bool(true, title = 'Color Bounce', tooltip = 'Make color gradient reverse at endpoints.\nCreates smooth color transitions back and forth.\nDefault: true', group = 'COLOR'),
 color_0            = input.color(color.yellow, title = 'Color #1', tooltip = 'Color #1 for gradient effect.\nUsed as the initial color in transitions.', group = 'COLOR'),
 color_1            = input.color(color.orange, title = 'Color #2', tooltip = 'Color #2 for gradient effect.\nUsed as the target color in transitions.', group = 'COLOR'),
 color_2            = input.color(color.fuchsia, title = 'Color #3', tooltip = 'Color #3 for gradient effect.\nUsed as the initial color in transitions.', group = 'COLOR'),
 color_3            = input.color(color.navy, title = 'Color #4', tooltip = 'Color #4 for gradient effect.\nUsed as the target color in transitions.', group = 'COLOR'),
 color_4            = input.color(color.aqua, title = 'Color #5', tooltip = 'Color #5 for gradient effect.\nUsed as the initial color in transitions.', group = 'COLOR'),
 color_5            = input.color(color.lime, title = 'Color #5', tooltip = 'Color #5 for gradient effect.\nUsed as the initial color in transitions.', group = 'COLOR'),
 multi_transition   = input.bool(false, title = 'Multi-Transition Example', tooltip = 'Demo of multiple transitions.\nAdds a blinking effect (3 loops)\nbefore the main selected effect.\nUseful for complex animations.', group = 'MULTI TRANSITION'),
 calculation        = input.enum(Calculation.relative, 'Calculation', group = 'MULTI TRANSITION'),
 console            = input.bool(false, title = 'Show Console - Insights', tooltip = 'Show Transition Insights', group = 'INSIGHTS'),
 console_ip         = input.bool(false, title = 'Multi-Transition Example', tooltip = 'Show Color Insights', group = 'INSIGHTS')
 )
// }

var map<string, string> effectMap = map.new<string, string>()
effectMap.put('marquee','fx')
effectMap.put('spot','fx')
effectMap.put('blink','fx')
effectMap.put('hide','fx')
effectMap.put('show','fx')
effectMap.put('slide_in_right','fx')
effectMap.put('slide_in_left','fx')
effectMap.put('slide_out_right','fx')
effectMap.put('slide_out_left','fx')
effectMap.put('blend_out_right','fx')
effectMap.put('blend_out_left','fx')
effectMap.put('blend_in_left','fx')
effectMap.put('blend_in_right','fx')
// --
effectMap.put('iterate', na)
effectMap.put('fade', na)
effectMap.put('fade_in', na)
effectMap.put('fade_out', na)
effectMap.put('move', na)
// ---------------------------------------------------------------------------------------------------------------------

// ———— Function Render Logo/Tag {
//
// @function   Creates a simple animated logo or tag.
// @param      _tagline     Optional string to use as the tagline. Default is '- A Pine Script™ Showcase -'.
// @param      _sizeLogo    Optional size parameter for the logo. Default is size.huge.
// @param      _sizeTag     Optional size parameter for the tagline. Default is size.normal.
// @param      _colorLogo   Optional color parameter for the logo. Default is #ff5252.
// @param      _colorTag    Optional color parameter for the tagline. Default is #ffffff96.
// @param      _colorDecor  Optional color parameter for decoration. Default is #ff525234.
// @param      _x           Optional integer specifying the X position. Default is bar_index.
// @param      _y           Optional float specifying the Y position. Default is 2100.
// @returns    `array<label>`
method render(
 array<label>  this,
 series string _sizeLogo   = size.huge, 
 series string _sizeTag    = size.normal, 
 series color  _colorLogo  = #ff5252, 
 series color  _colorTag   = #ffffff96, 
 series color  _colorDecor = #ff525234, 
 series string _tagline    = '- A Pine Script™ Showcase -',
 series int    _x          = bar_index, 
 series float  _y          = close
 ) =>
    if this.size() == 0
        // >>
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '',
          color             = #00000000,
          size              = _sizeLogo,
          style             = label.style_label_center,
          textcolor         = _colorLogo,
          textalign         = text.align_center,
          text_font_family  = font.family_default
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '└',
          color             = #00000000,
          size              = _sizeLogo,
          style             = label.style_label_upper_right,
          textcolor         = _colorDecor,
          textalign         = text.align_left,
          text_font_family  = font.family_default
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '┘',
          color             = #00000000,
          size              = _sizeLogo,
          style             = label.style_label_upper_left,
          textcolor         = _colorDecor,
          textalign         = text.align_left,
          text_font_family  = font.family_default
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '┌',
          color             = #00000000,
          size              = _sizeLogo,
          style             = label.style_label_lower_right,
          textcolor         = _colorDecor,
          textalign         = text.align_left,
          text_font_family  = font.family_default
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '┐',
          color             = #00000000,
          size              = _sizeLogo,
          style             = label.style_label_lower_left,
          textcolor         = _colorDecor,
          textalign         = text.align_left,
          text_font_family  = font.family_default
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = ' ',
          size              = _sizeLogo,
          color             = #00000000,
          textcolor         = color.new(_colorLogo, 75),
          text_font_family  = font.family_default,
          style             = label.style_label_down,
          textalign         = text.align_left
          ))
        this.push(
         label.new(
          x                 = _x,
          y                 = _y,
          text              = '\n\n\n\n\n' + _tagline,
          color             = #00000000,
          size              = size.small,
          style             = label.style_label_up,
          textcolor         = _colorTag,
          textalign         = text.align_left,
          text_font_family  = font.family_monospace
         ))
    // >>
    this
// }

// ———— Method for Updating Logo {
//
// @function    Updates the logo's properties.
// @param       _logo           Array of label objects constituting the logo.
// @param       _textLogo       Optional new text for the logo. Default is 'na'.
// @param       _textTagline    Optional new text for the tagline. Default is 'na'.
// @param       _x              Optional new X position. Default is bar_index.
// @param       _y              Optional new Y position. Default is 'na'.
// @returns     `void`          The function doesn't return any value.
method update(
 array<label>   this, 
 string         _textLogo       = na,
 string         _textTagline    = na,
 float          _y              = na,
 int            _x              = bar_index,
 color          _colorDecor     = na
 ) =>
    // --
    if (barstate.islast or barstate.isrealtime) and this.size() > 0
        for i = 0 to this.size() - 1
            label l = this.get(i)
            l.set_xy(
             _x.isset(l.get_x()), 
             _y.isset(l.get_y())
             )
        // --
        if not na(_colorDecor)
            for i = 1 to 4
                label l = this.get(i)
                l.set_textcolor(color.new(_colorDecor, 85))
        // --
        label l0 = this.get(0)
        label l6 = this.get(6)
        l0.set_text(
         _textLogo.isset(l0.get_text())
         )
        l0.set_textcolor(_colorDecor)
        l6.set_text(
         _textTagline.isset(l6.get_text())
         )
    // >>
    this
// }

// ———— Motion. ✨ {
//
const string TAGLINE = '~ A Pine Script™ {0} ~'
const array<string> LOGO_TEXT = array.from('M ◞TION.','M◟ TION.','M◜ TION.','M ◝TION.')
// --
var keyframe taglineKf1  = keyframe.new(intv = 4, steps = 1)
var keyframe taglineKf2  = keyframe.new(intv = 1, steps = 1)
// --
series string taglineFX1 = taglineKf1.iteration(
 _seqArr = array.from('Showcase','Library'),
 __opt   = option.new( 
  prefix = 'A Pine Script™ ',
  refill = true
  )
 )
// --
series string taglineFX2 = taglineKf2.transition(
 _seq = taglineFX1,
 _fx = 'slide_in_right',
 __opt = option.new(
  max_loops = 1,
  prefix    = '\n\n\n\n' + '- ',
  suffix    = ' -'
  )
 )
// --
series color colorFX = array.from(
 __input.color_0,
 __input.color_1,
 __input.color_2,
 __input.color_3,
 __input.color_4,
 __input.color_5
 )
 .fade(_steps = __input.color_steps)
// --
series string logoFX = LOGO_TEXT.motion(_join = false)
// --
var array<label> LOGO = array.new<label>()
LOGO
 .render()
 .update(logoFX, taglineFX2, 10, _colorDecor = colorFX)
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Label {
//
// @variable    An example `<label>` object.
var series label select = label.new(
 x                  = bar_index,
 y                  = 750,
 text               = 'Select FX',
 textcolor          = color.white,
 color              = #ffffff0b,
 size               = size.normal, 
 text_formatting    = text.format_italic,
 style              = label.style_label_down
 )
// @variable    An example `<label>` object.
var series label fx = label.new(
 x                  = bar_index,
 y                  = 700,
 text               = __input.fx,
 textcolor          = colorFX,
 color              = #ffffff0b,
 size               = 12,
 style              = label.style_label_center,
 textalign          = text.align_center,
 text_font_family   = font.family_default,
 text_formatting    = text.format_bold
 )
// @variable    An example `<label>` object.
var series label example = label.new(
 x                  = bar_index,
 y                  = 600,
 text               = __input.txt,
 textcolor          = chart.fg_color,
 color              = #2c2b2b,
 size               = 24,
 style              = label.style_label_center,
 textalign          = text.align_center,
 text_font_family   = __input.font_family
 )
// @variable    An example `<label>` object.
var series label info = label.new(
 x                  = bar_index,
 y                  = 400,
 text               = 'ℹ️\n \nAdd the script to your chart to experience its features!\nA symbol with a high price update frequency is recommanded!',
 textcolor          = #ffffffA0,
 color              = #ffffff00,
 size               = size.small,
 style              = label.style_label_center,
 text_font_family   = font.family_monospace
 )
// @variable    An example `<label>` object.
var label openSource = label.new(
 x                  = bar_index,
 y                  = 300,
 text               = '🔋 Batteries Included',
 textcolor          = color.new(color.silver, 30),
 color              = #ffffff00,
 size               = size.small,
 style              = label.style_label_center
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Keyframes {
//
// @variable    The Color FX `<keyframe>` object.
var keyframe colorKf = keyframe.new(
 intv   = __input.intv,
 steps  = __input.step,
 exec   = __input.play,
 extern = __input.extern
 )
// @variable    The Transition FX `<keyframe>` object.
var keyframe transitionKf = keyframe.new(
 intv   = __input.intv,
 steps  = __input.step,
 exec   = __input.play,
 extern = __input.extern
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Option {
// 
// @variable    The global `<option>` object.
var option __opt = option.new(
 ws             = __input.ws,
 max_loops      = __input.max_loops,
 reverse        = __input.reverse,
 bounce         = __input.bounce,
 refill         = __input.refill,
 reset          = __input.reset,
 sub_length     = __input.sub_length,
 sub_start      = __input.sub_start,
 fx_length      = __input.fx_length,
 prefix         = __input.prefix,
 suffix         = __input.suffix,
 easing         = __input.easing
 )
// @variable    A modified copy of the global `<option>` object.
var option __opt2 = __opt.copy()
__opt2.max_loops := 3
// @variable    A modified copy of the global `<option>` object.
var option __opt4 = __opt.copy()
__opt4.bounce := __input.color_bounce
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— Timer {
//
// @variable    The global `<timer>` object.
var timer __timer = timer.new(
 frequency      = __input.frequency,
 start_on       = __input.start_on,
 mu             = __input.mu,
 calculation    = __input.calculation
 )
// }


// ---------------------------------------------------------------------------------------------------------------------

// ———— FX {
//
series string myTransition = __input.txt
if effectMap.get(__input.fx) == 'fx'
    if __input.multi_transition
        // --
        transitionKf.transition(
         _seq       = __input.txt,
         _fx        = 'blink',
         __opt      = __opt2,
         __timer    = __timer
         )
    // @variable    Output of the executed effect.
    myTransition := transitionKf.transition(
     _seq       = __input.txt,
     _fx        = __input.fx,
     __opt      = __opt,
     __timer    = __timer
     )
else if effectMap.get(__input.fx) == 'iterate'
    array<string> iterationArray = array.from('PLAN','EVERY','STEP','YOU','TAKE')

if not (effectMap.get(__input.fx) == 'fx')
    myTransition := __input.txt
// }

// ---------------------------------------------------------------------------------------------------------------------

//———— Updates {
//
if barstate.islast or barstate.isrealtime
    // @variable    X-axis anchor for example `<label>`.
    series int x = bar_index
    // --
    select.set_xy(x, 7)
    fx.set_xy(x, 6.2)
    fx.set_text(__input.fx)
    fx.set_textcolor(colorFX)
    example.set_xy(x, 5)
    example.set_text(myTransition)
    info.set_xy(x, 1)
    info.fade(
     _colorFrom     = color.silver,
     _colorTo       = color.silver,
     _steps         = str.length(__input.txt) + __input.ws,
     _transpFrom    = 80,   
     _transpTo      = 0,
     __opt          = option.new(bounce = true)
     )
    openSource.set_xy(x, 0)
// }

//  ▪ DEBUGGING ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ———— Console )Chart {
//
// The debugging feature can only be used by creating your own copy of this script and uncomment the lines below:
// ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾ ▾

// --
import cryptolinx/Console/9 as c
// --
// Leveraging console methods
method stats(c.terminal this, keyframe __keyframe) =>
    if barstate.islast
        transition t = __keyframe.__transition
        option     o = t.__opt
        // --
        this
         .log('Fx', t.fx).opt_lvl(1)
         .log('Action', t.action).opt_lvl(2)
         .log('Keyframe Init', __keyframe.init)
         .log('Keyframe Execution', __keyframe.exec)
         .log('Transition Init', t.init)
         .log('Transition Started', t.started)
         .log('Timer Started', __keyframe.__timer.started)
         .log('Timer Start', __keyframe.__timer.start)
         .hr()
         .log('Timer Update Offset', __keyframe.__timer.offset)
         .log('Transition Index', __keyframe.idx)
         .log('Total Length', __keyframe.getTotalLength())
         .log('Update No', __keyframe.update_no)
         .log('Serial No', __keyframe.frame_no)
         .log('Loop No', __keyframe.loop_no)
         .log('Pointer/Length',
          (__keyframe.pointer + 1).tostring() + '/' + (t.iteration_length + 1 - (_onDefaultIteration(t) ? 1 : 0)).tostring()
         )
         .log('reverse', o.reverse)
         .log('Bounce', o.bounce)
         .log('Default Iteration', _onDefaultIteration(t))
         .hr()
         .log('String Length', t.str_length)
         .log('Iteration Length', t.iteration_length)
         .log('Max. Length', t.max_length)
         .log('Max. Loops', o.max_loops)
         .hr()
         .log('Subsequence Start', o.sub_start)
         .log('Subsequence Length', o.sub_length)
         .hr()
         .log('Multi-Transition', _onMultiTransition(__keyframe))
          .opt_lvl(_onMultiTransition(__keyframe) ? 2 : 3)
         .log('Stack Size', __keyframe.__queue.size())
    // >>
    this
// --
if (barstate.islast or barstate.isrealtime) and __input.console_ip
    // --
    consoleIp = c.terminal.new(
     rows           = 20,
     columns        = 1,
     height         = 40,
     width          = 25,
     display        = 'chart',
     log_position   = position.middle_left,
     ip             = true
     )
     .init()
    // --
    consoleIp
     .log('ENDLESS COLOR LOOPS! NO GAP!')
      .opt_sticky()
     .log(colorFX)
     .show()
// --
if (barstate.islast or barstate.isrealtime) and __input.console
    console = c.terminal.new(
     rows       = 30,
     columns    = 1,
     height     = 60,
     width      = 25,
     display    = 'chart',
     indent     = true
     )
     .init()
    // --
    console
     .stats(transitionKf) // <-- change keyframe for insight
     .show()
// }

