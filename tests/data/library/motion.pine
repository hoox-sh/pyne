export method iterate(
 series string  this,
 keyframe       __kf        = na, 
 option         __opt       = na, 
 timer          __timer     = na
 ) =>
    // --
    var keyframe kf = __kf.isset(keyframe.new())
    // >>
    kf.iteration(
     _seq    = this,
     __opt   = __opt.isset(option.new()),
     __timer = __timer.isset(timer.new())
     )
// --
    // @function    Generates a iterate text scrolling effect and applies it onto a `<string>`.
