//---------------------------------------------------- START OF SCRIPT --{


//@version=4
study("Laguerre RSI (Self Adjusting Alpha with Fractals Energy)", shorttitle="LRSI")


//////////////////////////////////////////////////////////////////////////
//-- INPUTS
//////////////////////////////////////////////////////////////////////////


var __SRC                    = input(title="Source", type=input.source, defval=close)

var float __ALPHA            = input(title="Alpha", type=input.float, minval=0, step=0.1, defval=0.7)
var bool __ON_FRACTAL        = input(title="Apply Fractal Energy ?", type=input.bool, defval=true)
var int __FRACTAL_LENGTH     = input(title="Fractals Energy Length", type=input.integer, minval=1, defval=13)



//////////////////////////////////////////////////////////////////////////
//-- COLORS
//////////////////////////////////////////////////////////////////////////


//--__buy, Upward
var color col_green_1        = #4EF9FF
var color col_green_2        = #3CADB1
var color col_green_3        = #26c6da  //*
var color col_green_4        = #afff00
var color col_green_5        = #CFD80E
var color col_green_6        = #90c818

//-- __sell, Downward
var color col_red_1          = #7b1fa2
var color col_red_2          = #7e57c2
var color col_red_3          = #512da8
var color col_red_4          = #7300de
var color col_red_5          = #4a148c  //*

//-- Idle, Sideward
var color col_yellow_1       = #ffa726
var color col_yellow_2       = #f57c00


//////////////////////////////////////////////////////////////////////////
//-- VARIABLES
//////////////////////////////////////////////////////////////////////////


float L0 = 0.0
float L1 = 0.0
float L2 = 0.0
float L3 = 0.0

float CU = 0.0
float CD = 0.0

float OC = (open + nz(close[1])) / 2
float HC = max(high, nz(close[1]))
float LC = min(low, nz(close[1]))


//////////////////////////////////////////////////////////////////////////
//-- CALCULATION
//////////////////////////////////////////////////////////////////////////


feSrc = (OC + HC + LC + close) / 4

feAlpha = log(sum((max(high, nz(close[1])) - min(low, nz(close[1]))) / (highest(high, __FRACTAL_LENGTH) - lowest(low, __FRACTAL_LENGTH)), __FRACTAL_LENGTH)) / 
   log(__FRACTAL_LENGTH)


lrsiAlpha = __ON_FRACTAL ? feAlpha : __ALPHA

L0 := lrsiAlpha * (__ON_FRACTAL ? feSrc : __SRC) + (1 - lrsiAlpha) * nz(L0[1])
L1 := -(1 - lrsiAlpha) * L0 + nz(L0[1]) + (1 - lrsiAlpha) * nz(L1[1])
L2 := -(1 - lrsiAlpha) * L1 + nz(L1[1]) + (1 - lrsiAlpha) * nz(L2[1])
L3 := -(1 - lrsiAlpha) * L2 + nz(L2[1]) + (1 - lrsiAlpha) * nz(L3[1])



CU := (L0 >= L1 ? L0 - L1 : 0) + (L1 >= L2 ? L1 - L2 : 0) + (L2 >= L3 ? L2 - L3 : 0)
CD := (L0 >= L1 ? 0 : L1 - L0) + (L1 >= L2 ? 0 : L2 - L1) + (L2 >= L3 ? 0 : L3 - L2)


var float __LRSI             = iff(CU + CD != 0, CU / (CU + CD), 0)


overboughtLevel = hline(0.8, title="Overbought Level", linestyle=hline.style_dashed, color=#686868)
oversoldLevel = hline(0.2, title="Oversold Level", linestyle=hline.style_dashed, color=#686868)


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


plot(__LRSI, title="LRSI", linewidth=2, color=col_yellow_1, transp=0)
plot(__ON_FRACTAL ? feAlpha : na, title="FE Alpha", linewidth=2, color=col_red_2, transp=0)


//------------------------------------------------------ END OF SCRIPT --}
