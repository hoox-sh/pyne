//@version=2
strategy(title='Renko Magic - Strategy', overlay=false)

//Entry/exit just after 1 RENKO BRICKS
buy_entry = close > open[1] and close[1] < open[2]
sell_entry = close < open[1] and close[1] > open[2]

//Entry/exit just after 2 RENKO BRICKS
//buy_entry = open[0] > open[1] and open[0] > open[2]
//sell_entry = open[0] < open[1] and open[0] < open[2]


// === CREATE INPUT WINDOW THAT ALLOWS TO ENTER SPECIFIC DATES FOR THE STRATEGY TESTER ===
FromMonth = input(defval = 3, title = "From Month", minval = 1, maxval = 12)
FromDay   = input(defval = 19, title = "From Day", minval = 1, maxval = 31)
FromYear  = input(defval = 2018, title = "From Year", minval = 2017)
ToMonth   = input(defval = 6, title = "To Month", minval = 1, maxval = 12)
ToDay     = input(defval = 19, title = "To Day", minval = 1, maxval = 31)
ToYear    = input(defval = 2018, title = "To Year", minval = 2017)

start     = timestamp(FromYear, FromMonth, FromDay, 00, 00)  // backtest start window
finish    = timestamp(ToYear, ToMonth, ToDay, 23, 59)        // backtest finish window
startTimeOk()  => time >= start and time <= finish ? true : false // create function "within window of time" if statement true

if( startTimeOk() )
    strategy.entry('buy', long=strategy.long, comment='buy', when=buy_entry)
    strategy.entry('sell', long=strategy.short, comment='sell', when=sell_entry)