//@version=5
indicator("[CLX] Scales Customizer", overlay=false)

import TradingView/ta/7
import cryptolinx/ScalesDEV/1 as scale
import cryptolinx/ConsoleDEV/5 as debug

// Source Settings
var SRC_GROUP = "Source Settings"
var SOURCE = input.string("RSI", "Indicator", options=["RSI", "MOM", "PRICE", "MANUAL"], group=SRC_GROUP)
var LENGTH = input.int(14, "Indicator Length", minval=1, maxval=500, group=SRC_GROUP)
var MANUAL_VALUE = input.float(50, "Manual Value", minval=-500, maxval=500, group=SRC_GROUP)

// Scale Settings
var SCALE_GROUP = "Scale Settings"
var SCALE_X = input.int(0, "X Offset", group=SCALE_GROUP)
var SCALE_Y = input.float(0, "Y Position", group=SCALE_GROUP)
var SCALE_MIN = input.float(0, "Min Value", group=SCALE_GROUP)
var SCALE_MAX = input.float(100, "Max Value", group=SCALE_GROUP)
var SCALE_BARS = input.int(10, "Number of Bars", minval=1, maxval=100, group=SCALE_GROUP)
var SCALE_BAR_WIDTH = input.int(2, "Bar Width", minval=1, maxval=10, group=SCALE_GROUP)
var SCALE_BAR_HEIGHT = input.int(5, "Bar Height", minval=1, maxval=20, group=SCALE_GROUP)
var SCALE_SPACING = input.int(1, "Bar Spacing", minval=0, maxval=5, group=SCALE_GROUP)
var SCALE_WPADDING = input.int(2, "Width Padding", minval=0, maxval=10, group=SCALE_GROUP)
var SCALE_HPADDING = input.int(0, "Height Padding", minval=0, maxval=10, group=SCALE_GROUP)
var SCALE_POINT_OF_VIEW = input.string(extend.right, "Point of View", options=[extend.right,extend.left,extend.both], group=SCALE_GROUP)
var SCALE_LINE_STYLE = input.string(line.style_solid, "Line Style", options=[line.style_solid,line.style_dotted,line.style_dashed], group=SCALE_GROUP)
var SCALE_DYNAMIC = input.bool(false, "Dynamic Range", group=SCALE_GROUP)
var SCALE_SYNC = input.bool(true, "Sync Dynamic Range", group=SCALE_GROUP)
var SCALE_POINTER = input.bool(false, "Use Pointer", group=SCALE_GROUP)
var SCALE_POINTER_SIZE = input.float(1.5, "Pointer Size", minval=1, maxval=3, step=0.1, group=SCALE_GROUP)
var SCALE_PREFILL = input.bool(true, "Prefill Bars", group=SCALE_GROUP)

// Theme Settings
var THEME_GROUP = "Theme Settings"
var COLOR_BG = input.color(color.new(#161424, 0), "Background Color", group=THEME_GROUP)
var COLOR_TEXT = input.color(color.new(#ffffff, 40), "Text Color", group=THEME_GROUP)
var COLOR_BAR_UNFILLED = input.color(color.new(#ffffff, 60), "Unfilled Bar Color", group=THEME_GROUP)
var COLOR_BAR_FILLED = input.color(#7d1aff, "Filled Bar Color", group=THEME_GROUP)
var USE_GRADIENT = input.bool(false, "Use Gradient", group=THEME_GROUP)
var COLOR_GRADIENT = input.color(color.red, "Gradient Color", group=THEME_GROUP)
var GRADIENT_LAST = input.bool(false, "Gradient Last", group=THEME_GROUP)

// Text Settings
var TEXT_GROUP = "Text Settings"
var TEXT_SIZE = input.string(size.normal, "Text Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=TEXT_GROUP)
var TEXT_FONT = input.string(font.family_default, "Font Family", options=[font.family_default, font.family_monospace], group=TEXT_GROUP)
var SHOW_VALUE = input.bool(true, "Show Current Value", group=TEXT_GROUP)
var SHOW_MINMAX = input.bool(true, "Show Min/Max", group=TEXT_GROUP)
var TEXT_POSITION = input.string(position.bottom_center, "Value Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=TEXT_GROUP)
var TEXT_PADDING = input.int(0, "Text Padding", minval=0, maxval=10, group=TEXT_GROUP)
var TEXT_PRECISION = input.int(2, "Decimal Precision", minval=0, maxval=6, group=TEXT_GROUP)
var TEXT_ROW = input.int(1, "Text Row", minval=1, maxval=5, group=TEXT_GROUP)

// Marker Settings
var MARKER_GROUP = "Marker Settings"
var USE_MARKER = input.bool(true, "Use Marker", group=MARKER_GROUP)
var MARKER_ICON = input.int(0, "Marker Icon", minval=0, maxval=12, group=MARKER_GROUP)
var MARKER_COLOR = input.color(#7d1aff, "Marker Color", group=MARKER_GROUP)
var MARKER_BGCOLOR = input.color(color.new(#000000, 100), "Marker Background Color", group=MARKER_GROUP)
var MARKER_LOCATION = input.string(location.bottom, "Marker Location", options=[location.top, location.bottom], group=MARKER_GROUP)
var MARKER_SIZE = input.string(size.normal, "Marker Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=MARKER_GROUP)
var MARKER_ANCHOR = input.bool(false, "Anchor to Scale", group=MARKER_GROUP)
var MARKER_OPTICAL_CORRECTION = input.bool(true, "Optical Correction", group=MARKER_GROUP)

// Range Settings
var RANGE_GROUP = "Range Settings"
var USE_RANGE = input.bool(true, "Use Range", group=RANGE_GROUP)
var RANGE_LENGTH = input.int(14, "Range Length", minval=1, maxval=500, group=RANGE_GROUP)
var RANGE_COLOR = input.color(color.new(color.gray, 50), "Range Color", group=RANGE_GROUP)
var RANGE_BGCOLOR = input.color(color.new(#000000, 90), "Range Background Color", group=RANGE_GROUP)
var RANGE_TEXT_ICON = input.int(0, "Range Text Icon", minval=0, maxval=8, group=RANGE_GROUP)
var RANGE_MARKER_ICON = input.int(0, "Range Marker Icon", minval=0, maxval=18, group=RANGE_GROUP)
var RANGE_SHOW_TEXT = input.bool(true, "Show Range Text", group=RANGE_GROUP)
var RANGE_SHOW_MARKER = input.bool(true, "Show Range Marker", group=RANGE_GROUP)
var RANGE_TEXT_LOCATION = input.string(location.top, "Range Text Location", options=[location.top, location.bottom], group=RANGE_GROUP)
var RANGE_MARKER_LOCATION = input.string(location.bottom, "Range Marker Location", options=[location.top, location.bottom], group=RANGE_GROUP)

// Average Settings
var AVG_GROUP = "Average Settings"
var USE_AVG = input.bool(true, "Use Average", group=AVG_GROUP)
var AVG_LENGTH = input.int(14, "Average Length", minval=1, maxval=500, group=AVG_GROUP)
var AVG_COLOR = input.color(color.new(color.blue, 0), "Average Color", group=AVG_GROUP)
var AVG_TEXT_ICON = input.int(0, "Average Text Icon", minval=0, maxval=2, group=AVG_GROUP)
var AVG_MARKER_ICON = input.int(0, "Average Marker Icon", minval=0, maxval=12, group=AVG_GROUP)
var AVG_SHOW_TEXT = input.bool(true, "Show Average Text", group=AVG_GROUP)
var AVG_SHOW_MARKER = input.bool(true, "Show Average Marker", group=AVG_GROUP)
var AVG_TEXT_POSITION = input.string(position.top_center, "Average Text Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=AVG_GROUP)
var AVG_MARKER_LOCATION = input.string(location.top, "Average Marker Location", options=[location.top, location.bottom], group=AVG_GROUP)

// Trend Settings
var TREND_GROUP = "Trend Settings"
var USE_TREND = input.bool(true, "Use Trend", group=TREND_GROUP)
var TREND_LENGTH = input.int(1, "Trend Length", minval=1, maxval=500, group=TREND_GROUP)
var TREND_ICON = input.int(0, "Trend Icon", minval=0, maxval=10, group=TREND_GROUP)
var TREND_POSITION = input.string(position.bottom_center, "Trend Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=TREND_GROUP)
var TREND_SPLIT = input.bool(true, "Split Trend", group=TREND_GROUP)
var TREND_LIVE = input.bool(false, "Live Trend", group=TREND_GROUP)
var TREND_COLORED = input.bool(true, "Colored Trend", group=TREND_GROUP)

// Decoration Settings
var DECOR_GROUP = "Decoration Settings"
var USE_DECOR = input.bool(true, "Use Decoration", group=DECOR_GROUP)
var DECOR_ICON = input.int(1, "Decoration Icon", minval=0, maxval=13, group=DECOR_GROUP)
var DECOR_COLOR = input.color(color.new(color.gray, 25), "Decoration Color", group=DECOR_GROUP)
var DECOR_BGCOLOR = input.color(color.new(#000000, 100), "Decoration Background Color", group=DECOR_GROUP)
var DECOR_SIZE = input.string(size.normal, "Decoration Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=DECOR_GROUP)
var DECOR_PADDING = input.int(0, "Decoration Padding", minval=0, maxval=10, group=DECOR_GROUP)
var DECOR_ROW = input.int(2, "Decoration Row", minval=1, maxval=5, group=DECOR_GROUP)
var DECOR_XCROSS = input.bool(false, "Decoration XCross", group=DECOR_GROUP)
var DECOR_PINGPONG = input.bool(false, "Decoration Pingpong", group=DECOR_GROUP)

// Loader Settings
var LOADER_GROUP = "Loader Settings"
var USE_LOADER = input.bool(true, "Use Loader", group=LOADER_GROUP)
var LOADER_ICON = input.int(0, "Loader Icon", minval=0, maxval=6, group=LOADER_GROUP)
var LOADER_COLOR = input.color(#7d1aff, "Loader Color", group=LOADER_GROUP)
var LOADER_BGCOLOR = input.color(color.new(#000000, 100), "Loader Background Color", group=LOADER_GROUP)
var LOADER_SIZE = input.string(size.normal, "Loader Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=LOADER_GROUP)
var LOADER_POSITION = input.string(position.bottom_right, "Loader Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=LOADER_GROUP)
var LOADER_SHOW_TICKS = input.bool(false, "Show Loader Ticks", group=LOADER_GROUP)
var LOADER_ROW = input.int(1, "Loader Row", minval=1, maxval=5, group=LOADER_GROUP)

var LOADER_COLOR_BAR_FILLED = input.bool(false, "Use Bar Filled Color for Loader", group=LOADER_GROUP)
var LOADER_REVERSE = input.bool(false, "Reverse Loader Animation", group=LOADER_GROUP)

// Timer Settings
var TIMER_GROUP = "Timer Settings"
var USE_TIMER = input.bool(true, "Use Timer", group=TIMER_GROUP)
var TIMER_POSITION = input.string(position.bottom_left, "Timer Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=TIMER_GROUP)
var TIMER_COLOR = input.color(color.gray, "Timer Color", group=TIMER_GROUP)
var TIMER_SIZE = input.string(size.normal, "Timer Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=TIMER_GROUP)
var TIMER_FORMAT = input.string("", "Custom Timer Format", group=TIMER_GROUP)
var TIMER_OUTPUT_FORMAT = input.string(format.inherit, "Timer Output Format", options=[format.inherit, format.percent], group=TIMER_GROUP)
var TIMER_INCLUDE_HOURS = input.bool(false, "Include Hours in Timer", group=TIMER_GROUP)
var TIMER_SHOW_ICON = input.bool(true, "Show Timer Icon", group=TIMER_GROUP)
var TIMER_ROW = input.int(1, "Timer Row", minval=0, maxval=5, group=TIMER_GROUP)

// Badge Settings
var BADGE_GROUP = "Badge Settings"
var USE_BADGE = input.bool(true, "Use Badge", group=BADGE_GROUP)
var BADGE_TEXT = input.string("BADGE", "Badge Text", group=BADGE_GROUP)
var BADGE_POSITION = input.string(position.top_left, "Badge Position", options=[position.top_left, position.top_center, position.top_right, position.bottom_left, position.bottom_center, position.bottom_right], group=BADGE_GROUP)
var BADGE_COLOR = input.color(color.blue, "Badge Color", group=BADGE_GROUP)
var BADGE_SIZE = input.string(size.normal, "Badge Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=BADGE_GROUP)
var BADGE_BGCOLOR = input.color(color.new(#000000, 50), "Badge Background Color", group=BADGE_GROUP)
var BADGE_ROW = input.int(2, "Badge Row", minval=0, maxval=5, group=BADGE_GROUP)

// Alert Settings
var ALERT_GROUP = "Alert Settings"
var USE_ALERT = input.bool(false, "Use Alert", group=ALERT_GROUP)
var ALERT_TARGET = input.float(70, "Alert Target", group=ALERT_GROUP)
var ALERT_ICON = input.int(0, "Alert Icon", minval=0, maxval=7, group=ALERT_GROUP)
var ALERT_TYPE = input.string("cross", "Alert Type", options=["cross", "crossover", "crossunder"], group=ALERT_GROUP)
var ALERT_FREQ = input.string(alert.freq_once_per_bar_close, "Alert Frequency", options=[alert.freq_all, alert.freq_once_per_bar, alert.freq_once_per_bar_close], group=ALERT_GROUP)
var ALERT_LOCATION = input.string(location.abovebar, "Alert Location", options=[location.abovebar, location.belowbar], group=ALERT_GROUP)
var ALERT_COLOR = input.color(color.yellow, "Alert Color", group=ALERT_GROUP)
var ALERT_SIZE = input.string(size.normal, "Alert Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=ALERT_GROUP)
var ALERT_MESSAGE = input.string("", "Custom Alert Message", group=ALERT_GROUP)

// Additional Theme Settings
var COLOR_BG_TEXT = input.color(color.new(#000000, 100), "Text Background Color", group=THEME_GROUP)
var COLOR_POSITIVE = input.color(color.green, "Positive Color", group=THEME_GROUP)
var COLOR_NEGATIVE = input.color(color.red, "Negative Color", group=THEME_GROUP)
var COLOR_NEUTRAL = input.color(color.gray, "Neutral Color", group=THEME_GROUP)

// Additional Text Settings
var TEXT_LEFT = input.string("", "Left Text", group=TEXT_GROUP)
var TEXT_RIGHT = input.string("", "Right Text", group=TEXT_GROUP)
var TEXT_TOP = input.string("", "Top Text", group=TEXT_GROUP)
var TEXT_BOTTOM = input.string("", "Bottom Text", group=TEXT_GROUP)
var PRECISION = input.int(2, "Decimal Precision", minval=0, maxval=8, group=TEXT_GROUP)

// Additional Scale Settings
var SCALE_PASSTHROUGT = input.bool(false, "Pass Through", group=SCALE_GROUP)
var SCALE_FIXED = input.bool(false, "Fixed Position", group=SCALE_GROUP)

// Additional Marker Settings
var MARKER_CUSTOM_ICON = input.string("", "Custom Marker Icon", group=MARKER_GROUP)
var MARKER_ROW = input.int(0, "Marker Row", minval=0, maxval=5, group=MARKER_GROUP)
var MARKER_COLOR_BAR_FILLED = input.bool(false, "Use Bar Filled Color", group=MARKER_GROUP)

// Additional Range Settings
var RANGE_SIZE = input.string(size.normal, "Range Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=RANGE_GROUP)
var RANGE_BG_HEIGHT = input.int(10, "Range Background Height", minval=1, maxval=50, group=RANGE_GROUP)
var RANGE_BG_PADDING = input.int(0, "Range Background Padding", minval=0, maxval=10, group=RANGE_GROUP)
var RANGE_TEXT_ROW = input.int(1, "Range Text Row", minval=0, maxval=5, group=RANGE_GROUP)
var RANGE_MARKER_ROW = input.int(0, "Range Marker Row", minval=0, maxval=5, group=RANGE_GROUP)

// Additional Average Settings
var AVG_BGCOLOR = input.color(color.new(#000000, 100), "Average Background Color", group=AVG_GROUP)
var AVG_SIZE = input.string(size.normal, "Average Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=AVG_GROUP)
var AVG_TEXT_ROW = input.int(1, "Average Text Row", minval=0, maxval=5, group=AVG_GROUP)
var AVG_MARKER_ROW = input.int(0, "Average Marker Row", minval=0, maxval=5, group=AVG_GROUP)

// Additional Trend Settings
var TREND_SIZE = input.string(size.normal, "Trend Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=TREND_GROUP)
var TREND_COLOR_BAR_FILLED = input.bool(false, "Use Bar Filled Color for Trend", group=TREND_GROUP)

// Additional Decoration Settings
var DECOR_WPADDING = input.int(0, "Decoration Width Padding", minval=0, maxval=10, group=DECOR_GROUP)

// Calculate source value
float src = switch SOURCE
    "RSI" => ta.rsi(close, LENGTH)
    "MOM" => ta.mom(close, LENGTH)
    "PRICE" => close
    => MANUAL_VALUE

// Create theme
var scale.theme theme = scale.theme.new(
     color_bg=COLOR_BG,
     color_bg_text=COLOR_BG_TEXT,
     color_text=COLOR_TEXT,
     color_bar_unfilled=COLOR_BAR_UNFILLED,
     color_bar_filled=COLOR_BAR_FILLED,
     gradient=USE_GRADIENT,
     color_gradient=COLOR_GRADIENT,
     gradient_last=GRADIENT_LAST,
     color_positive=COLOR_POSITIVE,
     color_negative=COLOR_NEGATIVE,
     color_neutral=COLOR_NEUTRAL
     )

// Initialize interface
var scale.interface ux = scale.getInterface()

if true
    setup = ux.setup("main_scale")
    
    setup.build(
     __theme=theme,
     _xOffset=SCALE_X,
     _y=SCALE_Y,
     _src=src,
     _minValue=SCALE_MIN,
     _maxValue=SCALE_MAX,
     _numBars=SCALE_BARS,
     _barWidth=SCALE_BAR_WIDTH,
     _barHeight=SCALE_BAR_HEIGHT,
     _spacing=SCALE_SPACING,
     _wpadding=SCALE_WPADDING,
     _hpadding=SCALE_HPADDING,
     _length=LENGTH,
     _pointOfView=SCALE_POINT_OF_VIEW,
     _lineStyle=SCALE_LINE_STYLE,
     _textLeft=TEXT_LEFT,
     _textRight=TEXT_RIGHT,
     _textTop=TEXT_TOP,
     _textBottom=TEXT_BOTTOM,
     _textSize=TEXT_SIZE,
     _textFontFamily=TEXT_FONT,
     _showSrc=SHOW_VALUE,
     _showMinMax=SHOW_MINMAX,
     _srcPosition=TEXT_POSITION,
     _textPadding=TEXT_PADDING,
     _precision=PRECISION,
     _row=TEXT_ROW,
     _dynamic=SCALE_DYNAMIC,
     _passthrougt=SCALE_PASSTHROUGT,
     _prefill=SCALE_PREFILL,
     _fixed=SCALE_FIXED
     )

    if USE_MARKER
        setup.addMarker(
         _icon=MARKER_ICON,
         _color=MARKER_COLOR,
         _bgcolor=MARKER_BGCOLOR,
         _location=MARKER_LOCATION,
         _size=MARKER_SIZE,
         _markerIconString=MARKER_CUSTOM_ICON,
         _row=MARKER_ROW,
         _anchorToScale=MARKER_ANCHOR,
         _colorBarFilled=MARKER_COLOR_BAR_FILLED
         )

    if USE_RANGE
        setup.addRange(
         _length=RANGE_LENGTH,
         _textIcon=RANGE_TEXT_ICON,
         _markerIcon=RANGE_MARKER_ICON,
         _textLocation=RANGE_TEXT_LOCATION,
         _markerLocation=RANGE_MARKER_LOCATION,
         _markerColor=RANGE_COLOR,
         _textColor=RANGE_COLOR,
         _textSize=RANGE_SIZE,
         _markerSize=RANGE_SIZE,
         _showText=RANGE_SHOW_TEXT,
         _showMarker=RANGE_SHOW_MARKER,
         _showBg=true,
         _bgColor=RANGE_BGCOLOR,
         _bgHeight=RANGE_BG_HEIGHT,
         _bgPadding=RANGE_BG_PADDING,
         _textRow=RANGE_TEXT_ROW,
         _markerRow=RANGE_MARKER_ROW
         )

    if USE_AVG
        setup.addAvg(
         _length=AVG_LENGTH,
         _textIcon=AVG_TEXT_ICON,
         _markerIcon=AVG_MARKER_ICON,
         _textPosition=AVG_TEXT_POSITION,
         _markerLocation=AVG_MARKER_LOCATION,
         _textColor=AVG_COLOR,
         _markerColor=AVG_COLOR,
         _bgcolor=AVG_BGCOLOR,
         _textSize=AVG_SIZE,
         _markerSize=AVG_SIZE,
         _showText=AVG_SHOW_TEXT,
         _showMarker=AVG_SHOW_MARKER,
         _textRow=AVG_TEXT_ROW,
         _markerRow=AVG_MARKER_ROW
         )

    if USE_TREND
        setup.addTrend(
         _icon=TREND_ICON,
         _length=TREND_LENGTH,
         _position=TREND_POSITION,
         _size=TREND_SIZE,
         _split=TREND_SPLIT,
         _live=TREND_LIVE,
         _colored=TREND_COLORED,
         _colorBarFilled=TREND_COLOR_BAR_FILLED
         )

    if USE_DECOR
        setup.addDecoration(
         _decor=DECOR_ICON,
         _color=DECOR_COLOR,
         _bgcolor=DECOR_BGCOLOR,
         _size=DECOR_SIZE,
         _wpadding=DECOR_WPADDING,
         _row=DECOR_ROW,
         _xcross=DECOR_XCROSS,
         _pingpong=DECOR_PINGPONG
         )

    if USE_LOADER
        setup.addLoader(
         _loaderIcon=LOADER_ICON,
         _color=LOADER_COLOR,
         _bgcolor=LOADER_BGCOLOR,
         _size=LOADER_SIZE,
         _position=LOADER_POSITION,
         _showTicks=LOADER_SHOW_TICKS,
         _colorBarFilled=LOADER_COLOR_BAR_FILLED,
         _row=LOADER_ROW,
         _reverse=LOADER_REVERSE
         )

    if USE_TIMER
        setup.addTimer(
         _position=TIMER_POSITION,
         _color=TIMER_COLOR,
         _size=TIMER_SIZE,
         _timerFormatString=TIMER_FORMAT,
         _outputFormat=TIMER_OUTPUT_FORMAT,
         _includeHours=TIMER_INCLUDE_HOURS,
         _showIcon=TIMER_SHOW_ICON,
         _row=TIMER_ROW
         )

    if USE_BADGE
        setup.addBadge(
         _text=BADGE_TEXT,
         _position=BADGE_POSITION,
         _color=BADGE_COLOR,
         _size=BADGE_SIZE,
         _bgcolor=BADGE_BGCOLOR,
         _row=BADGE_ROW
         )

    if USE_ALERT
        setup.addAlert(
         _target=ALERT_TARGET,
         _icon=ALERT_ICON,
         _type=ALERT_TYPE,
         _freq=ALERT_FREQ,
         _location=ALERT_LOCATION,
         _color=ALERT_COLOR,
         _size=ALERT_SIZE,
         _customAlertMessage=ALERT_MESSAGE
         )