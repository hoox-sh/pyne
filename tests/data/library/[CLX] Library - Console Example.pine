// ——— Console {
//
// @version=5
// @description This script is an example of how to use the Console library.
indicator("[CLX] Library Console - Examples")
// --
import cryptolinx/ConsoleDEV/9 as Console
// }

// ---------------------------------------------------------------------------------------------------------------------


//  ▪ ——— GLOBALS
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— Brackets {
//
// @variable    An empty string.
const string EMPTY      = ''
// @variable    A string with a single white space.
const string WS         = ' '
// @variable    A string with a single white space.
const string SWS        = ' '
// @variable    A block to use in color preview.
const string BL         = '▮'
// @variable    A pin icon.
const string PIN        = '🖈'
// @variable    Line Break.
const string BR         = '\n'
// @variable    Equal.
const string EQL        = '='
// @variable    Snippet #1.
const string SNP1       = WS + EQL + WS
// }

// ——— Defaults {
//
// @variable    Default background color opacity.
const int    BG_OPACITY = 90
// }
//  ▪ ——— EXAMPLES
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ——— Inputs {
//
const string    DOT         = '🔵' + SWS
// @variable    Holding the name `<string>` of the input group #1.
const string    GRP1        = DOT + 'DISPLAY'
// @variable    Holding the name `<string>` of the input group #2.
const string    GRP2        = DOT + 'LOGGING'
// @variable    Holding the name `<string>` of the input group #3.
const string    GRP3        = DOT + 'EXTRA'
// @variable    Holding the name `<string>` of the input group #4.
const string    GRP4        = DOT + 'THEME'
// @variable    Holding the name `<string>` of the input group #4.
const string    GRP5        = DOT + 'INDENTATION'
// --
// @variable    User input to control the output visibility.
simple bool     _SHOW       = input.bool(true, 'Show Logs', group = GRP1)
// @variable    User input to set the display mode ('all', 'chart', 'logs').
simple string   _DISPLAY    = input.string('all', 'Display', options = ['all', 'chart', 'logs'], group = GRP1)
// @variable    User input to set the position of the console.
simple string   _POSITION   = input.string(position.bottom_right, 'Position', options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = GRP1)
// @variable    User input to set the number of columns.
simple int      _COLUMNS    = input.int(1, 'Columns', step = 1, minval = 1, maxval = 5, group = GRP1)
// @variable    User input to set the number of rows.
simple int      _ROWS       = input.int(16, 'Rows', step = 1, minval = 1, maxval = 50, group = GRP1)
// @variable    User input to set the height of the console.
simple int      _HEIGHT     = input.int(48, 'Height', step = 1, minval = 1, maxval = 100, group = GRP1)
// @variable    User input to set the width of the console.
simple int      _WIDTH      = input.int(30, 'Width', step = 1, minval = 1, maxval = 100, group = GRP1)
// @variable    User input for the log offset.
simple int      _OFFSET     = -input.int(0, 'Log Offset', step = 1, minval = 0, tooltip = 'A (+/-) offset to move through the logs', group = GRP1)
// @variable    User input for the maximum number of logs.
simple int      _MAX        = input.int(1000, 'Max. Logs', step = 100, minval = 1, maxval = 10000, group = GRP1)
// @variable    User input for the log prefix.
simple string   _PREFIX     = input.string(EMPTY, 'Prefix', group = GRP1)
// --
// @variable    User input to show line numbers.
simple bool     _SHOW_NO    = input.bool(false, 'Show Line Number', group = GRP2)
// @variable    User input to enable hide on empty.
simple bool     _HIDE       = input.bool(false, 'Enable Hide On Empty', tooltip = 'If enabled the console gets hidden on empty logs.', group = GRP2)
// --
// @variable    User input to enable continuous mode (IP).
simple bool     _IP         = input.bool(false, 'Enable Continuous Mode (IP)', tooltip = 'Logging Types:\nstandard - per bar\nip (innercandle process) - per execution', group = GRP3)
// @variable    User input to enable continuous mode (IP).
simple bool     _BAR        = input.bool(false, 'Enable Infobar', tooltip = 'Logging Types:\nstandard - per bar\nip (innercandle process) - per execution', group = GRP3)
// @variable    User input for the infobar location.
simple string   _BAR_LOC    = input.string(location.top, 'Infobar Location', options = [location.top, location.bottom], tooltip = 'Valid Location:\nlocation.top | location.bottom', group = GRP3)
// @variable    User input to enable continuous mode (IP).
simple bool     _LOADER     = input.bool(false, 'Enable Infobar Loader', group = GRP3)
// --
// @variable    User input to show a theme example.
simple bool     _THEME      = input.bool(false, 'Show Theme Example', group = GRP4)
// @variable    User input for text size in the console.
simple string   _SIZE       = input.string(size.small, 'Text Size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = GRP4)
// @variable    User input to show a theme example.
simple bool     _indent      = input.bool(false, 'Enable Indentation', group = GRP5)
// @variable    User input to set the width of the console.
simple int      _TAB_SIZE   = input.int(4, 'Tab Size', step = 1, minval = 0, group = GRP5)
// }

// ——— Setup {
//
// Do not forget to import this library first by using `import Cryptolinx/Console/$VERSION as $ALIAS`.
// --

// @variable    A custom `<terminal>` theme.
Console.theme customTheme = Console.theme.new(
 color_text         = #c1a4f7,
 color_bg_table     = #04000a80
 )

// @variable    A new, initialized `<terminal>` object, recreated on every bar.
Console.terminal console = Console.terminal.new(
 log_position       = _POSITION, 
 height             = _HEIGHT,
 width              = _WIDTH,
 columns            = _COLUMNS,
 rows               = _ROWS,
 size               = _SIZE,
 display            = _DISPLAY,
 ip                 = _IP,
 hide_on_empty      = _HIDE,
 prefix             = _PREFIX,
 show_no            = _SHOW_NO,
 infobar            = _BAR,
 infobar_location   = _BAR_LOC,
 infobar_loader     = _LOADER,
 max_logs           = _MAX,
 tab_size           = _TAB_SIZE,
 indent             = _indent
 )
 .init(
 _THEME ? customTheme : na
 )

// @variable    Full Log Example: A new, initialized `<terminal>` object, created once on the first bar.
// var terminal console_full = terminal.new(log_position=position.bottom_left, prefix = '> ', show_no = true).init()
// }

// ———  Inline ✨ {
//
// @variable    An example array.
series array <float>    testArray = na
// @variable    A example label.
series label            testLabel = na
// --
if not _IP

    // On Variable declaration
    // --
    testArray := array.new<float>(3, .0)//.log_inline(console)
    testLabel := label.new(bar_index + 25, close, 'Test Label', style = label.style_label_center).log_inline(console)

    // On Built-In Variables
    // --
    color.orange.log_inline(console)
    color.blue.log_inline(console)
    label.all.log_inline(console, 'Label All')

    // It is also possible to log an expression or calculation by adding `().` ✨.
    // --
    // @variable    An example integer.
    series int a        = 100
    // @variable    The sum of an example calculation
    series int testCalc = (5 * 100).log_inline(console) + a.log_inline(console,'+') // SUM: 600

    // If you use inline logging on variables that get initialized by the `var` keyword,
    // your data will only get logged once on the first bar.
// }

// ——— Basic {
//
    console
     .hr('TOTAL', '=')
     .log('SUM', testCalc)
     .hr('My Arrays', ':')
     .log('My Array', testArray)
      .opt_lvl(1)
     .hr()
     .log(testLabel)
      .opt_lvl(4)
     .hr('Chart.Point')
     .log('Current', chart.point.now())
      .opt_textColor(color.aqua)
     .log('NEW! Sticky Notes!')
      .opt_sticky(1)
    // --
    console
     .log(#FF46A4)
     .log(color.blue)
     .log(color.orange)
     .log(matrix.new<float>(2, 2, 5))
    // --
    console
     .log('Bar State: Is Realtime')
      .opt_lvl(2)
      .opt_cond(barstate.isrealtime)
     // on bar replay
     .log('Bar State: Is History')
      .opt_cond(barstate.ishistory)
// --
else
    console
     .log('NEW! Sticky Notes!')
      .opt_sticky()
     .log('Close', close, 4)
// }

// ——— Finally {
//

console.show(_SHOW, _OFFSET) // The _show argument is true by default. Simply turn it on or off.
// } 

// ——— Cleaning {
//
testLabel.delete()
// }

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Initialize the console terminal
var Console.terminal c = Console.terminal.new(
 display       = 'all',             // Display logs on chart and native logs
 log_position  = position.bottom_left,
 columns       = 1,
 rows          = 15,
 width         = 30,
 height        = 30,
 prefix        = "LOG",
 show_no       = true,
 indent        = true,
 ip            = false
 )
 .init()

// Prepare some data to log
int          myInt = 42
float        myFloat = 3.1415926
bool         myBool = true
color        myColor = color.blue
string       myString = "Hello, Console!"
array<float> myArray = array.new<float>(1, 1.23)

// 1. Variant 1: console.log(data)
//    Use this variant when you have a data object or a simple value to log.
c
 .log(myInt)
 .log(myFloat)
 .log(myBool)
 .log(myColor)
 .log(myString)
 .log(myArray)

// 2. Variant 2: console.log(string _title, data)
//    Use this variant when you want to add a custom title or prefix to your log entry.
c
 .log("Integer Value", myInt)
 .log("Float Value", myFloat)
 .log("Boolean Value", myBool)
 .log("Color Value", myColor)
 .log("String Value", myString)
 .log("Array Value", myArray)

// 3. Variant 3: Inline logging with data.log_inline(console, string _title = '')
//    Use this variant when you want to log data inline, especially within expressions or function calls.
//    It returns the data, allowing it to be used immediately.
myInt := myInt + 1
myInt.log_inline(c, "Updated Integer")
// myFloat := myFloat * 2
// myFloat.log_inline(c, "Updated Float")
myBool := not myBool
myBool.log_inline(c, "Updated Boolean")
myColor := color.green
myColor.log_inline(c, "Updated Color")
myString := str.upper(myString)
myString.log_inline(c, "Updated String")
array.push(myArray, 4.56)
myArray.log_inline(c, "Updated Array")

// 4. Variant 4: Direct logging with data.log_direct(int _lvl = 1)
//    Use this variant when you want to log directly to the native Pine Script logs without using a console instance.
//    This is useful for quick debugging or when you don't need the console on the chart.
myInt.log_direct(1)      // Log level 1 (info)
myFloat.log_direct(2)    // Log level 2 (warning)
myBool.log_direct(3)     // Log level 3 (error)
myColor.log_direct()     // Default log level 1 (info)
myString.log_direct()
myArray.log_direct()

// Display the console
c.show()

