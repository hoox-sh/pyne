//@version=4

// Original Script > @DanWall
// Edit and Update to PineScript Version 4 > @jango_blockchained

//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] - Range Filter v3.124
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] - Range Filter v3.124",shorttitle="[IFLOST.io] Range Filter v3.124", overlay=true)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


// Source 
src = input(defval=close, title="Source")

// Sampling Period
per = input(defval=7, minval=1, title="Sampling Period")

// Range Multiplier
mult= input(defval=3.7, minval=0.1, title="Full Range Multiplier")

// Show Buy & Sell Signals
signals = input(defval=false, title="Show Buy & Sell Signals", type=input.bool)
useTargets = input(defval=false, title="Use High & Low Targets for Buy & Sell Signals", type=input.bool)
usePingPong = input(defval=false, title="Creat Ping Pong Signals", type=input.bool)
negativTrades = input(defval=false, title="No negativ trades", type=input.bool)
useInvert = input(defval=false, title="Invert Signals", type=input.bool)

bool invertSignal = useInvert
invertSignal := invertSignal[1]

// Accept Panic Sell
acceptPanicSell = input(defval=false, title="Accept Panic Sell", type=input.bool)
panicSell = input(defval=3.0, minval=0.0, title="Activate Panic Sell at %", type=input.float)

// Accept Panic Buy
acceptPanicBuy = input(defval=false, title="Accept Panic Buy", type=input.bool)
panicBuy = input(defval=3.0, minval=0.0, title="Activate Panic Buy at %", type=input.float)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D

//////////////////////////////////////////////////////////////////////////
// Functions
//////////////////////////////////////////////////////////////////////////


// Smooth Average Range
smoothrng(x, t, m)=> 
    wper      = (t*50) - 1
    avrng     = ema(abs(x - x[1]), t)
    smoothrng = ema(avrng, wper)*m
    smoothrng
smrng = smoothrng(src, per, mult)

// Range Filter
rngfilt(x, r)=>
    rngfilt  = x
    rngfilt := x > nz(rngfilt[1]) ? ((x - r) < nz(rngfilt[1]) ? nz(rngfilt[1]) : (x - r)) : ((x + r) > nz(rngfilt[1]) ? nz(rngfilt[1]) : (x + r))
    rngfilt
filt = rngfilt(src, smrng)

changeDirection(_invertSignal)=>
    inv = _invertSignal == true ? false : true
    inv
   
//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


// Filter Direction
upward   = 0.0
upward  := filt > filt[1] ? nz(upward[1]) + 1 : filt < filt[1] ? 0 : nz(upward[1])
downward = 0.0
downward := filt < filt[1] ? nz(downward[1]) + 1 : filt > filt[1] ? 0 : nz(downward[1])

// Target Bands
hband = filt + smrng
lband = filt - smrng

// ToDo: steigend (lime), fallend (red), seitwärs (orange), seitwärts im steigenden (green), seitwärts im fallenden (maroon)
filtcolor = upward > 0 ? clg : downward > 0 ? clr : cly
barcolor  = (src > filt) and (src > src[1]) and (upward > 0) ? clg : (src > filt) and (src < src[1]) and (upward > 0) ? cdg : 
   (src < filt) and (src < src[1]) and (downward > 0) ? clr : (src < filt) and (src > src[1]) and (downward > 0) ? cdr : cly

filtplot = plot(filt, color=filtcolor, linewidth=2, title="Range Filter", transp=0)

// Target
hbandplot = plot(hband, color=cbg, transp=50, title="High Target")
lbandplot = plot(lband, color=cbr, transp=50, title="Low Target")

// Fills
fill(hbandplot, filtplot, color=cbg, title="High Target Range")
fill(lbandplot, filtplot, color=cbr, title="Low Target Range")

// Bar Color
barcolor(barcolor)

// Break Outs
bool longCond = na
bool shortCond = na

longCond := ((src > filt) and (src > src[1]) and (upward > 0)) or ((src > filt) and (src < src[1]) and (upward > 0)) 
shortCond := ((src < filt) and (src < src[1]) and (downward > 0)) or ((src < filt) and (src > src[1]) and (downward > 0))

CondIni = 0
CondIni := longCond ? 1 : shortCond ? -1 : CondIni[1]
longCondition = longCond and CondIni[1] == -1
shortCondition = shortCond and CondIni[1] == 1



// Panic Condition
panicBuyCondition = false
panicSellCondition = false

var bool panicResellCondition = false
var bool panicRebuyCondition = false
var bool highTragetCondition = false
var bool lowTragetCondition = false

if(acceptPanicSell)
    panicDiff = 100 - (close / close[1] * 100)
    if(panicDiff >= panicSell)
        panicSellCondition := true
    else
        panicSellCondition := false
    if(panicSellCondition[1] == true)
        panicRebuyCondition := true
    else
        panicRebuyCondition := false

// Panic buy
if(acceptPanicBuy)
    panicDiff = (close / close[1] * 100) - 100
    if(panicDiff >= panicBuy)
        panicBuyCondition := 1

// High Low Targets
if(useTargets)
    shortCondition := close == hband ? true : false
    longCondition := close == lband ? true : false

// Last Condition
float lastCond = 0


// Last Price
float lastPrice = 0

// On Buy 
lastInvertValue = invertSignal[0]
if(negativTrades)
    invertSignal := longCondition and close >= lastPrice[1] ? true : shortCondition and close <= lastPrice[1] ? true : false


// Ping Pong 
if(invertSignal)
    memLong = longCondition
    memShort = shortCondition
    longCondition := memShort ? true : false
    shortCondition := memLong ? true : false
    

if(usePingPong)
    if(lastCond[1] == 1)
        longCondition := false
    if(lastCond[1] == -1)
        shortCondition := false

// Set Data
lastCond := longCondition ? 1 : shortCondition ? -1 : lastCond[1]
lastPrice := longCondition and invertSignal == false ? close : shortCondition and invertSignal == false ? close : lastPrice[1]




// Debugging
plot(longCondition ? 1: 0,title="Long Condition", linewidth=0, transp=100)
plot(shortCondition ? 1 : 0,title="Short Condition", linewidth=0, transp=100)
plot(lastCond,title="Last Condition", linewidth=0, transp=100)
plot(lastPrice,title="Last Price", linewidth=0, transp=100)
plot(invertSignal ? 1 : 0,title="Invert Signal", linewidth=0, transp=100)


//////////////////////////////////////////////////////////////////////////
// Alerts & Signals
//////////////////////////////////////////////////////////////////////////


// Signals
if(not signals)
    longCondition := false
    shortCondition := false

plot(longCondition == 1 ? 1 : shortCondition == 1 ? -1 : 0, title="Trade Manager Signal", linewidth=0, transp=100)

// Alerts
alertcondition(longCondition, title="Buy Alert", message = "BUY")
alertcondition(shortCondition, title="Sell Alert", message = "SELL")
alertcondition(panicSellCondition, title="Panic Sell Alert", message = "PANIC SELL - once per bar/minute") // once per bar or once per minute, oder so :D
alertcondition(panicBuyCondition, title="Panic Buy Alert", message = "PANIC Buy - once per bar/minute") // once per bar or once per minute, oder so :D
alertcondition(panicResellCondition, title="Panic Resell Alert", message = "PANIC ResELL - once per bar/minute") // once per bar or once per minute, oder so :D
alertcondition(panicRebuyCondition, title="Panic Rebuy Alert", message = "PANIC Rebuy - once per bar/minute") // once per bar or once per minute, oder so :D

// Plots
plotshape(longCondition, title = "Buy Signal", text = "B", textcolor = color.white, style=shape.labelup, size = size.normal, location=location.belowbar, color = clg, transp = 0)
plotshape(shortCondition, title = "Sell Signal", text ="S", textcolor = color.white, style=shape.labeldown, size = size.normal, location=location.abovebar, color = clr, transp = 0)
plotshape(panicSellCondition, title = "Panic Sell Signal", text ="PS", textcolor = clr, style=shape.labelup, size = size.small, location=location.bottom, color = color.black, transp = 0)
plotshape(panicBuyCondition, title = "Panic Buy Signal", text ="PB", textcolor = clg, style=shape.labelup, size = size.small, location=location.bottom, color = color.black, transp = 0)
plotshape(panicResellCondition, title = "Panic Resell Signal", text ="PRS", textcolor = clr, style=shape.labelup, size = size.small, location=location.bottom, color = color.black, transp = 0)
plotshape(panicRebuyCondition, title = "Panic Rebuy Signal", text ="PRB", textcolor = clg, style=shape.labelup, size = size.small, location=location.bottom, color = color.black, transp = 0)
