//@version=4

//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] MACD+ v1.101
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] MACD+ v1.101", shorttitle="[IFLOST.io] MACD+ v1.101", precision=8)


/////////////////////////////////////////////////////////////////////////                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   /
// Inputs
//////////////////////////////////////////////////////////////////////////


fast_length = input(title="Fast Length", type=input.integer, defval=12)
slow_length = input(title="Slow Length", type=input.integer, defval=26)
src = input(title="Source", type=input.source, defval=close)
signal_length = input(title="Signal Smoothing", type=input.integer, minval = 1, maxval = 50, defval = 9)
sma_source = input(title="Simple MA(Oscillator)", type=input.bool, defval=false)
sma_signal = input(title="Simple MA(Signal Line)", type=input.bool, defval=false)
sbs = input(type=input.bool, title="Show Buy & Sell Signals", defval=false)
scl = input(defval=false, title="Show Custom Entry Line", type=input.bool)
scl2 = input(defval=false, title="Show Custom Exit Line", type=input.bool)
clv = input(title="Custom Entry Line Value", type=input.float, defval=6.5, minval = 0.1, maxval = 40, step=0.1)
clv2 = input(title="Custom Exit Line Value", type=input.float, defval=6.5, minval = 0.1, maxval = 40, step=0.1)
scs = input(defval=false, title="Show Custom Signals", type=input.bool)
pf = input(title="Precision Multiplier", type=input.integer, minval = 1, maxval = 100000000, defval = 100000000)

//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #7b1fa2
cdr = #512da8	
cbr = #7e57c2

// Idle, Sideward
cly = #ffa726


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


fast_ma = sma_source ? sma(src, fast_length) : ema(src, fast_length)
slow_ma = sma_source ? sma(src, slow_length) : ema(src, slow_length)
macd = fast_ma - slow_ma
sig = sma_signal ? sma(macd, signal_length) : ema(macd, signal_length)
hist = macd - sig


//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


plot(hist, title="Histogram", style=plot.style_columns, color=(hist>=0 ? (hist[1] < hist ? clg : cdg) : (hist[1] < hist ? clr : cdr) ), transp=0 )
plot(macd, title="MACD", color=cly, transp=0)
plot(sig, title="Signal", color=clr, transp=0)

plot(scl ? clv : na, title="Custom Entry Line", style=plot.style_linebr, linewidth=1, color=cly, transp=50)
plot(scl2 ? (clv2*-1) : na, title="Custom Exit Line", style=plot.style_line, linewidth=1, color=cly, transp=50)
//////////////////////////////////////////////////////////////////////////
// Alerts & Signals for Trade Manager
//////////////////////////////////////////////////////////////////////////


// Signal plot to be used as external 
// if crossover, sends 1, otherwise sends -1 

macrossover = crossover(macd, sig) 
macrossunder = crossunder(macd, sig) 
signal = macrossover ? 1 : macrossunder ? -1 : na
alertcondition(sbs and signal == 1, title="MA Crossover Buy Alert", message = "BUY")
alertcondition(sbs and signal == -1, title="MA Crossunder Sell Alert", message = "SELL")
plot(signal, title="Trade Manager Signal", linewidth=0, transp=100)
bgcolor(sbs and signal == 1 ? clg : sbs and signal == -1 ? cdr : na, transp=55)

float crossCustomLine = na
crossCustomLine := crossCustomLine[1]
float lastSignal = na
lastSignal := lastSignal[1]
float customSignal = na
customSignal := customSignal[1]

crossCustomLine := hist*pf >= clv ? -1 : hist*pf <= (clv2*-1) ? 1 : 0
lastSignal := crossCustomLine == -1 ? -1 : crossCustomLine == 1 ? 1 : lastSignal[1]
customSignal := crossCustomLine == 1 and lastSignal[1] == -1 ? 1 : crossCustomLine == -1 and lastSignal[1] == 1 ? -1 : 0
// bgcolor(sbs and signal == 1 ? clg : sbs and signal == -1 ? clr : na, transp=40)
bgcolor(scs ? customSignal == 0 ? na : cly : na, transp=40)

alertcondition(scs ? customSignal == 1 ? true : false : false, title="Custom Buy Long Alert", message = "BUY")
alertcondition(scs ? customSignal == -1 ? true : false : false, title="Custom Sell Short Alert", message = "SELL")

plot(customSignal, title="Trade Manager Signal - Custom Signal", linewidth=0, transp=100)
plot(crossCustomLine, title="Trade Manager Signal - Cross Custom Line", linewidth=0, transp=100)

