StrategyName                    = "[SETUP-02-DEV][ST] Super Trend + Range Filter + ATR + Thereshold"
ShortStrategyName               = "[S02-DEV][ST] SR + RF + ATR + THS"

IndicatorName                   = "[SETUP-02-DEV][IN] Super Trend + Range Filter + ATR + Thereshold"
ShortIndicatorName              = "[S02-DEV][IN] SR + RF + ATR + THS"

TradeId                         = "[IFLO]"

InitialCapital                  = 5000
InitPosition                    = 98
CommissionValue                 = 0.075
CommissionType                  = strategy.commission.percent,
Pyramiding                      = 1
CalcOnorderFills                = true
CalcOnTick                      = true
DefaultQtyType                  = strategy.percent_of_equity
DefaultQtyValue                 = 100
Precision                       = 4
Overlay                         = true
Slippage                        = 1
Currency                        = currency.USD
Format                          = format.price


//////////////////////////////////////////////////////////////////////////
//-- [SETUP-02][ST] Super Range Thereshold Filter Trend
//////////////////////////////////////////////////////////////////////////


strategy(
 title                          = StrategyName,
 shorttitle                     = ShortStrategyName,
 overlay                        = Overlay, 
 pyramiding                     = Pyramiding, 
 default_qty_type               = DefaultQtyType, 
 default_qty_value              = DefaultQtyValue, 
 initial_capital                = InitialCapital, 
 commission_type                = CommissionType, 
 commission_value               = CommissionValue, 
 slippage                       = Slippage,
 currency                       = Currency,
 precision                      = Precision
 )


// study(
//  title = IndicatorName, 
//  shorttitle = ShortIndicatorName, 
//  overlay = Overlay,
//  precision = Precision
//  )


