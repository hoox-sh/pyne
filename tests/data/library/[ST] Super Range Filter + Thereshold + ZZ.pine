//-- DIVIDER LINE
string __DL = "▬▬▬▬▬▬▬"

//-- DATA SOURCE
float __INPUT                   = input(close, title="Data Input", type=input.source)

//-- BACKTEST PERIOD
bool __D1                       = input(false, type=input.bool, title=__DL+" BACKTEST PERIOD "+__DL)
int __DAYF                      = input(1, title="From Day", minval=1, maxval=31)
int __MONTHF                    = input(11, title="From Month", minval=1, maxval=12)
int __YEARF                     = input(2019, title="From Year", minval=2012)
int __DAYT                      = input(1, title="To Day", minval=1, maxval=31)
int __MONTHT                    = input(12, title="To Month", minval=1, maxval=12)
int __YEART                     = input(2020, title="To Year", minval=2019)

//-- TRAILING TP
bool __D3                       = input(false, type=input.bool, title=__DL+" TRAILING TP "+__DL)
bool __USE_TLG                  = input(true, type=input.bool, title="Use Trailing Take Profit?")
float __TLG_PERCENT             = input(2.0, title="Trailing Take Profit (%)",minval=0,step=0.1,type=input.float) * 0.01
bool  __USE_TLG_TRIGGER         = input(true, title="Use Trailing Take Profit Trigger Level?", type=input.bool)
float __TLG_PERCENT_TRIGGER     = input(4.0, title="Trailing Take Profit Trigger Level (%)",minval=0,step=0.1,type=input.float) * 0.01

//-- TRAILING SL
bool __D4                       = input(false, type=input.bool, title=__DL+" TRAILING SL "+__DL)
bool __USE_SL                   = input(false, "Use Trailing Stop Loss")
float __SL_PERCENT              = input(2.2,title="Trailing Stop Loss (%)", type=input.float, minval=0.0, step=0.1) * 0.01
bool __USE_SL_TRIGGER           = input(false, "Use Trailing Stop Loss Trigger Level?")
float __SL_PERCENT_TRIGGER      = input(4.0, "Trailing Stop Loss Trigger Level (%)",minval=0,step=0.1,type=input.float) * 0.01

//-- PRINTING
bool __D5                       = input(false, type=input.bool, title=__DL+" PRINTING "+__DL)
bool __PRINT_BARCOLOR           = input(true, type=input.bool, title="Print Barcolor?")
bool __PRINT_LASTPRICE          = input(true, type=input.bool, title="Print Last Price Line?")
bool __PRINT_ALL_COND           = input(false, type=input.bool, title="Print all possible Conditions?")
bool __PRINT_TLG                = input(false, type=input.bool, title="Print Trailing Take Profit?")
bool __PRINT_TLG_TRIGGER        = input(false, type=input.bool, title="Print Trailing Take Profit Trigger Level?")
bool __PRINT_SL                 = input(false, type=input.bool, title="Print Trailing Stop Loss?")
bool __PRINT_SL_TRIGGER         = input(false, type=input.bool, title="Print Trailing Stop Loss Trigger Level?")
bool __PRINT_ES                 = input(false, type=input.bool, title="Print External Signal?")
bool __PRINT_TH                 = input(false, type=input.bool, title="Print Thereshold?")
bool __PRINT_ZZ                 = input(false, type=input.bool, title="Print ZigZag?")
bool __DEBUGG                   = input(true, type=input.bool, title="Debugging?")

//-- PREFERENCES
bool __D6                       = input(false, type=input.bool, title=__DL+" PREFERENCES "+__DL)


