__SRC                           = close

var int __STARTF                = timestamp(__YEARF, __MONTHF, __DAYF, 00, 00)
var int __FINISHT               = timestamp(__YEART, __MONTHT, __DAYT, 23, 59)

var bool __LONG                 = false
var bool __SHORT                = false

var bool __CLOSE_LONG           = na
var bool __CLOSE_SHORT          = na

var float __LAST_CONDITION      = na
var float __LAST_PRICE          = na

var float __TREND               = 0.0

var int __SINCE_BUY             = na
var int __SINCE_SELL            = na

var bool __TREND_BUY            = na
var bool __TREND_SELL           = na
var bool __TREND_CHANGE         = na

var bool __TLG_TRIGGER_LONG_HIT = false
var bool __TLG_TRIGGER_SHORT_HIT= false

var bool __SL_TRIGGER_LONG_HIT  = false
var bool __SL_TRIGGER_SHORT_HIT = false

var bool __COND_LONG_TLG_HIT    = false
var bool __COND_SHORT_TLG_HIT   = false

var bool __COND_LONG_SL_HIT     = false
var bool __COND_SHORT_SL_HIT    = false

var bool __COND_LONG_RSI_HIT    = false
var bool __COND_SHORT_RSI_HIT   = false

var float __LONG_TRAIL_TP       = 0.0
var float __SHORT_TRAIL_TP      = 0.0

var float __LONG_TRAIL_SL       = 0.0
var float __SHORT_TRAIL_SL      = 0.0

var float __TP_TRIGGER_PRICE    = 0.0
var float __SL_TRIGGER_PRICE    = 0.0

var int __OUTPUT                = 0


//////////////////////////////////////////////////////////////////////////
//-- SETUP: COLORS
//////////////////////////////////////////////////////////////////////////


//--__buy, Upward
color col_green_1               = color.new(#4EF9FF,0) //*
color col_green_1_90            = color.new(#4EF9FF,90)
color col_green_2               = color.new(#3CADB1,0)
color col_green_3               = color.new(#26c6da,0)  
color col_green_4               = color.new(#afff00,0)
color col_green_5               = color.new(#CFD80E,0)
color col_green_6               = color.new(#90c818,0)

//-- __sell, Downward
color col_red_1                 = color.new(#7b1fa2,0) //*
color col_red_1_90              = color.new(#7b1fa2,90) //*
color col_red_2                 = color.new(#7e57c2,0)
color col_red_3                 = color.new(#512da8,0)
color col_red_4                 = color.new(#7300de,0)
color col_red_5                 = color.new(#4a148c,0)  
color col_red_6                 = color.new(#2d2456,0)

//-- Idle, Sideward
color col_yellow_1              = color.new(#ffa726,0)
color col_yellow_2              = color.new(#f57c00,0)

color col_light_1               = color.new(#FFFFFF,0)
color col_light_1_50            = color.new(#FFFFFF,50)

color col_dark_1                = color.new(#000000,0)
color col_dark_1_50             = color.new(#000000,50)


//////////////////////////////////////////////////////////////////////////
//-- SETUP: FUNCTIONS
//////////////////////////////////////////////////////////////////////////
//
// Setup funuctions beginning with a "f_" 
// Setup intern function variables beginning with a underscore "_var"
// Setup extern function variables "var"
// Corresponding to the Setup variables __LONG and __SHORT, the buy and sell function beginning with double underscore followed by UPERCASE letters
//
// !!! Variables and functions shares the same namespace !!!
//
//////////////////////////////////////////////////////////////////////////


//
//-- MATH FUNCTIONS
//

//-- Phi
//@return           float
f_phi() =>
    float _phi = 0.5 + sqrt(1.25)
    _phi

//-- Fibonacci Numbers
//@return           float
f_fib(_step) =>
    float _phi = 1.618
    float _n_phi = 1/_phi
    int _r = round(abs(_step >= 0 ? pow(_phi, _step) / sqrt(5.0) : pow(-_n_phi, _step) / sqrt(5)))
    _r

//-- Bool to integer
//-- @return        integer
f_b2n(_b) =>
    int _r = _b ? 1 : 0
    _r

//-- Date and start filter
//-- @return        bool
f_window() =>
    bool _r = time >= __STARTF and time <= __FINISHT ? true : false
    _r

//-- Rounding Levels to min ticks
//-- @return        float
f_nround(_x) => 
    float _r = round(_x / syminfo.mintick) * syminfo.mintick
    _r

//-- Draw info panel
//-- @return        label
f_draw_infopanel(_x, _y, _line, _text, _color) =>
    _rep_text = ""
    for _l = 0 to _line
        _rep_text := _rep_text + "\n"
    _rep_text := _rep_text + _text
    var label _la = na
    label.delete(_la)
    _la := label.new(
         x=_x, y=_y, 
         text=_rep_text, xloc=xloc.bar_time, yloc=yloc.price, 
         color=color.yellow, style=label.style_none, textcolor=_color, size=size.large)

//
//-- MAIN FUNCTIONS
//

//-- @return        bool
_LONG() =>
    bool _r = (__LONG or __CLOSE_SHORT) and __LAST_CONDITION[1] != 1 and f_window() == true
    _r

//-- @return        bool
_LONG_ONLY() =>
    bool _r = __LONG and __LAST_CONDITION[1] != 1 and f_window() == true
    _r

//-- @return        bool
_CLOSE_LONG_ONLY() =>
    bool _r = __CLOSE_LONG and __LAST_CONDITION[1] != -1 and f_window() == true
    _r

//-- @return        bool
_SHORT() =>
    bool _r = (__SHORT or __CLOSE_LONG) and __LAST_CONDITION[1] != -1 and f_window() == true
    _r

//-- @return        bool
_SHORT_ONLY() =>
    bool _r = __SHORT and __LAST_CONDITION[1] != -1 and f_window() == true
    _r

//-- @return        bool
_CLOSE_SHORT_ONLY() =>
    bool _r = __CLOSE_SHORT and __LAST_CONDITION[1] != 1 and f_window() == true
    _r

//-- @return        bool
_TP_LONG() =>
    bool _r = __COND_LONG_TLG_HIT and f_window() == true
    _r

//-- @return        bool
_TP_SHORT() =>
    bool _r = __COND_SHORT_TLG_HIT and f_window() == true
    _r

//-- @return        bool
_SL_LONG() =>
    bool _r = __COND_LONG_SL_HIT and f_window() == true
    _r

//-- @return        bool
_SL_SHORT() =>
    bool _r = __COND_SHORT_SL_HIT and f_window() == true
    _r

//-- @return        bool 
_RSI_LONG() =>
    bool _r = __COND_LONG_RSI_HIT and f_window() == true
    _r

//-- @return        bool
_RSI_SHORT() =>
    bool _r = __COND_SHORT_RSI_HIT and f_window() == true
    _r


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: DONCHAIN CHANNEL + PIVOT POINTS + ZIGZAG LINES + DIAVATION
//////////////////////////////////////////////////////////////////////////


//
//-- INPUTS
//

bool i_zz_dl_1                  = input(false, title=__DL+"ZigZag"+__DL, type=input.bool)
int i_zz_tf                     = input(1440, title="Zig Zag: Higher Timeframe", type=input.integer)
// i_zz_plot_style                 = input("ZigZag", options=["ZigZag","Screener"], title="ZigZag: Plot Style")
float i_zz_st_mult              = input(0.1, title='ZigZag: Trend Multiplier', minval=0, maxval=100, step=0.01)
int i_zz_st_period              = input(10, title='ZigZag: Trend Period', minval=1) 
float i_zz_percent1             = input(title="ZigZag: Diavation %", defval=2, minval=0.001, maxval=20, step=0.001, type=input.float)

bool i_zz_dl_2                  = input(false, title=__DL+"Donchian"+__DL, type=input.bool)
int i_zz_length                 = input(20, title="Donchian: Length", type=input.integer)
int i_zz_tPeriods               = input(30, title="Donchian: Period", type=input.integer)

bool i_zz_dl_3                  = input(false, title=__DL+"Pivot"+__DL, type=input.bool)
bool i_zz_disp_panels           = input(true, title="Pivot: Display high/low info panels?")
int i_zz_fibs_label_off         = input(5, title="Pivot: High/Low label offset")
i_zz_fibs_label_size            = input(size.normal, options=[size.tiny, size.small, size.normal, size.large, size.huge], title="Pivot: Label size")


//
//-- VARIABLES
//

var int i_zz_last_cond          = 0
var int i_zz_signal             = 0

//
//-- FUNCTIONS
//

//-- DONCHIAN CHANNEL
donchian(_len) =>
    float _r = avg(lowest(_len), highest(_len))
    _r

//
//-- CALCULATION
//

int i_zz_mult                   = 2
float i_zz_dev                  = i_zz_mult * stdev(__SRC, i_zz_length)
float i_zz_upper                = highest(high, i_zz_length)[1]
float i_zz_lower                = lowest(low, i_zz_length)[1]
float i_zz_basis                = (i_zz_upper + i_zz_lower) / 2

int i_zz_per                    = timeframe.isintraday and timeframe.multiplier >= 1 ? 
 i_zz_tf / timeframe.multiplier * 7 : 
 timeframe.isintraday and timeframe.multiplier < 60 ? 
 60 / timeframe.multiplier * 24 * 7 : 7

i_zz_tper                       = donchian(i_zz_tPeriods)

//-- CHANNEL
i_zz_hb                         = highest(high, i_zz_per)  //High Border
i_zz_lb                         = lowest(low, i_zz_per)  //Low Border
i_zz_dist                       = i_zz_hb - i_zz_lb  //range of the channel 
i_zz_med                        = (i_zz_hb + i_zz_lb) / 2  //median of the channel

i_zz_hf                         = i_zz_hb - i_zz_dist * 0.236  //Highest Fib
i_zz_chf                        = i_zz_hb - i_zz_dist * 0.382  //Center High Fib
i_zz_clf                        = i_zz_hb - i_zz_dist * 0.618  //Center Low Fib
i_zz_lf                         = i_zz_hb - i_zz_dist * 0.764  //Lowest Fib

i_zz_r1_x                       = timenow + round(change(time) * i_zz_fibs_label_off)
i_zz_r1_y                       = i_zz_hb
i_zz_text1                      = "High : " + tostring(f_nround(i_zz_hb))
i_zz_s1_y                       = i_zz_lb
i_zz_text3                      = "Low : " + tostring(f_nround(i_zz_lb))

i_zz_posx                       = timenow + round(change(time) * 10)
i_zz_posy                       = highest(30)

i_zz_up_lev                     = close - (i_zz_st_mult * atr(i_zz_st_period))
i_zz_dn_lev                     = close + (i_zz_st_mult * atr(i_zz_st_period))

i_zz_percent                    = i_zz_percent1 * 0.01

i_zz_hh                         = 0.00  //Highest High
i_zz_hh                        := nz(i_zz_hh[1])
i_zz_hhh                        = 0.000
i_zz_hhh                       := nz(i_zz_hhh[1])

i_zz_ll                         = 0.00  //Lowest Low
i_zz_ll                        := nz(i_zz_ll[1])
i_zz_lll                        = 0.000
i_zz_lll                       := nz(i_zz_lll[1])

i_zz_count                      = 0
i_zz_count                     := nz(i_zz_count[1]) + 1

i_zz_trend                      = 0
i_zz_trend                     := nz(i_zz_trend[1])
i_zz_nimo                       = i_zz_dn_lev
i_zz_ximo                       =i_zz_up_lev

if(barstate.isfirst)

    i_zz_count                 := 0
    i_zz_ll                    := i_zz_nimo                     //Lowest low 
    i_zz_hh                    := i_zz_ximo                     //Highest high                        
    i_zz_lll                   := low                           //Lowest low low
    i_zz_hhh                   := high                          //Highest high high 
    i_zz_hhh

if(i_zz_count == 1)

    if(i_zz_ximo >= i_zz_hh[1])

        i_zz_hh                := i_zz_ximo
        i_zz_hhh               := high
        i_zz_trend             := 1                             //up
        i_zz_trend

    else

        i_zz_ll                := i_zz_nimo
        i_zz_lll               := low
        i_zz_trend             := -1                            //down
        i_zz_trend

if(i_zz_count > 1)

    if(i_zz_trend[1] > 0)                                       //if(trend up

        i_zz_hhh               := max(i_zz_hhh[1], high)
        
        if(i_zz_ximo >= i_zz_hh[1])                                   //if(High greater or equal to Highest high

            i_zz_hh            := i_zz_ximo
            i_zz_hh

        else
                                                                //else (High is smaller than Highest high)
            if(i_zz_nimo < i_zz_hh[1] - i_zz_hh[1] * i_zz_percent)
                i_zz_ll        := i_zz_nimo                     //Lowest low = low
                i_zz_lll       := low
                i_zz_trend     := -1                            //i_zz_trend down
                i_zz_trend

    else
        //else (i_zz_trend down)
        i_zz_lll               := min(i_zz_lll[1], low)

        if(i_zz_nimo <= i_zz_ll[1])  //if(Low smaller or equal to Lowest low

            i_zz_ll            := i_zz_nimo  //Lowest low = low 
            i_zz_ll

        else
            //else (Low is greater than Lowest low)
            if(i_zz_ximo > i_zz_ll[1] + i_zz_ll[1] * i_zz_percent)  //if(high > Lowest low + Lowest low * Percent

                i_zz_hh        := i_zz_ximo  //Highest high = high
                i_zz_hhh       := high
                i_zz_trend     := 1  //i_zz_trend up
                i_zz_trend

i_zz_pt                         = i_zz_trend > i_zz_trend[1] ? 1 : i_zz_trend < i_zz_trend[1] ? -1 : 0  //Change in i_zz_trend
i_zz_vor                        = i_zz_trend == 1 ? i_zz_hh : i_zz_trend == -1 ? i_zz_ll : na
i_zz_vor1                       = i_zz_pt == 1 ? i_zz_ll : i_zz_pt == -1 ? i_zz_hh : na

//
//-- CONDITION
//

i_zz_long                       = i_zz_trend == 1 and i_zz_trend[1] == -1 
i_zz_short                      = i_zz_trend == -1 and i_zz_trend[1] == 1 

i_zz_last_long                  = 0.0
i_zz_last_short                 = 0.0
i_zz_last_long                 := i_zz_long ? time : nz(i_zz_last_long[1])
i_zz_last_short                := i_zz_short ? time : nz(i_zz_last_short[1])

long_i_zz_signal                = crossover(i_zz_last_long, i_zz_last_short)
short_i_zz_signal               = crossover(i_zz_last_short, i_zz_last_long)

i_zz_signal                    := long_i_zz_signal ? 1 : short_i_zz_signal ? -1 : 0
i_zz_last_cond                 := i_zz_last_cond[1] != i_zz_signal ? i_zz_signal : i_zz_last_cond[1]

//
//-- PAINTING
//

i_zz_meanp                      = plot(__PRINT_ZZ ? i_zz_med : na, title="Fib Mean Line ", color=col_light_1, transp=85)  
i_zz_bsign                      = plot(__PRINT_ZZ ? i_zz_hb : na, title="Fib. Upper Line", color=col_green_1, transp=75, linewidth=1)  
i_zz_ssign                      = plot(__PRINT_ZZ ? i_zz_lb : na, title="Fib. Lower Line", color=col_red_1, transp=75, linewidth=1)  
i_zz_hf1                        = plot(__PRINT_ZZ ? i_zz_hf : na, title="i_zz_upper fib ", color=col_yellow_1, transp=75, linewidth=1)  
i_zz_chf1                       = plot(__PRINT_ZZ ? i_zz_chf : na, title="center high fib", color=col_yellow_2, transp=85, linewidth=1) 
i_zz_clf1                       = plot(__PRINT_ZZ ? i_zz_clf : na, title="center low fib ", color=col_yellow_2, transp=85, linewidth=1)  
i_zz_lf1                        = plot(__PRINT_ZZ ? i_zz_lf : na, title="low fib", color=col_yellow_1, transp=75, linewidth=1) 

fill(i_zz_bsign, i_zz_hf1, title="i_zz_upper ", color=col_green_1_90)  
fill(i_zz_ssign, i_zz_lf1, title="i_zz_lower", color=col_red_1_90) 

i_zz_R1_label                   = __PRINT_ZZ and i_zz_disp_panels ? label.new(x=i_zz_r1_x, y=i_zz_r1_y, text=i_zz_text1, xloc=xloc.bar_time, yloc=yloc.price, color=col_red_6, style=label.style_labeldown, textcolor=col_light_1, size=i_zz_fibs_label_size) : na
i_zz_S1_label                   = __PRINT_ZZ and i_zz_disp_panels ? label.new(x=i_zz_r1_x, y=i_zz_s1_y, text=i_zz_text3, xloc=xloc.bar_time, yloc=yloc.price, color=col_red_6, style=label.style_labelup, textcolor=col_light_1, size=i_zz_fibs_label_size) : na

label.delete(i_zz_R1_label[1])
label.delete(i_zz_S1_label[1])

if(__PRINT_ZZ and i_zz_disp_panels)
    f_draw_infopanel(i_zz_posx, i_zz_posy, 0, close[1] > i_zz_basis ? "UP" : "DOWN", close[1] > i_zz_basis ? col_green_1 : col_red_1)

plot(__PRINT_ZZ ? i_zz_vor : na, color=i_zz_trend == 1 ? col_green_1 : col_red_5, style=plot.style_circles, linewidth=1, title="zigi", transp=0, join=true)
plot(__PRINT_ZZ ? i_zz_vor1 : na, color=i_zz_trend == 1 ? col_red_1 : col_green_1, style=plot.style_line, linewidth=1, title="zigzag", transp=0, join=true, offset=-1)

plotshape(__PRINT_ZZ ? long_i_zz_signal : na, style=shape.triangleup, size=size.normal, location=location.belowbar, color=col_green_1)
plotshape(__PRINT_ZZ ? short_i_zz_signal : na, style=shape.triangledown, size=size.normal, location=location.abovebar, color=col_red_5)

plot(__PRINT_ZZ ? i_zz_last_cond : na, title="OUTPUT - External i_zz_signal")


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: RELATIVE STRENGHT INDEX
//////////////////////////////////////////////////////////////////////////


//
//-- INPUTS
//

bool i_rsi_description          = input(false, type=input.bool, title="----- RSI")
bool i_rsi_activ                = input(true, type=input.bool, title="RSI: Extra entry and exit condition?")
bool i_rsi_print_bg             = input(true, type=input.bool, title="RSI: Show colored background over/under levels?")

int i_rsi_lenght                = input(14, type=input.integer,title="RSI: Lenght")
int i_rsi_overbought            = input(90, type=input.integer,title="RSI: Overbought Level")
int i_rsi_oversold              = input(10, type=input.integer,title="RSI: Oversold Level")

//
//-- VARIABLES
//

var float i_rsi                 = 0.0

//
//-- CALCULATION
//

i_rsi                          := rsi(__SRC, i_rsi_lenght)

//
//-- COLOR & PAINTING
//

bgcolor(i_rsi_activ and i_rsi_print_bg ? i_rsi <= i_rsi_oversold ? col_green_1_90 : i_rsi >= i_rsi_overbought ? col_red_1_90 : na : na)


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: RANGE FILTER
//////////////////////////////////////////////////////////////////////////


//
//-- RF: INPUTS
//

// Show visualisation
bool i_rf_print                 = input(defval = false, type=input.bool, title="----- Range Filter")

// Sampling Period 17,12
int i_rf_per                    = input(defval = 12, minval = 1, type=input.integer, title = "Range Filter: Period")

// Range Multiplier
float i_rf_mult                 = input(defval = 2.2, minval = 0, type=input.float, step=0.01, title = "Range Filter: Range Multiplier")

// Thereshold - The higher the threshold, the earlier or the later it crossover or crossunder the Super Trend line.
float i_rf_thl                  = input(title = "Range Filter: Thereshold Long", type = input.float, defval = 0.017, step = 0.0001)
float i_rf_ths                  = input(title = "Range Filter: Thereshold Short", type = input.float, defval = -0.0045, step = 0.0001)

// Thereshold Minimizer
bool i_rf_min_th                = input(defval = false, type=input.bool, title = "Range Filter: Minimize Thereshold")
float i_rf_min_th_factor        = input(defval = 0.9998, type=input.float, minval = 0.05, step=0.0001, title = "Range Filter: Minimize Factor")

bool i_rf_rsi                   = input(false, type=input.bool, title = "Range Filter: Multiply Thereshold by RSI/100")

//
//-- RF: VARIABLES
//

var float i_rf_upward           = 0.0
var float i_rf_downward         = 0.0
var float i_rf_min_th_score     = 1.0

//
//-- RF: FUNCTIONS
//

// Smooth Average Range
i_smoothrng(_x, _t, _m) =>
    wper                        = _t / 3 - 1
    avrng                       = sma(abs(_x - _x[1]), _t)
    smoothrng                   = sma(avrng, wper) * _m
    smoothrng

// Range Filter
i_rngfilt(_x, _r) =>
    rngfilt                     = _x
    rngfilt                    := _x > nz(rngfilt[1]) ? _x - _r < nz(rngfilt[1]) ? nz(rngfilt[1]) : _x - _r : _x + _r > nz(rngfilt[1]) ? nz(rngfilt[1]) : _x + _r
    rngfilt

//
//-- RF: CALCULATION
//

// Smoothrange
float i_rf_smrng                = i_smoothrng(__SRC, i_rf_per, i_rf_mult)

// Range Filter
float i_rf_filt                 = i_rngfilt(__SRC, i_rf_smrng)

// Filter Direction
float i_rf_hband                = i_rf_filt + i_rf_smrng 
float i_rf_lband                = i_rf_filt - i_rf_smrng

float i_rf_filt_scored_th       = i_rf_min_th ? nz(i_rf_min_th_score[1]) : 1

float i_rf_filt_thl             = i_rf_rsi ? ((i_rf_filt * i_rf_thl) - (i_rf_filt * i_rf_thl * (i_rsi / 50))) + i_rf_filt : (i_rf_filt * i_rf_thl * i_rf_filt_scored_th) + i_rf_filt
float i_rf_filt_ths             = i_rf_rsi ? ((i_rf_filt * i_rf_ths) - (i_rf_filt * i_rf_ths * (100 - i_rsi / 100))) + i_rf_filt : (i_rf_filt * i_rf_ths * i_rf_filt_scored_th) + i_rf_filt 

i_rf_upward                    := i_rf_filt > i_rf_filt[1] ? nz(i_rf_upward[1]) + 1 : i_rf_filt < i_rf_filt[1] ? 0 : nz(i_rf_upward[1])
i_rf_downward                  := i_rf_filt < i_rf_filt[1] ? nz(i_rf_downward[1]) + 1 : i_rf_filt > i_rf_filt[1] ? 0 : nz(i_rf_downward[1])

//
//-- RF: COLORS & PLOTS
//

// Colors
color i_rf_filtcolor            = i_rf_upward > 0 ? col_green_4 : i_rf_downward > 0 ? col_red_5 : color.white
color i_rf_barcolor             = (__SRC > i_rf_filt) and (__SRC > __SRC[1]) and (i_rf_upward > 0) ? col_green_1 : (__SRC > i_rf_filt) and (__SRC < __SRC[1]) and (i_rf_upward > 0) ? col_green_5 : (__SRC < i_rf_filt) and (__SRC < __SRC[1]) and (i_rf_downward > 0) ? col_red_5 : (__SRC < i_rf_filt) and (__SRC > __SRC[1]) and (i_rf_downward > 0) ? col_red_2 : col_yellow_1

// Range Filter
i_rf_filt_p                     = plot(i_rf_print ? i_rf_filt : na, color=i_rf_filtcolor, linewidth=2, title="RF: Range Filter")

// Target
i_rf_hband_p                    = plot(i_rf_print ? i_rf_hband : na, color=col_green_2, transp=50, title="RF: High Target")
i_rf_lband_p                    = plot(i_rf_print ? i_rf_lband : na, color=col_red_3, transp=50, title="RF: Low Target")

// Fills
fill(i_rf_hband_p, i_rf_filt_p, color=col_green_2, title="RF: High Target Range")
fill(i_rf_lband_p, i_rf_filt_p, color=col_red_3, title="RF: Low Target Range")

// Bar Color
barcolor(__PRINT_BARCOLOR ? i_rf_barcolor : na)


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: SUPERTREND
//////////////////////////////////////////////////////////////////////////


//
//-- ST: INPUTS
//

i_st_vis_activ                  = input(false, title="----- Super Trend ATR", type=input.bool)
i_st_factor                     = input(4, minval = 1, maxval = 100, type=input.float,step=0.01,title="Super Trend: Factor")
i_st_period                     = input(6, minval = 1, maxval = 100, type=input.integer,title="Super Trend: Period")


//
//-- ST: FUNCTIONS
//

i_supertrend(_factor, _period) =>

    var float   _trendup        = 0.0
    var float   _trenddown      = 0.0
    var float   _trend          = 0.0

    _up                         = hl2 - _factor * atr(_period)
    _down                       = hl2 + _factor * atr(_period)

    _trendup                   := __SRC[1] > _trendup[1] ? max(_up, _trendup[1]) : _up
    _trenddown                 := __SRC[1] < _trenddown[1] ? min(_down, _trenddown[1]) : _down

    _trend                     := __SRC > _trenddown[1] ? 1 : __SRC < _trendup[1] ? -1 : nz(_trend[1], 1)
    _supertrend                 = _trend == 1 ? _trendup : _trenddown

    [_trend, _supertrend]

//
//-- ST: CALCULATION
//

[i_st_trend, i_st_supertrend]   = i_supertrend(i_st_factor,i_st_period)

//
//-- ST: COLORS & PLOTS
//

i_st_linecolor                  = i_st_trend == 1 ? col_green_3 : col_yellow_2

plot(i_st_vis_activ ? i_st_supertrend : na, color = i_st_linecolor, style = plot.style_line, linewidth = 2, title = "ST: SuperTrend")


//////////////////////////////////////////////////////////////////////////
//-- CONDITIONS
//////////////////////////////////////////////////////////////////////////


__LONG                         := crossunder(i_st_supertrend, i_rf_filt_thl)
__SHORT                        := crossover(i_st_supertrend, i_rf_filt_ths)


//////////////////////////////////////////////////////////////////////////
//-- AFTER CONDITIONS
//////////////////////////////////////////////////////////////////////////


i_rf_min_th_score              := _LONG() or _SHORT() ? 1 : (i_rf_min_th_score[1] * i_rf_min_th_factor)

//
//-- SAVE INFORMATION
//

// trend states
__SINCE_BUY                    := barssince(_LONG())
__SINCE_SELL                   := barssince(_SHORT())

__TREND_BUY                    := __SINCE_SELL > __SINCE_BUY
__TREND_SELL                   := __SINCE_SELL < __SINCE_BUY 
__TREND_CHANGE                 := (__TREND_BUY and __TREND_SELL[1]) or (__TREND_SELL and __TREND_BUY[1])


//////////////////////////////////////////////////////////////////////////
//-- SETUP: TRAILING TAKE PROFIT
//////////////////////////////////////////////////////////////////////////


__TP_TRIGGER_PRICE             := if(__USE_TLG_TRIGGER)
    if(__TREND_BUY)
        __LAST_PRICE[1] * (1 + __TLG_PERCENT_TRIGGER) 
    else
        __LAST_PRICE[1] * (1 - __TLG_PERCENT_TRIGGER)
else
    -1

__TLG_TRIGGER_LONG_HIT         := __USE_TLG and __USE_TLG_TRIGGER and __TREND_BUY and close >= __TP_TRIGGER_PRICE ? true : __TLG_TRIGGER_LONG_HIT[1]
__TLG_TRIGGER_SHORT_HIT        := __USE_TLG and __USE_TLG_TRIGGER and __TREND_SELL and close <= __TP_TRIGGER_PRICE ? true : __TLG_TRIGGER_SHORT_HIT[1]

display_long_TLG_trigger        = __USE_TLG and __TREND_BUY  and __TLG_TRIGGER_LONG_HIT == false and __TP_TRIGGER_PRICE != -1
display_short_TLG_trigger       = __USE_TLG and __TREND_SELL and __TLG_TRIGGER_SHORT_HIT == false and __TP_TRIGGER_PRICE != -1
display_TLG_trigger             = display_long_TLG_trigger or display_short_TLG_trigger

// Start trailing once trigger is reached
__LONG_TRAIL_TP                := if(__USE_TLG and __TREND_BUY )
    tpValue = high * (1 - __TLG_PERCENT)
    max(tpValue, __LONG_TRAIL_TP[1])
else
    0

__SHORT_TRAIL_TP               := if(__USE_TLG and __TREND_SELL)
    tpValue = low * (1 + __TLG_PERCENT)
    min(tpValue, __SHORT_TRAIL_TP[1])
else
    999999


//////////////////////////////////////////////////////////////////////////
//-- SETUP: TRAILING STOP LOSS
//////////////////////////////////////////////////////////////////////////


__SL_TRIGGER_PRICE             := if(__USE_SL_TRIGGER)
    if(__TREND_BUY)
        __LAST_PRICE[1] * (1 - __SL_PERCENT_TRIGGER) 
    else
        __LAST_PRICE[1] * (1 + __SL_PERCENT_TRIGGER)
else
    -1

__SL_TRIGGER_LONG_HIT          := __USE_SL and __USE_SL_TRIGGER and __TREND_BUY and close <= __SL_TRIGGER_PRICE ? true : __SL_TRIGGER_LONG_HIT[1]
__SL_TRIGGER_SHORT_HIT         := __USE_SL and __USE_SL_TRIGGER and __TREND_SELL and close >= __SL_TRIGGER_PRICE ? true : __SL_TRIGGER_SHORT_HIT[1]

display_long_SL_trigger         = __USE_SL and __TREND_BUY  and __USE_SL_TRIGGER and __SL_TRIGGER_LONG_HIT == false and __SL_TRIGGER_PRICE != -1
display_short_SL_trigger        = __USE_SL and __TREND_SELL and __USE_SL_TRIGGER and __SL_TRIGGER_SHORT_HIT == false and __SL_TRIGGER_PRICE != -1
display_SL_trigger              = display_long_SL_trigger or display_short_SL_trigger

// Determine trail stop loss prices
__LONG_TRAIL_SL                := if(__USE_SL and __TREND_BUY)
    stopValue = low * (1 - __SL_PERCENT)
    max(stopValue, __LONG_TRAIL_SL[1])
else
    0

__SHORT_TRAIL_SL               := if(__USE_SL and __TREND_SELL)
    stopValue = high * (1 + __SL_PERCENT)
    min(stopValue, __SHORT_TRAIL_SL[1])
else
    999999


//////////////////////////////////////////////////////////////////////////////////////////
//-- BEFORE CONDITIONS
//////////////////////////////////////////////////////////////////////////////////////////


//-- TRAILING TAKE PROFIT HIT CONDITIONS TO BE USED IN ALERTS
__COND_LONG_TLG_HIT            := __USE_TLG and __TREND_BUY  and crossover(close, __LONG_TRAIL_TP) and (__TLG_TRIGGER_LONG_HIT or __USE_TLG_TRIGGER == false) 
__COND_SHORT_TLG_HIT           := __USE_TLG and __TREND_SELL and crossunder(close, __SHORT_TRAIL_TP) and (__TLG_TRIGGER_SHORT_HIT or __USE_TLG_TRIGGER == false)

//-- TRAILING STOP lOSS HIT CONDITIONS TO BE USED IN ALERTS
__COND_LONG_SL_HIT             := __USE_SL and __TREND_BUY and crossunder(low, __LONG_TRAIL_SL) and (__SL_TRIGGER_LONG_HIT or __USE_SL_TRIGGER == false)
__COND_SHORT_SL_HIT            := __USE_SL and __TREND_SELL and crossover(high, __SHORT_TRAIL_SL) and (__SL_TRIGGER_SHORT_HIT or __USE_SL_TRIGGER == false)

__COND_LONG_RSI_HIT            := i_rsi_activ and i_rsi <= i_rsi_oversold
__COND_SHORT_RSI_HIT           := i_rsi_activ and i_rsi >= i_rsi_overbought
 
//-- COMBINE CONDITIONS
__CLOSE_LONG                   := __COND_LONG_TLG_HIT or __COND_LONG_SL_HIT or __COND_SHORT_RSI_HIT
__CLOSE_SHORT                  := __COND_SHORT_TLG_HIT or __COND_SHORT_SL_HIT or __COND_LONG_RSI_HIT

//-- SAVE
__LAST_PRICE                   := _LONG() or _SHORT() ? __SRC : nz(__LAST_PRICE[1])
__LAST_CONDITION               := _LONG() ? 1 : _SHORT() ? -1 : nz(__LAST_CONDITION[1])
__OUTPUT                       := _LONG() ? 1 : _SHORT() ? -1 : 0


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


//-- Range Filter Thereshold
plot(__PRINT_TH ? i_rf_filt_ths : na, title="RF: Range - Thereshold Short",transp=50, color=col_red_3, style=plot.style_line, linewidth=1)
plot(__PRINT_TH ? i_rf_filt_thl : na, title="RF: Range + Thereshold Long",transp=50, color=col_green_3, style=plot.style_line, linewidth=1)

//-- Last Entry Price
plot(__PRINT_LASTPRICE ? __LAST_PRICE : na, title="__LAST_PRICE", style=plot.style_cross, linewidth=1, color=col_green_4, transp=30)

//-- Entry Condition
plotshape(_LONG_ONLY(), title="__LONG", color=col_green_3, textcolor=color.white, transp=0, style=shape.labelup, location=location.belowbar, size=size.small, text="L", offset=0)
plotshape(_SHORT_ONLY(), title="__SHORT", color=col_red_5, textcolor=color.white, transp=0, style=shape.labeldown, location=location.abovebar, size=size.small, text="S", offset=0)

//-- TP
plotshape(_TP_SHORT(), title="TLG_CLOSE_SHORT_LONG", color=col_green_3, textcolor=color.white, transp=0, style=shape.labelup, location=location.belowbar, size=size.small, text="TTP", offset=0)
plotshape(_TP_LONG(), title="TLG_CLOSE_LONG_SHORT", color=col_red_5, textcolor=color.white, transp=0, style=shape.labeldown, location=location.abovebar, size=size.small, text="TTP", offset=0)

//-- SL
plotshape(_SL_SHORT(), title="SL_SHORT", color=col_green_3, textcolor=color.white, transp=0, style=shape.labelup, location=location.belowbar, size=size.small, text="TSL", offset=0)
plotshape(_SL_LONG(), title="SL_LONG", color=col_red_5, textcolor=color.white, transp=0, style=shape.labeldown, location=location.abovebar, size=size.small, text="TSL", offset=0)

//-- RSI
plotshape(_RSI_LONG(), title="RSI_LONG", color=col_green_3, textcolor=color.white, transp=0, style=shape.labelup, location=location.belowbar, size=size.small, text="RSI", offset=0)
plotshape(_RSI_SHORT(), title="RSI_SHORT", color=col_red_5, textcolor=color.white, transp=0, style=shape.labeldown, location=location.abovebar, size=size.small, text="RSI", offset=0)

//-- Additional Condition
plotshape(__PRINT_ALL_COND ? __LONG : na, title="__LONG_ALL", style=shape.circle, location=location.belowbar, color=col_green_3, size=size.small)
plotshape(__PRINT_ALL_COND ? __SHORT : na, title="__SHORT_ALL", style=shape.circle, location=location.abovebar, color=col_red_5, size=size.small)

//-- Plot take profits values for confirmation. Display the trailing TP until not hit
plot(series = __PRINT_TLG and __USE_TLG and __TREND_BUY and high >= __LONG_TRAIL_TP and (__TLG_TRIGGER_LONG_HIT or __USE_TLG_TRIGGER == false) ? __LONG_TRAIL_TP : na, color = col_green_1, style=plot.style_line, linewidth = 1, title = "Long Trail TP")
plot(series = __PRINT_TLG and __USE_TLG and __TREND_SELL and low <= __SHORT_TRAIL_TP and (__TLG_TRIGGER_SHORT_HIT or __USE_TLG_TRIGGER == false) ? __SHORT_TRAIL_TP : na, color = col_green_1, style = plot.style_line, linewidth = 1, title = "Short Trail TP")

//-- Plot stop loss values for confirmation. Display the trailing SL until not hit
plot(series = __PRINT_SL and __USE_SL and __TREND_BUY and low <= __LONG_TRAIL_SL and (__SL_TRIGGER_LONG_HIT or __USE_SL_TRIGGER == false) ? __LONG_TRAIL_SL : na, color=col_red_1, style=plot.style_line, linewidth=1, title="Long Trail SL")
plot(series = __PRINT_SL and __USE_SL and __TREND_SELL and high >= __SHORT_TRAIL_SL and (__SL_TRIGGER_SHORT_HIT or __USE_SL_TRIGGER == false) ? __SHORT_TRAIL_SL : na, color=col_red_1, style=plot.style_line, linewidth=1, title="Short Trail SL")

plot(__PRINT_TLG_TRIGGER and display_TLG_trigger ? __TP_TRIGGER_PRICE : na, title='__TP_TRIGGER_PRICE', transp=0, color=col_yellow_1, style=plot.style_cross, linewidth=1)
plot(__PRINT_SL_TRIGGER and display_SL_trigger ? __SL_TRIGGER_PRICE : na, title='SLPriceTrigger', transp=0, color=col_red_4, style=plot.style_cross, linewidth=1)

//-- External Signal for Panel Info
plot(__PRINT_ES ? __OUTPUT : na, title="External Signal", style=plot.style_line, linewidth=1, color=col_green_4, transp=100)


//////////////////////////////////////////////////////////////////////////
//-- STRATEGY OR EXECUTION
//////////////////////////////////////////////////////////////////////////


// Submit entry orders
strategy.entry(TradeId, long=true, when=_LONG())
strategy.entry(TradeId, long=false, when=_SHORT())


// //-- SWING
// alertcondition(_LONG_ONLY(), title="Open Long / Close Short", message="Open Long / Close Short >>> ONCE PER BAR CLOSE!!! <<<") 
// alertcondition(_SHORT_ONLY(), title="Open Short / Close Long", message="Open Short / Close Long >>> ONCE PER BAR CLOSE!!! <<<")

// //-- TRAILING TAKE PROFIT
// alertcondition(_CLOSE_LONG_ONLY(), title="Trailing Take Profit / Stop Loss - Close Long / Open Short", message="Trailing Take Profit / Stop Loss - Close Long / Open Short >>> ONCE PER BAR!!! <<<")
// alertcondition(_CLOSE_SHORT_ONLY(), title="Trailing Take Profit / Stop Loss - Close Short / Open Long", message="Trailing Take Profit / Stop Loss - Close Short / Open Long >>> ONCE PER BAR!!! <<<")

// //-- POSITION
// alertcondition(__LONG, title="Additional Open Long ", message="Additional Open Long >>> ONCE PER BAR CLOSE!!! <<<") 
// alertcondition(__SHORT, title="Additional Open Short", message="Additional Open Short >>> ONCE PER BAR CLOSE!!! <<<")

// //-- ZIGZAG
// alertcondition(long_i_zz_signal, title='ZZ Long', message='ZZ Long')
// alertcondition(short_i_zz_signal, title='ZZ Short', message='ZZ Short')


//////////////////////////////////////////////////////////////////////////
//-- AFTER: STRATEGY OR EXECUTION
//////////////////////////////////////////////////////////////////////////


if(__TREND_CHANGE)
    __TLG_TRIGGER_LONG_HIT     := false
    __TLG_TRIGGER_SHORT_HIT    := false 
    __SL_TRIGGER_LONG_HIT      := false
    __SL_TRIGGER_SHORT_HIT     := false


//////////////////////////////////////////////////////////////////////////
//-- SETUP: DEBUGGING
//////////////////////////////////////////////////////////////////////////


// plot(__DEBUGG ? __LONG_TRAIL_TP : na, title='__LONG_TRAIL_TP', transp=100)
// plot(__DEBUGG ? __SHORT_TRAIL_TP : na, title='__SHORT_TRAIL_TP', transp=100)
// plot(__DEBUGG ? f_b2n(__TLG_TRIGGER_LONG_HIT) : na, title='__TLG_TRIGGER_LONG_HIT', transp=100)
// plot(__DEBUGG ? f_b2n(__TLG_TRIGGER_SHORT_HIT) : na, title='__TLG_TRIGGER_SHORT_HIT', transp=100) 
// plot(__DEBUGG ? __LONG_TRAIL_SL : na, title='__LONG_TRAIL_SL', transp=100)
// plot(__DEBUGG ? __SHORT_TRAIL_SL : na, title='__SHORT_TRAIL_SL', transp=100)
// plot(__DEBUGG ? f_b2n(__SL_TRIGGER_LONG_HIT) : na, title='__SL_TRIGGER_LONG_HIT', transp=100)
// plot(__DEBUGG ? f_b2n(__SL_TRIGGER_SHORT_HIT) : na, title='__SL_TRIGGER_SHORT_HIT', transp=100)
