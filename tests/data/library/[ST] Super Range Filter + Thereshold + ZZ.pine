// plot(__DEBUGG ? __LAST_CONDITION : na, title="__LAST_CONDITION")

// plot(__DEBUGG ? f_b2n(_LONG()) : na, title="_LONG()")
// plot(__DEBUGG ? f_b2n(_LONG_ONLY()) : na, title="_LONG_ONLY()")
// plot(__DEBUGG ? f_b2n(_SHORT()) : na, title="_SHORT()")
// plot(__DEBUGG ? f_b2n(_SHORT_ONLY()) : na, title="_SHORT_ONLY()")
// plot(__DEBUGG ? i_rsi : na, title="RSI")


//-- } End of Setup