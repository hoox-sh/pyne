//@version=4
//@editor=jango_blockchained

// This was supposed to be an automatic ICT OTE (Optimal Trade Entry) Fib level placement on a 3-day scale, 
// but this did not turn out anywhere near close to how I envisioned it working. 
// Probably with some more development and applied math for the fib levels, I can get this to work even with breached 3D levels,
// but currently it's an exercise in frustration.

study(title="ote 3d v0", overlay=true)


dopen_3 = security(syminfo.tickerid, "3D", open[1], lookahead=barmerge.lookahead_on)
dhigh_3 = security(syminfo.tickerid, "3D", high[1], lookahead=barmerge.lookahead_on)
dlow_3 = security(syminfo.tickerid, "3D", low[1], lookahead=barmerge.lookahead_on)
dclose_3 = security(syminfo.tickerid, "3D", close[1], lookahead=barmerge.lookahead_on)

dmidline_3 = (dopen_3 + dclose_3) / 2
show_dopen_3 = true // input(true, "Show 3-Day Open", input.bool)
show_dmidline_3 = input(false, "Show 3-Day H/L Midline", input.bool)
show_dclose_3 = true // input(true, "Show 3-Day Close", input.bool)

plot(show_dopen_3 ? dopen_3 : na, color=#6495ED, transp=50, linewidth=1, style=plot.style_stepline, title="3 Day Open", trackprice=false)
plot(show_dclose_3 ? dclose_3 : na, color=#6495ED, transp=0, linewidth=2, style=plot.style_stepline, title="3 Day Close", trackprice=false)
plot(show_dmidline_3 ? dmidline_3[1] : na, color=#6495ED, transp=0, linewidth=1, style=plot.style_circles, title="3 Day Midline", trackprice=false)

h = dhigh_3
l = dlow_3

fib0 = input(1)
fib1 = input(0.79)
fib2 = input(0.705)
fib3 = input(0.618)
fib4 = input(0)
fib5 = input(-1)

rangeh = l - h
rangel = h - l

mid = (h - l) / 2 + l

// Someone pls put this script out of it's misery, pinescript is totally a meme.
f0ch = rangeh * fib0 + h
f1ch = rangeh * fib1 + h
f2ch = rangeh * fib2 + h
f3ch = rangeh * fib3 + h
f4ch = rangeh * fib4 + h
f5ch = rangeh * fib5 + h

f0cl = rangel * fib0 + l
f1cl = rangel * fib1 + l
f2cl = rangel * fib2 + l
f3cl = rangel * fib3 + l
f4cl = rangel * fib4 + l
f5cl = rangel * fib5 + l

// plot(f0ch, color=fuchsia,linewidth=1,style=stepline)
plot(f1ch, color=color.lime, linewidth=2, style=plot.style_stepline)
plot(f2ch, color=color.lime, linewidth=2, style=plot.style_stepline)
plot(f3ch, color=color.lime, linewidth=2, style=plot.style_stepline)
// plot(f4ch, color=gray,linewidth=2, style=stepline)
plot(f5ch, color=#66CDAA, linewidth=2, style=plot.style_stepline)

// plot(f0cl, color=fuchsia,linewidth=1,style=stepline)
plot(f1cl, color=color.lime, linewidth=2, style=plot.style_stepline)
plot(f2cl, color=color.lime, linewidth=2, style=plot.style_stepline)
plot(f3cl, color=color.lime, linewidth=2, style=plot.style_stepline)
// plot(f4cl, color=gray,linewidth=2, style=stepline)
plot(f5cl, color=#66CDAA, linewidth=2, style=plot.style_stepline)

// CTRL+C of previous section for extensions. Yup.
f0chi = rangel * fib0 + h
f1chi = rangel * fib1 + h
f2chi = rangel * fib2 + h
f3chi = rangel * fib3 + h
f4chi = rangel * fib4 + h
f5chi = rangel * fib5 + h

f0cli = rangeh * fib0 + l
f1cli = rangeh * fib1 + l
f2cli = rangeh * fib2 + l
f3cli = rangeh * fib3 + l
f4cli = rangeh * fib4 + l
f5cli = rangeh * fib5 + l
// plot(f0ch, color=fuchsia,linewidth=1,style=stepline)
plot(f1chi, color=color.red, linewidth=2, style=plot.style_stepline)
plot(f2chi, color=color.red, linewidth=2, style=plot.style_stepline)
plot(f3chi, color=color.red, linewidth=2, style=plot.style_stepline)
// plot(f4ch, color=gray,linewidth=2, style=stepline)
plot(f5chi, color=#66CDAA, linewidth=2, style=plot.style_stepline)

// plot(f0cl, color=fuchsia,linewidth=1,style=stepline)
plot(f1cli, color=color.red, linewidth=2, style=plot.style_stepline)
plot(f2cli, color=color.red, linewidth=2, style=plot.style_stepline)
plot(f3cli, color=color.red, linewidth=2, style=plot.style_stepline)
// plot(f4cl, color=gray,linewidth=2, style=stepline)
plot(f5cli, color=#66CDAA, linewidth=2, style=plot.style_stepline)
