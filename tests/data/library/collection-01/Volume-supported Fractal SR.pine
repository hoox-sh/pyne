//@version=4
//@author=synapticEX
//@editor=jango_blockchained
//@source=Volume-supported Fractal S/R
//@link=ttps://www.tradingview.com/script/cDCNneRP-Fractal-Support-Resistance-Fixed-Volume-2/

study("Volume-supported Fractal SR",shorttitle="VS FSR", overlay=true)
vamp1 = input(title="Fractal S/R Volume MA Length", type=input.integer, defval=20)
vamp2 = input(title="Fractal S/R Volume MA Length 2", type=input.integer, defval=50)

fsr(vamp) =>
    vam = ema(volume, vamp)
    up = high[3] > high[4] and high[4] > high[5] and high[2] < high[3] and 
       high[1] < high[2] and volume[3] > vam[3]
    down = low[3] < low[4] and low[4] < low[5] and low[2] > low[3] and low[1] > low[2] and 
       volume[3] > vam[3]
    fractalup = 0.0
    fractaldown = 0.0
    fractalup := up ? high[3] : nz(fractalup[1])
    fractaldown := down ? low[3] : nz(fractaldown[1])
    [fractalup, fractaldown]
[fup, fdn] = fsr(vamp1)
[fup2, fdn2] = fsr(vamp2)

// Plot S/R
plot(fup, "Fractal Resistance", color=color.red, linewidth=1, style=plot.style_circles, transp=0, offset=-3, join=false)
plot(fdn, "Fractal Support", color=color.lime, linewidth=1, style=plot.style_circles, transp=0, offset=-3, join=false)

plot(fup2, "Fractal Resistance 2", color=color.orange, linewidth=1, style=plot.style_circles, transp=0, offset=-3, join=false)
plot(fdn2, "Fractal Support 2", color=color.yellow, linewidth=1, style=plot.style_circles, transp=0, offset=-3, join=false)
