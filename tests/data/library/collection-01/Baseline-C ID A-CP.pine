        // jiehonglim, NNFX Baseline Script - Moving Averages 
            // https://www.tradingview.com/script/XmEVK58c-NNFX-Baseline-Script-Moving-Averages/
        // Fractured, Many Moving Averages
            // https://www.tradingview.com/script/xDdweXk5-Many-Moving-Averages/
        // everget, Jurik Moving Average/JMA
            // https://www.tradingview.com/script/nZuBWW9j-Jurik-Moving-Average/
        // 03.freeman, InfoPanel Divergence Indicator
            // https://www.tradingview.com/script/w1yWukv0-InfoPanel-Divergence-Indicator/
        // Ggqmna Volume stops
            // https://www.tradingview.com/script/rK7Dzxam-volume-stops/
        // Libertus RSI Divs
            // https://www.tradingview.com/script/42wcFfql-Relative-Strength-Index-Divergences-Libertus/
        // ChrisMoody, CM_Price-Action-Bars-Price Patterns That Work
            // https://www.tradingview.com/script/GHnJs0X8-CM-Price-Action-Bars-Price-Patterns-That-Work/
        // Erwinbeckers SSL Channel
            // https://www.tradingview.com/script/xzIoaIJC-SSL-channel/
            
//-------------------------------------------------------------------
study("Baseline-C [ID: AC-P]",overlay=true)
//-------------------------------------------------------------------
show_bl = input(title="Show Baseline?",type=input.bool,defval=true)

length = input(title="Baseline: Length", type=input.integer, defval=70)
phase = input(title="Baseline: Phase", type=input.float, step=0.1, defval=5, minval=-100, maxval=100) 
power = input(title="Baseline: Power", type=input.integer, defval=2) 
src_bl = input(title="Baseline: Source", type=input.source, defval=close)

show_bl_slow = input(title="Show Slow Baseline?",type=input.bool,defval=false)
length_slow = input(title="Slow Baseline: Length", type=input.integer, defval=200)
phase_slow  = input(title="Slow Baseline: Phase", type=input.float, step=0.1, defval=0, minval=-100, maxval=100)
power_slow  = input(title="Slow Baseline: Power", type=input.integer, defval=2) 
src_bl_slow = input(title="Slow Baseline: Source", type=input.source, defval=close)

jma(src, length, power, phase) => 

    phaseRatio = phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100 + 1.5
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = pow(beta, power)
    jma = 0.0
    e0 = 0.0
    e0 := (1 - alpha) * src + alpha * nz(e0[1])
    e1 = 0.0
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 = 0.0
    e2 := (e0 + phaseRatio * e1 - nz(jma[1])) * pow(1 - alpha, 2) + pow(alpha, 2) * nz(e2[1])
    jma := e2 + nz(jma[1])
    jma

// lsma_offset  = input(defval=0, title="* Least Squares (LSMA) Only - Offset Value", minval=0)
// alma_offset  = input(defval=0.85, title="* Arnaud Legoux (ALMA) Only - Offset Value", minval=0, step=0.01)
// alma_sigma   = input(defval=6, title="* Arnaud Legoux (ALMA) Only - Sigma Value", minval=0)

phase_atr = input(title="ATR: Phase", type=input.float, step=0.1, defval=0, minval=-100, maxval=100)
power_atr = input(title="ATR: Power", type=input.integer, defval=1) //2,1
ma(type, src, len,power_atr,phase_atr)=>
    float result = 0
    if type=="SMA" // Simple
        result := sma(src, len)
    if type=="EMA" // Exponential
        result := ema(src, len)
    if type=="DEMA" // Double Exponential
        e = ema(src, len)
        result := 2 * e - ema(e, len)
    if type=="TEMA" // Triple Exponential
        e = ema(src, len)
        result := 3 * (e - ema(e, len)) + ema(ema(e, len), len)
    if type=="WMA" // Weighted
        result := wma(src, len)
    if type=="VWMA" // Volume Weighted
        result := vwma(src, len) 
    if type=="SMMA" // Smoothed
        w = wma(src, len)
        result := na(w[1]) ? sma(src, len) : (w[1] * (len - 1) + src) / len
    if type=="HMA" // Hull
        result := wma(2 * wma(src, len / 2) - wma(src, len), round(sqrt(len)))
    // if type=="LSMA" // Least Squares
    //     result := linreg(src, len, lsma_offset)
    // if type=="ALMA" // Arnaud Legoux
    //     result := alma(src, len, alma_offset, alma_sigma)
    if type=="Kijun" //Kijun-sen
        kijun = avg(lowest(len), highest(len))
        result :=kijun
    if type=="McGinley"
        mg = 0.0
        mg := na(mg[1]) ? ema(src, len) : mg[1] + (src - mg[1]) / (len * pow(src/mg[1], 4))
        result :=mg
    if type == "JMA"
        result := jma(src, len, power_atr, phase_atr) 
    result

//-------------------------------------------------------------------
//---- Point of Control/Volume Profile Periods
show_poc = input(title= "Show Volume Profile Point of Control (POC)",defval=true)
show_poc12 = input(title= "Show Volume Profile Point of Control (POC) 12H",defval=true)

//POC
i2 = input(25, title = "Volume Profile Point of Control (POC): Volume Periods")
poc2= barssince(volume == max(highest(volume, i2), 0))
//POC 12hr
i = input(25, title = "Volume Profile Point of Control (POC): Volume Periods 12H")
vol_12h = security(syminfo.tickerid, "720", volume, barmerge.gaps_off, barmerge.lookahead_on)
vol_12hc = security(syminfo.tickerid, "720", close, barmerge.gaps_off, barmerge.lookahead_on)
poc = barssince(vol_12h == max(highest(vol_12h, i), 0))
//POC 12hr plot
plot(show_poc12 ? vol_12hc[poc] : na , color = color.white, title = "Volume Profile Point of Control (POC) 12H", style = plot.style_circles, transp = 0)
//POC plot
plot(show_poc ? close[poc2] : na, color = color.gray, title = "Volume Profile Point of Control (POC)", style = plot.style_circles, transp = 0)
//-------------------------------------------------------------------

//---- Baseline plotting
baseline = jma(src_bl , length, power, phase)
baseline_slow = jma(src_bl_slow , length_slow, power_slow, phase_slow)

plot(show_bl_slow ? baseline_slow : na,color=color.red,linewidth=1,title="Slow Baseline (Barstate Unconfirmed/Bar Not Closed)")
plot(show_bl_slow and baseline_slow and barstate.isconfirmed ? baseline_slow : na,color=color.red,linewidth=2,title="Slow Baseline")

plot(show_bl ? baseline : na ,color=color.red,linewidth=2,title="Baseline (Barstate Unconfirmed/Bar Not Closed)")
plot(show_bl and baseline and barstate.isconfirmed ? baseline : na,color=color.yellow,linewidth=2,title="Baseline")

//---- Signals based on crossover
base_cross_long = crossover(src_bl , baseline) and barstate.isconfirmed 
base_cross_short = crossover(baseline, src_bl) and barstate.isconfirmed 
base_color = base_cross_long ? color.green : base_cross_short ? color.red : na 

base_cross_long_slow = crossover(src_bl_slow , baseline_slow) and barstate.isconfirmed 
base_cross_short_slow = crossover(baseline_slow, src_bl_slow) and barstate.isconfirmed 
base_color_slow = base_cross_long_slow ? color.blue : base_cross_short_slow ? color.purple : na 

//---- Signals based on signal position
base_trend_long_binary = baseline < src_bl  ? 1 : 0
base_trend_short_binary = baseline > src_bl  ? 1 : 0

//-------------------------------------------------------------------

//-------------------------------------------------------------------
show_barcolor_bl_cross = input(title="Bar Color for Baseline Cross", type=input.bool, defval=true)
show_shape_bl_cross = input(title="Triangle Indication for Baseline Cross", type=input.bool, defval=true)
show_barcolor_bl_cross_slow = input(title="Bar Color for Slow Baseline Cross", type=input.bool, defval=false)
show_shape_bl_cross_slow = input(title="Triangle Indication for Slow Baseline Cross", type=input.bool, defval=false)

show_atr = input(title="Show ATR Bands", type=input.bool, defval=false)
show_atr_info = input(title="Show Current/Previous ATR Infopanel", type=input.bool, defval=false)
show_atr_jh = input(title="Show Current/Previous ATR Info Above/Below Candles", type=input.bool, defval=false)
x=input(defval=20,type=input.integer,title="ATR Infopanel: X")
y=input(defval=20,type=input.integer,title="ATR Infopanel: Y")
background=input(defval="Black",options=["Black","White"],title="ATR Infopanel: Background Color")

show_atr_rule = input(title="Show ATR Mult Violation", type=input.bool, defval=false)
atr_mult_violation = input(defval=1.0,title="ATR Mult Violation",type=input.float,step=0.1)

show_baseline_glow =  input(title="Show Baseline glow", type=input.bool, defval=false)

show_atr_bl = input(title="Show BL ATR Bands 1x", type=input.bool, defval=true)
show_atr_bl_15 = input(title="Show BL ATR Bands 1.5x", type=input.bool, defval=true)

plotshape(show_shape_bl_cross and base_cross_long,style=shape.triangleup,location=location.belowbar,color=color.green,transp=0, title="Baseline: Cross Long")
plotshape(show_shape_bl_cross and base_cross_short,style=shape.triangledown,location=location.abovebar,color=color.red,transp=0, title="Baseline: Cross Short")
barcolor(show_barcolor_bl_cross ? base_color : na,title="Bar Color for Baseline Cross")

plotshape(show_shape_bl_cross_slow and base_cross_long_slow,style=shape.triangleup,location=location.abovebar,color=color.blue,transp=0, title="Slow Baseline: Cross Long")
plotshape(show_shape_bl_cross_slow and base_cross_short_slow,style=shape.triangledown,location=location.belowbar,color=color.purple,transp=0, title="Slow Baseline: Cross Short")
barcolor(show_barcolor_bl_cross_slow ? base_color_slow : na,title="Bar Color for Slow Baseline Cross")
//-------------------------------------------------------------------

// slMultiplier = 1.5
// tpMultiplier = 1

atrlength = input(title="ATR Length", defval=14, minval=1)

atrsmoothing = input(title="ATR Smoothing Method", defval="JMA", options=["RMA", "SMA", "EMA", "WMA","JMA"]) //SMA, JMA
atr = ma(atrsmoothing, tr(true), atrlength,power_atr,phase_atr)
//-------------------------------------------------------------------

//---- ATR Check Component
distBasefromPrice = abs(baseline - src_bl)
//1 if more than ATR
atrFail = distBasefromPrice <= atr*atr_mult_violation ? 0 : 1 
//Always 1, unless ATR fails
allow_enter_ATR = atrFail ? 0 : 1
atrchecklocation = atrFail and base_trend_long_binary ? baseline - (atr*0.5) : atrFail and base_trend_short_binary ? baseline + (atr*0.5) : na

atr_top_1_time = src_bl + atr
atr_top_1_5_time = src_bl + (atr * 1.5)
atr_bottom_1_time = src_bl - atr
atr_bottom_1_5_time = src_bl - (atr * 1.5)

//-------------------------------------------------------------------

//plot(slow_ma, color=color.white, linewidth=4,transp=0,title='Slow MA')
bl_glow_color = close > baseline ? color.green : color.red
p1 = plot(show_baseline_glow ? baseline : na, color=bl_glow_color, linewidth=4,transp=0, title='Baseline glow')
p2=plot(src_bl,color=na)
fill(p1,p2,color=bl_glow_color, transp=95)

//Plot Shape if price is more than 1 ATR from baseline
plotshape(show_atr_rule ? atrchecklocation : na, style=shape.diamond, location=location.absolute, size=size.auto, color=color.white, transp=20)

//ATR Plots
tp1 = plot(show_atr ? atr_top_1_time : na, "ATR Top 1", linewidth=1, color=color.blue, transp=55)
tp2 = plot(show_atr ? atr_bottom_1_time : na, "ATR Bottom 1", linewidth=1, color=color.blue, transp=55)
// fill(tp, tp2, color=color.blue, transp=show_atr ? 95 : 100)

sl1 = plot(show_atr ? atr_top_1_5_time : na, "ATR Top 1.5", linewidth=1, color=color.orange, transp=55)
sl2 = plot(show_atr ? atr_bottom_1_5_time : na, "ATR Bottom 1.5", linewidth=1, color=color.orange, transp=55)
// fill(sl1, sl2, color=color.orange, transp=show_atr ? 95 : 100)

previous_atr = atr[1]

upper_atr_bl = baseline + atr 
lower_atr_bl  = baseline - atr 
upper_atr_bl_15 = baseline + (atr * 1.5)
lower_atr_bl_15  = baseline - (atr * 1.5) 
upper_atr_bl_plot = plot(show_atr_bl ? upper_atr_bl : na, color=color.navy, linewidth=2,title="Upper ATR BL 1x",transp=50)
lower_atr_bl_plot = plot(show_atr_bl ? lower_atr_bl : na, color=color.navy, linewidth=2,title="Lower ATR BL 1x",transp=50)
upper_atr_bl_plot_15 = plot(show_atr_bl_15 ? upper_atr_bl_15 : na, color=color.orange, linewidth=2,title="Upper ATR BL 1.5x",transp=80)
lower_atr_bl_plot_15 = plot(show_atr_bl_15 ? lower_atr_bl_15 : na, color=color.orange,linewidth=2,title="Lower ATR BL 1.5x",transp=80)

//----
// study("SSL channel", overlay=true)
period_ssl=input(title="SSL Period", defval=20) //10
len_ssl=input(title="SSL Length", defval=20) //10
smaHigh=sma(high, len_ssl)
smaLow=sma(low, len_ssl)
float Hlv = na
Hlv := close > smaHigh ? 1 : close < smaLow ? -1 : Hlv[1]
sslDown = Hlv < 0 ? smaHigh: smaLow
sslUp   = Hlv < 0 ? smaLow : smaHigh
show_ssl = input(false,title="Show SSL")
plot(show_ssl ? sslDown : na , linewidth=2, color=color.red,transp=50)
plot(show_ssl ? sslUp : na , linewidth=2, color=color.lime,transp=50)
//----


f_draw_infopanel(_x, _y, _line, _text)=>
    _rep_text = ""
    for _l = 0 to _line
        _rep_text := _rep_text + "\n"
    _rep_text := _rep_text + _text
    var label _la = na
    label.delete(_la)
    _la := label.new(
         x=_x, y=_y, 
         text=_rep_text, xloc=xloc.bar_time, yloc=yloc.price, 
         color=background=="Black"?color.black:color.white, style=label.style_labelup, textcolor=background=="Black"?color.white:color.black, size=size.small)
         //)

lapos_x = timenow + round(change(time)*x)
lapos_y = highest(20)+(syminfo.mintick*y)

// f_draw_infopanel(lapos_x, lapos_y, 8, "╚════════════════════╝")
if (show_atr_info)
    f_draw_infopanel(lapos_x, lapos_y, 4, 'Previous ATR \n'+tostring(previous_atr))
    f_draw_infopanel(lapos_x, lapos_y, 1, 'Current ATR is \n'+tostring(atr))
// f_draw_infopanel(lapos_x, lapos_y, 0, "╔════════════════════╗")

if (show_atr_jh)
    //Label for day before ATR
    l = label.new(bar_index-1, na, 'Previous ATR \n'+tostring(previous_atr), 
      color=color.gray, 
      textcolor=color.white,
      style=label.style_labelup, yloc=yloc.belowbar)
    
    label.delete(l[1])
    
    //Today's
    l2 = label.new(bar_index, na, 'Current ATR is \n'+tostring(atr), 
      color=color.gray, 
      textcolor=color.white,
      style=label.style_labeldown, yloc=yloc.abovebar)
    
    label.delete(l2[1])
