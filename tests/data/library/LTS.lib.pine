//@version=5

// @description
library("LTSDEV")

//@variable	Whitespace
const string WS = ' '
//@variable Underscore
const string US = '_'
//@variable Underscore
const string LB = '{'
//@variable Underscore
const string RB = '}'
//@variable Underscore
const string DS = '"'
//@variable Underscore
const string C = ','
//@variable Underscore 
const string DP = ':'

//@type 	description
//@field	key		
//@field	value
//@field    n
//@field	freq
export type Datafield
	// --
	string  key
	float   value
	int	   	n
	string  freq


//@type 	description
//@field	secret_hash	
//@field	use_smart_contract
//@field	init
//@field    __Datafield
export type Connection
	// --
	string 					secret_hash
	bool					use_smart_contract  = false
	bool					init				= false
	array <Datafield>		__Datafield

//@function	
//@param	this
//@returns  `<string>`
method format(series string this) =>
	// >>
	str.upper(str.replace_all(this, WS, US))


//@function	
//@param	this	A `<Connection>` object.
//@returns 	`<Connection>`
export method init(Connection this) =>
	// --
	if not this.init
		this.__Datafield	:= na(this.__Datafield) ? array.new<Datafield>() : this.__Datafield  // redundant
		this.init 			:= true
	// >>
	this


//@function	
//@param	this			
//@param	_useSmartContract
//@returns 	`<Connection>`
export login(series string _secretHash, series bool _useSmartContract = false) =>
	// >>
	Connection.new(_secretHash, _useSmartContract).init()


//@function	
//@param	this	A `<Connection>` object.
//@param	key		The `key` to set/update. It is not case sensitive and can be the `key` or the `Symbol ID`.
//@returns 	`<Connection>`
export method set(
 Connection 	this, 
 series string 	_key, 
 series float 	_value, 
 series int 	_n 		= na, 
 series string 	_freq 	= alert.freq_once_per_bar_close
 ) =>
	// --
	this.__Datafield.push(Datafield.new(_key.format(), _value, _n, _freq))
	// >>
	this


//@function	
//@param	this	A `<Connection>` object.
//@param	key		The `key` to remove. It is not case sensitive and can be the `key` or the `Symbol ID`.
//@returns 	`<Connection>`
export method unset(Connection this, series string _key) =>
	// --
	series string key = _key.format()
	for [i, d] in this.__Datafield
		if d.key == key
			this.__Datafield.remove(i)
	// >>
	this

//@function	
//@param	this	A `<Connection>` object.
//@returns 	`<Connection>`
export method upload(Connection this) =>
	// --
	if this.__Datafield.size() > 0
		for d in this.__Datafield
			//@variable	A JSON formatted alert message.
			series string msg 
			 = '{"secret_hash":"' + this.secret_hash + '","datafield": {"key":"'
			 + d.key + '","value":"' + str.tostring(d.value) + '"'
			msg += not na(d.n) ? ',"n":"' + str.tostring(d.n) + '"' : ''
			msg += '}'
			switch d.freq
				alert.freq_all 					=> alert(msg, alert.freq_all)
				alert.freq_once_per_bar	 		=> alert(msg, alert.freq_once_per_bar)
				alert.freq_once_per_bar_close   => alert(msg, alert.freq_once_per_bar_close)
	// >>
	this

// Example - Set 
// Connection lts = login('3ad56429f9884d92')		// global scope (required)
// if bar_index % 2
// 	lts.set('test', bar_index)						// any scope
// 	lts.set('test2', close)						// any scope
// 	lts.set('volume', volume)						// any scope
// // >>
// lts.upload()								// global scope (recommanded)

