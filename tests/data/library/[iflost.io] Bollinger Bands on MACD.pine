//   ||   START OF SETUP


//      ____________    ____  ___________________ 
//     /  _/ ____/ /   / __ \/ ___/_  __/  _/ __ \
//     / // /_  / /   / / / /\__ \ / /  / // / / /
//   _/ // __/ / /___/ /_/ /___/ // / _/ // /_/ / 
//  /___/_/   /_____/\____//____//_(_)___/\____/  
// 
//  EVERYTHING IS POSSIBLE, BY THE POWER OF DATA.


//@version=4
//@authors                      = Jan Goischke & Dennis Hilpmann


IndicatorName                   = "[iflost.io] Bollinger Bands on MACD"
ShortIndicatorName              = "[iflost.io] BB-MACD"

TradeId                         = "[IFLO] BB-MACD"

InitCapital                     = 5000
InitPosition                    = 98
InitCommission                  = 0.075

Precision                       = 0
Overlay                         = false

Format                          = format.price


//////////////////////////////////////////////////////////////////////////
//-- [iflost.io] Bollinger Bands on MACD
//////////////////////////////////////////////////////////////////////////


study(
 title                          = IndicatorName, 
 shorttitle                     = ShortIndicatorName, 
 overlay                        = Overlay,
 format                         = Format,
 precision                      = Precision
 )


//////////////////////////////////////////////////////////////////////////
//-- INPUTS
//////////////////////////////////////////////////////////////////////////


int i_bbm_rapid                 = input(8, "Rapid", type=input.integer)
int i_bbm_lenght                = input(26, "Lenght", type=input.integer)
float i_bbm_stdv                = input(0.8, "Stdv", type=input.float)


//////////////////////////////////////////////////////////////////////////
//-- VARIABLES
//////////////////////////////////////////////////////////////////////////


float i_bbm_sdev                = 0.0
float i_bbm_hband               = 0.0
float i_bbm_lband               = 0.0


//////////////////////////////////////////////////////////////////////////
//-- COLORS
//////////////////////////////////////////////////////////////////////////


//--__buy, Upward
color col_green_1               = #4EF9FF
color col_green_2               = #3CADB1
color col_green_3               = #26c6da  //*
color col_green_4               = #afff00
color col_green_5               = #CFD80E
color col_green_6               = #90c818

//-- __sell, Downward
color col_red_1                 = #7b1fa2
color col_red_2                 = #7e57c2
color col_red_3                 = #512da8
color col_red_4                 = #7300de
color col_red_5                 = #4a148c  //*

//-- Idle, Sideward
color col_yellow_1              = #ffa726
color col_yellow_2              = #f57c00

color col_light_50              = color.new(#FFFFFF,50)


//////////////////////////////////////////////////////////////////////////
//-- CALCULATION
//////////////////////////////////////////////////////////////////////////


float i_bbm_rapid_m             = ema(close,i_bbm_rapid)
float i_bbm_lenght_m            = ema(close,i_bbm_lenght)
float i_bbm_bbmacd              = i_bbm_rapid_m - i_bbm_lenght_m
float i_bbm_avg                 = ema(i_bbm_bbmacd,9)

i_bbm_sdev                     := stdev(i_bbm_bbmacd,9)
i_bbm_hband                    := i_bbm_avg + i_bbm_stdv * i_bbm_sdev
i_bbm_lband                    := i_bbm_avg - i_bbm_stdv * i_bbm_sdev


//////////////////////////////////////////////////////////////////////////
//-- CONDITION
//////////////////////////////////////////////////////////////////////////


bool i_bbm_long                 = crossover(i_bbm_bbmacd, i_bbm_hband)
bool i_bbm_short                = crossunder(i_bbm_bbmacd, i_bbm_lband)


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


i_bbm_plot_color                = i_bbm_bbmacd < i_bbm_lband ? col_red_1 : i_bbm_bbmacd > i_bbm_hband ? col_green_1 : color.blue

i_plot_a                        = plot(i_bbm_hband, title="Higher Bands", color=col_light_50, linewidth=1, style=plot.style_line, transp=30)
i_plot_b                        = plot(i_bbm_lband, title="Lower Bands", color=col_light_50, linewidth=1, style=plot.style_line, transp=30)
i_plot_c                        = plot(i_bbm_bbmacd, title="Linear MACD Bollinger Band", color=i_bbm_plot_color, linewidth=2, style=plot.style_line, transp=0)

fill(i_plot_a, i_plot_b, color=col_light_50)

i_bbm_plot_color1               = i_bbm_bbmacd < i_bbm_lband ? col_red_1 :  na
fill(i_plot_c, i_plot_b, color=i_bbm_plot_color1, transp=50)

i_bbm_plot_color2               = i_bbm_bbmacd > i_bbm_hband ? col_green_1  :  na
fill(i_plot_c, i_plot_a, color=i_bbm_plot_color2, transp=50)


//////////////////////////////////////////////////////////////////////////
//-- ALERTS
//////////////////////////////////////////////////////////////////////////


alertcondition(i_bbm_long,title="LONG",message="LONG")
alertcondition(i_bbm_short,title="SHORT",message="SHORT")


//-- } End of Script