var bool __LONG                 = false
var bool __SHORT                = false

var bool __CLOSE_LONG           = na
var bool __CLOSE_SHORT          = na

var float __LAST_CONDITION      = na
var float __LAST_PRICE          = na

var float __TREND               = 0.0

var int __SINCE_BUY             = na
var int __SINCE_SELL            = na

var bool __TREND_BUY            = na
var bool __TREND_SELL           = na
var bool __TREND_CHANGE         = na

var bool __TLG_TRIGGER_LONG_HIT = false
var bool __TLG_TRIGGER_SHORT_HIT= false

var bool __SL_TRIGGER_LONG_HIT  = false
var bool __SL_TRIGGER_SHORT_HIT = false

var bool __COND_LONG_TLG_HIT    = false
var bool __COND_SHORT_TLG_HIT   = false

var bool __COND_LONG_SL_HIT     = false
var bool __COND_SHORT_SL_HIT    = false

var bool __COND_LONG_RSI_HIT    = false
var bool __COND_SHORT_RSI_HIT   = false

var int __EXTERN                = 0


//////////////////////////////////////////////////////////////////////////
//-- SETUP: FUNCTIONS
//////////////////////////////////////////////////////////////////////////
//
// Setup funuctions beginning with a "f_" 
// Setup intern function variables beginning with a underscore "_var"
// Setup extern function variables "var"
// Corresponding to the Setup variables __LONG and __SHORT, the buy and sell function beginning with double underscore followed by UPERCASE letters
//
// !!! Variables and functions shares the same namespace !!!
//
//////////////////////////////////////////////////////////////////////////


//
//-- MATH FUNCTIONS
//

//-- Phi
//@return           float
f_phi() =>
    float _phi = 0.5 + sqrt(1.25)
    _phi

//-- Fibonacci Numbers
//@return           float
f_fib(_step) =>
    float _phi = 1.618
    float _n_phi = 1/_phi
    int _r = round(abs(_step >= 0 ? pow(_phi, _step) / sqrt(5.0) : pow(-_n_phi, _step) / sqrt(5)))
    _r

//-- Bool to integer
//-- @return        integer
f_b2n(_b) =>
    int _r = _b ? 1 : 0
    _r

//-- Date and start filter
//-- @return        bool
f_window() =>
    bool _r = time >= __STARTF and time <= __FINISHT ? true : false
    _r

_LONG() =>
    bool _r = (__LONG or __CLOSE_SHORT) and __LAST_CONDITION[1] != 1
    _r
    
_LONG_ONLY() =>
    bool _r = __LONG and __LAST_CONDITION[1] != 1
    _r
    
_CLOSE_LONG_ONLY() =>
    bool _r = __CLOSE_LONG and __LAST_CONDITION[1] != -1
    _r

_SHORT() =>
    bool _r = (__SHORT or __CLOSE_LONG) and __LAST_CONDITION[1] != -1
    _r

_SHORT_ONLY() =>
    bool _r = __SHORT and __LAST_CONDITION[1] != -1
    _r
    
_CLOSE_SHORT_ONLY() =>
    bool _r = __CLOSE_SHORT and __LAST_CONDITION[1] != 1
    _r


