bool __D1                   = input(defval=false, type=input.bool, title="―――――――――――――――――――――")

bool __USE_TLG              = input(defval=true, type=input.bool, title="Use Trailing Take Profit?")
float __TLG_PERCENT         = input(defval=2.0, title="Trailing Take Profit (%)",minval=0,step=0.1,type=input.float) * 0.01
bool  __USE_TLG_TRIGGER     = input(defval=true, title="Use Trailing Take Profit Trigger Level?", type=input.bool)
float __TLG_PERCENT_TRIGGER = input(defval=4.0, title="Trailing Take Profit Trigger Level (%)",minval=0,step=0.1,type=input.float) * 0.01

bool __D4                   = input(defval=false, type=input.bool, title="―――――――――――――――――――――")

bool __USE_SL               = input(false, "Use Trailing Stop Loss")
float __SL_PERCENT          = input(title="Trailing Stop Loss (%)", type=input.float, minval=0.0, step=0.1, defval=2.2) * 0.01
bool __USE_SL_TRIGGER       = input(false, "Use Trailing Stop Loss Trigger Level?")
float __SL_PERCENT_TRIGGER  = input(4.0, "Trailing Stop Loss Trigger Level (%)",minval=0,step=0.1,type=input.float) * 0.01

bool __D5                   = input(false, type=input.bool, title="―――――――――――――――――――――")

