bool __PRINT_TLG            = input(false, type=input.bool, title="Print Trailing Take Profit?")
bool __PRINT_TLG_TRIGGER    = input(false, type=input.bool, title="Print Trailing Take Profit Trigger Level?")
bool __PRINT_SL             = input(false, type=input.bool, title="Print Trailing Stop Loss?")
bool __PRINT_SL_TRIGGER     = input(false, type=input.bool, title="Print Trailing Stop Loss Trigger Level?")

bool __PRINT_TH             = input(false, type=input.bool, title="Print Thereshold?")

bool __DEBUGG               = input(true, type=input.bool, title="Debugging?")

bool __D6                   = input(false, type=input.bool, title="―――――――――――――――――――――")


