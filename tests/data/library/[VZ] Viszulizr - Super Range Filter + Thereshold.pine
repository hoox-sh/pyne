//
//-- INPUTS
//

bool i_rsi_description      = input(false, type=input.bool, title="----- RSI")
bool __USE_RSI              = input(true, type=input.bool, title="Use RSI for extra entry and exit condition?")
bool __PRINT_RSI_BG         = input(true, type=input.bool, title="Show colored background over/under levels?")

int i_rsi_lenght            = input(14, type=input.integer,title="RSI Lenght")
int i_rsi_overbought        = input(90, type=input.integer,title="RSI Overbought Level")
int i_rsi_oversold          = input(10, type=input.integer,title="RSI Oversold Level")

//
//-- VARIABLES
//

var float i_rsi                 = 0.0

//
//-- CALCULATION
//

i_rsi                          := rsi(__SRC, i_rsi_lenght)


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: RANGE FILTER
//////////////////////////////////////////////////////////////////////////


//
//-- RF: INPUTS
//

// Show visualisation
var bool i_rf_print             = input(defval = false, type=input.bool, title="----- Range Filter")

// Sampling Period 17,12
var int i_rf_per                = input(defval = 12, minval = 1, type=input.integer, title = "RF: Period")

// Range Multiplier
var float i_rf_mult             = input(defval = 2.2, minval = 0, type=input.float, step=0.01, title = "RF: Range Multiplier")

// Thereshold - The higher the threshold, the earlier or the later it crossover or crossunder the Super Trend line.
var float i_rf_thl              = input(title = "RF: Thereshold Long", type = input.float, defval = 0.017, step = 0.0005)
var float i_rf_ths              = input(title = "RF: Thereshold Short", type = input.float, defval = -0.005, step = 0.0005)

// Thereshold Minimizer
var bool i_rf_min_th            = input(defval = false, type=input.bool, title = "RF: Minimize Thereshold")
float i_rf_min_th_factor    = input(defval = 0.995, type=input.float, minval = 0.05, step=0.005, title = "RF: Minimize Factor")

//
//-- RF: VARIABLES
//

var float i_rf_upward           = 0.0
var float i_rf_downward         = 0.0
var float i_rf_min_th_score     = 1.0

//
//-- RF: FUNCTIONS
//

// Smooth Average Range
i_smoothrng(_x, _t, _m) =>
    wper                        = _t / 3 - 1
    avrng                       = sma(abs(_x - _x[1]), _t)
    smoothrng                   = sma(avrng, wper) * _m
    smoothrng

// Range Filter
i_rngfilt(_x, _r) =>
    rngfilt                     = _x
    rngfilt                    := _x > nz(rngfilt[1]) ? _x - _r < nz(rngfilt[1]) ? nz(rngfilt[1]) : _x - _r : _x + _r > nz(rngfilt[1]) ? nz(rngfilt[1]) : _x + _r
    rngfilt

//
//-- RF: CALCULATION
//

// Smoothrange
float i_rf_smrng                      = i_smoothrng(__SRC, i_rf_per, i_rf_mult)

// Range Filter
float i_rf_filt                       = i_rngfilt(__SRC, i_rf_smrng)

// Filter Direction
float i_rf_hband                      = i_rf_filt + i_rf_smrng 
float i_rf_lband                      = i_rf_filt - i_rf_smrng

float i_rf_filt_scored_th             = i_rf_min_th ? nz(i_rf_min_th_score[1]) : 1

float i_rf_filt_thl                   = (i_rf_filt * i_rf_thl * i_rf_filt_scored_th) + i_rf_filt 
float i_rf_filt_ths                   = (i_rf_filt * i_rf_ths * i_rf_filt_scored_th) + i_rf_filt 

// i_rf_filt_thl                   = ((i_rf_filt * i_rf_thl) - (i_rf_filt * i_rf_thl * (i_rsi / 100))) + i_rf_filt 
// i_rf_filt_ths                   = ((i_rf_filt * i_rf_ths) - (i_rf_filt * i_rf_ths * (i_rsi / 100))) + i_rf_filt 

i_rf_upward                    := i_rf_filt > i_rf_filt[1] ? nz(i_rf_upward[1]) + 1 : i_rf_filt < i_rf_filt[1] ? 0 : nz(i_rf_upward[1])
i_rf_downward                  := i_rf_filt < i_rf_filt[1] ? nz(i_rf_downward[1]) + 1 : i_rf_filt > i_rf_filt[1] ? 0 : nz(i_rf_downward[1])

//
//-- RF: COLORS & PLOTS
//

// Colors
color i_rf_filtcolor                  = i_rf_upward > 0 ? col_green_4 : i_rf_downward > 0 ? col_red_5 : color.white
color i_rf_barcolor                   = (__SRC > i_rf_filt) and (__SRC > __SRC[1]) and (i_rf_upward > 0) ? col_green_1 : (__SRC > i_rf_filt) and (__SRC < __SRC[1]) and (i_rf_upward > 0) ? col_green_5 : (__SRC < i_rf_filt) and (__SRC < __SRC[1]) and (i_rf_downward > 0) ? col_red_5 : (__SRC < i_rf_filt) and (__SRC > __SRC[1]) and (i_rf_downward > 0) ? col_red_2 : col_yellow_1

// Range Filter
// i_rf_filt_p                     = plot(i_rf_print ? i_rf_filt : na, color=i_rf_filtcolor, linewidth=2, title="RF: Range Filter")

// // Target
// i_rf_hband_p                    = plot(i_rf_print ? i_rf_hband : na, color=col_green_2, transp=50, title="RF: High Target")
// i_rf_lband_p                    = plot(i_rf_print ? i_rf_lband : na, color=col_red_3, transp=50, title="RF: Low Target")

// // Fills
// fill(i_rf_hband_p, i_rf_filt_p, color=col_green_2, title="RF: High Target Range")
// fill(i_rf_lband_p, i_rf_filt_p, color=col_red_3, title="RF: Low Target Range")

// // Bar Color
// barcolor(__PRINT_BARCOLOR ? i_rf_barcolor : na)


//////////////////////////////////////////////////////////////////////////
//-- INDICATOR: SUPERTREND
//////////////////////////////////////////////////////////////////////////


//
//-- ST: INPUTS
//

i_st_vis_activated     = input(false, title="----- Super Trend ATR", type=input.bool)
i_st_factor           = input(4, minval = 1, maxval = 100, type=input.float,step=0.01,title="ST: Factor")
i_st_period             = input(6, minval = 1, maxval = 100, type=input.integer,title="ST: Period")


//
//-- ST: FUNCTIONS
//

i_supertrend(_factor, _period) =>

    var float   _trendup        = 0.0
    var float   _trenddown      = 0.0
    var float   _trend          = 0.0

    _up                         = hl2 - _factor * atr(_period)
    _down                       = hl2 + _factor * atr(_period)

    _trendup                   := __SRC[1] > _trendup[1] ? max(_up, _trendup[1]) : _up
    _trenddown                 := __SRC[1] < _trenddown[1] ? min(_down, _trenddown[1]) : _down

    _trend                     := __SRC > _trenddown[1] ? 1 : __SRC < _trendup[1] ? -1 : nz(_trend[1], 1)
    _supertrend                 = _trend == 1 ? _trendup : _trenddown

    [_trend, _supertrend]

//
//-- ST: CALCULATION
//

[i_st_trend, i_st_supertrend]   = i_supertrend(i_st_factor,i_st_period)

//
//-- ST: COLORS & PLOTS
//

i_st_linecolor                  = i_st_trend == 1 ? col_green_3 : col_yellow_2

// plot(i_st_vis_activated ? i_st_supertrend : na, color = i_st_linecolor, style = plot.style_line, linewidth = 2, title = "ST: SuperTrend")


//////////////////////////////////////////////////////////////////////////
//-- CONDITIONS
//////////////////////////////////////////////////////////////////////////


__LONG                         := crossunder(i_st_supertrend, i_rf_filt_thl)
__SHORT                        := crossover(i_st_supertrend, i_rf_filt_ths)


//////////////////////////////////////////////////////////////////////////
//-- AFTER CONDITIONS
//////////////////////////////////////////////////////////////////////////


i_rf_min_th_score              := __LONG or __SHORT ? 1 : (i_rf_min_th_score[1] * i_rf_min_th_factor)

//
//-- SAVE INFORMATION
//

// trend states
__SINCE_BUY                    := barssince(_LONG())
__SINCE_SELL                   := barssince(_SHORT())

__TREND_BUY                    := __SINCE_SELL > __SINCE_BUY
__TREND_SELL                   := __SINCE_SELL < __SINCE_BUY 
__TREND_CHANGE                 := (__TREND_BUY and __TREND_SELL[1]) or (__TREND_SELL and __TREND_BUY[1])


//////////////////////////////////////////////////////////////////////////
//-- SETUP: TRAILING TAKE PROFIT
//////////////////////////////////////////////////////////////////////////


trailingPriceTrigger          = 0.0
trailingPriceTrigger := if (__USE_TLG_TRIGGER)
    if (__TREND_BUY)
        __LAST_PRICE * (1 + __TLG_PERCENT_TRIGGER) 
    else
        __LAST_PRICE * (1 - __TLG_PERCENT_TRIGGER)
else
    -1

__TLG_TRIGGER_LONG_HIT          := __USE_TLG and __USE_TLG_TRIGGER and __TREND_BUY and high >= trailingPriceTrigger ? true : __TLG_TRIGGER_LONG_HIT[1]
__TLG_TRIGGER_SHORT_HIT         := __USE_TLG and __USE_TLG_TRIGGER and __TREND_SELL and low <= trailingPriceTrigger ? true : __TLG_TRIGGER_SHORT_HIT[1]

display_long_TLG_trigger         = __USE_TLG and __TREND_BUY  and __TLG_TRIGGER_LONG_HIT == false and trailingPriceTrigger != -1
display_short_TLG_trigger        = __USE_TLG and __TREND_SELL and __TLG_TRIGGER_SHORT_HIT == false and trailingPriceTrigger != -1
display_TLG_trigger              = display_long_TLG_trigger or display_short_TLG_trigger

__LONG_TRAIL_TP = 0.0, __SHORT_TRAIL_TP = 0.0

// Trailing Profit
// Start trailing once trigger is reached
__LONG_TRAIL_TP                 := if __USE_TLG and __TREND_BUY 
    tpValue = high * (1 + __TLG_PERCENT)
    max(tpValue, __LONG_TRAIL_TP[1])
else
    0

__SHORT_TRAIL_TP                := if __USE_TLG and __TREND_SELL
    tpValue = low * (1 - __TLG_PERCENT)
    min(tpValue, __SHORT_TRAIL_TP[1])
else
    999999


//////////////////////////////////////////////////////////////////////////
//-- SETUP: TRAILING STOP LOSS
//////////////////////////////////////////////////////////////////////////


StopLossPriceTrigger            = 0.0
StopLossPriceTrigger := if (__USE_SL_TRIGGER)
    if __TREND_BUY
        __LAST_PRICE * (1 - __SL_PERCENT_TRIGGER) 
    else
        __LAST_PRICE * (1 + __SL_PERCENT_TRIGGER)
else
    -1

__SL_TRIGGER_LONG_HIT          := __USE_SL and __USE_SL_TRIGGER and __TREND_BUY and low <= StopLossPriceTrigger ? true : __SL_TRIGGER_LONG_HIT[1]
__SL_TRIGGER_SHORT_HIT         := __USE_SL and __USE_SL_TRIGGER and __TREND_SELL and high >= StopLossPriceTrigger ? true : __SL_TRIGGER_SHORT_HIT[1]

display_long_SL_trigger         = __USE_SL and __TREND_BUY  and __USE_SL_TRIGGER and __SL_TRIGGER_LONG_HIT == false and StopLossPriceTrigger != -1
display_short_SL_trigger        = __USE_SL and __TREND_SELL and __USE_SL_TRIGGER and __SL_TRIGGER_SHORT_HIT == false and StopLossPriceTrigger != -1
display_SL_trigger              = display_long_SL_trigger or display_short_SL_trigger

// Determine trail stop loss prices
__LONG_TRAIL_SL = 0.0, __SHORT_TRAIL_SL = 0.0

__LONG_TRAIL_SL                := if __USE_SL and __TREND_BUY
    stopValue = low * (1 - __SL_PERCENT)
    max(stopValue, __LONG_TRAIL_SL[1])
else
    0

__SHORT_TRAIL_SL               := if __USE_SL and __TREND_SELL
    stopValue = high * (1 + __SL_PERCENT)
    min(stopValue, __SHORT_TRAIL_SL[1])
else
    999999


//////////////////////////////////////////////////////////////////////////////////////////
//-- BEFORE CONDITIONS
//////////////////////////////////////////////////////////////////////////////////////////


//-- TRAILING TAKE PROFIT HIT CONDITIONS TO BE USED IN ALERTS
__COND_LONG_TLG_HIT            := __USE_TLG and __TREND_BUY   and crossover(high, __LONG_TRAIL_TP[1]) and (__TLG_TRIGGER_LONG_HIT or __USE_TLG_TRIGGER == false) 
__COND_SHORT_TLG_HIT           := __USE_TLG and __TREND_SELL  and crossunder(low, __SHORT_TRAIL_TP[1]) and (__TLG_TRIGGER_SHORT_HIT or __USE_TLG_TRIGGER == false)

//-- TRAILING STOP lOSS HIT CONDITIONS TO BE USED IN ALERTS
__COND_LONG_SL_HIT             := __USE_SL and __TREND_BUY and crossunder(low, __LONG_TRAIL_SL[1]) and (__SL_TRIGGER_LONG_HIT or __USE_SL_TRIGGER == false)
__COND_SHORT_SL_HIT            := __USE_SL and __TREND_SELL and crossover(high, __SHORT_TRAIL_SL[1]) and (__SL_TRIGGER_SHORT_HIT or __USE_SL_TRIGGER == false)

__COND_LONG_RSI_HIT            := __USE_RSI and i_rsi <= i_rsi_oversold
__COND_SHORT_RSI_HIT           := __USE_RSI and i_rsi >= i_rsi_overbought

//-- COMBINE CONDITIONS
__CLOSE_LONG                   := __COND_LONG_TLG_HIT or __COND_LONG_SL_HIT or __COND_SHORT_RSI_HIT
__CLOSE_SHORT                  := __COND_SHORT_TLG_HIT or __COND_SHORT_SL_HIT or __COND_LONG_RSI_HIT

//-- SAVE 
__LAST_PRICE                   := __PRINT_ALL_COND and (__LONG or __SHORT) ? __SRC : _LONG() or _SHORT() ? __SRC : nz(__LAST_PRICE[1])
__LAST_CONDITION               := _LONG() ? 1 : _SHORT() ? -1 : nz(__LAST_CONDITION[1])
__EXTERN                       := _LONG() ? 1 : _SHORT() ? -1 : 0


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


//-- Range Filter Thereshold
plot(__PRINT_TH ? i_rf_filt_ths : na, title="RF: Range - Thereshold Short",transp=50, color=col_red_3, style=plot.style_line, linewidth=1)
plot(__PRINT_TH ? i_rf_filt_thl : na, title="RF: Range + Thereshold Long",transp=50, color=col_green_3, style=plot.style_line, linewidth=1)

//-- Last Entry Price
plot(__PRINT_LASTPRICE ? __LAST_PRICE : na, title="__LAST_PRICE", style=plot.style_cross, linewidth=1, color=col_green_4, transp=30)

//-- Entry Condition
plotshape(_LONG_ONLY() ? 145 : na, title="__LONG", color=col_green_4, textcolor=color.white, transp=0, style=shape.triangledown, location=location.absolute, size=size.tiny, text="", offset=0)
plotshape(_SHORT_ONLY() ? -145 : na, title="__SHORT", color=col_green_4, textcolor=color.white, transp=0, style=shape.triangleup, location=location.absolute, size=size.tiny, text="", offset=0)

//-- Exit Condition
plotshape(_CLOSE_SHORT_ONLY(), title="TLG_CLOSE_SHORT_LONG", color=col_green_4, textcolor=color.white, transp=0, style=shape.labelup, location=location.bottom, size=size.tiny, text=":", offset=0)
plotshape(_CLOSE_LONG_ONLY(), title="TLG_CLOSE_LONG_SHORT", color=col_green_4, textcolor=color.white, transp=0, style=shape.labeldown, location=location.top, size=size.tiny, text=":", offset=0)

//-- Additional Condition
plotshape(__PRINT_ALL_COND ? __LONG : na, title="__LONG_ALL", style=shape.circle, location=location.bottom, color=col_green_3, size=size.tiny)
plotshape(__PRINT_ALL_COND ? __SHORT : na, title="__SHORT_ALL", style=shape.circle, location=location.top, color=col_red_5, size=size.tiny)

//-- Plot take profits values for confirmation. Display the trailing TP until not hit
plot(series = __PRINT_TLG and __USE_TLG and __TREND_BUY and high <= __LONG_TRAIL_TP and (__TLG_TRIGGER_LONG_HIT or __USE_TLG_TRIGGER == false) ? __LONG_TRAIL_TP : na, color = col_green_1, style=plot.style_line, linewidth = 1, title = "Long Trail TP")
plot(series = __PRINT_TLG and __USE_TLG and __TREND_SELL and low >= __SHORT_TRAIL_TP and (__TLG_TRIGGER_SHORT_HIT or __USE_TLG_TRIGGER == false) ? __SHORT_TRAIL_TP : na, color = col_green_1, style = plot.style_line, linewidth = 1, title = "Short Trail TP")

//-- Plot stop loss values for confirmation. Display the trailing SL until not hit
plot(series = __PRINT_SL and __USE_SL and __TREND_BUY and low >= __LONG_TRAIL_SL and (__SL_TRIGGER_LONG_HIT or __USE_SL_TRIGGER == false) ? __LONG_TRAIL_SL : na, color=col_red_1, style=plot.style_line, linewidth=1, title="Long Trail SL")
plot(series = __PRINT_SL and __USE_SL and __TREND_SELL and high <= __SHORT_TRAIL_SL and (__SL_TRIGGER_SHORT_HIT or __USE_SL_TRIGGER == false) ? __SHORT_TRAIL_SL : na, color=col_red_1, style=plot.style_line, linewidth=1, title="Short Trail SL")

plot(__PRINT_TLG_TRIGGER and display_TLG_trigger ? trailingPriceTrigger : na, title='trailingPriceTrigger', transp=0, color=col_yellow_1, style=plot.style_cross, linewidth=1)
plot(__PRINT_SL_TRIGGER and display_SL_trigger ? StopLossPriceTrigger : na, title='SLPriceTrigger', transp=0, color=col_red_4, style=plot.style_cross, linewidth=1)

hline(100)
hline(0)
hline(-100)

_zero = i_rf_filt
_top = i_rf_filt_thl
_btm = i_rf_filt_ths
_sts = i_st_supertrend

_diff_range_top = _top - _zero
_diff_range_btm = _zero - _btm

_diff_range_st_top = _sts - _zero
_diff_range_st_btm = _zero - _sts

_d_t = _diff_range_st_top / _diff_range_top * 100
_d_b = _diff_range_btm / _diff_range_st_btm * 100

plot(_d_t > _d_b ? _d_t : _d_t < _d_b ? _d_b*-1 : na, color=_d_t > _d_b ? col_green_1 : _d_t < _d_b ? col_red_5 : na, style=plot.style_columns)
bgcolor(__LAST_CONDITION == 1 ? col_green_1 : __LAST_CONDITION == -1 ? col_red_5 : na, transp=96)


//////////////////////////////////////////////////////////////////////////
//-- AFTER: STRATEGY OR EXECUTION
//////////////////////////////////////////////////////////////////////////


if __TREND_CHANGE
    __TLG_TRIGGER_LONG_HIT     := false
    __TLG_TRIGGER_SHORT_HIT    := false 
    __SL_TRIGGER_LONG_HIT      := false
    __SL_TRIGGER_SHORT_HIT     := false


//-- } End of Setup