//@version=3


strategy("[jango] Strategy Template", overlay=true, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=95, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1)


//////////////////////////////////////////////////////////////////////////
// -- INPUTS & VARIABLES
//////////////////////////////////////////////////////////////////////////


strategyType    = input(defval="Long Only", options=["Long & Short", "Long Only", "Short Only"])

FromMonth       = input(defval = 1, title = "Ab Monat", minval = 1, maxval = 12)
FromDay         = input(defval = 1, title = "Ab Tag", minval = 1, maxval = 31)
FromYear        = input(defval = 2019, title = "Ab Jahr", minval = 2018)
ToMonth         = input(defval = 12, title = "Bis Monat", minval = 1, maxval = 12)
ToDay           = input(defval = 1, title = "Bis Tag", minval = 1, maxval = 31)
ToYear          = input(defval = 2020, title = "Bis Jahr", minval = 2019)

sls             = input(5, title='Stop Loss %', type=float)/100
tpt             = input(1, title='Take Profit %', type=float)/100

start           = timestamp(FromYear, FromMonth, FromDay, 00, 00)  
finish          = timestamp(ToYear, ToMonth, ToDay, 23, 59)        

bool _LONG      = false
bool _SHORT     = false

//////////////////////////////////////////////////////////////////////////
// -- COLORS
//////////////////////////////////////////////////////////////////////////


// --BUY, UPWARD
col_green_1     = #4EF9FF
col_green_2     = #3CADB1
col_green_3     = #26c6da  //*
col_green_4     = #afff00
col_green_5     = #CFD80E
col_green_6     = #90c818

// -- SELL, DOWNWARD
col_red_1       = #7b1fa2
col_red_2       = #7e57c2
col_red_3       = #512da8
col_red_4       = #7300de
col_red_5       = #4a148c  //*

// -- IDLE, SIDEWARD
col_yellow_1    = #ffa726
col_yellow_2    = #f57c00


//////////////////////////////////////////////////////////////////////////
// -- LOGIC
//////////////////////////////////////////////////////////////////////////

//

// -- PUT YOUR LOGIC HERE                   <<<<<<<<   <<<<<<<<   <<<<<<<

//

//////////////////////////////////////////////////////////////////////////
// -- FUNCTIONS
//////////////////////////////////////////////////////////////////////////


// -- STRATEGYTYPE
type() =>
    iff(strategyType == "Long & Short", true, iff(strategyType == "Long", true, iff(strategyType == "Short", false, na) ) )

// -- DATE AND START FILTER
window() =>
    time >= start and time <= finish ? true : false

// -- PING PONG
trigger(s) =>
    s[1] != s[0] ? true : false

// -- STRATEGY BUY / SELL ENTRIES
buy() =>
    window() and type() and _LONG
    
sell() =>
    window() and type() and _SHORT


//////////////////////////////////////////////////////////////////////////
// -- BACKTEST: STRATEGY
//////////////////////////////////////////////////////////////////////////

// -- EXECUTION: ENTRY
if buy()
    strategy.entry("Long", strategy.long, comment="Long")

if sell()
    strategy.entry("Short", strategy.short, comment="Short")

// -- EXECUTION: EXIT
stopLevel = strategy.position_avg_price * (1 - sl_inp)
takeLevel = strategy.position_avg_price * (1 + tp_inp)

strategy.exit("Stop Loss/Profit", "Long", stop=stopLevel, limit=takeLevel)
