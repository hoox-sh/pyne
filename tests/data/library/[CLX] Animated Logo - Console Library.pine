//@version=5
indicator("[CLX] Console - Animated Logo", overlay = true)

import cryptolinx/MotionDEV/32 as motion

const int Y_OFFSET = 500

// Override/Extending Built-In isset Function
method isset(string _src, string _rep) => na(_src) or _src == string(na) ? _rep : _src
method isset(float _src, float _rep) => na(_src) ? _rep : _src
method isset(int _src, int _rep) => na(_src) ? _rep : _src

// New Animated Console Logo
method render(
 map <string, label>    this,
 string                 logoSize        = size.huge,
 string                 iconSize        = size.large,
 string                 textSize        = size.normal,
 color                  logoColor       = #00FFAA,
 color                  textColor       = #BBBBBB,
 string                 logoText        = 'ConsoleDEV',
 string                 taglineText     = 'Empowering Pine Script™ Debugging',
 int                    xOffset         = 0,
 float                  yOffset         = 0
 ) => 
    if barstate.isfirst   
        this.put(
         "consoleBorder",      
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset, 
          text              = '╔════════════════════════════════╗\n║                                ║\n║                                ║\n║                                ║\n║                                ║\n╚════════════════════════════════╝', 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = logoColor, 
          text_font_family  = font.family_monospace, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        this.put(
         "animatedIcon",           
         label.new(
          x                 = bar_index + xOffset - 80, 
          y                 = Y_OFFSET + yOffset + 20, 
          text              = '⠵', 
          size              = iconSize, 
          color             = #00000000, 
          textcolor         = logoColor, 
          text_font_family  = font.family_monospace, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        this.put(
         "logo",           
         label.new(
          x                 = bar_index + xOffset + 30, 
          y                 = Y_OFFSET + yOffset + 20, 
          text              = logoText, 
          size              = logoSize, 
          color             = #00000000, 
          textcolor         = logoColor, 
          text_font_family  = font.family_monospace, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        this.put(
         "tagline",        
         label.new(
          x                 = bar_index + xOffset, 
          y                 = Y_OFFSET + yOffset - 30, 
          text              = taglineText, 
          size              = textSize, 
          color             = #00000000, 
          textcolor         = textColor, 
          text_font_family  = font.family_monospace, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
        this.put(
         "blinkingBlock",        
         label.new(
          x                 = bar_index + xOffset + 130, 
          y                 = Y_OFFSET + yOffset - 30, 
          text              = '█', 
          size              = textSize, 
          color             = #00000000, 
          textcolor         = textColor, 
          text_font_family  = font.family_monospace, 
          style             = label.style_label_center, 
          textalign         = text.align_center
          )
         )
    this

// Update Logo
method update(
 map <string, label> this,
 string              newLogoIcon,
 bool                showBlinkingBlock
 ) =>
    if barstate.islast or barstate.isrealtime
        for key in this.keys()
            this.get(key).set_x(bar_index)
        this.get("animatedIcon").set_text(newLogoIcon)
        this.get("blinkingBlock").set_text(showBlinkingBlock ? '█' : '')
    this

// New animation sequence
var string[] animationSequence = array.from('⠵', '⡃', '⠠', '⡜', '⡫', '⡻', '⡺', '⡵', '⡲', '⡰', '⡟', '⡏', '⠉', '⠸', '☰', '☱', '☲', '☳', '☴', '☵', '☶', '☷', '▙', '▞', '▚', '▟', '▖', '▝', '▗', '▖', '▘')

var map <string, label> logo = map.new<string, label>()
logo.render().update(
 animationSequence.get(bar_index % array.size(animationSequence)),
 bar_index % 2 == 0  // This will make the block blink every other bar
 )	
