//@version=5

// @description TODO: add library description here
library("Orderbook")

// @function TODO: add function description here
// @param x TODO: add parameter x description here
// @returns TODO: add what function returns


// ──── Condition {
export isLongPos() =>
    strategy.position_size > 0
// --
export isShortPos() =>
    strategy.position_size < 0
// --
export isOpen() =>
    strategy.position_size != 0
// }

// ── Price {
export avgPrice(simple string _engine, series float _sum, series float _contracts) =>
    _engine == 'CUSTOM' ? math.abs(_sum / _contracts) : strategy.position_avg_price
// --
export openProfit_inCurrency() =>
    float result = 0.
    for i = 0 to strategy.opentrades - 1
        result += strategy.opentrades.profit(i)
    result
// --
export openProfit(series float _avgPrice) => float((isLongPos() ? close -  _avgPrice :  _avgPrice - close) * strategy.position_size)
// --
export avgOpenPositionPrice() =>
    float result = 0.
    for i = 0 to strategy.opentrades - 1
        result += strategy.opentrades.entry_price(i) * strategy.opentrades.size(i) / strategy.position_size
    strategy.opentrades > 0 ? result / strategy.opentrades : na
// }

// ── PnL {
export grossProfit() =>
    float result = 0.
    for i = 0 to strategy.opentrades - 1
        result += strategy.opentrades.profit(i) + strategy.opentrades.commission(i)
    result
// --
export avgGrossProfit() =>
    float subresult = 0.
    for int i = 0 to strategy.closedtrades - 1
        subresult += strategy.closedtrades.profit(i) + strategy.closedtrades.commission(i)
    strategy.closedtrades > 0 ? subresult / strategy.closedtrades : na
// --
export profit_inPercent() =>
    float profitInPercent = 0.
    for i = 0 to strategy.closedtrades - 1
        float entryP = strategy.closedtrades.entry_price(i), float exitP = strategy.closedtrades.exit_price(i)
        profitInPercent += (exitP - entryP) / entryP * strategy.closedtrades.size(i)
    profitInPercent
// --
export avgProfit_inPercent() =>
    strategy.closedtrades > 0 ? profit_inPercent() / strategy.closedtrades * 100 : na
// }

// ── Min. / Max. {
export maxDrawDown() =>
    float result = 0.
    for i = 0 to strategy.closedtrades - 1
        result := math.max(result, strategy.closedtrades.max_drawdown(i))
    result
// --
export maxDrawDownOpen() =>
    float result = 0.
    for i = 0 to strategy.opentrades - 1
        result := math.max(result, strategy.opentrades.max_drawdown(i))
    result
// --
export maxRunUp() =>
    float result = 0.
    for i = 0 to strategy.closedtrades - 1
        result := math.max(result, strategy.closedtrades.max_runup(i))
    result
// --
export maxRunUpOpen() =>
    float result = 0.
    for i = 0 to strategy.opentrades - 1
        result := math.max(result, strategy.opentrades.max_runup(i))
    result
// }

// ── Since {
export barsSinceLastEntry() =>
    strategy.opentrades > 0 ? (bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)) : na
// --
export _timeSinceLastEntry() =>
    strategy.opentrades > 0 ? (time - strategy.opentrades.entry_time(strategy.opentrades - 1)) : na
// }

// ── Time & Bars {
export avgTradeDuration() =>
    int subresult = 0
    for i = 0 to strategy.closedtrades - 1
        subresult += strategy.closedtrades.exit_time(i) - strategy.closedtrades.entry_time(i)
    strategy.closedtrades > 0 ? subresult / strategy.closedtrades : na
// --
export avgBarsInTrade() =>
    int subresult = 0
    for i = 0 to strategy.closedtrades - 1
        subresult += strategy.closedtrades.exit_bar_index(i) - strategy.closedtrades.entry_bar_index(i) + 1
    math.round(strategy.closedtrades > 0 ? subresult / strategy.closedtrades : na)
// }

// ── Buy & Hold Return - in Account {
export buyAndHoldReturnInAccount(series int from) =>
    if time >= from
        float capital = close * syminfo.pointvalue, var float begin = strategy.convert_to_account(capital)
        (strategy.convert_to_account(capital) - begin) / begin * 100
// }

// ── Kelly Capital Ratio {
export kellyRatio() =>
    float krP = strategy.wintrades / strategy.closedtrades, float krW = strategy.grossprofit / strategy.wintrades
    float krL = strategy.grossloss / strategy.losstrades, float kr = (krP - (1 - krP) / (krW / krL)) * 100 / 100
    kr > 0 ? kr : 0
// }

export orderbook() =>
    var table BOOK = table.new(position.middle_left, 4, 20, frame_width = 12, bgcolor = #0d0c1a, frame_color = color.new(na, 85), border_width = 3, border_color = color.new(na, 85))
    if barstate.isfirst
        table.cell(BOOK, 0, 0,'\#ID', width=3, height=3, text_color = color.silver), table.cell(BOOK, 1, 0, 'Entry Price $',width=15, height=3, text_color = color.silver)
        table.cell(BOOK, 2, 0, 'Exit Price $',width=10, height=3, text_color = color.silver), table.cell(BOOK, 3, 0, 'Profit %',width=15, height=3, text_color = color.silver, text_halign = text.align_right)
        for i = 1 to 19 by 1
            for ii = 0 to 3 by 1
                table.cell(BOOK, ii, i, width= i == 1 ? 3 : 10, height=3, text_color = #0d0c1a)
    // --
    if barstate.islast or barstate.isrealtime
        float profitInPercent = .0
        for i = 1 to math.min(19, strategy.closedtrades) by 1
            float entryP = strategy.closedtrades.entry_price(strategy.closedtrades - i), float exitP = strategy.closedtrades.exit_price(strategy.closedtrades - i)
            float tmp = (exitP - entryP) / entryP * strategy.closedtrades.size(strategy.closedtrades - i), profitInPercent += tmp
            table.cell_set_text(BOOK, 0, i, str.tostring(strategy.closedtrades - i,'\#00')), table.cell_set_text(BOOK, 1, i, str.tostring(entryP,'#.0000 $'))
            table.cell_set_text(BOOK, 2, i, str.tostring(exitP,'#.0000 $')), table.cell_set_text(BOOK, 3, i, str.format('{0,number,percent} [{1,number,percent}] {2}', tmp, profitInPercent, tmp > 0 ? '▲' : '▼'))
            color cellColor = color.new(tmp < 0 ? #28194E : tmp > 0 ? #0A3E3C : #0d0c1a, 0)
            table.cell_set_bgcolor(BOOK, 0, i, cellColor), table.cell_set_bgcolor(BOOK, 1, i, cellColor), table.cell_set_bgcolor(BOOK, 2, i, cellColor), table.cell_set_bgcolor(BOOK, 3, i, cellColor)

