//@version=4
//@author=jango_blockchained


study(title="[IFLOST.io] End of Trends", shorttitle="[IFLOST.io] End of Trends", overlay=false)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


fromIndex 		= input(title="From Candle", type=input.integer, minval=1, defval=1)
toIndex 		= input(title="To Candle", type=input.integer, minval=1, defval=12)
src 			= input(title="Source", type=input.source, defval=close)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg 			= #4EF9FF
cdg 			= #3CADB1
cbg 			= #00BCD4 //Background

// Sell, Downward
clr 			= #7b1fa2
cdr 			= #7e57c2	
cbr 			= #512da8

// Idle, Sideward
cly 			= #ffa726

// New
cLime 			= #afff00
cPurple 		= #4a148c


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


endoftrends(src, fromIndex, toIndex) =>
	float sum = 0.0

	for i = fromIndex to toIndex
		sum := src >= nz(src[i]) ? sum + 1 : sum - 1
	sum

simpleColor(value) =>
	trendColor = value > 0 ? cLime : cPurple
	trendColor

float score = endoftrends(src, fromIndex, toIndex)


//////////////////////////////////////////////////////////////////////////
// Plots
//////////////////////////////////////////////////////////////////////////


plot(score, title="End of Trends Line", linewidth=2, color=simpleColor(score), transp=0, style=plot.style_line)
plot(score, title="End of Trends Circles", linewidth=2, color=simpleColor(score), transp=0)