// ——— 🔹 Method - Log #4/4 - Direct Logging { 
//
// Basic direct logging
//
// @function    Log data directly without requiring a terminal object
// @param       this            The data to log
// @param       _lvl            The log level (1=info, 2=warning, 3=error)
// @returns     data            The input data for chaining
export method log_direct(data this, series int _lvl = 1) =>
    terminal.new(display = 'logs').init().pushData(this).opt_lvl(_lvl).show()

// Basic data types direct
//
// @function    Log a string directly without terminal object
// @param       this            The string to log
// @param       _lvl            The log level (1=info, 2=warning, 3=error)
// @returns     string          The input string for chaining
export method log_direct(series string this, series int _lvl = 1) =>
    log_direct(data.new(this), _lvl)
    this

// @function    Log an integer directly without terminal object
// @param       this            The integer to log
// @param       _lvl            The log level (1=info, 2=warning, 3=error)
// @returns     int             The input integer for chaining
export method log_direct(series int this, series int _lvl = 1) =>
    log_direct(this.tostring(), _lvl)
    this

// @function    Log a float directly without terminal object with optional rounding
// @param       this            The float to log
// @param       _lvl            The log level (1=info, 2=warning, 3=error)
// @param       _round          Optional decimal places for rounding
// @returns     float           The input float for chaining
export method log_direct(series float this, series int _lvl = 1, simple int _round = na) =>
    log_direct(this.round(_round).tostring(), _lvl)
    this

// @function    Log a boolean directly without terminal object
// @param       this            The boolean to log
// @param       _lvl            The log level (1=info, 2=warning, 3=error)
// @returns     bool            The input boolean for chaining
export method log_direct(series bool this, series int _lvl = 1) =>
    log_direct(this.tostring(), _lvl)
    this

