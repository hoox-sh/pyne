// @param       this    The `<terminal>` object.
// @param       _size   The temporary text size.
// @returns     `<terminal>`
export method opt_textSize(terminal this, string _size) =>
    // --
    data last           = this.__logs.last()
    last.opt_text_size := _size
    // >>
    this
// }

