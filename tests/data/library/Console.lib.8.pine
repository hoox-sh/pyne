export method tostring(matrix <string> _data) =>
    // @variable An array, holding the stringified row data.
    array <string> tmp = defaultArrayMatrix(_data.columns(), _data.rows())
    for r = 0 to _data.rows() - 1
        // @variable An array, holding the stringified column data.
        tmpCol = array.new<string>()
        for c = 0 to _data.columns() - 1
            tmpCol.push(_data.get(r, c))
        tmp.push(tmpCol.tostring())
    tmp.tostring()
