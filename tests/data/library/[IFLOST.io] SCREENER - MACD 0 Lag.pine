f_draw_label(bar_index[index_fifth_line], lapos_y - (i_second_col * lapos_y), my_signal(outHistZL4_2), my_color(outHistZL4_2), size.normal) // Fifth Column
f_draw_label(bar_index[index_sixth_line], lapos_y - (i_second_col * lapos_y), my_signal(outHistZL5_2), my_color(outHistZL5_2), size.normal) // Sxith Column

