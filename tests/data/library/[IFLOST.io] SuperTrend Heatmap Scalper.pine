//@version=4
//based on https://www.tradingview.com/script/38nC12rD-Supertrend-Heatmap-Multi-timeframes/
study("Supertrend MTF LAG ISSUE", shorttitle="SMTFLAGI", overlay=true, precision=6)

Factor=input(3,title="[ST] Factor", minval=1,maxval = 100, type=input.float)
Pd=input(7, title="[ST] PD", minval=1,maxval = 100)

Supertrend(Factor, Pd) =>
    Up=hl2-(Factor*atr(Pd))
    Dn=hl2+(Factor*atr(Pd))
    
    TrendUp = 0.0
    TrendUp := close[1]>TrendUp[1] ? max(Up,TrendUp[1]) : Up
    TrendDown = 0.0
    TrendDown := close[1]<TrendDown[1]? min(Dn,TrendDown[1]) : Dn
    Trend = 0.0
    Trend := close > TrendDown[1] ? 1: close< TrendUp[1]? -1: nz(Trend[1],1)
    Tsl = Trend==1? TrendUp: TrendDown
    
    S_Buy = Trend == 1 ? 1 : 0
    S_Sell = Trend != 1 ? 1 : 0
    
    [Trend, Tsl]

[Trend,Tsl] = Supertrend(Factor, Pd)
// Security
ST30_Trend_MTF = security(syminfo.tickerid, "30", Trend)
ST60_Trend_MTF = security(syminfo.tickerid, "60", Trend)
ST120_Trend_MTF = security(syminfo.tickerid, "120", Trend)
ST240_Trend_MTF = security(syminfo.tickerid, "240", Trend)
ST480_Trend_MTF = security(syminfo.tickerid, "480", Trend)
STD_Trend_MTF = security(syminfo.tickerid, "D", Trend)
STW_Trend_MTF = security(syminfo.tickerid, "W", Trend)

// l1  = hline(min + 0 * incr - 0.5 * incr,  color=color(#000000,  100), linewidth = 0, linestyle = dotted)
h0 = hline(1, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h1 = hline(2, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h2 = hline(3, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h3 = hline(4, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h4 = hline(5, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h5 = hline(6, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)
h6 = hline(7, color=color.new(color.black, 10), linewidth=2, linestyle=hline.style_solid)

get_bars(Trend)=>
    since_st_buy = barssince(Trend == 1)
    since_st_sell = barssince(Trend == -1)
    [since_st_buy, since_st_sell]
    
[since_st_30_buy, since_st_30_sell] = get_bars(ST30_Trend_MTF)
[since_st_60_buy, since_st_60_sell] = get_bars(ST60_Trend_MTF)    
[since_st_120_buy, since_st_120_sell] = get_bars(ST120_Trend_MTF)    
[since_st_240_buy, since_st_240_sell] = get_bars(ST240_Trend_MTF)    
[since_st_D_buy, since_st_D_sell] = get_bars(STD_Trend_MTF)    
[since_st_W_buy, since_st_W_sell] = get_bars(STW_Trend_MTF)    

heatmap_color(cond1, cond2) =>
    cond1 ? color.new(color.green, 20) : cond2 ? color.new(color.red, 20) : na
    
lapos_x = timenow + round(change(time)*3)
lapos_y = highest(5)// + (0.15 * highest(20))
    
f_draw_label(x,y,_text,_textcolor, _size)=>
    var label Label = na
    label.delete(Label)
    Label := label.new(x, y, _text, color=color.new(color.white, 20), textcolor=_textcolor, style=label.style_none, yloc=yloc.price, xloc=xloc.bar_time, size=_size)

// draw the TF labels
f_draw_label(lapos_x, 1, "m30", color.black, size.large)
f_draw_label(lapos_x, 2, "H1", color.black, size.large) 
f_draw_label(lapos_x, 3, "H2", color.black, size.large) 
f_draw_label(lapos_x, 4, "H4", color.black, size.large) 
f_draw_label(lapos_x, 5, "Daily", color.black, size.large) 
f_draw_label(lapos_x, 6, "Weekly", color.black, size.large) 


fill(h0 ,h1, color=heatmap_color(since_st_30_sell>since_st_30_buy,   since_st_30_sell<since_st_30_buy))
fill(h1, h2, color=heatmap_color(since_st_60_sell>since_st_60_buy,   since_st_60_sell<since_st_60_buy))
fill(h2, h3, color=heatmap_color(since_st_120_sell>since_st_120_buy, since_st_120_sell<since_st_120_buy))
fill(h3, h4, color=heatmap_color(since_st_240_sell>since_st_240_buy, since_st_240_sell<since_st_240_buy))
fill(h4, h5, color=heatmap_color(since_st_D_sell>since_st_D_buy,     since_st_D_sell<since_st_D_buy))
fill(h5, h6, color=heatmap_color(since_st_W_sell>since_st_W_buy,     since_st_W_sell<since_st_W_buy))
plotshape(crossover ( since_st_60_sell,since_st_60_buy) and crossover ( since_st_30_sell,since_st_30_buy), "up arrow", shape.triangleup, location.belowbar, color.green,size=size.large)
plotshape(crossunder ( since_st_60_sell,since_st_60_buy) and crossunder ( since_st_30_sell,since_st_30_buy) , "down arrow", shape.triangledown, location.abovebar, color.red,size=size.large)
// Alertconditions
alertcondition(crossover ( since_st_60_sell,since_st_60_buy) and crossover ( since_st_30_sell,since_st_30_buy) , title='Buy Alert ST1 Trend', message="Buy Alert ST1 Trend")
alertcondition(crossunder (since_st_60_sell,since_st_60_buy) and crossunder ( since_st_30_sell,since_st_30_buy)  , title='Sell Alert ST1 Trend', message='Sell Alert ST1 Trend')