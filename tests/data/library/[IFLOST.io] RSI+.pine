//@version=3

// Original Script > ChrisMoody on 8/15/2014
// Edits > @jango_blockchained

//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] RSI+ v1.36
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] RSI+ v1.36", shorttitle="[IFLOST.io] RSI+ v1.36", precision=0)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


src = close
res = period
len = input(14, minval=1, title="RSI length")
upLine = input(70, minval=50, maxval=90, title="Upperline value")
lowLine = input(30, minval=10, maxval=50, title="Lowerline value")
sml = input(true, title="Show Middleline")
sbh = input(true, title="Show background highlights when RSI is above/below high/low lines?")
sch = input(true, title="Show Buy & Sell Signals?")


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


up = rma(max(change(src), 0), len)
down = rma(-min(change(src), 0), len)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

//ToDo > Repainting problem????? Done! ;)
outRSI = rsi

aboveLine = outRSI > upLine ? 1 : 0
belowLine = outRSI < lowLine ? 1 : 0
crossUp = outRSI[1] <  lowLine and outRSI > lowLine ? 1 : 0
crossDn = outRSI[1] >  upLine and outRSI < upLine ? 1 : 0


//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


bgcolor(sbh and aboveLine ? clr : na, transp=70)
bgcolor(sbh and belowLine ? cdg : na, transp=70)
bgcolor(sch and crossUp ? clg : na, transp=40)
bgcolor(sch and crossDn ? clr : na, transp=40)

plot(outRSI, title="RSI", style=line, linewidth=2, color=clg, transp=0)

p1 = plot(upLine, title="Upperline", style=solid, linewidth=1, color=clr, transp=0)
p2 = plot(lowLine, title="Lowerline", style=solid, linewidth=1, color=clg, transp=0)
plot(sml and 50 ? 50 : na, title="Middleline", style=linebr, linewidth=2, color=gray)

// Trade Manager Signal
signal = crossUp == 1 ? 1 : crossDn == 1 ? -1 : 0

plot(signal, title="Trade Manager Signal") 
