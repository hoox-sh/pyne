//@version=3


//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] Pump & Dump Oscillator v1.3
//////////////////////////////////////////////////////////////////////////


study(title = "[IFLOST.io] Pump & Dump Oscillator v1.3", shorttitle = "[IFLOST.io] P&D Oscillator v1.3", overlay=false)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


multiplier = input(3)
length = input(100)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


body = abs(close - open)
sma = sma(body, length) * multiplier

isPump = body > sma and close > open
isDump = body > sma and close < open

//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


plot(body, color = cbr, linewidth = 1, transp = 0, title = "Body")
plot(sma, color = cly, style = area, linewidth = 0, transp = 90, title = "Avg.body * Multiplier")
bgcolor(isPump ? clg : isDump ? clr : na, transp = 40)


//////////////////////////////////////////////////////////////////////////
// Alerts & Signals
//////////////////////////////////////////////////////////////////////////

alertcondition(isPump, title="Buy at Pump", message = "Buy at Pump - ONCE PER BAR")
alertcondition(isPump, title="Sell after Pump", message = "Sell after Pump - ONCE PER BAR CLOSE")
alertcondition(isDump, title="Sell at Dump", message = "Sell at Dump - ONCE PER BAR")
alertcondition(isDump, title="Buy after Dump", message = "Buy after Dump - ONCE PER BAR CLOSE")
