// 
//  EVERYTHING IS POSSIBLE, BY THE POWER OF DATA.


//@version=4
//@authors                      = Jan Goischke & Dennis Hilpmann


IndicatorName                   = "[iflost.io] Dynamic RSI"
ShortIndicatorName              = "[iflost.io] DRSI"

TradeId                         = "[IFLO] DRSI"

InitCapital                     = 5000
InitPosition                    = 98
InitCommission                  = 0.075

Precision                       = 0
Overlay                         = false

Format                          = format.price

//////////////////////////////////////////////////////////////////////////
//-- [SETUP-02][ST] Super Range Thereshold Filter Trend
//////////////////////////////////////////////////////////////////////////


study(
 title = IndicatorName, 
 shorttitle = ShortIndicatorName, 
 overlay = Overlay,
 format = Format,
 precision = Precision
 )


//////////////////////////////////////////////////////////////////////////
//-- VARIABLES
//////////////////////////////////////////////////////////////////////////


float i_buy                     = input(0.1,type=input.float, title="DRSI Buy Factor")
float i_sell                    = input(0.1,type=input.float, title="DRSI Sell Factor")
int i_period                    = input(14,type=input.integer, title="DRSI Lenght")
int i_lookback                  = input(60,type=input.integer, title="DRSI Lookback")


//////////////////////////////////////////////////////////////////////////
//-- COLORS
//////////////////////////////////////////////////////////////////////////


//--__buy, Upward
color col_green_1               = #4EF9FF
color col_green_2               = #3CADB1
color col_green_3               = #26c6da  //*
color col_green_4               = #afff00
color col_green_5               = #CFD80E
color col_green_6               = #90c818

//-- __sell, Downward
color col_red_1                 = #7b1fa2
color col_red_2                 = #7e57c2
color col_red_3                 = #512da8
color col_red_4                 = #7300de
color col_red_5                 = #4a148c  //*

//-- Idle, Sideward
color col_yellow_1              = #ffa726
color col_yellow_2              = #f57c00

color col_light_50              = color.new(#FFFFFF,50)


//////////////////////////////////////////////////////////////////////////
//-- CALCULATION
//////////////////////////////////////////////////////////////////////////


float i_rsi_line                = rsi(close,i_period)
float i_highest                 = highest(i_rsi_line, i_lookback)
float i_lowest                  = lowest(i_rsi_line, i_lookback)
float i_wma                     = (wma((i_highest-i_lowest)*0.5,i_period) + wma(i_lowest,i_period))
float i_high_line               = i_highest - i_wma * i_buy
float i_low_line                = i_lowest + i_wma * i_sell
float i_drsi                    = (4 * i_rsi_line + 3 * i_rsi_line[1] + 2 * i_rsi_line[2] + i_rsi_line[3] ) / 10


//////////////////////////////////////////////////////////////////////////
//-- PAINTING
//////////////////////////////////////////////////////////////////////////


a                               = plot(i_drsi, title='DRSI', color=col_light_50, linewidth=1, style=plot.style_line, transp=0)
b                               = plot(i_high_line, title='High Line', color=col_light_50, linewidth=1, style=plot.style_line, transp=0)
c                               = plot(i_low_line, title='Low Line', color=col_light_50, linewidth=1, style=plot.style_line, transp=0)

plot(i_wma, title='WMA', color=col_red_5, linewidth=1, style=plot.style_line, transp=50)

color col_1                     = i_drsi > i_high_line ? col_red_1 : na
color col_2                     = i_drsi < i_low_line ? col_green_1 : na

fill(a, b, color=col_1,transp=0)
fill(a, c, color=col_2,transp=0)


//-- } End of Script