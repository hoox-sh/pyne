//@version=4
//Credits and Thanks to: Jhanson107 for SAR Trend Trader w/Alerts and JacobAmos for Parabollic Glitter
//This shows 2 PSAR at once (the script has 3 but I use the 100% transparent for alerts to be prepared and the other one for entry points. The EMA setup is unnecesary)
study("PGlitter + TT", "PG+TT", overlay=true)

//Inputs 021215
//Glitter input
init = input(0.2, title="Initial Start", type=input.float, step=0.1)
fi = input(0.2, title="Increment/Start Ratio", type=input.float, step=0.1)
fm = input(0.5, title="Max/Start Ratio", type=input.float, step=0.1)
ac = input(true, title="PSAR Color G/R", type=input.bool)

//Glitter section for 1 of 10 PSAR plots
sar01 = sar(init * 01, init * fi * 01, init * fm * 01)
sar02 = sar(init * 02, init * fi * 02, init * fm * 02)
plot(sar01, title="SAR 01", style=plot.style_cross, color=ac ? sar01 > high ? color.red : color.green : color.silver, transp=50, linewidth=2)
plot(sar02, title="SAR 02", style=plot.style_circles, color=ac ? sar02 > high ? color.red : color.green : color.silver, transp=100, linewidth=2)
//---//---//
//SAR Trend input
UseEMA = input(false, "Use EMA Filter")
SlowEMALength = input(1, "Slow EMA Length")
FastEMALength = input(1, "Fast EMA Length")
start = 0.01
increment = 0.1
maximum = 0.11722
//SAR Trend section
psar = sar(start, increment, maximum)
ema = ema(close, SlowEMALength)
fastema = ema(close, FastEMALength)
rsi = rsi(close, 14)

//SAR Trend Signals
long = high[1] < psar[2] and high >= psar[1] and close > ema and fastema > ema and 
   UseEMA or not UseEMA and high[1] < psar[2] and high >= psar[1] or 
   UseEMA and crossover(fastema[2], ema[2]) and fastema > ema and close > psar
short = low[1] > psar[2] and low <= psar[1] and close < ema and fastema < ema and UseEMA or 
   not UseEMA and low[1] > psar[2] and low <= psar[1] or 
   UseEMA and crossunder(fastema[2], ema[2]) and rsi > 30 and fastema < ema and 
   close < psar

//SAR Trend Plot EMA
//plot(ema, color = color.blue , linewidth=4, transp= UseEMA ? 0 : 100, title="Slow EMA")
//plot(fastema, color= color.purple , linewidth=4, transp= UseEMA ? 0 : 100, title="Fast EMA")

//SAR Trend Plot PSAR
plot(psar, title="PSAR", style=plot.style_cross, color=color.blue, trackprice=true, transp=100, linewidth=2)

//SAR Trend Barcolor
//UseEMA
barcolor(close > psar and close > ema and fastema > ema and UseEMA ? color.green : na, title="Long w/ EMA")
barcolor(close > psar and close < ema and UseEMA or close > psar and fastema < ema and UseEMA or close < psar and close > ema and UseEMA or close < psar and fastema > ema ? color.white : na, title="No Trade")
barcolor(close < psar and close < ema and fastema < ema and UseEMA ? color.red : na, title="Short w/ EMA")
//NoEMA
barcolor(close > psar and not UseEMA ? color.green : na, title="Long No EMA")
barcolor(close < psar and not UseEMA ? color.red : na, title="Short No EMA")

//SAR Trend Plots
plot(cross(fastema, ema) ? fastema : na, style=plot.style_cross, linewidth=4, color=ema > fastema ? color.red : color.green, transp=UseEMA ? 10 : 100, editable=true)
plotshape(long, title="Long", text="Alerta C", style=shape.labelup, location=location.belowbar, color=color.green, size=size.tiny, textcolor=color.white, transp=0)
plotshape(short, title="Short", text="Alerta V", style=shape.labeldown, location=location.abovebar, color=color.red, size=size.tiny, textcolor=color.white, transp=0)

alertcondition(long, "Long", "Long")
alertcondition(short, "Short", "Short")