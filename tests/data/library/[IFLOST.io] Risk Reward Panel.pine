//@version=4
// Original Script > @Daveatt/David Attias
// Edits > @jango_blockchained


//////////////////////////////////////////////////////////////////////////
// [IFLOST.io] Risk Reward Panel
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] Risk Reward Panel", shorttitle="[IFLOST.io] Risk Reward Panel", overlay=true, precision=6)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


// PnL Panel positions on the chart
posXPanel = input(40, title="Panel X Position")
posYPanel = input(20, title="Panel Y Position")
// Direction
direction = input(defval="LONG", title="Trade Direction :",options=["LONG", "SHORT"])
// Entry Price
entryPrice = input(10000, title="Entry Price :")
// Stop Loss
stopLoss = input(9500, title="Stop Loss : ", type=input.float, step=1, minval=1)
// Take profits
tp1_level = input(12000, minval=0.0, title = "Take profit 1 :", type=input.float, step=0.5)
tp2_level = input(12500, minval=0.0, title = "Take profit 2 :", type=input.float, step=0.5)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


// SL and TPs calculations and plots

// ———————————————————— Function used to round values.
RoundToTick( _price) => round(_price/syminfo.mintick)*syminfo.mintick

Round( _val, _decimals) => 
    // Rounds _val to _decimals places.
    _p = pow(10,_decimals)
    round(abs(_val)*_p)/_p*sign(_val)

BuyTrend = direction == "LONG"
SellTrend = direction == "SHORT"

// STOP LOSS errors
error_SL_BUY = stopLoss >= entryPrice
error_SL_SELL = stopLoss <= entryPrice

// Take Profits errors
tp_buy_profits_error = (tp1_level > tp2_level)
tp_entry_buy_error = (tp1_level < entryPrice) or (tp2_level < entryPrice)
tp_buy_errors = tp_buy_profits_error or tp_entry_buy_error
tp_sell_profits_error = (tp1_level < tp2_level)
tp_entry_sell_error = (tp1_level > entryPrice) or (tp2_level > entryPrice)
tp_sell_errors = tp_sell_profits_error or tp_entry_sell_error

// show_panel
lapos_x = time + posXPanel
lapos_y = highest(posYPanel)
//lapos_x = time + round(change(time)*posXPanel)
//lapos_y = highest(posYPanel) * 1.15

//posXPanel = 40
//posYPanel = 20



float NO_TRADE = 0.0

calc_pnl() =>
    
    float pnl_b = NO_TRADE, float pnl_s = NO_TRADE

    if BuyTrend
        if close > entryPrice
            pnl_b := abs(((close - entryPrice)/close)*100)
        else // Long in loss
            pnl_b := abs(((entryPrice - close)/entryPrice)*100)
    
    if SellTrend
        if close < entryPrice
            pnl_s := abs(((entryPrice - close)/entryPrice)*100)
        else
            pnl_s := abs(((close - entryPrice)/close)*100)

    [pnl_b, pnl_s]

[pnl_b, pnl_s] = calc_pnl()


// Display the R:R into a Fraction format
find_rational(value, maxdenom) =>
    
    float best_err = 0.0, float err = 0.0
    float best_denom = 1
    float best_number = 1, float number=1
    string str = ""

    best_err := abs(value - 1)
    if (not maxdenom)
        maxdenom = 10000
    for denom = 1 to maxdenom
        if (best_err > 0)
            number := round(value * denom)
            err := abs(value - number / denom)
            if (err >= best_err)
                continue
            best_number := number
            best_err := err
            best_denom := denom
            str := tostring((denom / number), "#.#")

    str


calc_risk_reward() =>

    float diff_tp1 = 0.0, float diff_tp2 = 0.0, float diff_sl = 0.0
    string rational_RR1 = "", string rational_RR2 = ""

    if BuyTrend 
     and not tp_buy_profits_error
     and not error_SL_BUY

        // what we can lose
        diff_sl := entryPrice - stopLoss 
        // what we can win
        diff_tp1 := tp1_level - entryPrice 
        diff_tp2 := tp2_level - entryPrice
        // rational cals
        rational_RR1 := find_rational(diff_sl/diff_tp1, 10)
        rational_RR2 := find_rational(diff_sl/diff_tp2, 10)

    if SellTrend 
     and not tp_sell_profits_error
     and not error_SL_SELL

        // what we can lose
        diff_sl := stopLoss - entryPrice
        // what we can win 
        diff_tp1 := entryPrice - tp1_level
        diff_tp2 := entryPrice - tp2_level 
        // rational cals
        rational_RR1 := find_rational(diff_sl/diff_tp1, 10)
        rational_RR2 := find_rational(diff_sl/diff_tp1, 10)

    [rational_RR1, rational_RR2]

[rational_RR1, rational_RR2] = calc_risk_reward()

down_arrows_text = "▼" + " " + "▼" + " " + "▼" + " " + "▼" + " " + "▼" + " " + "▼" + " " + "▼" + " "

format_text(str) =>
    str + "\n"

var label PnL_Label = na
label.delete(PnL_Label)

my_text_1 =         format_text("___" + "PnL Panel" + "___\n")
//my_text_2 =         format_text(" " + down_arrows_text + " ")
my_text_3 =         format_text("Long PnL : " + tostring(Round(pnl_b,2), "#.##") + "%")
my_text_4 =         format_text("Short PnL : " + tostring(Round(pnl_s,2), "#.##") + "%\n")
my_text_5 =         format_text("R:R TP1 : " + rational_RR1)
my_text_6 =         format_text("R:R TP2 : " + rational_RR2)

final_text = my_text_1 + my_text_3 + my_text_4 + my_text_5 + my_text_6

color_PnL = (direction == "LONG") ? color.new(clg, 15) : (direction == "SHORT") ? color.new(clr, 50) : na
style_Pnl = (direction == "LONG") ? label.style_labelup : (direction == "SHORT") ? label.style_labeldown : na
PnL_Label := label.new(lapos_x, lapos_y, final_text, xloc=xloc.bar_time, yloc=yloc.price, color=color_PnL, style=style_Pnl, textcolor=color.white, size=size.small)

Calc_errors() =>

    error = ""

    if (BuyTrend and tp_buy_profits_error)
        error := error + "―═ Please make sure TP1 < TP2 for a LONG ══―"
    if (BuyTrend and tp_entry_buy_error)
        error := error + "\n\n―═ Please make sure TP1/TP2 > BUY price for a LONG ══―"
    if (SellTrend and tp_sell_profits_error)
        error := error + "\n\n―═ Please make sure TP1 > TP2 for a SHORT ══―"
    if (SellTrend and tp_entry_sell_error)
        error := error + "\n\n―═ Please make sure TP1/TP2 < SELL price for a SHORT ══―"
    if (BuyTrend and error_SL_BUY)    
        error := error + "\n\n―═ Stop Loss can't be above the BUY price ══―"
    if (SellTrend and error_SL_SELL)    
        error := error + "\n\n―═ Stop Loss can't be below the SELL price ══―"

    error

var label Error_Label = na
label.delete(Error_Label)
// pos for errur panel
lapos_err_x = time + round(change(time)*posXPanel)
lapos_err_y = lowest(20) * 0.95

//err_string = Calc_TP_errors()

if (Calc_errors() != "")
    
    my_err_text_1 = format_text("╔══════════ " + "Error Panel" + " ═════=════╗")
    my_err_text_2 = format_text(" " + down_arrows_text + " ")
    my_err_text_3 = format_text("  " + Calc_errors() + "  ")
    my_err_text_last = "╚═══════════════════=═══=════╝"

    final_err_text = my_err_text_1 + my_err_text_2 + my_err_text_3 + my_err_text_last
    Error_Label := label.new(lapos_err_x, lapos_err_y, final_err_text, color=color.new(cly, 40), textcolor=cdr, style=label.style_labelup, yloc=yloc.price, xloc=xloc.bar_time)


//////////////////////////////////////////////////////////////////////////
// Painting
//////////////////////////////////////////////////////////////////////////


// Plots
var SLplot = 0.0,  SLplot := nz(SLplot[1])
SLplot := (BuyTrend and not error_SL_BUY) ? stopLoss : (SellTrend and not error_SL_SELL) ? stopLoss : na
plot(SLplot, title="SL Plot", linewidth=2, color=color.new(clr, 30), trackprice=true, show_last=1)

var TP1plot = 0.0, TP1plot := nz(TP1plot[1])
TP1plot := (BuyTrend and not tp_buy_profits_error and not tp_entry_buy_error) 
 ? tp1_level : (SellTrend and not tp_sell_profits_error and not tp_entry_sell_error) ? tp1_level : na
plot(TP1plot, title="TP1 Plot", linewidth=2, color=color.new(clg, 30), trackprice=true, show_last=1)

var TP2plot = 0.0, TP2plot := nz(TP2plot[1])
TP2plot := (BuyTrend and not tp_buy_profits_error and not tp_entry_buy_error) 
 ? tp2_level : (SellTrend and not tp_sell_profits_error and not tp_entry_sell_error) ? tp2_level : na
plot(TP2plot, title="TP2 Plot", linewidth=2, color=color.new(clg, 30), trackprice=true, show_last=1)
