method pct(series float _srcFloat, series float _divisor = close, series bool _normalized = false) =>
    _srcFloat / _divisor * (_normalized ? 1 : 100)
method pct(series int _srcInt, series float _divisor = close, series bool _normalized = false) =>
    float(_srcInt).pct(_divisor, _normalized)


