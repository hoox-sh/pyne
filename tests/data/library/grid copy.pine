// ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

// ──── Draw Line {
//
f_draw_line(_x, _y, _x2, _y2, _col, _width) =>
    objx.push(fLINE, line.new(_x, _y, _x2, _y2, xloc.bar_index, extend.none, _col, line.style_dashed, _width))
f_draw_line2(_x, _y, _col, _width, _offsetLabels) =>
    objx.push(fLINE, line.new(_x, _y, bar_index + _offsetLabels, _y, xloc.bar_time, extend.none, _col, line.style_dashed, _width))
f_draw_line3(_y, _offsetX, _color, _offsetY, _offsetYDiv, _gridSize) =>
    series int _x1 = bar_index + _offsetX
    series float _y0 = _gridSize * .75
    series float _y1 = _y + _y0
    series float _y2 = _y - _y0
    objx.push(fLINE, line.new(_x1, _y1, _x1, _y2, xloc.bar_time, extend.none, _color, line.style_solid, 2))
f_draw_vline(_arrLine, _barTime, _color, _lineStyle, _lineWidth) =>
    objx.push(_arrLine, line.new(_barTime, high, _barTime, low, xloc.bar_time, extend = extend.both, color = _color, style = _lineStyle, width = _lineWidth))
    // }

// ──── Draw Pointer {
//
f_draw_pointer(_arrLine, _arrLabel, _anker, _offset, _type, _loc, _pcol, _spreadSize, _text1, _text2, _textAdjustment) =>
    series float location = _loc == ABOVE ? -1 : 1
    series bool above = _loc == ABOVE
    series bool below = _loc == BELOW
    color pColor = _pcol
    series float spread = (_type == CLOSE ? 1.33 * _spreadSize : _spreadSize) * location
    series float spreadStart = _anker
    objx.push(_arrLine, line.new(x1 = bar_index + _offset - 1, y1 = spreadStart - spread * 3, x2 = bar_index + _offset - 1, y2 = spreadStart - spread * 4, xloc = xloc.bar_index, extend = extend.none, color = pColor, style = line.style_solid, width = 2))
    objx.push(_arrLine, line.new(x1 = bar_index + _offset + 0, y1 = spreadStart - spread * 0.75, x2 = bar_index + _offset + 0, y2 = spreadStart - spread * 3.25, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + _offset + 0, y1 = spreadStart - spread * 3.75, x2 = bar_index + _offset + 0, y2 = spreadStart - spread * 5, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLabel, label.new(x = bar_index + _offset + 0, y = spreadStart - spread * 3.5, xloc = xloc.bar_index, textcolor = pColor, style = label.style_label_center, color = #FFFFFF00, size = size.small, text = DOT, textalign = text.align_center))
    series int descId = array.size(_arrLabel)
    objx.push(_arrLabel, label.new(x = bar_index + _offset - 1, y = spreadStart - spread * 3.5, xloc = xloc.bar_index, textcolor = color.silver, style = label.style_label_right, color = #FFFFFF00, size = size.small, text = _text2, textalign = text.align_right))
    objx.push(_arrLabel, label.new(x = bar_index + _offset + 0, y = spreadStart - spread * 5.25, xloc = xloc.bar_index, textcolor = pColor, style = label.style_label_center, color = #FFFFFF00, size = size.small, text = DIAMOND, textalign = text.align_center))
    objx.push(_arrLabel, label.new(x = bar_index + _offset + 0, y = spreadStart - spread * 5.25, xloc = xloc.bar_index, textcolor = pColor, style = _textAdjustment, color = #FFFFFF00, size = size.small, text = _text1, textalign = text.align_center))
    [descId]
    // }

// ──── Draw Info Panel {
//
f_draw_info_panel(_arrLine, _arrLabel, _offsetX, _offsetXInner, _offsetY, _offsetYDiv, _tooltip, _grid, _gridSize, _gridSizePct, _loc, _col, _labelText01, _labelText02, _labelText03) =>
    series int OFFSET = _offsetX < 0 ? 0 : _offsetX
    series int OFFSET_INNER = _offsetXInner + _offsetX < 0 ? 0 : _offsetXInner + _offsetX
    series float switch_1 = _loc == ABOVE ? -1 : 1
    series float spread = _gridSize * _offsetY * switch_1
    series float spreadStart = _grid
    series float spreadMax = _loc == BELOW ? spreadStart - spread * 7.5 : spreadStart + spread * 7.5
    series float spreadExtra = 0.
    objx.push(_arrLabel, label.new(x = bar_index + OFFSET + 2, y = spreadStart, xloc = xloc.bar_index, textcolor = _col, style = label.style_label_center, color = #FFFFFF00, size = size.small, text = '◄', textalign = text.align_center))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET + 3, y1 = spreadStart, x2 = bar_index + OFFSET + 5, y2 = spreadStart, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET + 5, y1 = spreadStart, x2 = bar_index + OFFSET + 5, y2 = spreadStart - spread * 1.25 + spreadExtra, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET + 5, y1 = spreadStart - spread * 1.25 + spreadExtra, x2 = bar_index + OFFSET_INNER + 0, y2 = spreadStart - spread * 2.75 + spreadExtra, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET_INNER + 0, y1 = spreadStart - spread * 2.75 + spreadExtra, x2 = bar_index + OFFSET_INNER + 0, y2 = spreadStart - spread * 4.75 + spreadExtra, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET_INNER + 2, y1 = spreadStart - spread * 3.75 + spreadExtra, x2 = bar_index + OFFSET_INNER + 2, y2 = spreadStart - spread * 6.25 + spreadExtra, xloc = xloc.bar_index, extend = extend.none, color = _col, style = line.style_solid, width = 2))
    objx.push(_arrLine, line.new(x1 = bar_index + OFFSET_INNER + 0, y1 = spreadStart - spread * 5.25 + spreadExtra, x2 = bar_index + OFFSET_INNER + 0, y2 = spreadStart - spread * 7.25 + spreadExtra, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 20), style = line.style_dotted, width = 1))
    objx.push(_arrLabel, label.new(bar_index + OFFSET_INNER + 0, spreadStart - spread * 5 + spreadExtra, xloc = xloc.bar_index, textcolor = _col, style = label.style_label_center, color = #FFFFFF00, size = size.small, text = DOT, textalign = text.align_center))
    objx.push(_arrLabel, label.new(bar_index + OFFSET_INNER + 2, spreadStart - spread * 5 + spreadExtra, xloc = xloc.bar_index, textcolor = color.white, style = label.style_label_left, color = #FFFFFF00, textalign = text.align_left, size = size.small, text = _labelText01))
    objx.push(_arrLabel, label.new(bar_index + OFFSET_INNER + 2, spreadStart - spread * 6 + spreadExtra, xloc = xloc.bar_index, textcolor = _col, style = label.style_label_left, color = #FFFFFF00, textalign = text.align_left, size = size.large, text = _labelText03))
    objx.push(_arrLabel, label.new(bar_index + OFFSET_INNER + 0, spreadStart - spread * 7.5 + spreadExtra, xloc = xloc.bar_index, textcolor = _col, style = label.style_label_center, color = #FFFFFF00, size = size.small, text = DIAMOND, textalign = text.align_center))
    objx.push(_arrLabel, label.new(bar_index + OFFSET_INNER + 0, spreadStart - spread * 7.5 + spreadExtra, xloc = xloc.bar_index, textcolor = _col, style = label.style_label_left, color = #FFFFFF00, size = size.normal, text = _labelText02, textalign = text.align_left, tooltip = _tooltip))
    series float yPos = spreadStart - spread * 6.1 + spreadExtra
    series float xPos = OFFSET_INNER + 2
    [xPos, yPos]
    // }

// ──── Draw Order Bar {
//
f_draw_order(_arrLine, _arrLabel, _offsetX, _src, _avg, _arrTp, _arrStop, _minSl) =>
    [sl1, sl2] = f_dist(_avg, __ORX_LONG ? _avg * (1 - array.max(_arrStop) / 100) : _avg * (1 + array.max(_arrStop) / 100))
    sl2 := sl2 < _minSl ? sl2 : _minSl
    series float sl = __ORX_LONG ? _avg * (1 - array.max(_arrStop) / 100) : _avg * (1 + array.max(_arrStop) / 100)
    series float tp = __ORX_LONG ? _avg * (1 + array.max(_arrTp) / 100) : _avg * (1 - array.max(_arrTp) / 100)
    series float avg = _avg
    // -- Skaleton
    objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = _avg, x2 = bar_index + _offsetX, y2 = tp, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = _avg, x2 = bar_index + _offsetX, y2 = sl, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
    // -- Skaleton
    objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = sl, x2 = bar_index + _offsetX + 1, y2 = sl, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
    objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = tp, x2 = bar_index + _offsetX + 1, y2 = tp, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
    // -- Profit Filled 
    // objx.push(_arrLine, line.new(x1=bar_index + _offsetX, y1=avg, x2=bar_index + _offsetX, y2=close, xloc=xloc.bar_index, extend=extend.none, color=__ORX_LONG and close > avg or __ORX_SHORT and close < avg ? color.new(CL_GR_4, 75) : color.new(CL_RD_5, 75), style=line.style_solid, width=7))
    objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = avg, x2 = bar_index + _offsetX, y2 = close, xloc = xloc.bar_index, extend = extend.none, color = __ORX_LONG and close > avg or __ORX_SHORT and close < avg ? color.new(CL_GR_4, 0) : color.new(CL_RD_5, 0), style = line.style_solid, width = 2))
    // -- Take Profit
    if array.size(_arrTp) > 0
        for i = 0 to array.size(_arrTp) - 1 by 1
            series float raw_ = array.get(_arrTp, i)
            series float tp_ = __ORX_LONG ? avg * (1 + raw_ / 100) : avg * (1 - raw_ / 100)
            objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = tp_, x2 = bar_index + _offsetX + 3, y2 = tp_, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
            objx.push(_arrLabel, label.new(x = bar_index + _offsetX, y = tp_, xloc = xloc.bar_index, style = label.style_label_center, textalign = text.align_center, text = i == array.size(_arrTp) - 1 ? __ORX_LONG ? '╔' : '╚' : '╠', size = size.small, textcolor = color.new(color.silver, 0), color = color.new(color(na), 90)))
            objx.push(_arrLabel, label.new(bar_index + _offsetX + 2, tp_, xloc = xloc.bar_index, textcolor = __MTP_TP1_LVL > i ? color.silver : CL_GR_4, style = label.style_label_left, color = #FFFFFF00, size = size.small, text = 'TP ' + str.tostring(i + 1) + ' | ' + str.tostring(tp_, '0.00 ₮'), textalign = text.align_left))
    // -- Stop-Loss
    if array.size(_arrStop) > 0
        for i = 0 to array.size(_arrStop) - 1 by 1
            series float raw_ = array.get(_arrStop, i)
            series float sl_ = __ORX_LONG ? avg * (1 - raw_ / 100) : avg * (1 + raw_ / 100)
            objx.push(_arrLine, line.new(x1 = bar_index + _offsetX, y1 = sl_, x2 = bar_index + _offsetX + 3, y2 = sl_, xloc = xloc.bar_index, extend = extend.none, color = color.new(color.silver, 55), style = line.style_dotted, width = 1))
            objx.push(_arrLabel, label.new(x = bar_index + _offsetX, y = sl_, xloc = xloc.bar_index, style = label.style_label_center, textalign = text.align_center, text = i == array.size(_arrStop) - 1 ? __ORX_SHORT ? '╔' : '╚' : '╠', size = size.small, textcolor = color.new(color.silver, 0), color = color.new(color(na), 90)))
            objx.push(_arrLabel, label.new(bar_index + _offsetX + 2, sl_, xloc = xloc.bar_index, textcolor = __MTP_SL1_LVL > i ? color.silver : CL_RD_5, style = label.style_label_left, color = #FFFFFF00, size = size.small, text = 'SL ' + str.tostring(i + 1) + ' | ' + str.tostring(sl_, '0.00 ₮'), textalign = text.align_left))
    // -- Position Average Price
    objx.push(_arrLabel, label.new(x = bar_index + _offsetX + 1, y = avg, xloc = xloc.bar_index, style = label.style_label_right, textalign = text.align_center, text = '', size = size.normal, textcolor = color.new(color.silver, 0), color = color.new(color(na), 90)))
    // objx.push(_arrLabel, label.new(x=bar_index + _offsetX, y=avg, xloc=xloc.bar_index, style=label.style_label_center, textalign=text.align_center, text='╫', size=size.normal, textcolor=color.new(color.silver, 0), color=color.new(color(na), 90)))
    objx.push(_arrLabel, label.new(x = bar_index + _offsetX + 2, y = avg, xloc = xloc.bar_index, textcolor = color.silver, style = label.style_label_left, color = #FFFFFF00, size = size.small, text = 'AVG ' + str.tostring(avg, '0.00 ₮'), textalign = text.align_left))
    // -- Close
    objx.push(_arrLabel, label.new(x = bar_index + _offsetX - 2, y = close, xloc = xloc.bar_index, style = label.style_label_right, textalign = text.align_center, text = '▶', size = size.small, textcolor = color.new(color.silver, 0), color = color.new(color(na), 90)))
    objx.push(_arrLabel, label.new(x = bar_index + _offsetX - 3, y = close, xloc = xloc.bar_index, textcolor = __ORX_LONG and close > avg or __ORX_SHORT and close < avg ? color.new(CL_GR_4, 0) : color.new(CL_RD_5, 0), style = label.style_label_left, color = #FFFFFF00, size = size.small, text = str.tostring(close, '0.00 ₮') + _BR_, textalign = text.align_right))
    // }}

orderFrame(series int _padding = 2, series color _border_color = color.gray, series color _bgcolor = na) =>
    var series box positionBox = na
    var series array<float> positionHL = array.new<float>()
    // --
    if strategy.position_size[1] == 0 and strategy.position_size != 0
        positionBox := box.new(na, na, na, na, bgcolor = _bgcolor, border_color = _border_color, border_width = 1, border_style = line.style_dotted)
        positionBox.set_left(bar_index - _padding)
    if strategy.position_size != 0
        positionHL.push(high)
        positionHL.push(low)
        positionBox.set_right(bar_index + _padding)
        positionBox.set_top(positionHL.max())
        positionBox.set_bottom(positionHL.min())
    if strategy.position_size == 0
        positionBox := na
        positionHL.clear()

orderFrame(_border_color = na, _bgcolor = color.new(__ORX_LONG ? CL_GR_4 : CL_RD_5, 95))


//  ▪ PAINTING ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Show Last {
//
bool __SHOW_LAST = __CSS_SHOW_LAST > 0 ? last_bar_index - bar_index <= __CSS_SHOW_LAST : true
// }

// ──── Source {
//
fill(plot(__SRC_PRINT and __SHOW_LAST ? __SRC_VIDYA : float(na), title = 'VIDYA', color = __SRC >= close ? color.new(CL_GR_4, 60) : color.new(CL_RD_5, 60), linewidth = 2, style = plot.style_line, join = false, editable = true, show_last = __CSS_SHOW_LAST), plot(__SRC_PRINT and __SHOW_LAST ? __SRC : float(na), title = 'REACT MA', color = __SRC >= close ? color.new(CL_GR_4, 60) : color.new(CL_RD_5, 60), linewidth = 2, style = plot.style_line, join = false, editable = true, show_last = __CSS_SHOW_LAST), color = __SRC >= close ? color.new(CL_GR_4, 80) : color.new(CL_RD_5, 80))
plot(__SRC_PRINT and __SHOW_LAST ? __SRC : float(na), title = 'REACT MA', color = __SRC >= close ? color.new(CL_GR_4, 60) : color.new(CL_RD_5, 60), linewidth = 3, style = plot.style_line, join = false, editable = true, show_last = __CSS_SHOW_LAST)

// }

// ──── Vidya {
//
var series int __VDY_COUNTER = 0
__VDY_COUNTER := __VDY_COUNTER >= __VDY_BANDS_AMOUNT ? 1 : __VDY_COUNTER + 1
var series float __VDY_BANDS_SLICE = 1 / __VDY_BANDS_AMOUNT
// --
series bool dynRange = input(false, 'Dynamic Range')
series float diffVidya = math.max(math.abs(__HIGHEST - __SRC_VIDYA_WEIGHTED), math.abs(__LOWEST - __SRC_VIDYA_WEIGHTED))
series float smaVidya = ta.sma(ta.cum(diffVidya) / ta.cum(__SRC_VIDYA_WEIGHTED), 100)
series float __VDY_FCT = dynRange ? smaVidya : __VDY_DEV_FCT
series float __VDY_DEV = __SRC_VIDYA_WEIGHTED * __VDY_FCT
series float __VDY_ALPHA = 95 //(70 + 25) / __VDY_BANDS_AMOUNT * __VDY_COUNTER
// --
plot(__VDY_BANDS_PRINT ? __SRC_VIDYA_WEIGHTED + __VDY_DEV * __VDY_BANDS_SLICE * __VDY_COUNTER : float(na), title = 'VIDYA Upper Multi', color = color.new(#CCCCCC40, __VDY_ALPHA), linewidth = 1, style = plot.style_cross, join = false, editable = true, show_last = __CSS_SHOW_LAST)
plot(__VDY_PRINT ? __SRC_VIDYA_WEIGHTED : float(na), title = 'VIDYA Long-term', color = color.new(color.aqua, f_param_high_volatility(10, 50) ? 0 : 50), linewidth = 2, style = plot.style_line, join = false, editable = true, show_last = __CSS_SHOW_LAST)
plot(__VDY_BANDS_PRINT ? __SRC_VIDYA_WEIGHTED - __VDY_DEV * __VDY_BANDS_SLICE * __VDY_COUNTER : float(na), title = 'VIDYA Lower Multi', color = color.new(#CCCCCC40, __VDY_ALPHA), linewidth = 1, style = plot.style_cross, join = false, editable = true, show_last = __CSS_SHOW_LAST)
// --
plotshape(__GRID_LONG and close <= __SRC_VIDYA_WEIGHTED * (1 - __VDY_DEV_FCT) or __GRID_SHORT and close >= __SRC_VIDYA_WEIGHTED * (1 + __VDY_DEV_FCT) ? close : float(na), title = 'VDY++', color = color.new(color.yellow, 0), size = size.tiny, editable = true, show_last = __CSS_SHOW_LAST, location = location.absolute, style = shape.cross)
// }

// ──── Grid {
//
series color gridLineColor = switch 
    __LOCKED => color.red
    __TRL_HIT => color.orange
    __COND_FULL_CLOSE => color.fuchsia
    __INJECTION => color.blue
    __GRID[0] < __GRID[1] => CL_GR_4
    __GRID[0] == __GRID[1] => color.blue
    __GRID[0] > __GRID[1] => CL_RD_5
    // --
plot(__SRC_PRINT ? __GRID : na, title = 'GRID', color = gridLineColor, linewidth = 2, join = true, style = plot.style_circles, editable = true, show_last = __CSS_SHOW_LAST)
if (__GRID_LONG or __GRID_SHORT) and not __INJECTION and not __COND_FULL_CLOSE and __SHOW_LAST
    string ctrTooltip = 'Dynamic Data' + _BR_ + (__MTG_ON ? 'MTG (Pos. Size)' + _W_ + str.tostring(__MTG, '0.00') + _BR_ : '') //+ (__GRID_MTG_ON ? 'MTG-GP (Grid Poles):' + _W_ + str.tostring(__GRID_MTG, '0.00') + _BR_ : '') //+ (__MA_DYN_LEN_ON ? 'Dynamic Length:' + _W_ + str.tostring(__MA_DYN_LEN_INT) + _BR_ : '')
    if __TR_STC_TP1_ON or __TR_TRL_ST1_ON or math.max(__GRID_CTR_LONG, __GRID_CTR_SHORT) > __TR_STC_TP1_START_FROM or __TR_STC_TP1_START_FROM == 1
        objx.push(xLABEL, label.new(time, y = __GRID, color = color.navy, text = '[' + str.tostring(__GRID_LONG ? __GRID_CTR_LONG : __GRID_CTR_SHORT) + '|' + str.tostring(__GRID_CTR) + ']', textcolor = color.new(color.silver, 0), textalign = text.align_center, style = __GRID_LONG ? label.style_label_lower_left : label.style_label_upper_left, xloc = xloc.bar_time, yloc = yloc.price, size = size.small, tooltip = ctrTooltip))
        // --
bgcolor(__PRINT_BG and __ORX_LONG and __SL_USED_PCT < 25 ? color.new(color.blue, 95) : color(na), editable = true)
// }

// ──── Post Trading Analyse {
//
// -- Singleton Tulip PTA Config Instance
series color gridColor = switch 
    __GRID_LONG[1] => CL_GR_4
    __GRID_SHORT[1] => CL_RD_4
    => color(na)
    // --
    // --
[ptaPrint, ptaColor, ptaTxt, ptaStyle, ptaSize] = switch 
    not __INJECTION[1] and not __COND_FULL_CLOSE[1] and not __LOCKED[1] and (__GRID_LONG[1] or __GRID_SHORT[1]) => [__GRID[1], gridColor, __DESC_STRING[1], label.style_circle, size.small]
    // --
    __INJECTION[1] and not __COND_FULL_CLOSE[1] and (__GRID_LONG[1] or __GRID_SHORT[1]) and not __LOCKED[1] => [__GRID[1], color.blue, __DESC_STRING[1], label.style_circle, size.small]
    // --
    (__COND_CLOSE[1] or __TRL_HIT[1]) and not __LOCKED[1] => [__GRID[1], color.orange, __DESC_STRING[1], label.style_circle, size.small]
    // --
    __COND_FULL_CLOSE[1] and not __LOCKED[1] => [__GRID[1], color.fuchsia, __DESC_STRING[1], label.style_diamond, size.small]
    // --
    __LOCKED[1] => [__GRID[1], color.red, __DESC_STRING[1], label.style_circle, size.small] //and (__GRID_LONG[1] or __GRID_SHORT[1]) => [__GRID[1], color.red, __DESC_STRING[1], label.style_circle,  size.small]

    // -- default
    => [float(na), #00000000, EMPTY, label.style_none, size.auto]
    // --
plotshape(__LOCKED[1] ? ptaPrint : na, title = 'GRID LOCK', color = color.new(color.red, 50), size = size.tiny, editable = true, style = shape.xcross, offset = -1, location = location.absolute, show_last = __CSS_SHOW_LAST)
if (__ORDER_EXEC[1] or not __ORDER_EXEC[1] and __LOCKED[1]) and __SHOW_LAST
    objx.push(xLABEL, label.new(bar_index, ptaPrint, color = color.new(ptaColor, 65), textcolor = color.new(color.white, 10), text = ptaTxt, style = ptaStyle, xloc = xloc.bar_index, yloc = yloc.price, size = ptaSize, tooltip = __INTF_TT))
plotshape(ptaPrint, title = 'GRID PTA 1', color = color.new(ptaColor, 65), size = size.small, editable = true, style = shape.circle, offset = -1, location = location.absolute, show_last = __CSS_SHOW_LAST)
plot(not __LOCKED[1] ? ptaPrint : na, title = 'GRID PA', color = color.new(CL_GR_4, 0), linewidth = 3, editable = true, join = false, style = plot.style_circles, offset = -1, show_last = __CSS_SHOW_LAST)
// --
// }

// ──── Static-/Trailing-/Static-Trailing Take Profit {
// -- TP
plot(__TR_STC_TP1_ON and not __STC_TP1_TGR and __TR_TP_PRINT1 and not __STC_TP1_HIT ? __STC_TP1 : float(na), title = 'Static/Trailing Take Profit', color = color.new(color.aqua, 60), style = plot.style_linebr, linewidth = 2, editable = true, show_last = __CSS_SHOW_LAST)
plot(__TR_STC_TP1_ON and __STC_TP1_TGR and __TR_TP_PRINT1 and not __STC_TP1_HIT ? __STC_TP1 : float(na), title = 'Static/Trailing Take Profit', color = color.new(color.aqua, 25), style = plot.style_circles, linewidth = 2, editable = true, show_last = __CSS_SHOW_LAST)
// -- Stop Loss
plot(__TR_STC_SL1_ON and __TR_TP_PRINT1 and not __STC_SL1_HIT ? __STC_SL1 : float(na), title = 'Static/Trailing Stop-Loss', color = __STC_SL1_TGR ? color.new(CL_RD_5, 10) : color.new(CL_RD_5, 85), style = plot.style_cross, linewidth = 2, editable = true, show_last = __CSS_SHOW_LAST)
// -- RL
plot(__TR_RLZ_LW1_ON ? __TR_RLZ_LW1_START_VALUE : float(na), title = 'TRAILING START LOW-PROFIT', color = __TR_RLZ_LW1_START_TGD ? color.new(color.orange, 50) : color.new(color.orange, 75), style = plot.style_circles, linewidth = 1, editable = true, show_last = __CSS_SHOW_LAST)
plot(__TR_RLZ_LW1_ON ? __TR_RLZ_LW1_MIN_VALUE : float(na), title = 'TRAILING HIT MIN LOW-PROFIT', color = __TR_RLZ_LW1_START_TGD ? color.new(color.red, 50) : color.new(color.red, 75), style = plot.style_cross, linewidth = 1, editable = true, show_last = __CSS_SHOW_LAST)
// -- Static Trailing
plot(__TR_TRL_ST1_ON and __TR_TP_PRINT1 and (__ORX_LONG and __GRID_CTR_LONG >= __TR_TRL_ST1_START_FROM or __ORX_SHORT and __GRID_CTR_SHORT >= __TR_TRL_ST1_START_FROM) ? __TRL_ST1 : float(na), title = 'TRAILING STOP #1', color = not na(__TRL_ST1) ? __ORX_LONG ? color.new(color.aqua, 0) : color.new(color.red, 0) : color(na), style = plot.style_linebr, linewidth = 1, editable = true, show_last = __CSS_SHOW_LAST)
// -- Adaptive Trailing Stop
plot(__TR_STC_TP1_ON and __TR_STC_TP1_EXTEND == ATS and __TRL_TGR and not __TRL_HIT and (__ORX_LONG and __ATS_TS < close and __GRID_CTR >= __TR_STC_TP1_START_FROM or __ORX_SHORT and __ATS_TS > close and __GRID_CTR >= __TR_STC_TP1_START_FROM) and __ATS_PRINT_ON ? __ATS_TS : float(na), 'ATS Trailing Stop Highlight', color = color.new(color(na), 65), editable = true, style = plot.style_linebr, linewidth = 4, show_last = __CSS_SHOW_LAST)
plot(__TR_STC_TP1_ON and __TR_STC_TP1_EXTEND == ATS and __TRL_TGR and not __TRL_HIT and (__ORX_LONG and __ATS_TS < close and __GRID_CTR >= __TR_STC_TP1_START_FROM or __ORX_SHORT and __ATS_TS > close and __GRID_CTR >= __TR_STC_TP1_START_FROM) and __ATS_PRINT_ON ? __ATS_TS : float(na), 'ATS Trailing Stop Highlight', color = color.new(#FFAB01, 5), editable = true, style = plot.style_linebr, linewidth = 2, show_last = __CSS_SHOW_LAST)
// }

// ──── Position Average Price {
//
plot(__TR_PRINT_AVG and __ORX_OPEN ? __ORX_AVG_PRICE : float(na), title = 'POS AVG PRICE', color = color.new(color(na), 50), show_last = __CSS_SHOW_LAST, style = plot.style_linebr, linewidth = 3, editable = true)
// fill(
plot(__TR_PRINT_AVG and __ORX_OPEN ? __ORX_AVG_PRICE : float(na), title = 'POS AVG PRICE', color = __ORX_LONG ? color.new(CL_GR_4, 0) : color.new(CL_RD_5, 0), show_last = __CSS_SHOW_LAST, style = plot.style_linebr, linewidth = 1, editable = true)
//  plot(close, 'Close', #00000000),
//  color = (__ORX_LONG and close > __ORX_AVG_PRICE) or (__ORX_SHORT and close < __ORX_AVG_PRICE) ? color.new(CL_GR_6, 90) : color.new(CL_RD_5, 90)
//  )
series bool lqPriceCond = math.abs(close - strategy.margin_liquidation_price) / close * 100 <= 3 and strategy.margin_liquidation_price == strategy.margin_liquidation_price[1]
plot(lqPriceCond ? strategy.margin_liquidation_price : na, color = color.new(color.red, 0), show_last = __CSS_SHOW_LAST, style = plot.style_linebr, linewidth = 2, editable = true)
// }

// ──── Stop-Loss - Reduce {
//
[__SL_DST1, __SL_DST2] = f_dist(__ORX_SHORT ? __ORX_AVG_PRICE : __SL_PRICE, __ORX_SHORT ? __SL_PRICE : __ORX_AVG_PRICE)
plot(__SL_DST2 < 5 and __SL_DST2 > 0 ? __SL_PRICE : float(na), title = 'SL PRICE', color = color.new(color.red, 0), show_last = __CSS_SHOW_LAST, style = plot.style_linebr, linewidth = 2, editable = true)
// }

// ──── Stop-Loss Warnings {
//
bgcolor(__SL_USED_PCT > 25 ? color.new(color.navy, 98 - __SL_USED_PCT) : color(na), editable = true)
// }

// ──── Average Distance Info {
//
if __ORX_AVG_PRICE != __ORX_AVG_PRICE[1] and __SHOW_LAST
    [avgDist1, avgDist2] = f_dist(close, __ORX_AVG_PRICE)
    distTooltip = str.format('Avg. Distance:\n{0,number,0.00} {3}  |  {1,number,percent}\nOpen: {2,number} {3}', avgDist1, avgDist2, __ORX_OPEN_PROFIT, __USDT)
    objx.push(xLABEL, label.new(time, y = __ORX_AVG_PRICE, color = #00000000, text = '⇵', textcolor = __ORX_LONG ? CL_GR_4 : CL_RD_5, textalign = text.align_right, style = __ORX_AVG_PRICE < __ORX_AVG_PRICE[1] ? label.style_label_right : label.style_label_right, xloc = xloc.bar_time, yloc = yloc.price, size = size.normal, tooltip = distTooltip))
    // }

// ──── Daily Close Divider { 
//
plot(__HTF_CLOSE == __HTF_CLOSE[1] ? __HTF_CLOSE : float(na), title = 'Last Day Close', color = f_tf_isNewWeek() ? color.new(color.yellow, 92) : color.new(color.blue, 92), style = plot.style_linebr, linewidth = 6, editable = true, show_last = __CSS_SHOW_LAST)
if f_tf_isNewDay() and __SHOW_LAST
    objx.push(xLABEL, label.new(time, close[1], style = label.style_label_right, color = color(na), text = str.tostring(close[1], '0.00 ₮') + ' ►', textcolor = f_tf_isNewWeek() ? color.yellow : color.blue, textalign = text.align_center, xloc = xloc.bar_time, size = size.tiny))
    // }

// ──── Daily Vertical Divider { 
//
if __SHOW_DAILY and timeframe.isintraday and f_tf_isNewDay() and __SHOW_LAST
    f_draw_vline(xLINE, time, f_tf_isNewWeek() ? color.new(color.yellow, 50) : color.new(color.blue, 0), line.style_dashed, 1)
    // }

// ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

// ──── Vertzical Progressbar - Draw Level {
if (barstate.isrealtime or barstate.islast or __ENV == DEV) and (__ORX_LONG or __ORX_SHORT) and __SHOW_LAST
    array<float> STOPS = array.new_float()
    STOPS := __TR_RLZ_LW1_ON ? array.concat(STOPS, array.from(__TR_RLZ_LW1_MIN_WR)) : __TR_STC_SL1_ON ? array.concat(STOPS, strx.array_strToNum(SL1)) : __TR_TRL_ST1_ON ? array.concat(STOPS, strx.array_strToNum(TRL1)) : STOPS
    f_draw_order(fLINE, fLABEL, 10, close, __ORX_AVG_PRICE, strx.array_strToNum(TP1), STOPS, 2)
    // }

// ──── Statistics {
if (barstate.isrealtime or barstate.islast or __ENV == DEV) and __SHOW_LAST
    // --
    series string labelText01 = 'Grid Size: {1}[{2} %]{0}Open Profit: {3}{0}Netto Profit: {4}'
    series string labelText02 = 'ANNUAL PROFIT:' + _W_ + str.tostring(math.abs(__NETTO_PNL) / strategy.initial_capital * 100 * bench.factor, '0.00') + ' % p.a.'
    series string labelText03 = str.tostring(math.abs(__NETTO_PNL) / strategy.initial_capital, (strategy.netprofit > 0 ? '+' : '-') + ' 0.00 %') + _W_ + '[' + str.tostring(bench.year_pct, '0.00') + ' year]'
    series string labelText05 = syminfo.tickerid
    series string labelText06 = __TR_MARKET + ' MARKET'
    series string labelText07 = 'LEVERAGE: ' + str.tostring(__TR_LEV) + _W_ + '|' + _W_ + '|' + _W_ + _BR_ + 'Grid Size %:' + str.tostring(__GRID_SIZE_PCT, '0.00%')
    series string labelText04 = labelText07 + _BR_ + 'Highest Open Loss:' + _W_ + str.tostring(__HIGHEST_OPENLOSS, '0.00 ₮') + _W_ + '|' + _W_ + 'Highest Open Profit:' + _W_ + str.tostring(__HIGHEST_OPENPROFIT, '0.00 ₮') + _BR_ + 'Since Long:' + _W_ + str.tostring(__SINCE_LONG) + ' Bars' + _W_ + '|' + _W_ + 'Since Short:' + _W_ + str.tostring(__SINCE_SHORT) + ' Bars' + _W_ + '|' + _W_ + 'Genesis Rescale Size:' + _W_
    [__PANEL_GRID_X, __PANEL_GRID_Y] = f_draw_info_panel(fLINE, fLABEL, __INTF_OFFSET_X, __INTF_OFFSET_X_INNER, __INTF_OFFSET_Y, __INTF_OFFSET_Y_DIV, __INTF_TT, __GRID, __GRID_SIZE, __GRID_SIZE_PCT, close < __GRID ? BELOW : ABOVE, color.blue, labelText01, labelText02, labelText03)
    [__PANEL_MARKET_X, __PANEL_MARKET_Y] = f_draw_info_panel(fLINE, fLABEL, __INTF_OFFSET_X, __INTF_OFFSET_X_INNER, __INTF_OFFSET_Y, __INTF_OFFSET_Y_DIV, __INTF_TT, close < __GRID ? __GRID - __GRID_SIZE : __GRID + __GRID_SIZE, __GRID_SIZE, __GRID_SIZE_PCT, close < __GRID ? ABOVE : BELOW, __SRC >= close ? CL_XX_7 : CL_RD_5, labelText04, labelText05, labelText06)
    // --
    [__POINTER_ID] = f_draw_pointer(fLINE, fLABEL, __GRID > __SRC ? __SRC - __GRID_SIZE : __SRC + __GRID_SIZE, __INTF_OFFSET_X + 5, INFO, __SRC > __GRID ? ABOVE : BELOW, __SRC >= close ? CL_XX_7 : CL_RD_5, __GRID_SIZE, 'LIVE', '', __SRC > __GRID ? label.style_label_down : label.style_label_up)
    // label.set_text(array.get(fLABEL, __POINTER_ID), f_ip_animatorTxt(ANI_ASSETS_03, str.format('T: {0,number,#}', f_ip_updateNo()), 2, -1))
    // --
    objx.push(fLABEL, label.new(x = bar_index + __INTF_OFFSET_X + 15, y = (__GRID + __SRC) / 2, color = #FFFFFF00, text = 'UNREALIZED' + _BR_ + (__ORX_OPEN_PROFIT > 0 ? '+ ' : '') + str.tostring(__ORX_OPEN_PROFIT, '0.00 ₮') + _BR_, textcolor = __ORX_OPEN_PROFIT > 0 ? CL_GR_4 : CL_RD_5, textalign = text.align_left, style = label.style_label_left, xloc = xloc.bar_index, yloc = yloc.price, size = size.normal))
    objx.push(fLABEL, label.new(x = bar_index + __INTF_OFFSET_X + 30, y = (__GRID + __SRC) / 2, color = #FFFFFF00, text = 'COM.' + _BR_ + '- ' + str.tostring(__ORX_COM, '0.00 ₮') + _BR_, textcolor = CL_RD_5, textalign = text.align_left, style = label.style_label_left, xloc = xloc.bar_index, yloc = yloc.price, size = size.normal))
    objx.push(fLABEL, label.new(x = bar_index + __INTF_OFFSET_X + 42, y = (__GRID + __SRC) / 2, color = #FFFFFF00, text = 'REALIZED' + _BR_ + (__ORX_OPEN_PROFIT > 0 ? '+ ' : '') + str.tostring(__ORX_PNL - __ORX_COM, '0.00 ₮') + _BR_, textcolor = __ORX_PNL - __ORX_COM > 0 ? CL_GR_4 : CL_RD_5, textalign = text.align_left, style = label.style_label_left, xloc = xloc.bar_index, yloc = yloc.price, size = size.normal))
    objx.push(fLINE, line.new(bar_index + __INTF_OFFSET_X + 15, (__GRID + __SRC) / 2, bar_index + __INTF_OFFSET_X + 56, (__GRID + __SRC) / 2, color = color.new(#512da8, 90), extend = extend.none, style = line.style_solid, width = 12))
    // --
    // progress.bar(_arrLine=fLINE, _arrLabel=fLABEL, _theme = PBAR_THEME_05, _offsetX = -50, _y = __PANEL_MARKET_Y + __GRID_SIZE,  _value = __MAX_SL_USED_PCT, _min = 0, _max = 100,  _slices = 9, _sliceWidth = 2, _sliceHeight = 12, _collapse = 1, _paddingWidth = 1, _paddingHeight = 4, _textTop = 'Max. SL Used %',  _textBottom = str.tostring(__MAX_SL_USED_PCT / 100,'0.00 %'),_textSize = size.small)
    // progress.bar(_arrLine=fLINE, _arrLabel=fLABEL, _theme = PBAR_THEME_05, _offsetX = -50, _y = __PANEL_MARKET_Y + (__GRID_SIZE * 3),  _value = __MAX_CTX_USED_PCT, _min = 0, _max = 100,  _slices = 9, _sliceWidth = 2, _sliceHeight = 12, _collapse = 1, _paddingWidth = 1, _paddingHeight = 4, _textTop = 'Max. Contracts Used %', _textSize = size.small,  _textBottom = str.tostring(__MAX_CTX_USED_PCT / 100,'0.00 %'))
    // progress.bar(_arrLine=fLINE, _arrLabel=fLABEL, _theme = PBAR_THEME_05, _offsetX = -50, _y = __PANEL_MARKET_Y + (__GRID_SIZE * 6),  _value = __MAX_MARGIN_USED_PCT, _min = 0, _max = 100,  _slices = 9, _sliceWidth = 2, _sliceHeight = 12, _collapse = 1, _paddingWidth = 1, _paddingHeight = 4, _textTop = 'Max. Margin Used %', _textSize = size.small,  _textBottom = str.tostring(__MAX_MARGIN_USED_PCT / 100,'0.00 %'))
    // }

// ──── Tables {
var series table T_ENV = table.new(position.top_right, 3, 1, border_color = #00000000, border_width = 2)
var series table T_STOP = table.new(position.middle_right, 3, 5, border_color = #00000000, border_width = 2)
// var series table T_JRX  = table.new(position.bottom_left, 3, __JRX_MSG_DISPLAY + 2, border_color=#00000000, border_width=2)
var series table T_STC = table.new(position.bottom_center, 5, 2, border_color = #00000000, border_width = 2)
// --
series color __T_BG_COL = color.new(strategy.netprofit > 0 ? CL_GR_1 : color.navy, 95)
series color __T_TEXT_COL = color.new(strategy.netprofit > 0 ? CL_GR_4 : CL_RD_5, 0)
// --
if barstate.isfirst
    // --
    table.cell(T_ENV, column = 0, row = 0, text = ICON_AT, width = 2, height = 3, text_color = color.white, text_size = size.small, bgcolor = __T_BG_COL, text_halign = text.align_center)
    table.cell(T_ENV, column = 1, row = 0, text = 'ENV', width = 2, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_ENV, column = 2, row = 0, text = __ENV, width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    // --
    table.cell(T_STOP, column = 0, row = 0, text = 'MR', width = 2, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STOP, column = 0, row = 1, text = 'SL', width = 2, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STOP, column = 0, row = 2, text = 'LQ', width = 2, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    // --
    table.cell(T_STOP, column = 1, row = 0, text = str.tostring(nz(__MARGIN_USED_PCT / 100, 0), '0.0 %') + ' / ' + str.tostring(__MARGIN_MAINTENANCE, '0.0 ₮'), width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_right)
    table.cell(T_STOP, column = 1, row = 1, text = str.tostring(nz(__SL_PRICE, 0), '0.00 ₮'), width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_right)
    table.cell(T_STOP, column = 1, row = 2, text = str.tostring(nz(__LQ_PRICE, 0), '0.00 ₮'), width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_right)
    // --
    table.cell(T_STC, column = 0, row = 0, text = 'Equity', width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 1, row = 0, text = str.tostring(strategy.equity, '0.00 ₮'), width = 7, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 2, row = 0, text = str.tostring(math.abs(strategy.netprofit) / strategy.initial_capital, (strategy.netprofit > 0 ? '+' : '-') + ' 0.00 %') + '\n' + str.tostring(bench.running_days) + ' Days', width = 7, height = 3, text_color = __T_TEXT_COL, text_size = size.small, bgcolor = __T_BG_COL, text_halign = text.align_center)
    table.cell(T_STC, column = 3, row = 0, text = 'AVG', width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 4, row = 0, text = str.tostring(__ORX_AVG_PRICE, '0.00 ₮'), width = 7, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    // --
    table.cell(T_STC, column = 0, row = 1, text = 'Equity', width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 1, row = 1, text = str.tostring(strategy.equity, '0.00 ₮'), width = 7, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 2, row = 1, text = str.tostring(math.abs(strategy.netprofit) / strategy.initial_capital, (strategy.netprofit > 0 ? '+' : '-') + ' 0.00 %') + '\n' + str.tostring(bench.running_days) + ' Days', width = 7, height = 3, text_color = __T_TEXT_COL, text_size = size.small, bgcolor = __T_BG_COL, text_halign = text.align_center)
    table.cell(T_STC, column = 3, row = 1, text = 'AVG', width = 5, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    table.cell(T_STC, column = 4, row = 1, text = str.tostring(__ORX_AVG_PRICE, '0.00 ₮'), width = 7, height = 3, text_color = color.white, text_size = size.small, bgcolor = color.new(color(na), 85), text_halign = text.align_center)
    // --
if barstate.islast and __SHOW_LAST
    // --
    table.cell_set_text(T_STOP, column = 1, row = 0, text = str.tostring(nz(__MARGIN_USED_PCT / 100, 0), '0.0 %') + ' / ' + str.tostring(__MARGIN_MAINTENANCE, '0.0 ₮'))
    table.cell_set_text(T_STOP, column = 1, row = 1, text = str.tostring(nz(__SL_PRICE, 0), '0.00 ₮'))
    table.cell_set_text(T_STOP, column = 1, row = 2, text = str.tostring(nz(__LQ_PRICE, 0), '0.00 ₮'))
    // --
    table.cell_set_text(T_STC, column = 0, row = 0, text = str.tostring(strategy.initial_capital, 'Start: 0.00 $'))
    table.cell_set_text(T_STC, column = 1, row = 0, text = str.tostring(__TOTAL_PNL + strategy.initial_capital - __TOTAL_COM + f_order_openProfit(__ORX_AVG_PRICE), 'Equity: 0.00 ₮'))
    table.cell_set_text(T_STC, column = 2, row = 0, text = str.tostring(math.abs(__TOTAL_PNL - __TOTAL_COM) / strategy.initial_capital, (__TOTAL_PNL > 0 ? '+' : '-') + ' 0.00 %') + '\n' + str.tostring(bench.running_days) + ' Days')
    table.cell_set_text_color(T_STC, column = 2, row = 0, text_color = __T_TEXT_COL)
    table.cell_set_text(T_STC, column = 3, row = 0, text = str.tostring(__ORX_AVG_PRICE, 'AVG: 0.00 ₮'))
    table.cell_set_text(T_STC, column = 4, row = 0, text = str.tostring(__MAX_SL_USED_PCT, 'MAX PNL: 0.00 %\n') + str.tostring(__TOTAL_COM, 'COM: 0.00 ₮\n'))
    // --
    table.cell_set_text(T_STC, column = 1, row = 1, text = str.tostring(strategy.equity, '0.00 ₮'))
    table.cell_set_text(T_STC, column = 2, row = 1, text = str.tostring(math.abs(strategy.netprofit) / strategy.initial_capital, (strategy.netprofit > 0 ? '+' : '-') + ' 0.00 %') + '\n' + str.tostring(bench.running_days) + ' Days [ ' + str.tostring(math.abs(strategy.netprofit) / strategy.initial_capital / bench.running_days, (strategy.netprofit > 0 ? '+' : '-') + ' 0.00 %') + ' p.d.]')
    table.cell_set_text_color(T_STC, column = 2, row = 1, text_color = __T_TEXT_COL)
    table.cell_set_text(T_STC, column = 4, row = 1, text = str.tostring(strategy.position_avg_price, '0.00 ₮'))
    // }


//  ▪ PNL (REALIZED)  ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Profits {
//
if __PROFIT
    [pnl1, pnl2] = f_dist(close, __ORX_AVG_PRICE)
    if __COND_FULL_CLOSE
        string pnlTxt1 = syminfo.ticker + (__ORX_LONG ? ' - LONG' : ' - SHORT') + ' PNL' + _BR_ + str.tostring(math.round(__POS_PNL, 2), '0.00') + ' x ' + str.tostring(close, '0.00## ₮') + ' | ' + str.tostring(__ORX_AVG_PRICE, '0.00## ₮') + ' AVG' + _BR_ + 'BRUTTO PNL: ' + str.tostring(__POS_PNL, '0.00## ₮') + _W_ + '|' + _W_ + str.tostring(pnl2, '0.00') + ' %' + _BR_ + 'COM: ' + str.tostring(__POS_COM, '0.00#### ₮') + _W_ + '|' + _W_ + str.tostring(__POS_COM / __POS_PNL, '0.00 %')
        __TOAST := 'PROFIT: ' + str.tostring(pnl2, '0.00') + ' %'
        objx.push(xLABEL, label.new(bar_index, __GRID >= close ? __GRID + __GRID_SIZE * labelDistFct : __GRID - __GRID_SIZE * labelDistFct, color = color.orange, style = __GRID >= close ? label.style_label_down : label.style_label_up, xloc = xloc.bar_index, textcolor = #000000FF, textalign = text.align_right, text = __TOAST, size = size.tiny, tooltip = pnlTxt1))
        // --
        hoox.addAlert(ALERTS_TELEGRAM, hoox.createTelegramMsg(_text = pnlTxt1, _secret = __HOOX_SECRET, _chatId = __TELEGRAM_CHAT_ID, _escapeables = array.from('')), __TELEGRAM_SEND_PNL)
    else
        float posContracts = math.abs(__ORX_LONG ? __CTX_SHORT : __CTX_LONG)
        string pnlTxt1 = syminfo.ticker + (__ORX_LONG ? ' - LONG' : ' - SHORT') + ' PNL' + _BR_ + str.tostring(posContracts, '0.00') + ' x ' + str.tostring(close, '0.00## ₮') + ' | ' + str.tostring(__ORX_AVG_PRICE, '0.00## ₮') + ' AVG' + _BR_ + 'BRUTTO PNL: ' + str.tostring(__POS_PNL, '0.00## ₮') + _W_ + '|' + _W_ + str.tostring(pnl2, '0.00') + ' %' + _BR_ + 'COM: ' + str.tostring(__POS_COM, '0.00## ₮') + _W_ + '|' + _W_ + str.tostring(__POS_COM / __POS_PNL, '0.00 %')
        __TOAST := 'PROFIT: ' + str.tostring(pnl2, '0.00') + ' %'
        objx.push(xLABEL, label.new(bar_index - 2, __ORX_LONG ? __GRID + __GRID_SIZE * .5 : __GRID - __GRID_SIZE * .5, color = pnl1 > 0 ? CL_GR_4 : CL_RD_5, style = __ORX_LONG ? label.style_label_lower_right : label.style_label_upper_right, xloc = xloc.bar_index, textcolor = pnl1 > 0 ? #000000FF : #FFFFFFFF, textalign = text.align_right, text = __TOAST, size = size.tiny, tooltip = pnlTxt1))
        // --
        hoox.addAlert(ALERTS_TELEGRAM, hoox.createTelegramMsg(_text = pnlTxt1, _secret = __HOOX_SECRET, _chatId = __TELEGRAM_CHAT_ID, _escapeables = array.from('')), __TELEGRAM_SEND_PNL)
        // --
if (__GRID_LONG or __GRID_SHORT) and __SL_USED_PCT >= __TR_SL_PCT / 3
    hoox.addAlert(ALERTS_TELEGRAM, str.format('SL: {0,number,percent}', __SL_USED_PCT / 100), __TELEGRAM_SEND_SL)
    // --
if (__GRID_LONG or __GRID_SHORT) and __MARGIN_USED_PCT >= __TR_MARGIN_PCT / 4
    string marginWarnString = hoox.createTelegramMsg(__HOOX_SECRET, __TELEGRAM_CHAT_ID, 'MARGIN RATIO WARNING ' + str.tostring(__MARGIN_USED_PCT, '0.00') + ' used from ' + str.tostring(__TR_MARGIN_PCT) + ' %', ESCAPEABLES)
    hoox.addAlert(ALERTS_TELEGRAM, marginWarnString, __TELEGRAM_SEND_MARGIN and __MARGIN_USED_PCT >= 25)
    // }

// ──── Send Alerts & Notifications {
//
if barstate.islast
    hoox.addAlert(ALERTS_TELEGRAM, hoox.createTelegramMsg(__HOOX_SECRET, __TELEGRAM_CHAT_ID, __INTF_TT, ESCAPEABLES), __TELEGRAM_SEND_STAT)
    // --
if barstate.islast and f_tf_interval(__TELEGRAM_INTV_INFO, __ORDER_EXEC)
    hoox.exec(ALERTS_TELEGRAM)
if barstate.islast and f_tf_interval(__TELEGRAM_INTV_ALERT, __ORDER_EXEC)
    hoox.exec(ALERTS_HOOX)
    // }

//  ▪ STRATEGY EXECUTION  ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Strategy Execution {
//
if barstate.isconfirmed and f_tf_backtestWindow()
    // --
    // [__HA_PAYLOAD_KEY, __HA_PAYLOAD] = hoox.createHomeAssistantPayload(_haToken = __HA_TOKEN, _haEntityId = array.get(str.split(__HA_ENTITY_ID, ':'), 0), _haEntityDomain = __HA_ENTITY_DOMAIN, _haLightFlash = __HA_LIGHT_FLASH)
    string openLongMsg = hoox.createOrderMsg(_secret = __HOOX_SECRET, _base = 'USDT', _quota = syminfo.ticker, _order_qty = __CTX_LONG, _action = BUY, _order_market = __TR_MARKET, _order_type = MARKET, _leverage = Leverage, _order_test = __HOOX_TEST)
    string closeLongMsg = hoox.createOrderMsg(_secret = __HOOX_SECRET, _base = 'USDT', _quota = syminfo.ticker, _order_qty = __CTX_SHORT, _action = CLOSE, _order_market = __TR_MARKET, _order_type = MARKET, _leverage = Leverage, _order_test = __HOOX_TEST)
    string openShortMsg = hoox.createOrderMsg(_secret = __HOOX_SECRET, _base = 'USDT', _quota = syminfo.ticker, _order_qty = __CTX_SHORT, _action = SELL, _order_market = __TR_MARKET, _order_type = MARKET, _leverage = Leverage, _order_test = __HOOX_TEST)
    string closeShortMsg = hoox.createOrderMsg(_secret = __HOOX_SECRET, _base = 'USDT', _quota = syminfo.ticker, _order_qty = __CTX_LONG, _action = CLOSE, _order_market = __TR_MARKET, _order_type = MARKET, _leverage = Leverage, _order_test = __HOOX_TEST)
    // --
    // ✅ INTEGRATED: Risk management constraints on trading
    if __TR_DIR == LONG_STACK or __TR_DIR == SHORT_STACK and not risk.emergencyMode
        switch 
            __COND_STACK_LONG and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.long, qty = __CTX_LONG_ABS, alert_message = openLongMsg)
            __COND_STACK_SHORT and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.short, qty = __CTX_SHORT_ABS, alert_message = openShortMsg)
            // --
            __COND_STACK_LONG_CLOSE => strategy.close(id = '.', qty = __QTY_FULL_ABS, alert_message = closeLongMsg)
            __COND_STACK_SHORT_CLOSE => strategy.close(id = '.', qty = __QTY_FULL_ABS, alert_message = closeShortMsg)

    else if __TR_DIR == FULL_STACK and not risk.emergencyMode
        switch 
            strategy.position_size == 0 and __COND_FULL_STACK_LONG and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.long, qty = __CTX_LONG_ABS, alert_message = openLongMsg)
            strategy.position_size == 0 and __COND_FULL_STACK_SHORT and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.short, qty = __CTX_SHORT_ABS, alert_message = openShortMsg)
            // --

            strategy.position_size < 0 and __COND_FULL_STACK_SHORT and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.short, qty = __CTX_SHORT_ABS, alert_message = openShortMsg)
            strategy.position_size < 0 and __CTX_LONG_ABS < __QTY_FULL_ABS and __COND_FULL_STACK_LONG => strategy.close(id = '.', qty = __CTX_LONG_ABS, alert_message = openLongMsg)
            strategy.position_size < 0 and __CTX_LONG_ABS >= __QTY_FULL_ABS and __COND_FULL_STACK_LONG => strategy.close(id = '.', qty = __QTY_FULL_ABS, alert_message = closeShortMsg)

            // --
            strategy.position_size > 0 and __COND_FULL_STACK_LONG and not risk.emergencyMode => strategy.entry(id = '.', direction = strategy.long, qty = __CTX_LONG_ABS, alert_message = openLongMsg)
            strategy.position_size > 0 and __CTX_SHORT_ABS < __QTY_FULL_ABS and __COND_FULL_STACK_SHORT => strategy.close(id = '.', qty = __CTX_SHORT_ABS, alert_message = openShortMsg)
            strategy.position_size > 0 and __CTX_SHORT_ABS >= __QTY_FULL_ABS and __COND_FULL_STACK_SHORT => strategy.close(id = '.', qty = __QTY_FULL_ABS, alert_message = closeLongMsg)

            // --
            __COND_CLOSE and not __COND_FULL_CLOSE and __ORX_OPEN => strategy.close(id = '.', qty = __ORX_LONG ? __CTX_SHORT : __CTX_LONG, alert_message = __ORX_LONG ? openShortMsg : openLongMsg)

            __COND_PART_CLOSE_SL and __ORX_OPEN and not __COND_FULL_CLOSE => strategy.close(id = '.', qty = math.abs(__ORX_LONG ? __CTX_LONG : __CTX_SHORT), alert_message = __TR_REDUCE_PCT == 100 ? __ORX_LONG ? closeLongMsg : closeShortMsg : __ORX_LONG ? openShortMsg : openLongMsg)

            // --
            __COND_FULL_CLOSE => strategy.close_all(alert_message = __ORX_LONG ? closeLongMsg : closeShortMsg)

// }

//  ▪ RESET ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Trailing {
//
if __TRL_ST1_HIT
    array.clear(TRL_SRC)
if strategy.position_size == 0 or not f_tf_backtestWindow()
    __TR_RLZ_LW1_START_TGD := false
    __TR_RLZ_LW1_START_TGD
    // }

// ──── Reset Multiplier {
//
if __TRL_HIT
    __MTP_TP1_LVL := __MTP_TP1_LVL == array.size(TP1) - 1 ? 0 : __MTP_TP1_LVL + 1
    __MTP_ST1_LVL := __MTP_ST1_LVL == array.size(TRL1) - 1 ? 0 : __MTP_ST1_LVL + 1
    __MTP_ST1_LVL
if __STC_SL1_HIT
    __MTP_SL1_LVL := __MTP_SL1_LVL == array.size(SL1) - 1 ? 0 : __MTP_SL1_LVL + 1
    __MTP_SL1_LVL
if strategy.position_size == 0
    __MTP_TP1_LVL := 0
    __MTP_SL1_LVL := 0
    __MTP_ST1_LVL := 0
    __MTG := __MTG_START
    __MTG
    // }

// ──── Position Martingale / Last-Entry {
//
if __COND_FULL_CLOSE or strategy.position_size == 0 or not f_tf_backtestWindow() //or __TRL_HIT // or __COND_CLOSE
    __LAST_ENTRY := 0
    __LAST_ENTRY
    // }

// ──── Housekeeping {
//
objx.cleanOldest(xLABEL, fLABEL, MaxLabelsCount, 80)
objx.cleanOldest(xLINE, fLINE, MaxLinesCount)
// }


