// ──── Status Indicators {
// ✅ IMPROVEMENT: Real-time status indicators (Priority 5.2)
f_getStrategyStatus() =>
    // Simplified status calculation without risk management variables
    status = switch
        strategy.openprofit > 0 => "💚 PROFITABLE"
        strategy.openprofit < -100 => "⚠️ HIGH RISK"
        strategy.openprofit < -50 => "🔶 MODERATE RISK"
        => "🔵 NORMAL"
    
    // Simplified grid status without complex regime detection
    gridStatus = switch
        close > ta.sma(close, 20) => "📈 BULLISH"
        close < ta.sma(close, 20) => "📉 BEARISH"
        => "🟡 NEUTRAL"
    
    [status, gridStatus]

[strategyStatus, gridStatus] = f_getStrategyStatus()

// ✅ FUTURES STATISTICS FUNCTION (with parameters instead of global vars)
f_getFuturesStatistics(totalPnL, totalCom, orxOpenProfit, nettoPnL, orxAvgPrice) =>
    // ✅ FUTURES CORRECTED: Use custom futures calculations instead of stock-based strategy.*
    
    // Custom futures equity and returns (matching existing table calculations)
    customEquity = f_safeCalculation(totalPnL + strategy.initial_capital - totalCom + orxOpenProfit, strategy.initial_capital)
    customNetPnL = f_safeCalculation(nettoPnL, 0.0)  // totalPnL - totalCom
    customReturn = f_safeDivision(math.abs(customNetPnL), strategy.initial_capital) * 100
    
    // Trade statistics (universal for both engines)
    winRate = f_safeDivision(strategy.wintrades, strategy.closedtrades) * 100
    
    // Custom futures-specific metrics
    totalCommission = f_safeCalculation(totalCom, 0.0)
    totalGrossPnL = f_safeCalculation(totalPnL, 0.0)
    commissionRatio = f_safeDivision(totalCommission, math.abs(totalGrossPnL)) * 100
    
    // Current position metrics
    currentAvgPrice = f_safeCalculation(orxAvgPrice, close)
    openProfit = f_safeCalculation(orxOpenProfit, 0.0)
    currentPnLPct = f_safeDivision(openProfit, math.abs(strategy.position_size * currentAvgPrice)) * 100
    
    // Risk metrics (use simplified calculations for now)
    maxDrawdownPct = math.abs(strategy.max_drawdown) / strategy.initial_capital * 100
    currentMarginUsed = f_safeDivision(math.abs(strategy.position_size * close), customEquity) * 100
    
    [customEquity, customReturn, winRate, customNetPnL, totalCommission, 
     commissionRatio, currentAvgPrice, openProfit, currentPnLPct, maxDrawdownPct, currentMarginUsed]

// ✅ IMPROVEMENT: Enhanced table with FUTURES-SPECIFIC metrics
// NOTE: Table moved to after function call (around line 2094) to fix variable dependency
