//  ▪ MARKET ANALYSIS ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Market Regime Detection {
// ✅ IMPROVEMENT: Advanced market regime detection (Priority 3.2)
type MarketRegime
    string trend      // "STRONG_UP", "WEAK_UP", "RANGING", "WEAK_DOWN", "STRONG_DOWN"
    float strength    // 0.0 to 1.0
    string volatility // "LOW", "MEDIUM", "HIGH"
    float bias        // -1.0 to 1.0 (short bias to long bias)

f_getATR() =>
    ta.atr(14)

f_getVolatility() =>
    currentATR = ta.atr(14)
    avgATR = ta.sma(ta.atr(14), 50)
    f_safeDivision(currentATR, avgATR)

f_getSMAs() =>
    sma20 = ta.sma(close, 20)
    sma50 = ta.sma(close, 50)
    [sma20, sma50]

// ──── Dynamic Grid Spacing {
// ✅ IMPROVEMENT: Adaptive spacing based on market conditions (Priority 3.1)
f_calculateDynamicSpacing(volatility, trendStrength, liquidityFactor) =>
    baseSpacing = f_getATR() * __GRID_SCALE
    
    // Volatility adjustment (higher volatility = wider spacing)
    volMultiplier = volatility > 1.5 ? 1.4 : volatility < 0.7 ? 0.8 : 1.0
    
    // Trend adjustment (strong trends = wider spacing to avoid whipsaws)
    trendMultiplier = math.abs(trendStrength) > 0.02 ? 1.3 : 1.0
    
    // Liquidity adjustment (low liquidity = wider spacing)
    liquidityMultiplier = liquidityFactor < 0.5 ? 1.2 : 1.0
    
    finalSpacing = baseSpacing * volMultiplier * trendMultiplier * liquidityMultiplier
    math.max(finalSpacing, syminfo.mintick * 10) // Ensure minimum spacing
// }

f_detectMarketRegime() =>
    [sma20, sma50] = f_getSMAs()
    sma200 = ta.sma(close, 200)
    
    // Trend analysis
    trendSlope = f_safeDivision(sma20 - sma20[20], sma20[20])
    trendAlignment = sma20 > sma50 and sma50 > sma200 ? 1 : 
                     sma20 < sma50 and sma50 < sma200 ? -1 : 0
    
    // Volatility analysis
    currentVol = f_getATR()
    avgVol = ta.sma(ta.atr(14), 50)
    volRatio = f_safeDivision(currentVol, avgVol)
    
    volRegime = volRatio > 1.5 ? "HIGH" : volRatio < 0.7 ? "LOW" : "MEDIUM"
    
    // Determine trend strength and direction
    trendStrength = math.abs(trendSlope) * math.abs(trendAlignment)
    
    trendType = switch
        trendSlope > 0.02 and trendAlignment == 1 => "STRONG_UP"
        trendSlope > 0.005 and trendAlignment >= 0 => "WEAK_UP"
        trendSlope < -0.02 and trendAlignment == -1 => "STRONG_DOWN"
        trendSlope < -0.005 and trendAlignment <= 0 => "WEAK_DOWN"
        => "RANGING"
    
    // Calculate bias (-1 to 1, where -1 favors shorts, 1 favors longs)
    bias = f_clamp(trendAlignment * trendStrength, -1.0, 1.0)
    
    MarketRegime.new(trendType, trendStrength, volRegime, bias)

// Calculate market conditions for dynamic spacing
f_getMarketConditions() =>
    volatility = f_getVolatility()
    [sma20, sma50] = f_getSMAs()
    trendStrength = f_safeDivision(sma20 - sma50, sma50)
    liquidityFactor = f_safeDivision(volume, ta.sma(volume, 20))
    
    [volatility, trendStrength, liquidityFactor]

// Get current market regime
currentRegime = f_detectMarketRegime()

// Calculate dynamic grid spacing
[volatility, trendStrength, liquidityFactor] = f_getMarketConditions()
dynamicSpacing = f_calculateDynamicSpacing(volatility, trendStrength, liquidityFactor)
// }

//  ▪ PERFORMANCE OPTIMIZATIONS ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Grid Level Management for Edgeless System {
// ✅ IMPROVEMENT: Efficient grid level storage with automatic cleanup (Priority 2.1)
type GridLevel
    float price
    bool isActive
    int barIndex
    string direction
    int levelId

var array<GridLevel> activeLevels = array.new<GridLevel>()
var int MAX_GRID_LEVELS = 50  // Reduced from unlimited to manageable amount

f_addGridLevel(price, direction) =>
    // ✅ FIX: Use bar_index as unique ID to avoid var modification in function
    levelId = bar_index + math.round(price * 10000)  // Unique ID combining bar and price
    newLevel = GridLevel.new(price, true, bar_index, direction, levelId)
    array.push(activeLevels, newLevel)
    
    // Maintain maximum level count for performance
    if array.size(activeLevels) > MAX_GRID_LEVELS
        array.shift(activeLevels)
    
    newLevel

f_pruneDistantLevels(currentPrice, maxDistance) =>
    if array.size(activeLevels) > 0
        for i = array.size(activeLevels) - 1 to 0
            if i < array.size(activeLevels)
                level = array.get(activeLevels, i)
                if math.abs(level.price - currentPrice) > maxDistance or 
                   bar_index - level.barIndex > 500
                    array.remove(activeLevels, i)

// ✅ FIX: Remove level instead of modifying var property (Pine Script v6 compliance)
f_removeGridLevel(levelId) =>
    if array.size(activeLevels) > 0
        for i = array.size(activeLevels) - 1 to 0
            level = array.get(activeLevels, i)
            if level.levelId == levelId
                array.remove(activeLevels, i)
                break
// }



//  ▪ EDGELESS GRID ENHANCEMENTS ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// (moved f_calculateDynamicSpacing function earlier)
// }

// ──── Intelligent Position Sizing for Edgeless Grids {
// ✅ IMPROVEMENT: Distance-based position sizing (Priority 3.3)
f_calculateEdgelessPositionSize(distanceFromEntry, baseSize, riskLevel) =>
    maxDistance = f_getATR() * 15 // Maximum distance before size reduction
    
    // Progressive size reduction as distance increases
    distanceFactor = math.max(0.1, 1 - (distanceFromEntry / maxDistance))
    
    // Risk-adjusted sizing based on market conditions
    riskAdjustment = 1 - f_clamp(riskLevel * 0.3, 0, 0.5)
    
    // Market regime adjustment
    regimeAdjustment = switch currentRegime.trend
        "STRONG_UP" => 1.1    // Slightly larger sizes in strong trends
        "STRONG_DOWN" => 1.1
        "RANGING" => 0.9      // Smaller sizes in ranging markets
        => 1.0
    
    adjustedSize = baseSize * distanceFactor * riskAdjustment * regimeAdjustment
    math.max(adjustedSize, baseSize * 0.05) // Absolute minimum 5% of base size

// Risk assessment for position sizing
f_assessMarketRisk() =>
    volatilityRisk = f_getVolatility() > 2 ? 0.8 : 0.2
    trendRisk = math.abs(ta.rsi(close, 14) - 50) > 30 ? 0.6 : 0.1
    volumeRisk = volume > ta.sma(volume, 20) * 2 ? 0.4 : 0.1
    
    f_clamp(volatilityRisk + trendRisk + volumeRisk, 0.0, 1.0)
// }

//  ▪ ADVANCED RISK MANAGEMENT ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Advanced Risk Manager {
// ✅ IMPROVEMENT: Sophisticated drawdown management (Priority 4.1)
type RiskManager
    float peakEquity
    float maxDrawdown
    float currentDrawdown
    bool emergencyMode
    int consecutiveLosses
    float exposureLimit
    int lastLossBar
    float currentRiskLevel

var RiskManager risk = RiskManager.new(strategy.initial_capital, 0.0, 0.0, false, 0, 1.0, 0, 0.0)

// ✅ FIX: Calculate risk values without modifying var in function (Pine Script v6 compliance)
f_calculateRiskMetrics() =>
    currentEquity = f_safeCalculation(strategy.equity + strategy.openprofit, strategy.initial_capital)
    
    // Calculate peak equity
    newPeakEquity = math.max(risk.peakEquity, currentEquity)
    
    // Calculate drawdown
    currentDrawdown = f_safeDivision(newPeakEquity - currentEquity, newPeakEquity)
    newMaxDrawdown = math.max(risk.maxDrawdown, currentDrawdown)
    
    // Count consecutive losses
    newConsecutiveLosses = risk.consecutiveLosses
    newLastLossBar = risk.lastLossBar
    if strategy.closedtrades > strategy.closedtrades[1] and strategy.wintrades == strategy.wintrades[1]
        newConsecutiveLosses += 1
        newLastLossBar := bar_index
    else if currentEquity > risk.peakEquity
        newConsecutiveLosses := 0
    
    // Emergency mode triggers
    emergencyTriggers = 
         currentDrawdown > 0.15 or          // 15% drawdown
         strategy.opentrades > 30 or        // Too many positions
         newConsecutiveLosses > 5 or        // Consecutive losses
         currentEquity < strategy.initial_capital * 0.7  // 30% loss from initial
    
    // Dynamic exposure adjustment
    exposureLimit = switch
        currentDrawdown > 0.10 => 0.5      // 50% exposure reduction
        currentDrawdown > 0.05 => 0.7      // 30% exposure reduction
        newConsecutiveLosses > 3 => 0.8    // Reduce after consecutive losses
        => 1.0                             // Full exposure
    
    // Calculate current risk level
    riskLevel = f_clamp(
         (currentDrawdown * 2) + 
         (newConsecutiveLosses * 0.1) + 
         (f_assessMarketRisk() * 0.3), 0.0, 1.0)
    
    [newPeakEquity, currentDrawdown, newMaxDrawdown, newConsecutiveLosses, 
     newLastLossBar, emergencyTriggers, exposureLimit, riskLevel]

// ✅ FIX: Update risk manager outside function to avoid var modification error
[newPeakEquity, currentDrawdown, newMaxDrawdown, newConsecutiveLosses, 
 newLastLossBar, emergencyTriggers, exposureLimit, riskLevel] = f_calculateRiskMetrics()

// Apply updates to risk manager (outside function)
risk.peakEquity := newPeakEquity
risk.currentDrawdown := currentDrawdown
risk.maxDrawdown := newMaxDrawdown
risk.consecutiveLosses := newConsecutiveLosses
risk.lastLossBar := newLastLossBar
risk.emergencyMode := emergencyTriggers
risk.exposureLimit := exposureLimit
risk.currentRiskLevel := riskLevel
// }

// ──── Emergency Stop Mechanisms {
// ✅ IMPROVEMENT: Multi-layered emergency stops (Priority 4.2)
f_checkEmergencyConditions() =>
    marginUsed = f_safeDivision(math.abs(strategy.position_size * close), strategy.equity)
    openProfit = f_safeCalculation(strategy.openprofit, 0.0)
    totalExposure = math.abs(strategy.position_size * close)
    
    emergencyConditions = array.new<string>()
    
    // Critical margin usage
    if marginUsed > 0.85
        array.push(emergencyConditions, "⚠️ Margin usage exceeded 85%")
    
    // Excessive open loss
    if openProfit < -strategy.initial_capital * 0.25
        array.push(emergencyConditions, "📉 Open loss exceeded 25% of capital")
    
    // Too many open positions
    if strategy.opentrades > 40
        array.push(emergencyConditions, "🔢 Too many open positions (40+)")
    
    // Total exposure too high
    if totalExposure > strategy.equity * 5
        array.push(emergencyConditions, "💰 Total exposure exceeds 5x equity")
    
    // Rapid equity decline
    if strategy.equity < strategy.equity[5] * 0.9 and bar_index > 5
        array.push(emergencyConditions, "📊 Rapid equity decline detected")
    
    // Return emergency status and reasons
    [array.size(emergencyConditions) > 0, emergencyConditions]

// Check emergency conditions
[isEmergency, emergencyReasons] = f_checkEmergencyConditions()

// ✅ IMPROVEMENT: Emergency response system
// ✅ FIXED: Properly manage emergency mode based on actual conditions
risk.emergencyMode := isEmergency

if isEmergency and not isEmergency[1]
    // Log emergency reasons (first occurrence only)
    if array.size(emergencyReasons) > 0
        firstReason = array.get(emergencyReasons, 0)
        // Emergency logged - mode already set above

// Apply risk-based position size adjustments
marketRisk = f_assessMarketRisk()
riskAdjustedExposure = risk.exposureLimit * (1 - marketRisk * 0.2)
// }

