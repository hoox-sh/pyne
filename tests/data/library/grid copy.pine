//  ▪ CORE UTILITIES & SAFETY FUNCTIONS ────
// ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

// ──── Safe Calculation Functions {
// ✅ IMPROVEMENT: Fix NaN values in statistics (Priority 1.1)
f_safeCalculation(value, fallback = 0.0) =>
    na(value) ? fallback : value

// ✅ IMPROVEMENT: Safe division to prevent division by zero
f_safeDivision(dividend, divisor) =>
    divisor != 0 ? dividend / divisor : 0.0

// ✅ IMPROVEMENT: Safe percentage calculation
f_safePercentage(value, base) =>
    base != 0 ? (value / base) * 100 : 0.0

// ✅ IMPROVEMENT: Clamp values within bounds
f_clamp(value, minVal, maxVal) =>
    math.max(minVal, math.min(maxVal, value))
// }

// ──── Input Validation Functions {
// ✅ IMPROVEMENT: Basic input validation (Priority 1.2)
// Note: Only validates variables declared before this point
f_validateInputs() =>
    // Basic timeframe validation
    if str.length(syminfo.ticker) == 0
        runtime.error("❌ Invalid symbol")
    
    // Ensure we're on a valid chart
    if na(close)
        runtime.error("❌ No price data available")
