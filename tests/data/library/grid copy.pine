// ──── Init/Start Benchmark {
type benchmark
	int time_begin = time
	float year_pct
	float factor
	float running_days

method run(series benchmark this) =>
    this.year_pct := (time_close - this.time_begin) / 60 * 60 * 24 * 365 * 1000
    this.factor := 1 / this.year_pct
    this.running_days := math.round((timenow - this.time_begin) / 1000 / (60 * 60 * 24), 1)
    this.running_days

var benchmark bench = benchmark.new()
bench.run()
// }


