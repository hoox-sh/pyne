//@version=4
//@author=jango_blockchained

//////////////////////////////////////////////////////////////////////////
// []IFLOST.io] Awesome Divergenz Hull MA SAR Super Trend Sucker :)
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] Awesome Divergenz Hull MA SAR Super Trend Sucker", shorttitle="[IFLOST.io] ADHS", overlay=true)


//////////////////////////////////////////////////////////////////////////
// INPUTS
//////////////////////////////////////////////////////////////////////////

float isrc = input(title="Source",type=input.source,defval=close)

// Hull MA
int hull_period =input(title="Hull MA Period",type=input.integer,defval=12)

// Awesome Oszillator
int ao_fast = input(title="AO Fast EMA Length",type=input.integer,defval=5)
int ao_slow = input(title="AO Slow EMA Length",type=input.integer,defval=26)

// Parabolic SAR
float psar_start = input(title="Parabolic SAR Start", type=input.float, step=0.001, defval=0.01)
float psar_increment = input(title="Parabolic SAR Increment", type=input.float, step=0.001, defval=0.01)
float psar_maximum = input(title="Parabolic SAR Maximum", type=input.float, step=0.01, defval=0.2)

// Super Trend
float st_factor = input(title="SuperTrend ATR Factor",defval=1.5,type=input.float)
int st_pd = input(title="SuperTrend ATR Period",defval=5,minval=1,maxval=100,type=input.integer)



//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #7b1fa2
cdr = #7e57c2	
cbr = #512da8

// Idle, Sideward
cly = #ffa726


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


// Hull MA
n2ma = 2 * wma(isrc, round(hull_period / 2))
nma = wma(isrc, hull_period)
diff = n2ma - nma
sqn= round(sqrt(hull_period))

n2ma1 = 2 * wma(isrc[1], round(hull_period / 2))
nma1 = wma(isrc[1], hull_period)
diff1 = n2ma1 - nma1
sqn1 = round(sqrt(hull_period))

n1 = wma(diff, sqn)
n2 = wma(diff1, sqn) 
c = n1 > n2 ? clg : clr

// Awsome Oszillator
ao = ema(hl2, ao_fast) - ema(hl2, ao_slow)
color_ao = change(ao) > 0 ? cdg : cdr

ao_shortCondition = change(ao) < 0

// Parabolic SAR
psar = sar(psar_start, psar_increment, psar_maximum)
dir = psar < isrc ? 1 : -1

psarColor = dir == 1 ? cbg : cbr
plot(psar, title="PSAR", style=plot.style_histogram, linewidth=1, color=psarColor, transp=0)

// AO
//plot(ao, style=plot.style_columns,color=color_ao,transp=0)

// Hull MA
hull_shortCondition = cross(n1, n2) and n2 > n1
hull_tm_short = hull_shortCondition ? -1 : 0

plot(hull_shortCondition ? n1 + (n1 / 200) : na, style=plot.style_cross, color=cly, linewidth=2, transp=0)
plot(hull_shortCondition ? ao_shortCondition ? n1 - (n1 / 100) : na : na, style=plot.style_cross, color=cly, linewidth=2, transp=0)

plot(n1, color=clg, linewidth=1)
plot(n2, color=clr, linewidth=1)
//plot(cross(n1, n2) ? n1 : na, style = cross, color = c, linewidth = 4)

