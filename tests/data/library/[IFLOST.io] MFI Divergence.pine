//@version=3

//edited the rsi div indicator by Libertus to use MFI & show on candles
//v2 update filters the divs with stochastic os/ob
//seems to work best on 1hr timeframe & below, & if after a signal you wait for a stochastic indicator to stop being oversold or overbought


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


study(title="[IFLOST.io] MFI Divergence ", shorttitle="[IFLOST.io] MFI Divs", overlay=true)


//////////////////////////////////////////////////////////////////////////
// Inputs
//////////////////////////////////////////////////////////////////////////


len = input(13, minval=1, title="MFI Length")
ob = input(75, "Overbought", integer, minval=0, maxval=100)
os = input(25, "Oversold", integer, minval=0, maxval=100)
periodK = input(14, title="Stoch period", minval=1)
smoothK = input(3, title="Stoch smooth", minval=1)

// RSI code edited to use MFI
src = hlc3
upper = sum(volume * (change(src) <= 0 ? 0 : src), len)
lower = sum(volume * (change(src) >= 0 ? 0 : src), len)
rsi = rsi(upper, lower)

//stoch
k = sma(stoch(close, high, low, periodK), smoothK)

// DIVS code
piv = input(false,"Hide pivots?")

max = na
max_rsi = na
min = na
min_rsi = na
pivoth = na
pivotl = na
divbear = na
divbull = na
isOS = na
isOB = na
xbars = na
hb = na
lb = na

bars1m = input(300, "Lookback 1m", integer, minval=1)
bars5m = input(110, "Lookback 5m", integer, minval=1)
bars15m = input(40, "Lookback 15m", integer, minval=1)
bars30m = input(30, "Lookback 30m", integer, minval=1)
bars1h = input(10, "Lookback 1h", integer, minval=1)
bars4h = input(10, "Lookback 4h", integer, minval=1)
bars12h = input(10, "Lookback 12h", integer, minval=1)
bars1d = input(10, "Lookback D", integer, minval=1)
bars3d = input(10, "Lookback 3D", integer, minval=1)
barsW = input(10, "Lookback W", integer, minval=1)


//////////////////////////////////////////////////////////////////////////
// Colors
//////////////////////////////////////////////////////////////////////////


// Buy, Upward
clg = #4EF9FF
cdg = #3CADB1
cbg = #00BCD4 //Background

// Sell, Downward
clr = #FF0081
cdr = #880E4F
cbr = #AB47BC

// Idle, Sideward
cly = #FBC02D

upColor = clg
dnColor = clr
wickColor = color.gray

fillColorUp = clg
fillColorDn = clr
fillColorWick = clg


//////////////////////////////////////////////////////////////////////////
// Calculation
//////////////////////////////////////////////////////////////////////////


if period == "1"
	xbars := bars1m
if period == "5"
	xbars := bars5m
if period == "15"
	xbars := bars15m
if period == "30"
	xbars := bars30m
if period == "60"
	xbars := bars1h
if period == "240"
	xbars := bars4h
if period == "720"
	xbars := bars12h
if period == "D"
	xbars := bars1d
if period == "3D"
	xbars := bars3d
if period == "W"
	xbars := barsW
	
hb := abs(highestbars(rsi, xbars)) // Finds bar with highest value in last X bars
lb := abs(lowestbars(rsi, xbars)) // Finds bar with lowest value in last X bars

//this bar or last is os/ob
isOS := (k[1] < os) or (k < os) ? true : na
isOB := (k[1] > ob) or (k > ob) ? true : na

// If bar with lowest / highest is current bar, use its value
max := hb == 0 ? close : na(max[1]) ? close : max[1]
max_rsi := hb == 0 ? rsi : na(max_rsi[1]) ? rsi : max_rsi[1]
min := lb == 0 ? close : na(min[1]) ? close : min[1]
min_rsi := lb == 0 ? rsi : na(min_rsi[1]) ? rsi : min_rsi[1]

// Compare high of current bar being examined with previous bar's high
// If curr bar high is higher than the max bar high in the lookback window range
if close > max // we have a new high
    max := close // change variable "max" to use current bar's high value
if rsi > max_rsi // we have a new high
    max_rsi := rsi // change variable "max_rsi" to use current bar's RSI value
if close < min // we have a new low
    min := close // change variable "min" to use current bar's low value
if rsi < min_rsi // we have a new low
    min_rsi := rsi // change variable "min_rsi" to use current bar's RSI value

// Finds pivot point with at least 2 right candles with lower value
pivoth := (max_rsi == max_rsi[2]) and (max_rsi[2] != max_rsi[3]) ? true : na
pivotl := (min_rsi == min_rsi[2]) and (min_rsi[2] != min_rsi[3]) ? true : na

// Detects divergences between price and indicator with 1 candle delay so it filters out repeating divergences
if (max[1] > max[2]) and (rsi[1] < max_rsi) and (rsi <= rsi[1])
    divbear := true
if (min[1] < min[2]) and (rsi[1] > min_rsi) and (rsi >= rsi[1])
    divbull := true


//////////////////////////////////////////////////////////////////////////
// Alerts
//////////////////////////////////////////////////////////////////////////


alertcondition((divbear and isOB), title='Bear div', message='Bear div')
alertcondition((divbull and isOS), title='Bull div', message='Bull div')


//////////////////////////////////////////////////////////////////////////
// Plots
//////////////////////////////////////////////////////////////////////////


plotshape((divbear and isOB) ? rsi[1] + 3 : na, location=location.abovebar, style=shape.triangledown, color=clr, size=size.tiny, transp=25, offset=0)
plotshape((divbull and isOS) ? rsi[1] - 3 : na, location=location.belowbar, style=shape.triangleup, color=clg, size=size.tiny, transp=40, offset=0)
plotshape(piv ? na : ((pivoth and isOB) ? max_rsi + 3 : na), location=location.abovebar, style=shape.triangledown, color=clr, size=size.tiny, transp=75, offset=0)
plotshape(piv ? na : ((pivotl and isOS) ? min_rsi - 3 : na), location=location.belowbar, style=shape.triangleup, color=clg, size=size.tiny, transp=80, offset=0)