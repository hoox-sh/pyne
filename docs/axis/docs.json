{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AXIS",
  "description": "Open charting PWA — compose sources, streams, engines, and storage. Full Pine Script™ surface via PYNE without a proprietary charting host.",
  "colors": {
    "primary": "#A78BFA",
    "light": "#C4B5FD",
    "dark": "#7C3AED"
  },
  "appearance": {
    "default": "dark"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "AXIS Docs",
      "og:title": "AXIS — Open Charting PWA",
      "og:description": "Installable AXIS for price and time. Orthogonal plugins: sources, streams, engines, storage. Self-host the chart.",
      "og:type": "website",
      "canonical": "https://hoox.sh/axis/docs",
      "robots": "index, follow"
    }
  },
  "search": {
    "prompt": "Search AXIS docs..."
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/jango-blockchained/pynescript/tree/main/frontend"
    }
  },
