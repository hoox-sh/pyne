{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pyne-api-container",
  "account_id": "debc6545e63bea36be059cbc82d80ec8",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "containers": [
    {
      "class_name": "PyneApiContainer",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PYNE_API",
        "class_name": "PyneApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PyneApiContainer"]
    }
  ]
}
