{
  "name": "pyne",
  "version": "0.6.7",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "jango-blockchained",
  "description": "pyne — Pine Script™ Python toolchain (parser, evaluator, LSP, Pro API). Part of HOOX: hoox.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoox-sh/pyne.git"
  },
  "homepage": "https://hoox.sh/pyne",
  "bugs": {
    "url": "https://github.com/hoox-sh/pyne/issues"
  },
  "scripts": {
    "docs:exports": "node scripts/docs/generate-exports.mjs",
    "docs:exports:all": "node scripts/docs/generate-exports.mjs --only=all",
    "docs:exports:pdfs": "node scripts/docs/generate-exports.mjs --only=pdfs",
    "docs:exports:agents": "node scripts/docs/generate-exports.mjs --only=agents",
    "docs:exports:pyne": "node scripts/docs/generate-exports.mjs --only=pyne",
    "docs:versions": "node scripts/docs/fetch_versions.mjs",
    "okf:enrich": "bun scripts/okf/cli.ts enrich",
    "okf:check": "bun scripts/okf/cli.ts enrich --check",
    "okf:lint": "bun scripts/okf/cli.ts lint",
    "okf:query": "bun scripts/okf/cli.ts query",
    "okf:context": "bun scripts/okf/cli.ts context",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "typescript": "7.0.2"
  }
}
